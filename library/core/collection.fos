import core.iteration

/// A repeatable collection with a known number of elements.
///
/// Collection access borrows the value. Creating an iterator produces an independent
/// cursor over the collection's read-only value view.
pub type Collection<T> & Iterable<T> {
    /// Returns the number of elements in this collection.
    pub func length(self) -> Int

    /// Returns whether this collection contains no elements.
    pub func empty?(self) -> Bool
}
