//! Floating-point arithmetic helpers and totalized comparison utilities.

import core.ordering

type FloatHost = {}

/// Host primitive used by the Foster-written floating-point formatter API.
func FloatHost.format(value: Float) -> String = intrinsic("float.format")

/// Formats a binary64 value as round-trippable decimal text.
pub func to_string(value: Float) -> String { FloatHost.format(value) }

/// Returns the absolute value of `value`.
pub func absolute(value: Float) -> Float {
    branch {
        value < 0.0 -> -value
        _ -> value
    }
}

/// Returns the smaller of `left` and `right`.
pub func minimum(left: Float, right: Float) -> Float {
    branch {
        left <= right -> left
        _ -> right
    }
}

/// Returns the larger of `left` and `right`.
pub func maximum(left: Float, right: Float) -> Float {
    branch {
        left >= right -> left
        _ -> right
    }
}

/// Restricts `value` to the inclusive range from `lower` to `upper`.
pub func clamp(value: Float, lower: Float, upper: Float) -> Float {
    minimum(maximum(value, lower), upper)
}

/// Returns `-1`, `0`, or `1` according to the sign of `value`.
pub func sign(value: Float) -> Int {
    branch {
        value < 0.0 -> -1
        value > 0.0 -> 1
        _ -> 0
    }
}

/// Compares two floating-point values and returns their ordering.
pub func compare(left: Float, right: Float) -> Ordering {
    branch {
        left < right -> Ordering.Less
        left > right -> Ordering.Greater
        _ -> Ordering.Equal
    }
}

/// Returns whether `value` lies in the inclusive range from `lower` to `upper`.
pub func between?(value: Float, lower: Float, upper: Float) -> Bool {
    branch {
        value < lower -> false
        _ -> value <= upper
    }
}

test "floating-point helpers clamp and compare values" {
    return [()][1] if absolute(-2.5) != 2.5
    return [()][1] if clamp(4.0, 0.0, 3.0) != 3.0
    return [()][1] if between?(2.0, 1.0, 3.0) == false
    ()
}
