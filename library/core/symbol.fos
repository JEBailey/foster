//! Immutable symbolic identifiers constructed from symbol literals.

/// An immutable symbolic identifier.
///
/// Symbol literals are the trusted construction path for the private text.
pub type Symbol = {
    value: String

    // Required public operations; implementations live in impl blocks.
    /// Explicitly copies this immutable identifier.
    pub func copy(self) -> self [read self]
}

impl Symbol {
    /// Explicitly copies this immutable identifier.
    pub func copy(self: Symbol) -> self [read self] { self }
}

test "symbols support explicit copying" {
    let value = :ready
    assert(value.copy() == value)
}
