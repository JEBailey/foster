//! Integer arithmetic helpers, ordering, and range generation.

import core.ordering

/// Returns the absolute value of this integer.
pub func Int.absolute(self: Int) -> Int {
    branch {
        self < 0 -> -self
        _ -> self
    }
}

/// Returns the smaller of `left` and `right`.
pub func Int.minimum(self: Int, right: Int) -> Int {
    branch {
        self <= right -> self
        _ -> right
    }
}

/// Returns the larger of `left` and `right`.
pub func Int.maximum(self: Int, right: Int) -> Int {
    branch {
        self >= right -> self
        _ -> right
    }
}

/// Restricts `value` to the inclusive range from `lower` to `upper`.
pub func Int.clamp(self: Int, lower: Int, upper: Int) -> Int {
    self.maximum(lower).minimum(upper)
}

/// Returns `-1`, `0`, or `1` according to the sign of `value`.
pub func Int.sign(self: Int) -> Int {
    branch {
        self < 0 -> -1
        self > 0 -> 1
        _ -> 0
    }
}

/// Compares two integers and returns their ordering.
pub func Int.compare(self: Int, right: Int) -> Ordering {
    branch {
        self < right -> Ordering.Less
        self > right -> Ordering.Greater
        _ -> Ordering.Equal
    }
}

/// Returns whether `value` lies in the inclusive range from `lower` to `upper`.
pub func Int.between?(self: Int, lower: Int, upper: Int) -> Bool {
    branch {
        self < lower -> false
        _ -> self <= upper
    }
}

/// Returns whether `value` is evenly divisible by two.
pub func Int.even?(self: Int) -> Bool {
    self / 2 * 2 == self
}

/// Returns whether `value` is not evenly divisible by two.
pub func Int.odd?(self: Int) -> Bool {
    self / 2 * 2 != self
}

/// Raises `base` to a nonnegative integer `exponent`.
pub func Int.power(self: Int, exponent: Int) -> Int {
    power_of(self, exponent)
}

/// Multiplies the base for each remaining exponent step.
func power_of(base: Int, exponent: Int) -> Int {
    branch {
        exponent <= 0 -> 1
        _ -> base * power_of(base, exponent - 1)
    }
}

/// Returns the remainder after integer division by `divisor`.
pub func Int.modulo(self: Int, divisor: Int) -> Int {
    self - self / divisor * divisor
}

/// Builds the half-open integer range `[start, end)`.
pub func Int.range(self: Int, end: Int) -> List<Int> {
    range_into(self, end, [])
}

/// Appends consecutive integers to the range accumulator.
func range_into(value: Int, end: Int, result: List<Int>) -> List<Int> [consume result] {
    branch {
        value >= end -> result
        _ -> range_into(value + 1, end, result.append(value))
    }
}

/// Formats an integer as decimal text.
pub func Int.as_string(self: Int) -> String {
    branch {
        self < 0 -> "-" + negative_string(self)
        _ -> unsigned_string(self)
    }
}

test "integer helpers cover signs ranges and powers" {
    assert((-4).absolute() == 4)
    assert(12.clamp(0, 10) == 10)
    assert(2.power(5) == 32)
    assert(2.range(5).length == 3)
    ()
}

/// Formats a known nonnegative integer as decimal text.
func unsigned_string(value: Int) -> String {
    let quotient = value / 10
    let digit = value - quotient * 10
    branch {
        quotient == 0 -> from_code_point(48 + digit).string
        _ -> unsigned_string(quotient) + from_code_point(48 + digit).string
    }
}

/// Formats a known negative integer without negating the signed minimum.
func negative_string(value: Int) -> String {
    let quotient = value / 10
    let remainder = value - quotient * 10
    let digit = -remainder
    branch {
        quotient == 0 -> from_code_point(48 + digit).string
        _ -> negative_string(quotient) + from_code_point(48 + digit).string
    }
}
