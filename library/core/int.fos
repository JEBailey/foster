//! Signed integer helpers, decimal formatting, and eager ranges.
//!
//! Ranges materialize a `List<Int>` and exclude the upper endpoint. Arithmetic uses
//! Foster's `Int` operations; these helpers do not provide arbitrary-precision results.
//! See individual methods for nonpositive exponents and division preconditions.
//!
//! Supports [Copy](core-copy.html#Copy): copying preserves the source and returns an independent scalar value.

import core.result as results

import core.ordering
import core.copy
import core.bytes
import core.byte
import core.list

/// Private signed 64-bit primitive storage.
intrinsic type RawInt

/// A signed 64-bit integer with private scalar storage.
/// The compiler keeps this representation inline, including during arithmetic.
pub type Int = & Copy & {
    value: RawInt

    /// Reads `.bytes`: eight little-endian two's-complement bytes, leaving `self` unchanged.
    pub func bytes(self) -> Bytes [read self]
    /// Encodes eight little-endian two's-complement bytes without consuming `self`.
    pub func to_le_bytes(self) -> Bytes [read self]
    /// Encodes eight big-endian two's-complement bytes without consuming `self`.
    pub func to_be_bytes(self) -> Bytes [read self]

    /// Returns the distance from zero: negative values become positive; zero and positive values stay the same.
    /// Leaves `self` unchanged. For example, `(-7).absolute()` returns `7`.
    /// Do not pass `-9223372036854775808`: its positive counterpart cannot fit in `Int`.
    pub func absolute(self) -> Int [read self]
    /// Returns the smaller of `self` and `right`.
    pub func minimum(self, right: Int) -> Int [read self, read right]
    /// Returns the larger of `self` and `right`.
    pub func maximum(self, right: Int) -> Int [read self, read right]
    /// Restricts `self` to the inclusive range `[lower, upper]`.
    /// Bounds are not validated; when `lower > upper`, the result is `upper`.
    pub func clamp(self, lower: Int, upper: Int) -> Int [read self, read lower, read upper]
    /// Returns `-1`, `0`, or `1` according to the sign of `self`.
    pub func sign(self) -> Int [read self]
    /// Compares two integers and returns their ordering.
    pub func compare(self, right: Int) -> Ordering [read self, read right]
    /// Returns whether `self` lies in the inclusive range from `lower` to `upper`.
    pub func between?(self, lower: Int, upper: Int) -> Bool [read self, read lower, read upper]
    /// Returns whether `self` is evenly divisible by two.
    pub func even?(self) -> Bool [read self]
    /// Returns whether `self` is not evenly divisible by two.
    pub func odd?(self) -> Bool [read self]
    /// Raises `self` to `exponent` by repeated multiplication.
    /// Returns `1` for zero or negative exponents, including `0.power(0)`.
    /// The result must fit `Int`; this is not arbitrary-precision exponentiation.
    pub func power(self, exponent: Int) -> Int [read self, read exponent]
    /// Returns the remainder after division truncated toward zero.
    /// A nonzero remainder has the dividend's sign; this is not Euclidean modulo.
    /// `divisor` must be nonzero and the division must be representable in `Int`.
    pub func modulo(self, divisor: Int) -> Int [read self, read divisor]
    /// Materializes consecutive integers in the half-open range `[self, end)`.
    /// Returns an empty list when `end <= self`; storage grows with the result length.
    pub func range(self, end: Int) -> List<Int> [read self, read end]
    /// Formats an integer as decimal text.
    pub func as_string(self) -> String [read self]
}

/// Failure to convert a Float to a signed 64-bit integer.
/// NotFinite means NaN or infinity; OutOfRange means truncation cannot fit Int.
pub enum IntConversionError = NotFinite | OutOfRange

type IntHost = {}

impl IntHost {
    /// Converts a finite value in [-2^63, 2^63) after the public range check.
    func from_float(value: Float) -> Int = intrinsic("int.from_float")
}

impl Int {
    /// Truncates a Float toward zero, preserving the input.
    /// Returns NotFinite for NaN or infinity, or OutOfRange when the result cannot fit Int.
    /// Both signed zeros convert to zero. No saturation or wrapping is performed.
    pub func from(value: Float) -> Result<Int, IntConversionError> [read value] {
        // Subtracting a nonfinite value from itself produces NaN.
        let difference = value - value
        return Result.Error(IntConversionError.NotFinite) if difference != difference
        if value < -9223372036854775808.0 || value >= 9223372036854775808.0 {
            return Result.Error(IntConversionError.OutOfRange)
        }
        Result.Ok(IntHost.from_float(value))
    }

    /// Reads `.bytes`: eight little-endian two's-complement bytes, leaving `self` unchanged.
    pub func bytes(self) -> Bytes [read self] {
        self.to_le_bytes()
    }

    /// Encodes eight little-endian two's-complement bytes without consuming `self`.
    pub func to_le_bytes(self) -> Bytes [read self] {
        let remaining = self
        let output = []
        let index = 0
        while index < 8 {
            let remainder = remaining.modulo(256)
            let octet = branch {
                remainder < 0 -> remainder + 256 _ -> remainder
            }
            output.push(Byte.unchecked(octet))
            remaining = remaining / 256
            // Floor division preserves the sign bits, including at Int's minimum.
            if remainder < 0 remaining = remaining - 1
            index = index + 1
        }
        Bytes.from(move output)
    }

    /// Encodes eight big-endian two's-complement bytes without consuming `self`.
    pub func to_be_bytes(self) -> Bytes [read self] {
        Bytes.from(self.to_le_bytes().list().reverse())
    }

    /// Explicitly copies this scalar value.
    pub func copy(self) -> self [read self] {
        Int {
            value: self.value
        }
    }

    /// Returns the distance from zero, ignoring the sign of this integer.
    ///
    /// Negative values become positive. Zero and positive values stay the same.
    /// The method returns an `Int` and leaves `self` unchanged; no `move` is needed.
    ///
    /// ```foster
    /// import core.int
    ///
    /// func main() -> Int {
    ///     let offset = -7
    ///     assert(offset.absolute() == 7)
    ///     assert(offset == -7)
    ///     assert(0.absolute() == 0)
    ///     assert(7.absolute() == 7)
    ///     0
    /// }
    /// ```
    ///
    /// Do not pass `-9223372036854775808`, the smallest signed 64-bit integer.
    /// Its positive counterpart, `9223372036854775808`, exceeds the largest `Int`.
    /// This method does not return an `Option` or `Result` for that case;
    /// callers must exclude it before calling.
    pub func absolute(self) -> Int {
        branch {
            self < 0 -> -self
            _ -> self
        }
    }

    /// Returns the smaller of `self` and `right`.
    pub func minimum(self, right: Int) -> Int {
        branch {
            self <= right -> self
            _ -> right
        }
    }

    /// Returns the larger of `self` and `right`.
    pub func maximum(self, right: Int) -> Int {
        branch {
            self >= right -> self
            _ -> right
        }
    }

    /// Restricts `self` to the inclusive range `[lower, upper]`.
    /// Bounds are not validated; when `lower > upper`, the result is `upper`.
    pub func clamp(self, lower: Int, upper: Int) -> Int {
        self.maximum(lower).minimum(upper)
    }

    /// Returns `-1`, `0`, or `1` according to the sign of `self`.
    pub func sign(self) -> Int {
        branch {
            self < 0 -> -1
            self > 0 -> 1
            _ -> 0
        }
    }

    /// Compares two integers and returns their ordering.
    pub func compare(self, right: Int) -> Ordering {
        branch {
            self < right -> Ordering.Less
            self > right -> Ordering.Greater
            _ -> Ordering.Equal
        }
    }

    /// Returns whether `self` lies in the inclusive range from `lower` to `upper`.
    pub func between?(self, lower: Int, upper: Int) -> Bool {
        branch {
            self < lower -> false
            _ -> self <= upper
        }
    }

    /// Returns whether `self` is evenly divisible by two.
    pub func even?(self) -> Bool {
        self / 2 * 2 == self
    }

    /// Returns whether `self` is not evenly divisible by two.
    pub func odd?(self) -> Bool {
        self / 2 * 2 != self
    }

    /// Raises `self` to `exponent` by repeated multiplication.
    /// Returns `1` for zero or negative exponents, including `0.power(0)`.
    /// The result must fit `Int`; this is not arbitrary-precision exponentiation.
    pub func power(self, exponent: Int) -> Int {
        power_of(self, exponent)
    }

    /// Returns the remainder after division truncated toward zero.
    /// A nonzero remainder has the dividend's sign; this is not Euclidean modulo.
    /// `divisor` must be nonzero and the division must be representable in `Int`.
    pub func modulo(self, divisor: Int) -> Int {
        self - self / divisor * divisor
    }

    /// Materializes consecutive integers in the half-open range `[self, end)`.
    /// Returns an empty list when `end <= self`; storage grows with the result length.
    pub func range(self, end: Int) -> List<Int> {
        range_into(self, end, [])
    }

    /// Formats an integer as decimal text.
    pub func as_string(self) -> String {
        branch {
            self < 0 -> "-" + negative_string(self)
            _ -> unsigned_string(self)
        }
    }
}

/// Multiplies the base for each remaining exponent step.
func power_of(base: Int, exponent: Int) -> Int {
    branch {
        exponent <= 0 -> 1
        _ -> base * power_of(base, exponent - 1)
    }
}

/// Appends consecutive integers to the range accumulator.
func range_into(value: Int, end: Int, result: List<Int>) -> List<Int> [consume result] {
    branch {
        value >= end -> result
        _ -> range_into(value + 1, end, result.append(value))
    }
}

test "integer helpers cover signs ranges and powers" {
    assert((-4).absolute() == 4)
    assert(12.clamp(0, 10) == 10)
    assert(2.power(5) == 32)
    assert(2.range(5).length == 3)
    ()
}

/// Formats a known nonnegative integer as decimal text.
func unsigned_string(value: Int) -> String {
    let quotient = value / 10
    let digit = value - quotient * 10
    branch {
        quotient == 0 -> from_code_point(48 + digit).string
        _ -> unsigned_string(quotient) + from_code_point(48 + digit).string
    }
}

/// Formats a known negative integer without negating the signed minimum.
func negative_string(value: Int) -> String {
    let quotient = value / 10
    let remainder = value - quotient * 10
    let digit = -remainder
    branch {
        quotient == 0 -> from_code_point(48 + digit).string
        _ -> negative_string(quotient) + from_code_point(48 + digit).string
    }
}

test "checked float conversion truncates and reports invalid input" {
    branch Int.from(-19.9) {
        Result.Ok(value) -> {
            assert(value == -19)
        }
        Result.Error(_) -> {
            panic("finite conversion failed")
        }
    }
    branch Int.from(9223372036854775808.0) {
        Result.Error(IntConversionError.OutOfRange) -> ()
        _ -> {
            panic("out-of-range conversion succeeded")
        }
    }
}
