import core.result
import core.bytes
import core.stream

/// Describes a failed TCP operation at the host boundary.
pub type NetworkError {
    pub operation: String
    pub message: String
}

/// An opaque listening TCP socket.
pub type Listener {
    handle: Int
}

/// An opaque connected TCP stream.
pub type Connection & Duplex<NetworkError> {
    handle: Int
}

/// Binds a TCP listener to an address and port.
pub func listen(address: String, port: Int) -> Result<Listener, NetworkError> {
    wrap_listener(__tcp_listen(address, port))
}

/// Connects to a TCP server.
pub func connect(address: String, port: Int) -> Result<Connection, NetworkError> {
    wrap_connection(__tcp_connect(address, port))
}

/// Converts a successful listener handle into an opaque `Listener`.
func wrap_listener(outcome: Result<Int, NetworkError>) -> Result<Listener, NetworkError> {
    branch outcome {
        Ok(handle) -> Ok(Listener { handle })
        Error(error) -> Error(error)
    }
}

/// Waits for and accepts one incoming connection.
pub func accept(listener: Listener) -> Result<Connection, NetworkError> {
    wrap_connection(__tcp_accept(listener.handle))
}

/// Converts a successful connection handle into an opaque `Connection`.
func wrap_connection(outcome: Result<Int, NetworkError>) -> Result<Connection, NetworkError> {
    branch outcome {
        Ok(handle) -> Ok(Connection { handle })
        Error(error) -> Error(error)
    }
}

/// Reads at most `maximum` bytes, returning empty bytes after an orderly peer shutdown.
pub func read(self: Connection, maximum: Int) -> Result<Bytes, NetworkError> [mut self.handle] {
    __tcp_read_bytes(self.handle, maximum)
}

/// Writes the complete byte sequence and reports its length.
pub func write(self: Connection, contents: Bytes) -> Result<Int, NetworkError> [mut self.handle] {
    written_bytes(__tcp_write_bytes(self.handle, contents), contents.length)
}

/// Flushes the TCP stream's host writer.
pub func flush(self: Connection) -> Result<Unit, NetworkError> [mut self.handle] {
    __tcp_write_bytes(self.handle, Bytes.empty())
}

/// Reads at most `maximum` bytes of UTF-8 text from a connection.
pub func read_text(self: Connection, maximum: Int) -> Result<String, NetworkError> [mut self.handle] {
    __tcp_read(self.handle, maximum)
}

/// Writes the complete UTF-8 string to a connection.
pub func write_text(self: Connection, text: String) -> Result<Unit, NetworkError> [mut self.handle] {
    __tcp_write(self.handle, text)
}

/// Compatibility spelling for binary `read`.
pub func read_bytes(self: Connection, maximum: Int) -> Result<Bytes, NetworkError> [mut self.handle] {
    self.read(maximum)
}

/// Explicit binary spelling for `write`.
pub func write_bytes(self: Connection, contents: Bytes) -> Result<Int, NetworkError> [mut self.handle] {
    self.write(contents)
}

/// Sets the connection's read and write timeout in milliseconds.
pub func set_timeout(connection: Connection, milliseconds: Int) -> Result<Unit, NetworkError> {
    __tcp_set_timeout(connection.handle, milliseconds)
}

/// Closes a listening socket.
pub func close_listener(listener: Listener) -> Result<Unit, NetworkError> {
    __tcp_close_listener(listener.handle)
}

/// Closes a connected TCP stream.
pub func close_connection(connection: Connection) -> Result<Unit, NetworkError> {
    __tcp_close_connection(connection.handle)
}

/// Converts a completed host write into the stream writer's byte count.
func written_bytes(outcome: Result<Unit, NetworkError>, length: Int) -> Result<Int, NetworkError> {
    branch outcome {
        Result.Error(error) -> Result.Error(error)
        Result.Ok(_) -> Result.Ok(length)
    }
}
