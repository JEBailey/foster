import core.result

/// Describes a failed TCP operation at the host boundary.
pub type NetworkError {
    pub operation: String
    pub message: String
}

/// An opaque listening TCP socket.
pub type Listener {
    handle: Int
}

/// An opaque connected TCP stream.
pub type Connection {
    handle: Int
}

/// Binds a TCP listener to an address and port.
pub func listen(address: String, port: Int) -> Result[Listener, NetworkError] {
    wrap_listener(__tcp_listen(address, port))
}

/// Connects to a TCP server.
pub func connect(address: String, port: Int) -> Result[Connection, NetworkError] {
    wrap_connection(__tcp_connect(address, port))
}

/// Converts a successful listener handle into an opaque `Listener`.
func wrap_listener(outcome: Result[Int, NetworkError]) -> Result[Listener, NetworkError] {
    branch outcome {
        Ok(handle) -> Ok(Listener { handle })
        Error(error) -> Error(error)
    }
}

/// Waits for and accepts one incoming connection.
pub func accept(listener: Listener) -> Result[Connection, NetworkError] {
    wrap_connection(__tcp_accept(listener.handle))
}

/// Converts a successful connection handle into an opaque `Connection`.
func wrap_connection(outcome: Result[Int, NetworkError]) -> Result[Connection, NetworkError] {
    branch outcome {
        Ok(handle) -> Ok(Connection { handle })
        Error(error) -> Error(error)
    }
}

/// Reads at most `maximum` bytes of UTF-8 text from a connection.
pub func read(connection: Connection, maximum: Int) -> Result[String, NetworkError] {
    __tcp_read(connection.handle, maximum)
}

/// Writes the complete UTF-8 string to a connection.
pub func write(connection: Connection, text: String) -> Result[Unit, NetworkError] {
    __tcp_write(connection.handle, text)
}

/// Sets the connection's read and write timeout in milliseconds.
pub func set_timeout(connection: Connection, milliseconds: Int) -> Result[Unit, NetworkError] {
    __tcp_set_timeout(connection.handle, milliseconds)
}

/// Closes a listening socket.
pub func close_listener(listener: Listener) -> Result[Unit, NetworkError] {
    __tcp_close_listener(listener.handle)
}

/// Closes a connected TCP stream.
pub func close_connection(connection: Connection) -> Result[Unit, NetworkError] {
    __tcp_close_connection(connection.handle)
}
