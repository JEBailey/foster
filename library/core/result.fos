//! Success and failure values with explicit recovery.
//!
//! `Ok` carries a result and `Error` carries its error value. `Map`ping a success leaves
//! errors untouched; error mapping leaves successes untouched. Use and_then to
//! chain fallible operations, or try when forwarding the same error type.

/// A value that is either a successful `Ok(T)` or a failed `Error(E)`.
pub enum Result<T, E> = Ok(T)
    | Error(E)
    & {
        // Required public operations; implementations live in impl blocks.
        /// Applies `transform` to a successful value and preserves an error.
        pub func map<U>(self, transform: func(T) -> U) -> Result<U, E> [read self, read transform]
        /// Applies `transform` to an error and preserves a successful value.
        pub func map_error<F>(self, transform: func(E) -> F) -> Result<T, F> [read self, read transform]
        /// Applies a result-producing transform to a successful value and flattens the result.
        pub func and_then<U>(self, transform: func(T) -> Result<U, E>) -> Result<U, E> [read self, read transform]
        /// Returns whether the result is successful.
        pub func success?(self) -> Bool [read self]
        /// Returns whether the result contains an error.
        pub func error?(self) -> Bool [read self]
        /// Returns the successful value, or a fallback when the result contains an error.
        pub func unwrap_or(self, fallback: T) -> T [consume fallback, read self]
        /// Returns the successful value, or computes a fallback from the error.
        pub func unwrap_or_else(self, fallback: func(E) -> T) -> T [read fallback, read self]
        /// Preserves a successful value, or recovers by transforming the error into another result.
        pub func or_else<F>(self, recover: func(E) -> Result<T, F>) -> Result<T, F> [read recover, read self]
    }

impl Result {
    /// Applies `transform` to a successful value and preserves an error.
    pub func map<T, E, U>(self: Result<T, E>, transform: func(T) -> U) -> Result<U, E> {
        branch self {
            Result.Ok(value) -> Result.Ok(transform(value))
            Result.Error(error) -> Result.Error(error)
        }
    }

    /// Applies `transform` to an error and preserves a successful value.
    pub func map_error<T, E, F>(self: Result<T, E>, transform: func(E) -> F) -> Result<T, F> {
        branch self {
            Result.Ok(value) -> Result.Ok(value)
            Result.Error(error) -> Result.Error(transform(error))
        }
    }

    /// Applies a result-producing transform to a successful value and flattens the result.
    pub func and_then<T, E, U>(self: Result<T, E>, transform: func(T) -> Result<U, E>) -> Result<U, E> {
        branch self {
            Result.Ok(value) -> transform(value)
            Result.Error(error) -> Result.Error(error)
        }
    }

    /// Returns whether the result is successful.
    pub func success?<T, E>(self: Result<T, E>) -> Bool {
        branch self {
            Result.Ok(_) -> true
            Result.Error(_) -> false
        }
    }

    /// Returns whether the result contains an error.
    pub func error?<T, E>(self: Result<T, E>) -> Bool {
        branch self {
            Result.Ok(_) -> false
            Result.Error(_) -> true
        }
    }

    /// Returns the successful value, or a fallback when the result contains an error.
    pub func unwrap_or<T, E>(self: Result<T, E>, fallback: T) -> T [consume fallback, read self] {
        branch self {
            Result.Ok(value) -> value
            Result.Error(_) -> fallback
        }
    }

    /// Returns the successful value, or computes a fallback from the error.
    pub func unwrap_or_else<T, E>(self: Result<T, E>, fallback: func(E) -> T) -> T {
        branch self {
            Result.Ok(value) -> value
            Result.Error(error) -> fallback(error)
        }
    }

    /// Preserves a successful value, or recovers by transforming the error into another result.
    pub func or_else<T, E, F>(self: Result<T, E>, recover: func(E) -> Result<T, F>) -> Result<T, F> {
        branch self {
            Result.Ok(value) -> Result.Ok(value)
            Result.Error(error) -> recover(error)
        }
    }

    /// Removes one layer from a nested successful result.
    pub func flatten<T, E>(self: Result<Result<T, E>, E>) -> Result<T, E> {
        branch self {
            Result.Ok(value) -> value
            Result.Error(error) -> Result.Error(error)
        }
    }
}

/// Supplies a concrete error type for the successful-result test case.
func successful_test_value() -> Result<Int, String> {
    Result.Ok(20)
}

test "result mapping transforms successful values" {
    let mapped = successful_test_value().map((value: Int) -> value + 2)
    let valid = branch mapped {
        Result.Ok(value) -> value == 22
        Result.Error(_) -> false
    }
    assert(valid)
}
