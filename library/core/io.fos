import core.option
import core.result
import core.bytes

/// Describes a failed host filesystem or path operation.
pub type IoError = {
    pub operation: String
    pub path: String
    pub message: String
}

/// Reads an entire UTF-8 text file.
pub func read_text(path: String) -> Result<String, IoError> {
    __io_read_text(path)
}

/// Replaces a file with UTF-8 text, creating it when necessary.
pub func write_text(path: String, text: String) -> Result<Unit, IoError> {
    __io_write_text(path, text)
}

/// Reads an entire file without applying text decoding.
pub func read_bytes(path: String) -> Result<Bytes, IoError> {
    __io_read_bytes(path)
}

/// Replaces a file with raw bytes, creating it when necessary.
pub func write_bytes(path: String, contents: Bytes) -> Result<Unit, IoError> {
    __io_write_bytes(path, contents)
}

/// Returns the names directly inside a directory in deterministic order.
pub func list_directory(path: String) -> Result<List<String>, IoError> {
    __io_list_directory(path)
}

/// Returns whether a filesystem entry exists at `path`.
pub func exists?(path: String) -> Bool {
    __io_exists(path)
}

/// Returns whether `path` identifies a regular file.
pub func file?(path: String) -> Bool {
    __io_is_file(path)
}

/// Returns whether `path` identifies a directory.
pub func directory?(path: String) -> Bool {
    __io_is_directory(path)
}

/// Joins two platform path components.
pub func join(left: String, right: String) -> String {
    __io_join(left, right)
}

/// Joins a list of platform path components, returning an empty string for an empty list.
pub func join_all(parts: List<String>) -> String {
    branch {
        parts.empty? -> ""
        _ -> join_remaining(parts.rest, parts.head)
    }
}

/// Joins remaining path components onto the accumulated path.
func join_remaining(parts: List<String>, path: String) -> String {
    branch {
        parts.empty? -> path
        _ -> join_remaining(parts.rest, join(path, parts.head))
    }
}

/// Returns the parent path, or `None` when no parent component exists.
pub func parent(path: String) -> Option<String> {
    optional_component(__io_parent(path))
}

/// Returns the final path component, or `None` when it is absent.
pub func file_name(path: String) -> Option<String> {
    optional_component(__io_file_name(path))
}

/// Returns the final extension without its separator, or `None` when it is absent.
pub func extension(path: String) -> Option<String> {
    optional_component(__io_extension(path))
}

/// Converts the host boundary's empty sentinel into an option.
func optional_component(value: String) -> Option<String> {
    branch {
        value.empty? -> Option.None
        _ -> Option.Some(value)
    }
}

/// Resolves `path` to an absolute canonical path.
pub func canonicalize(path: String) -> Result<String, IoError> {
    __io_canonicalize(path)
}

/// Returns the process's current working directory.
pub func current_directory() -> Result<String, IoError> {
    __io_current_directory()
}
