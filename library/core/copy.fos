//! The contract for making an independent value without consuming its source.
//!
//! Copy describes observable independence, not a requirement to duplicate every
//! allocation. Implementations may share immutable backing storage.

/// A value that can produce another value of its concrete type without consuming itself.
pub type Copy = {
    /// Creates an independent value of the concrete receiver type without consuming the source.
    pub func copy(self) -> self [read self]
}
