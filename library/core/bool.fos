//! Boolean logic helpers.

/// Returns the logical negation of `value`.
pub func not(value: Bool) -> Bool {
    return false if value
    true
}

/// Returns true only when both values are true.
pub func and(left: Bool, right: Bool) -> Bool {
    return right if left
    false
}

/// Returns true when either value is true.
pub func or(left: Bool, right: Bool) -> Bool {
    return true if left
    right
}

/// Returns true when exactly one value is true.
pub func xor(left: Bool, right: Bool) -> Bool {
    return not(right) if left
    right
}

/// Returns a singleton list containing `value` when `condition` is true, or an empty list otherwise.
pub func then<T>(condition: Bool, value: T) -> List<T> [consume value] {
    return [value] if condition
    []
}

test "boolean helpers implement their truth tables" {
    assert(not(true) == false)
    assert(and(true, true))
    assert(or(false, true))
    assert(xor(true, false))
    ()
}
