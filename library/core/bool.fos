//! Boolean logic helpers.

/// Returns the logical negation of `value`.
pub func Bool.not(self: Bool) -> Bool {
    return false if self
    true
}

/// Returns true only when both values are true.
pub func Bool.and(self: Bool, right: Bool) -> Bool {
    return right if self
    false
}

/// Returns true when either value is true.
pub func Bool.or(self: Bool, right: Bool) -> Bool {
    return true if self
    right
}

/// Returns true when exactly one value is true.
pub func Bool.xor(self: Bool, right: Bool) -> Bool {
    return right.not() if self
    right
}

/// Returns a singleton list containing `value` when `condition` is true, or an empty list otherwise.
pub func Bool.then<T>(self: Bool, value: T) -> List<T> [read self, consume value] {
    return [value] if self
    []
}

test "boolean helpers implement their truth tables" {
    assert(true.not() == false)
    assert(true.and(true))
    assert(false.or(true))
    assert(true.xor(false))
    ()
}
