//! `Bool`ean queries and conditional values.
//!
//! Use the language's short-circuit operators for conditional evaluation. Method
//! arguments are evaluated before a call, including values passed to conditional helpers.
//!
//! Supports [Copy](core-copy.html#Copy): copying preserves the source and returns an independent scalar value.

impl Bool {
    /// Explicitly copies this scalar value.
    pub func copy(self: Bool) -> self [read self] { self }

    /// Returns true when exactly one value is true.
    pub func xor(self: Bool, right: Bool) -> Bool {
        self != right
    }

    /// Returns a singleton list containing `value` when `condition` is true, or an empty list otherwise.
    pub func then<T>(self: Bool, value: T) -> List<T> [read self, consume value] {
        return [value] if self
        []
    }
}

test "boolean helpers implement their truth tables" {
    assert(not true == false)
    assert(true && true)
    assert(false || true)
    assert(true.xor(false))
    ()
}
