//! Boolean queries and conditional values.
//!
//! Use the language's short-circuit operators for conditional evaluation. Method
//! arguments are evaluated before a call, including values passed to conditional helpers.
//!
//! Supports [Copy](core-copy.html#Copy): copying preserves the source and returns an independent scalar value.

import core.byte

import core.bytes.Bytes

impl Bool {
    /// Reads `.bytes`: one byte, `0` for false or `1` for true, leaving `self` unchanged.
    pub func bytes(self: Self) -> Bytes [read self] {
        Bytes.from([Byte.unchecked(branch {
            self -> 1 _ -> 0
        })])
    }

    /// Returns `true` or `false` as text without consuming this value.
    pub func as_string(self: Self) -> String [read self] {
        branch {
            self -> "true" _ -> "false"
        }
    }

    /// Explicitly copies this scalar value.
    pub func copy(self: Self) -> Self [read self] {
        self
    }

    /// Returns true when exactly one value is true.
    pub func xor(self: Self, right: Bool) -> Bool {
        self != right
    }

    /// Returns a singleton list containing `value` when `condition` is true, or an empty list otherwise.
    pub func then<T>(self: Self, value: T) -> List<T> [read self, consume value] {
        return [value] if self
        []
    }
}

test "boolean helpers implement their truth tables" {
    assert(not true == false)
    assert(true && true)
    assert(false || true)
    assert(true.xor(false))
    ()
}
