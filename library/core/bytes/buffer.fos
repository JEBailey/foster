//! Mutable byte construction with immutable snapshots.
//!
//! Append with push or extend. snapshot preserves the buffer; freeze consumes it
//! and returns `Bytes`. Capacity and reservation APIs are allocation hints, not
//! guarantees about reserved storage. Negative sizes fail an assertion.

import core.bytes
import core.list

/// Mutable byte construction storage.
///
/// Capacity is an implementation hint: the Foster implementation reports its current length and
/// accepts reservations without making allocation strategy observable.
pub type ByteBuffer = {
    value: List<Byte>

    // Required public operations; implementations live in impl blocks.
    /// Appends one byte.
    pub func push(self, value: Byte) -> () [reshape self.value.items]
    /// Appends an immutable byte sequence.
    pub func extend(self, values: Bytes) -> () [reshape self.value.items]
    /// Removes every buffered byte.
    pub func clear(self) -> () [mut self.value]
    /// Keeps at most the first `length` bytes; a larger length leaves the buffer unchanged.
    /// Asserts if `length` is negative.
    pub func truncate(self, length: Int) -> () [mut self.value]
    /// Accepts a nonnegative allocation hint; negative values fail an assertion.
    /// The current implementation does not reserve storage in advance.
    pub func reserve(self, additional: Int) -> () [read additional]
    /// Consumes the buffer and packs its values into immutable bytes.
    pub func freeze(self) -> Bytes [consume self]
    /// Copies the current values into immutable bytes.
    pub func snapshot(self) -> Bytes [read self.value]
    /// Returns whether the buffer contains no bytes.
    pub func empty?(self) -> Bool
    /// Returns the number of buffered bytes.
    pub func length(self) -> Int
    /// Reports current length without exposing allocation strategy.
    pub func capacity(self) -> Int
}

impl ByteBuffer {
    /// Returns whether the buffer contains no bytes.
    pub func empty?(self: ByteBuffer) -> Bool { self.value.empty? }

    /// Returns the number of buffered bytes.
    pub func length(self: ByteBuffer) -> Int { self.value.length }

    /// Reports current length without exposing allocation strategy.
    pub func capacity(self: ByteBuffer) -> Int { self.value.length }

    /// Creates an empty mutable byte buffer.
    pub func empty() -> ByteBuffer {
        ByteBuffer { value: [] }
    }

    /// Creates an empty buffer with a nonnegative allocation hint.
    /// Asserts for a negative capacity; no allocation size is guaranteed.
    pub func with_capacity(capacity: Int) -> ByteBuffer {
        assert(capacity >= 0, "ByteBuffer capacity cannot be negative")
        ByteBuffer.empty()
    }

    /// Appends one byte.
    pub func push(self: ByteBuffer, value: Byte) -> () [reshape self.value.items] {
        self.value.push(value)
        ()
    }

    /// Appends an immutable byte sequence.
    pub func extend(self: ByteBuffer, values: Bytes) -> () [reshape self.value.items] {
        let index = 0
        loop {
            break if index >= values.length
            self.value.push(values[index])
            index = index + 1
        }
        ()
    }

    /// Removes every buffered byte.
    pub func clear(self: ByteBuffer) -> () [mut self.value] {
        self.value = []
        ()
    }

    /// Keeps at most the first `length` bytes; a larger length leaves the buffer unchanged.
    /// Asserts if `length` is negative.
    pub func truncate(self: ByteBuffer, length: Int) -> () [mut self.value] {
        assert(length >= 0, "truncate length cannot be negative")
        self.value = self.value.take(length)
        ()
    }

    /// Accepts a nonnegative allocation hint; negative values fail an assertion.
    /// The current implementation does not reserve storage in advance.
    pub func reserve(self: ByteBuffer, additional: Int) -> () {
        assert(additional >= 0, "reserve amount cannot be negative")
        ()
    }

    /// Consumes the buffer and packs its values into immutable bytes.
    pub func freeze(self: ByteBuffer) -> Bytes [consume self] {
        Bytes.from(move self.value)
    }

    /// Copies the current values into immutable bytes.
    pub func snapshot(self: ByteBuffer) -> Bytes {
        Bytes.from(self.value.map((value: Byte) -> value))
    }
}

test "byte buffers append snapshot and freeze contents" {
    let buffer = ByteBuffer.empty()
    buffer.extend("ok".bytes)
    assert(buffer.snapshot().hex() == "6f6b")
    assert((move buffer).freeze().hex() == "6f6b")
    ()
}
