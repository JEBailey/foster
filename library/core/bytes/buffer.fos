//! Mutable byte accumulation implemented over Foster's lower-level list storage.

import core.bytes
import core.list

/// Mutable byte construction storage.
///
/// Capacity is an implementation hint: the Foster implementation reports its current length and
/// accepts reservations without making allocation strategy observable.
pub type ByteBuffer = {
    value: List<Byte>
}

/// Creates an empty mutable byte buffer.
pub func ByteBuffer.empty() -> ByteBuffer {
    ByteBuffer { value: [] }
}

/// Creates an empty buffer with an allocation hint.
pub func ByteBuffer.with_capacity(capacity: Int) -> ByteBuffer {
    assert(capacity >= 0, "ByteBuffer capacity cannot be negative")
    ByteBuffer.empty()
}

/// Appends one byte.
pub func ByteBuffer.push(self: ByteBuffer, value: Byte) -> () [reshape self.value.items] {
    self.value.push(value)
    ()
}

/// Appends an immutable byte sequence.
pub func ByteBuffer.extend(self: ByteBuffer, values: Bytes) -> () [reshape self.value.items] {
    let index = 0
    loop {
        break if index >= values.length
        self.value.push(values[index])
        index = index + 1
    }
    ()
}

/// Removes every buffered byte.
pub func ByteBuffer.clear(self: ByteBuffer) -> () [mut self.value] {
    self.value = []
    ()
}

/// Keeps at most the first `length` buffered bytes.
pub func ByteBuffer.truncate(self: ByteBuffer, length: Int) -> () [mut self.value] {
    assert(length >= 0, "truncate length cannot be negative")
    self.value = self.value.take(length)
    ()
}

/// Accepts an allocation hint without exposing storage capacity as semantics.
pub func ByteBuffer.reserve(self: ByteBuffer, additional: Int) -> () {
    assert(additional >= 0, "reserve amount cannot be negative")
    ()
}

/// Consumes the buffer and packs its values into immutable bytes.
pub func ByteBuffer.freeze(self: ByteBuffer) -> Bytes [consume self] {
    Bytes.from(move self.value)
}

/// Copies the current values into immutable bytes.
pub func ByteBuffer.snapshot(self: ByteBuffer) -> Bytes {
    Bytes.from(self.value.map((value: Byte) -> value))
}

test "byte buffers append snapshot and freeze contents" {
    let buffer = ByteBuffer.empty()
    buffer.extend("ok".utf8)
    assert(buffer.snapshot().hex() == "6f6b")
    assert((move buffer).freeze().hex() == "6f6b")
    ()
}
