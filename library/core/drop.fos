//! The contract for cleanup when ownership ends.
//!
//! Implement deinit to release resources owned by a value. Ownership transfer moves
//! the cleanup responsibility with the value; deinit is not a copying operation.

/// The compiler calls `deinit` once, before cleaning up the value's fields.
pub type Drop = {
    /// Releases external resources before the compiler releases owned fields and payloads.
    pub func deinit(self) -> () [read self]
}
