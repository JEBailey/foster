//! Reusable sequence views backed by an owned list.
//!
//! `Range<T>` stores supplied values; it is not a lazy numeric interval. Use `Int.range`
//! to construct consecutive integers. Iterators traverse the stored order.

import std.collections.Collection

import std.iter.Iterator

/// A reusable sequence view over a bounded list of values.
///
/// Construct with `Range.from`, which takes ownership of the supplied list.
/// This is stored data, not a lazy arithmetic interval; `Int.range` constructs integer lists.
/// Iteration preserves stored order and creates an independent cursor.
pub type Range<T> = & Sequence<T> & Collection<T> & {
    values: List<T>
}

impl Range<T> {
    /// Creates a range view over `values`.
    pub func from(values: List<T>) -> Range<T> [consume values] {
        Range {
            values: move values
        }
    }

    /// Returns whether the range is empty.
    pub func empty?(self: Self) -> Bool {
        self.values.empty?
    }

    /// Returns the number of values remaining in the range.
    pub func length(self: Self) -> Int {
        self.values.length
    }

    /// Returns the first range value.
    pub func head(self: Self) -> T {
        self.values.head
    }

    /// Returns a sequence containing all values after the head.
    pub func rest(self: Self) -> Sequence<T> {
        self.values.rest
    }

    /// Creates an independent iterator over the range values.
    pub func iterator(self: Self) -> Iterator<T> {
        self.values.iterator()
    }
}
