//! Values whose result is obtained by consuming them with `await`.
//!
//! `Future<T>` is a completion contract, not a factory or a promise that work has
//! started. The provider determines when work begins. Await consumes the future
//! and yields its result once; failures belong in T, commonly Result<Value, Error>.
//! Use std.process for child-process futures. RemoteFuture represents a request
//! to a remote owner, which must remain alive until completion.

/// A consuming, potentially suspending computation. Composes with other contracts.
pub type Future<T> = {
    /// Consumes this computation and returns its completed result.
    pub func resolve(self: Self) -> T [consume self, suspend]
}

intrinsic type RawFuture<T>

/// An outstanding remote request. Its remote owner must outlive completion.
pub type RemoteFuture<T> = & Future<T> & {
    value: RawFuture<T>
}

impl RemoteFuture<T> {
    /// Waits for the remote request, consuming its single completion handle.
    pub func resolve(self: Self) -> T [consume self, suspend] {
        await self.value
    }
}
