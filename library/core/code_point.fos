//! Unicode scalar construction, classification, and UTF-8 encoding.

import core.option

/// Creates a code point from a valid Unicode scalar value.
///
/// Returns `None` for negative values, surrogate code points, and values above `0x10FFFF`.
pub func from_int(value: Int) -> Option<CodePoint> {
    branch {
        value < 0 -> Option.None
        value > 1114111 -> Option.None
        value >= 55296 -> branch {
            value <= 57343 -> Option.None
            _ -> Option.Some(from_code_point(value))
        }
        _ -> Option.Some(from_code_point(value))
    }
}

/// Returns the Unicode scalar value represented by `character`.
pub func to_int(character: CodePoint) -> Int {
    character + 0
}

/// Converts one code point to its single-code-point string representation.
pub func to_string(character: CodePoint) -> String {
    character.string
}

test "code points round-trip Unicode scalar values" {
    branch from_int(955) {
        Option.Some(character) -> branch {
            to_int(character) != 955 -> [()][1]
            to_string(character) != "λ" -> [()][1]
            _ -> ()
        }
        Option.None -> [()][1]
    }
}
