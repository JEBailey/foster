//! Optional values and transformations that preserve absence.

/// The present member of `Option<T>`.
pub type Some<T> = { pub value: T }

/// The absent member of `Option<T>`.
pub type None = {}

/// A value that is either present as `Some<T>` or absent as `None`.
pub type Option<T> =
| Some<T>
| None

/// Applies `transform` to a present value and preserves `None`.
pub func map<T, U>(option: Option<T>, transform: func(T) -> U) -> Option<U> {
    branch option {
        Option.Some(value) -> Option.Some(transform(value))
        Option.None -> Option.None
    }
}

/// Applies an optional-producing transform to a present value and flattens the result.
pub func and_then<T, U>(option: Option<T>, transform: func(T) -> Option<U>) -> Option<U> {
    branch option {
        Option.Some(value) -> transform(value)
        Option.None -> Option.None
    }
}

/// Returns the contained value, or `fallback` when the option is `None`.
pub func unwrap_or<T>(option: Option<T>, fallback: T) -> T {
    branch option {
        Option.Some(value) -> value
        Option.None -> fallback
    }
}

/// Returns whether the option contains a value.
pub func present?<T>(option: Option<T>) -> Bool {
    branch option {
        Option.Some(_) -> true
        Option.None -> false
    }
}

/// Returns whether the option contains no value.
pub func absent?<T>(option: Option<T>) -> Bool {
    branch option {
        Option.Some(_) -> false
        Option.None -> true
    }
}

/// Returns the contained value, or computes a fallback when the option is `None`.
pub func unwrap_or_else<T>(option: Option<T>, fallback: func() -> T) -> T {
    branch option {
        Option.Some(value) -> value
        Option.None -> fallback()
    }
}

/// Preserves a present value, or computes another option when this option is `None`.
pub func or_else<T>(option: Option<T>, fallback: func() -> Option<T>) -> Option<T> {
    branch option {
        Option.Some(value) -> Option.Some(value)
        Option.None -> fallback()
    }
}

/// Removes one layer from a nested option.
pub func flatten<T>(option: Option<Option<T>>) -> Option<T> {
    branch option {
        Option.Some(value) -> value
        Option.None -> Option.None
    }
}

test "option transformations preserve presence and absence" {
    let mapped = map(Option.Some(20), (value: Int) -> value + 1)
    branch mapped {
        Option.Some(value) -> branch {
            value == 21 -> ()
            _ -> [()][1]
        }
        Option.None -> [()][1]
    }
}
