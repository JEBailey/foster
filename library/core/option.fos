//! Optional values and transformations that preserve absence.

import core.functions

/// A value that is either present as `Some(T)` or absent as `None`.
pub enum Option<T> = Some(T)
    | None

/// Applies `transform` to a present value and preserves `None`.
pub func Option.map<T, U>(self: Option<T>, transform: func(T) -> U) -> Option<U> {
    branch self {
        Option.Some(value) -> Option.Some(transform(value))
        Option.None -> Option.None
    }
}

/// Applies an optional-producing transform to a present value and flattens the result.
pub func Option.and_then<T, U>(self: Option<T>, transform: func(T) -> Option<U>) -> Option<U> {
    branch self {
        Option.Some(value) -> transform(value)
        Option.None -> Option.None
    }
}

/// Returns the contained value, or `fallback` when the option is `None`.
pub func Option.unwrap_or<T>(self: Option<T>, fallback: T) -> T {
    branch self {
        Option.Some(value) -> value
        Option.None -> fallback
    }
}

/// Returns whether the option contains a value.
pub func Option.present?<T>(self: Option<T>) -> Bool {
    branch self {
        Option.Some(_) -> true
        Option.None -> false
    }
}

/// Returns whether the option contains no value.
pub func Option.absent?<T>(self: Option<T>) -> Bool {
    branch self {
        Option.Some(_) -> false
        Option.None -> true
    }
}

/// Returns the contained value, or computes a fallback when the option is `None`.
pub func Option.unwrap_or_else<T>(self: Option<T>, fallback: Supplier<T>) -> T {
    branch self {
        Option.Some(value) -> value
        Option.None -> fallback()
    }
}

/// Preserves a present value, or computes another option when this option is `None`.
pub func Option.or_else<T>(self: Option<T>, fallback: Supplier<Option<T>>) -> Option<T> {
    branch self {
        Option.Some(value) -> Option.Some(value)
        Option.None -> fallback()
    }
}

/// Removes one layer from a nested option.
pub func Option.flatten<T>(self: Option<Option<T>>) -> Option<T> {
    branch self {
        Option.Some(value) -> value
        Option.None -> Option.None
    }
}

test "option transformations preserve presence and absence" {
    let mapped = Option.Some(20).map((value: Int) -> value + 1)
    let valid = branch mapped {
        Option.Some(value) -> value == 21
        Option.None -> false
    }
    assert(valid)
}
