//! `Option`al values and transformations that preserve absence.
//!
//! `Some` carries a value; `None` represents absence without an error explanation.
//! map and and_then invoke their callback only for `Some`. unwrap_or receives an
//! already evaluated fallback; unwrap_or_else computes one only for `None`.

import core.functions

/// A value that is either present as `Some(T)` or absent as `None`.
pub enum Option<T> = Some(T)
    | None
    & {
        // Required public operations; implementations live in impl blocks.
        /// Applies `transform` to a present value and preserves `None`.
        pub func map<U>(self, transform: func(T) -> U) -> Option<U> [read self, read transform]
        /// Applies an optional-producing transform to a present value and flattens the result.
        pub func and_then<U>(self, transform: func(T) -> Option<U>) -> Option<U> [read self, read transform]
        /// Returns the contained value, or `fallback` for `None`.
        /// The fallback is evaluated before this call, even for `Some`; use
        /// `unwrap_or_else` to defer computation.
        pub func unwrap_or(self, fallback: T) -> T [consume fallback, read self]
        /// Returns whether the option contains a value.
        pub func present?(self) -> Bool [read self]
        /// Returns whether the option contains no value.
        pub func absent?(self) -> Bool [read self]
        /// Returns the contained value; calls `fallback` exactly once only for `None`.
        pub func unwrap_or_else(self, fallback: Supplier<T>) -> T [read fallback, read self]
        /// Preserves a present value, or computes another option when this option is `None`.
        pub func or_else(self, fallback: Supplier<Option<T>>) -> Option<T> [read fallback, read self]
    }

impl Option {
    /// Applies `transform` to a present value and preserves `None`.
    pub func map<T, U>(self: Option<T>, transform: func(T) -> U) -> Option<U> {
        branch self {
            Option.Some(value) -> Option.Some(transform(value))
            Option.None -> Option.None
        }
    }

    /// Applies an optional-producing transform to a present value and flattens the result.
    pub func and_then<T, U>(self: Option<T>, transform: func(T) -> Option<U>) -> Option<U> {
        branch self {
            Option.Some(value) -> transform(value)
            Option.None -> Option.None
        }
    }

    /// Returns the contained value, or `fallback` for `None`.
    /// The fallback is evaluated before this call, even for `Some`; use
    /// `unwrap_or_else` to defer computation.
    pub func unwrap_or<T>(self: Option<T>, fallback: T) -> T [consume fallback, read self] {
        branch self {
            Option.Some(value) -> value
            Option.None -> fallback
        }
    }

    /// Returns whether the option contains a value.
    pub func present?<T>(self: Option<T>) -> Bool {
        branch self {
            Option.Some(_) -> true
            Option.None -> false
        }
    }

    /// Returns whether the option contains no value.
    pub func absent?<T>(self: Option<T>) -> Bool {
        branch self {
            Option.Some(_) -> false
            Option.None -> true
        }
    }

    /// Returns the contained value; calls `fallback` exactly once only for `None`.
    pub func unwrap_or_else<T>(self: Option<T>, fallback: Supplier<T>) -> T {
        branch self {
            Option.Some(value) -> value
            Option.None -> fallback()
        }
    }

    /// Preserves a present value, or computes another option when this option is `None`.
    pub func or_else<T>(self: Option<T>, fallback: Supplier<Option<T>>) -> Option<T> {
        branch self {
            Option.Some(value) -> Option.Some(value)
            Option.None -> fallback()
        }
    }

    /// Removes one layer from a nested option.
    pub func flatten<T>(self: Option<Option<T>>) -> Option<T> {
        branch self {
            Option.Some(value) -> value
            Option.None -> Option.None
        }
    }
}

test "option transformations preserve presence and absence" {
    let mapped = Option.Some(20).map((value: Int) -> value + 1)
    let valid = branch mapped {
        Option.Some(value) -> value == 21
        Option.None -> false
    }
    assert(valid)
}
