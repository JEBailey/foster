//! Three-way ordering results and ordering transformations.

/// The relative order of two comparable values.
pub enum Ordering = Less
    | Equal
    | Greater

/// A type whose values can be compared for semantic equality with `T`.
///
/// Implementations must be reflexive, symmetric, and transitive.
pub type Equality<T> = {
    /// Returns whether this value and `other` are semantically equal.
    pub func equal?(self, other: T) -> Bool
}

/// A totally ordered type whose values can be compared with `T`.
///
/// `compare` must agree with the composed `Equality<T>` implementation:
/// it returns `Ordering.Equal` exactly when `equal?` returns true.
pub type Ordered<T> = & Equality<T> & {
    /// Compares this value with `other`.
    pub func compare(self, other: T) -> Ordering
}

/// A type that provides a stable integer hash for its semantic value.
///
/// Values considered equal must return the same hash. Unequal values may collide.
pub type Hashing = {
    /// Returns this value's stable integer hash.
    pub func hash(self) -> Int
}

/// Reverses an ordering, exchanging `Less` and `Greater` while preserving `Equal`.
pub func Ordering.reverse(self: Ordering) -> Ordering {
    branch self {
        Ordering.Less -> Ordering.Greater
        Ordering.Equal -> Ordering.Equal
        Ordering.Greater -> Ordering.Less
    }
}

test "reversing an ordering exchanges less and greater" {
    let valid = branch Ordering.Less.reverse() {
        Ordering.Greater -> true
        _ -> false
    }
    assert(valid)
}
