//! Immutable binary data, encoding conversions, and byte-oriented queries.

import core.byte
import core.list
import core.result

/// Private host-backed compact byte storage.
intrinsic type RawBytes

/// Private namespace for host-backed byte operations.
type BytesHost = {}

/// Packs a Foster byte list into compact storage.
func BytesHost.from_list(values: List<Byte>) -> Bytes [consume values] = intrinsic("bytes.from_list")
/// Expands compact storage into a Foster list.
func BytesHost.to_list(values: Bytes) -> List<Byte> = intrinsic("bytes.to_list")
/// Constructs text from bytes already validated by Foster code.
func BytesHost.decode_utf8(value: Bytes) -> String = intrinsic("bytes.decode_utf8")

/// Immutable binary data backed by compact private host storage.
pub type Bytes = {
    value: RawBytes
}

/// Describes a failed UTF-8 decoding operation.
pub type Utf8Error = {
    pub offset: Int
    pub message: String
}

/// Describes malformed hexadecimal byte text.
pub type HexError = {
    pub offset: Int
    pub message: String
}

/// Creates an empty immutable byte sequence.
pub func Bytes.empty() -> Bytes {
    BytesHost.from_list([])
}

/// Packs a list of bytes into compact immutable storage.
pub func Bytes.from(values: List<Byte>) -> Bytes [consume values] {
    BytesHost.from_list(move values)
}

/// Decodes an even-length hexadecimal string.
pub func Bytes.from_hex(value: String) -> Result<Bytes, HexError> {
    decode_hex(value.code_points(), 0, [])
}

/// Concatenates two immutable byte sequences.
pub func Bytes.concat(self: Bytes, other: Bytes) -> Bytes {
    let left = self.list()
    Bytes.from((move left).concat(other.list()))
}

/// Returns bytes in the half-open range `start..end`.
pub func Bytes.slice(self: Bytes, start: Int, end: Int) -> Bytes {
    assert(start >= 0 && end >= start && end <= self.length, "byte slice is out of bounds")
    let values = self.list()
    let remaining = (move values).drop(start)
    Bytes.from(remaining.take(end - start))
}

/// Expands compact bytes into a Foster list.
pub func Bytes.list(self: Bytes) -> List<Byte> {
    BytesHost.to_list(self)
}

/// Encodes bytes as lowercase hexadecimal text.
pub func Bytes.hex(self: Bytes) -> String {
    hex_remaining(self.list(), "")
}

/// Returns whether two byte sequences contain identical values.
pub func Bytes.equal?(self: Bytes, other: Bytes) -> Bool {
    self == other
}

/// Computes a deterministic hash over the byte sequence.
pub func Bytes.hash(self: Bytes) -> Int {
    hash_remaining(self, 17)
}

/// Decodes valid UTF-8 or returns a typed error.
pub func Bytes.utf8_valid?(self: Bytes) -> Bool {
    utf8_valid(self.list())
}

/// Decodes valid UTF-8 or returns a typed error.
pub func String.from_utf8(value: Bytes) -> Result<String, Utf8Error> {
    branch {
        value.utf8_valid?() -> Result.Ok(BytesHost.decode_utf8(value))
        _ -> Result.Error(Utf8Error { offset: -1, message: "Bytes are not valid UTF-8" })
    }
}

test "bytes round-trip UTF-8 and hexadecimal text" {
    let encoded = "Foster λ".utf8
    let valid = branch String.from_utf8(encoded) {
        Result.Ok(value) -> value == "Foster λ"
        Result.Error(_) -> false
    }
    assert(valid)
    assert(encoded.hex() == "466f7374657220cebb")
}

/// Accumulates a stable byte hash.
func hash_remaining(values: Bytes, state: Int) -> Int {
    branch {
        values.empty? -> state
        _ -> hash_remaining(values.rest, state + values.head)
    }
}

/// Decodes pairs of ASCII hexadecimal code points into compact bytes.
func decode_hex(characters: List<CodePoint>, offset: Int, output: List<Byte>) -> Result<Bytes, HexError> [consume output] {
    branch {
        characters.empty? -> Result.Ok(Bytes.from(move output))
        characters.rest.empty? -> Result.Error(HexError {
            offset: offset + 1
            message: "hexadecimal byte text must have even length"
        })
        _ -> decode_hex_pair(characters, offset, move output)
    }
}

/// Validates and appends one hexadecimal byte pair.
func decode_hex_pair(characters: List<CodePoint>, offset: Int, output: List<Byte>) -> Result<Bytes, HexError> [consume output] {
    let high = hex_nibble(characters.head)
    return invalid_hex(offset, characters.head) if high < 0
    let tail = characters.rest
    let low = hex_nibble(tail.head)
    return invalid_hex(offset + 1, tail.head) if low < 0
    decode_hex(tail.rest, offset + 2, output.append(Byte.unchecked(high * 16 + low)))
}

/// Converts one hexadecimal digit to its integer nibble, or `-1` when invalid.
func hex_nibble(character: CodePoint) -> Int {
    let value = character.as_int()
    branch {
        value >= 48 && value <= 57 -> value - 48
        value >= 97 && value <= 102 -> value - 87
        value >= 65 && value <= 70 -> value - 55
        _ -> -1
    }
}

/// Constructs a hexadecimal decoding error at the supplied character offset.
func invalid_hex(offset: Int, character: CodePoint) -> Result<Bytes, HexError> {
    Result.Error(HexError {
        offset
        message: "invalid hexadecimal digit `" + character.string + "`"
    })
}

/// Encodes every byte as two lowercase hexadecimal digits.
func hex_remaining(values: List<Byte>, output: String) -> String [consume output] {
    branch {
        values.empty? -> output
        _ -> hex_remaining(values.rest, output + hex_byte(values.head))
    }
}

/// Encodes one byte as two lowercase hexadecimal digits.
func hex_byte(value: Byte) -> String {
    let integer = value.int
    let high = integer / 16
    hex_digit(high) + hex_digit(integer - high * 16)
}

/// Encodes one integer nibble as a lowercase hexadecimal digit.
func hex_digit(value: Int) -> String {
    branch {
        value < 10 -> from_code_point(48 + value).string
        _ -> from_code_point(87 + value).string
    }
}

/// Validates a complete UTF-8 byte sequence.
func utf8_valid(values: List<Byte>) -> Bool {
    branch {
        values.empty? -> true
        values.head.int <= 127 -> utf8_valid(values.rest)
        values.head.int >= 194 && values.head.int <= 223 -> valid_utf8_tail(values.rest, 1)
        values.head.int == 224 -> valid_utf8_second(values.rest, 160, 191, 1)
        values.head.int >= 225 && values.head.int <= 236 -> valid_utf8_tail(values.rest, 2)
        values.head.int == 237 -> valid_utf8_second(values.rest, 128, 159, 1)
        values.head.int >= 238 && values.head.int <= 239 -> valid_utf8_tail(values.rest, 2)
        values.head.int == 240 -> valid_utf8_second(values.rest, 144, 191, 2)
        values.head.int >= 241 && values.head.int <= 243 -> valid_utf8_tail(values.rest, 3)
        values.head.int == 244 -> valid_utf8_second(values.rest, 128, 143, 2)
        _ -> false
    }
}

/// Validates a constrained second byte followed by ordinary continuation bytes.
func valid_utf8_second(values: List<Byte>, minimum: Int, maximum: Int, remaining: Int) -> Bool {
    branch {
        values.empty? -> false
        values.head.int < minimum -> false
        values.head.int > maximum -> false
        _ -> valid_utf8_tail(values.rest, remaining)
    }
}

/// Validates `remaining` continuation bytes and then the rest of the sequence.
func valid_utf8_tail(values: List<Byte>, remaining: Int) -> Bool {
    branch {
        remaining == 0 -> utf8_valid(values)
        values.empty? -> false
        values.head.int < 128 -> false
        values.head.int > 191 -> false
        _ -> valid_utf8_tail(values.rest, remaining - 1)
    }
}
