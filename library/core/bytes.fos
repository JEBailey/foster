//! Immutable binary data, encoding conversions, and byte-oriented queries.

import core.byte
import core.result

/// Private host-backed compact byte storage.
intrinsic type RawBytes

/// Private namespace for host-backed byte operations.
type BytesHost = {}

/// Creates empty compact byte storage.
func BytesHost.empty() -> Bytes = intrinsic("bytes.empty")
/// Packs a Foster byte list into compact storage.
func BytesHost.from_list(values: List<Byte>) -> Bytes [consume values] = intrinsic("bytes.from_list")
/// Decodes hexadecimal text at the host boundary.
func BytesHost.from_hex(value: String) -> Result<Bytes, HexError> = intrinsic("bytes.from_hex")
/// Concatenates compact byte sequences.
func BytesHost.concat(left: Bytes, right: Bytes) -> Bytes = intrinsic("bytes.concat")
/// Extracts a half-open byte range.
func BytesHost.slice(values: Bytes, start: Int, end: Int) -> Bytes = intrinsic("bytes.slice")
/// Expands compact storage into a Foster list.
func BytesHost.to_list(values: Bytes) -> List<Byte> = intrinsic("bytes.to_list")
/// Encodes compact bytes as hexadecimal text.
func BytesHost.hex(values: Bytes) -> String = intrinsic("bytes.hex")
/// Encodes Foster text as UTF-8 bytes.
func BytesHost.encode_utf8(value: String) -> Bytes = intrinsic("bytes.encode_utf8")
/// Checks whether bytes contain valid UTF-8.
func BytesHost.utf8_valid(value: Bytes) -> Bool = intrinsic("bytes.utf8_valid")
/// Decodes bytes already known to contain valid UTF-8.
func BytesHost.decode_utf8(value: Bytes) -> String = intrinsic("bytes.decode_utf8")

/// Immutable binary data backed by compact private host storage.
pub type Bytes = {
    value: RawBytes
}

/// Describes a failed UTF-8 decoding operation.
pub type Utf8Error = {
    pub offset: Int
    pub message: String
}

/// Describes malformed hexadecimal byte text.
pub type HexError = {
    pub offset: Int
    pub message: String
}

/// Creates an empty immutable byte sequence.
pub func Bytes.empty() -> Bytes {
    BytesHost.empty()
}

/// Packs a list of bytes into compact immutable storage.
pub func Bytes.from(values: List<Byte>) -> Bytes [consume values] {
    BytesHost.from_list(move values)
}

/// Decodes an even-length hexadecimal string.
pub func Bytes.from_hex(value: String) -> Result<Bytes, HexError> {
    BytesHost.from_hex(value)
}

/// Concatenates two immutable byte sequences.
pub func concat(self: Bytes, other: Bytes) -> Bytes {
    BytesHost.concat(self, other)
}

/// Returns bytes in the half-open range `start..end`.
pub func slice(self: Bytes, start: Int, end: Int) -> Bytes {
    BytesHost.slice(self, start, end)
}

/// Expands compact bytes into a Foster list.
pub func list(self: Bytes) -> List<Byte> {
    BytesHost.to_list(self)
}

/// Encodes bytes as lowercase hexadecimal text.
pub func hex(self: Bytes) -> String {
    BytesHost.hex(self)
}

/// Returns whether two byte sequences contain identical values.
pub func equal?(self: Bytes, other: Bytes) -> Bool {
    self == other
}

/// Computes a deterministic hash over the byte sequence.
pub func hash(self: Bytes) -> Int {
    hash_remaining(self, 17)
}

/// Encodes a string as UTF-8.
pub func utf8(value: String) -> Bytes {
    BytesHost.encode_utf8(value)
}

/// Decodes valid UTF-8 or returns a typed error.
pub func String.from_utf8(value: Bytes) -> Result<String, Utf8Error> {
    branch {
        BytesHost.utf8_valid(value) -> Result.Ok(BytesHost.decode_utf8(value))
        _ -> Result.Error(Utf8Error { offset: -1, message: "Bytes are not valid UTF-8" })
    }
}

test "bytes round-trip UTF-8 and hexadecimal text" {
    let encoded = utf8("Foster λ")
    let valid = branch String.from_utf8(encoded) {
        Result.Ok(value) -> value == "Foster λ"
        Result.Error(_) -> false
    }
    assert(valid)
    assert(encoded.hex == "466f7374657220cebb")
}

/// Accumulates a stable byte hash.
func hash_remaining(values: Bytes, state: Int) -> Int {
    branch {
        values.empty? -> state
        _ -> hash_remaining(values.rest, state + values.head)
    }
}
