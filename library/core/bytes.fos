//! Immutable binary data, encoding conversions, and byte-oriented queries.

import core.byte
import core.list
import core.result

/// Private host-backed compact byte storage.
intrinsic type RawBytes

/// Private namespace for host-backed byte operations.
type BytesHost = {}

/// Packs a Foster byte list into compact storage.
func BytesHost.from_list(values: List<Byte>) -> Bytes [consume values] = intrinsic("bytes.from_list")
/// Expands compact storage into a Foster list.
func BytesHost.to_list(values: Bytes) -> List<Byte> = intrinsic("bytes.to_list")
/// Constructs text from bytes already validated by Foster code.
func BytesHost.decode_utf8(value: Bytes) -> String = intrinsic("bytes.decode_utf8")

/// Immutable binary data backed by compact private host storage.
pub type Bytes = {
    value: RawBytes
}

/// Describes a failed UTF-8 decoding operation.
pub type Utf8Error = {
    pub offset: Int
    pub message: String
}

/// Describes malformed hexadecimal byte text.
pub type HexError = {
    pub offset: Int
    pub message: String
}

/// Creates an empty immutable byte sequence.
pub func Bytes.empty() -> Bytes {
    BytesHost.from_list([])
}

/// Packs a list of bytes into compact immutable storage.
pub func Bytes.from(values: List<Byte>) -> Bytes [consume values] {
    BytesHost.from_list(move values)
}

/// Decodes an even-length hexadecimal string.
pub func Bytes.from_hex(value: String) -> Result<Bytes, HexError> {
    let characters = value.code_points()
    let output = []
    let offset = 0
    loop {
        break if offset >= characters.length
        return Result.Error(HexError {
            offset: offset + 1
            message: "hexadecimal byte text must have even length"
        }) if offset + 1 == characters.length
        let high = hex_nibble(characters[offset])
        return invalid_hex(offset, characters[offset]) if high < 0
        let low = hex_nibble(characters[offset + 1])
        return invalid_hex(offset + 1, characters[offset + 1]) if low < 0
        output.push(Byte.unchecked(high * 16 + low))
        offset = offset + 2
    }
    Result.Ok(Bytes.from(move output))
}

/// Concatenates two immutable byte sequences.
pub func Bytes.concat(self: Bytes, other: Bytes) -> Bytes {
    let output = self.list()
    let index = 0
    loop {
        break if index >= other.length
        output.push(other[index])
        index = index + 1
    }
    Bytes.from(move output)
}

/// Returns bytes in the half-open range `start..end`.
pub func Bytes.slice(self: Bytes, start: Int, end: Int) -> Bytes {
    assert(start >= 0 && end >= start && end <= self.length, "byte slice is out of bounds")
    let output = []
    let index = start
    loop {
        break if index >= end
        output.push(self[index])
        index = index + 1
    }
    Bytes.from(move output)
}

/// Expands compact bytes into a Foster list.
pub func Bytes.list(self: Bytes) -> List<Byte> {
    BytesHost.to_list(self)
}

/// Encodes bytes as lowercase hexadecimal text.
pub func Bytes.hex(self: Bytes) -> String {
    let output = []
    let index = 0
    loop {
        break if index >= self.length
        let value = self[index].int
        output.push(hex_digit(value / 16))
        output.push(hex_digit(value - value / 16 * 16))
        index = index + 1
    }
    BytesHost.decode_utf8(Bytes.from(move output))
}

/// Returns whether two byte sequences contain identical values.
pub func Bytes.equal?(self: Bytes, other: Bytes) -> Bool {
    return false if self.length != other.length
    let index = 0
    loop {
        break if index >= self.length
        return false if self[index] != other[index]
        index = index + 1
    }
    true
}

/// Computes a deterministic hash over the byte sequence.
pub func Bytes.hash(self: Bytes) -> Int {
    let state = 17
    let index = 0
    loop {
        break if index >= self.length
        state = state + self[index]
        index = index + 1
    }
    state
}

/// Checks UTF-8 scalar boundaries without allocating decoded text or copied suffixes.
pub func Bytes.utf8_valid?(self: Bytes) -> Bool {
    let index = 0
    loop {
        break if index >= self.length
        let first = self[index].int
        let width = branch {
            first <= 127 -> 1
            first >= 194 && first <= 223 -> 2
            first >= 224 && first <= 239 -> 3
            first >= 240 && first <= 244 -> 4
            _ -> 0
        }
        return false if width == 0 || width > self.length - index
        branch {
            width > 1 -> {
                let second = self[index + 1].int
                return false if second < 128 || second > 191
                return false if first == 224 && second < 160
                return false if first == 237 && second > 159
                return false if first == 240 && second < 144
                return false if first == 244 && second > 143
                let tail = 2
                loop {
                    break if tail >= width
                    let continuation = self[index + tail].int
                    return false if continuation < 128 || continuation > 191
                    tail = tail + 1
                }
                ()
            }
            _ -> ()
        }
        index = index + width
    }
    true
}

/// Decodes valid UTF-8 or returns a typed error.
pub func String.from_utf8(value: Bytes) -> Result<String, Utf8Error> {
    branch {
        value.utf8_valid?() -> Result.Ok(BytesHost.decode_utf8(value))
        _ -> Result.Error(Utf8Error { offset: -1, message: "Bytes are not valid UTF-8" })
    }
}

test "bytes round-trip UTF-8 and hexadecimal text" {
    let encoded = "Foster λ".utf8
    let valid = branch String.from_utf8(encoded) {
        Result.Ok(value) -> value == "Foster λ"
        Result.Error(_) -> false
    }
    assert(valid)
    assert(encoded.hex() == "466f7374657220cebb")
}

/// Converts one hexadecimal digit to its integer nibble, or `-1` when invalid.
func hex_nibble(character: CodePoint) -> Int {
    let value = character.as_int()
    branch {
        value >= 48 && value <= 57 -> value - 48
        value >= 97 && value <= 102 -> value - 87
        value >= 65 && value <= 70 -> value - 55
        _ -> -1
    }
}

/// Constructs a hexadecimal decoding error at the supplied character offset.
func invalid_hex(offset: Int, character: CodePoint) -> Result<Bytes, HexError> {
    Result.Error(HexError {
        offset
        message: "invalid hexadecimal digit `" + character.string + "`"
    })
}

/// Encodes one integer nibble as an ASCII byte.
func hex_digit(value: Int) -> Byte {
    branch {
        value < 10 -> Byte.unchecked(48 + value)
        _ -> Byte.unchecked(87 + value)
    }
}

test "UTF-8 validation rejects invalid boundaries and truncated sequences" {
    assert(Bytes.from([Byte.unchecked(0)]).utf8_valid?())
    assert("λ€🙂".utf8.utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(128)]).utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(192), Byte.unchecked(128)]).utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(224), Byte.unchecked(159), Byte.unchecked(191)]).utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(237), Byte.unchecked(160), Byte.unchecked(128)]).utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(244), Byte.unchecked(144), Byte.unchecked(128), Byte.unchecked(128)]).utf8_valid?())
    assert(!Bytes.from([Byte.unchecked(240), Byte.unchecked(159)]).utf8_valid?())
    assert("abcdef".utf8.slice(2, 4).hex() == "6364")
    ()
}
