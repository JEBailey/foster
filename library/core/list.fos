//! Owned homogeneous lists and indexed, stack-safe collection algorithms.

import std.iter
import core.functions
import core.option
import core.result as outcomes
import core.string

/// Private descriptor-backed contiguous list storage shared by executable backends.
intrinsic type RawList<T>

/// An ordered value collection backed by private copy-on-write contiguous storage.
pub type List<T> = {
    value: RawList<T>

    // Required public operations; implementations live in impl blocks.
    /// Appends `value` to this list in place.
    pub func push(self, value: T) -> () [reshape self.items]
    /// Returns this list with `value` appended.
    pub func append(self, value: T) -> List<T> [consume self]
    /// Copies an element without removing it. Bounds are checked before its Copy capability.
    pub func at(self, index: Int) -> Result<T, ListReadError> [read self]
    /// Returns whether this list contains `expected`.
    pub func contains?(self, expected: T) -> Bool [read expected, read self]
    /// Copies the first element, or returns `None` when it is absent or not copyable.
    pub func first(self) -> Option<T> [read self]
    /// Copies the final element, or returns `None` when it is absent or not copyable.
    pub func last(self) -> Option<T> [read self]
    /// Applies `transform` to every element, from left to right.
    pub func map<U>(self, transform: func(T) -> U) -> List<U> [read self, read transform]
    /// Returns the elements for which `include` evaluates to true.
    pub func filter(self, include: Predicate<T>) -> List<T> [read include, read self]
    /// Reduces the list from left to right, beginning with `initial`.
    pub func fold<U>(self, initial: U, combine: func(consume U, consume T) -> U) -> U [consume initial, read self]
    /// Returns the first matching element; stops evaluating the predicate at that element.
    pub func find(self, predicate: Predicate<T>) -> Option<T> [read predicate, read self]
    /// Returns whether at least one element satisfies `predicate`.
    pub func any?(self, predicate: Predicate<T>) -> Bool [read predicate, read self]
    /// Returns whether every element satisfies `predicate`.
    pub func all?(self, predicate: Predicate<T>) -> Bool [read predicate, read self]
    /// Builds a reversed list without materializing intermediate tails.
    pub func reverse(self) -> List<T> [read self]
    /// Appends every element of `right`, consuming the left list.
    pub func concat(self, right: List<T>) -> List<T> [consume self, read right]
    /// Returns a copy of the element, or None when it is unavailable or not copyable.
    pub func get(self, index: Int) -> Option<T> [read self]
    /// Copies only the elements in the checked half-open range `start..end`.
    pub func slice(self, start: Int, end: Int) -> List<T> [read end, read self, read start]
    /// Returns at most the first `count` elements; a nonpositive count returns an empty list.
    pub func take(self, count: Int) -> List<T> [read count, read self]
    /// Consumes the list and returns the elements after the first `count` entries.
    pub func drop(self, count: Int) -> List<T> [consume self]
    /// Maps each element to a list and appends its elements to one output buffer.
    pub func flat_map<U>(self, transform: func(T) -> List<U>) -> List<U> [read self, read transform]
    /// Counts the elements satisfying `predicate`.
    pub func count(self, predicate: Predicate<T>) -> Int [read predicate, read self]
    /// Returns whether no element satisfies `predicate`.
    pub func none?(self, predicate: Predicate<T>) -> Bool [read predicate, read self]
    /// Combines a nonempty list into one value, or returns `None` for an empty list.
    pub func reduce(self, combine: func(T, T) -> T) -> Option<T> [read combine, read self]

    // Required accessors supplied by the builtin storage implementation.
    /// Reports whether the collection contains no elements.
    pub func empty?(self) -> Bool
    /// Returns the number of elements.
    pub func length(self) -> Int
    /// Returns the first element; the collection must not be empty.
    pub func head(self) -> T
    /// Returns the collection without its first element.
    pub func rest(self) -> List<T>
    /// Creates an independent iterator over the elements.
    pub func iterator(self) -> Iterator<T>
}

/// Why an independently owned element could not be obtained.
pub enum ListReadError = OutOfBounds
    | NotCopyable

impl List {
    /// Appends `value` to this list in place.
    pub func push<T>(self: List<T>, value: T) -> () [reshape self.items] = intrinsic("list.push")

    /// Returns this list with `value` appended.
    pub func append<T>(self: List<T>, value: T) -> List<T> [consume self] = intrinsic("list.append")

    /// Copies an element without removing it. Bounds are checked before its Copy capability.
    pub func at<T>(self: List<T>, index: Int) -> Result<T, ListReadError> [read self] {
        branch {
            index < 0 || index >= self.length -> Result.Error(ListReadError.OutOfBounds)
            !self.can_copy_at(index) -> Result.Error(ListReadError.NotCopyable)
            _ -> Result.Ok(self.copy_at(index))
        }
    }

    /// Tests the runtime Copy capability of an in-bounds element.
    func can_copy_at<T>(self: List<T>, index: Int) -> Bool [read self] = intrinsic("list.can_copy_at")
    /// Invokes Copy after the caller checks bounds and capability.
    func copy_at<T>(self: List<T>, index: Int) -> T [read self] = intrinsic("list.copy_at")

    /// Collection algorithms that produce owned elements require Copy.
    func read_at<T>(self: List<T>, index: Int) -> T [read self] {
        assert(index >= 0 && index < self.length, "list index is out of bounds")
        assert(self.can_copy_at(index), "list element does not implement Copy")
        self.copy_at(index)
    }

    /// Returns whether this list contains `expected`.
    pub func contains?<T>(self: List<T>, expected: T) -> Bool {
        let index = 0
        loop {
            return false if index >= self.length
            return true if self[index] == expected
            index = index + 1
        }
        false
    }

    /// Copies the first element, or returns `None` when it is absent or not copyable.
    pub func first<T>(self: List<T>) -> Option<T> {
        self.get(0)
    }

    /// Copies the final element, or returns `None` when it is absent or not copyable.
    pub func last<T>(self: List<T>) -> Option<T> {
        self.get(self.length - 1)
    }

    /// Applies `transform` to every element, from left to right.
    pub func map<T, U>(self: List<T>, transform: func(T) -> U) -> List<U> {
        let result = []
        let index = 0
        loop {
            break if index >= self.length
            result.push(transform(self[index]))
            index = index + 1
        }
        result
    }

    /// Returns the elements for which `include` evaluates to true.
    pub func filter<T>(self: List<T>, include: Predicate<T>) -> List<T> {
        let result = []
        let index = 0
        loop {
            break if index >= self.length
            let value = self.read_at(index)
            branch {
                include(value) -> result.push(value)
                _ -> ()
            }
            index = index + 1
        }
        result
    }

    /// Reduces the list from left to right, beginning with `initial`.
    pub func fold<T, U>(self: List<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [consume initial, read self] {
        let result = move initial
        let index = 0
        loop {
            break if index >= self.length
            result = combine(move result, self.read_at(index))
            index = index + 1
        }
        result
    }

    /// Returns the first matching element; stops evaluating the predicate at that element.
    pub func find<T>(self: List<T>, predicate: Predicate<T>) -> Option<T> {
        let index = 0
        loop {
            break if index >= self.length
            let value = self.read_at(index)
            return Option.Some(value) if predicate(value)
            index = index + 1
        }
        Option.None
    }

    /// Returns whether at least one element satisfies `predicate`.
    pub func any?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
        let index = 0
        loop {
            return false if index >= self.length
            return true if predicate(self[index])
            index = index + 1
        }
        false
    }

    /// Returns whether every element satisfies `predicate`.
    pub func all?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
        let index = 0
        loop {
            return true if index >= self.length
            return false if !predicate(self[index])
            index = index + 1
        }
        true
    }

    /// Builds a reversed list without materializing intermediate tails.
    pub func reverse<T>(self: List<T>) -> List<T> {
        let result = []
        let index = self.length
        loop {
            break if index <= 0
            index = index - 1
            result.push(self.read_at(index))
        }
        result
    }

    /// Appends every element of `right`, consuming the left list.
    pub func concat<T>(self: List<T>, right: List<T>) -> List<T> [consume self, read right] {
        let result = move self
        let index = 0
        loop {
            break if index >= right.length
            result.push(right.read_at(index))
            index = index + 1
        }
        result
    }

    /// Returns a copy of the element, or None when it is unavailable or not copyable.
    pub func get<T>(self: List<T>, index: Int) -> Option<T> [read self] {
        branch self.at(index) {
            Result.Ok(value) -> Option.Some(value)
            Result.Error(_) -> Option.None
        }
    }

    /// Copies only the elements in the checked half-open range `start..end`.
    pub func slice<T>(self: List<T>, start: Int, end: Int) -> List<T> {
        assert(start >= 0 && end >= start && end <= self.length, "list slice is out of bounds")
        let result = []
        let index = start
        loop {
            break if index >= end
            result.push(self.read_at(index))
            index = index + 1
        }
        result
    }

    /// Returns at most the first `count` elements; a nonpositive count returns an empty list.
    pub func take<T>(self: List<T>, count: Int) -> List<T> {
        let end = branch {
            count < 0 -> 0
            count > self.length -> self.length
            _ -> count
        }
        self.slice(0, end)
    }

    /// Consumes the list and returns the elements after the first `count` entries.
    pub func drop<T>(self: List<T>, count: Int) -> List<T> [consume self] {
        return self if count <= 0
        return [] if count >= self.length
        self.slice(count, self.length)
    }

    /// Maps each element to a list and appends its elements to one output buffer.
    pub func flat_map<T, U>(self: List<T>, transform: func(T) -> List<U>) -> List<U> {
        let result = []
        let index = 0
        loop {
            break if index >= self.length
            let mapped = transform(self[index])
            let item = 0
            loop {
                break if item >= mapped.length
                result.push(mapped.read_at(item))
                item = item + 1
            }
            index = index + 1
        }
        result
    }

    /// Concatenates nested lists in source order without constructing intermediate tails.
    pub func flatten<T>(self: List<List<T>>) -> List<T> {
        let result = []
        let index = 0
        loop {
            break if index >= self.length
            let item = 0
            loop {
                break if item >= self[index].length
                result.push(self[index].read_at(item))
                item = item + 1
            }
            index = index + 1
        }
        result
    }

    /// Counts the elements satisfying `predicate`.
    pub func count<T>(self: List<T>, predicate: Predicate<T>) -> Int {
        let count = 0
        let index = 0
        loop {
            break if index >= self.length
            branch {
                predicate(self[index]) -> {
                    count = count + 1
                    ()
                }
                _ -> ()
            }
            index = index + 1
        }
        count
    }

    /// Returns whether no element satisfies `predicate`.
    pub func none?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
        !self.any?(predicate)
    }

    /// Combines a nonempty list into one value, or returns `None` for an empty list.
    pub func reduce<T>(self: List<T>, combine: func(T, T) -> T) -> Option<T> {
        return Option.None if self.empty?
        let result = self.read_at(0)
        let index = 1
        loop {
            break if index >= self.length
            result = combine(result, self.read_at(index))
            index = index + 1
        }
        Option.Some(result)
    }

    /// Joins strings into one byte builder, inserting separators only between elements.
    pub func join(self: List<String>, separator: String) -> String {
        let output = StringBuilder.empty()
        let index = 0
        loop {
            break if index >= self.length
            branch {
                index > 0 -> output.append(separator)
                _ -> ()
            }
            output.append(self.read_at(index))
            index = index + 1
        }
        (move output).finish()
    }
}

test "list algorithms transform and aggregate values" {
    let values = [1, 2, 3].map((value: Int) -> value * 2)
    assert(values == [2, 4, 6])
    assert(values.fold(0, (total: Int, value: Int) -> total + value) == 12)
    assert(values.reverse() == [6, 4, 2])
    assert(values.slice(1, 3) == [4, 6])
    assert(values.take(-1) == [])
    assert(values.take(99) == values)
    assert(values.get(-1) == Option.None)
    assert(values.get(3) == Option.None)
    assert(values.last() == Option.Some(6))
    assert([[1, 2], [], [3]].flatten() == [1, 2, 3])
    assert(["λ", "", "🙂"].join("|") == "λ||🙂")
    ()
}
