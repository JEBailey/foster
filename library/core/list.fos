//! Owned homogeneous lists and their sequence and iterator operations.

import core.functions
import core.option
import std.sequence

/// Private host-backed contiguous list storage.
intrinsic type RawList<T>

/// An immutable ordered collection backed by private contiguous storage.
pub type List<T> = {
    value: RawList<T>
}

/// Appends `value` to this list in place.
pub func List.push<T>(self: List<T>, value: T) -> () [reshape self.items] = intrinsic("list.push")

/// Returns this list with `value` appended.
pub func List.append<T>(self: List<T>, value: T) -> List<T> [consume self] = intrinsic("list.append")

/// Returns whether this list contains `expected`.
pub func List.contains?<T>(self: List<T>, expected: T) -> Bool {
    sequence::contains?(self, expected)
}

/// Returns the first element, or `None` when the list is empty.
pub func List.first<T>(self: List<T>) -> Option<T> {
    branch {
        self.empty? -> Option.None
        _ -> Option.Some(self.head)
    }
}

/// Returns the final element, or `None` when the list is empty.
pub func List.last<T>(self: List<T>) -> Option<T> {
    last_value(self)
}

/// Finds the final element by walking the remaining list.
func last_value<T>(values: List<T>) -> Option<T> [read values] {
    branch {
        values.empty? -> Option.None
        values.rest.empty? -> Option.Some(values.head)
        _ -> last_value(values.rest)
    }
}

/// Applies `transform` to every element and returns the transformed list.
pub func List.map<T, U>(self: List<T>, transform: func(T) -> U) -> List<U> {
    sequence::map(self, transform)
}

/// Returns the elements for which `include` evaluates to true.
pub func List.filter<T>(self: List<T>, include: Predicate<T>) -> List<T> {
    sequence::filter(self, include)
}

/// Reduces the list from left to right, beginning with `initial`.
pub func List.fold<T, U>(self: List<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [read self, consume initial] {
    fold_values(self, move initial, combine)
}

/// Reduces the remaining values into the accumulator.
func fold_values<T, U>(values: List<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [read values, consume initial] {
    branch {
        values.empty? -> initial
        _ -> fold_values(values.rest, combine(move initial, values.head), combine)
    }
}

/// Returns the first element satisfying `predicate`, or `None` if none does.
pub func List.find<T>(self: List<T>, predicate: Predicate<T>) -> Option<T> {
    find_value(self, predicate)
}

/// Finds the first matching value in the remaining list.
func find_value<T>(values: List<T>, predicate: Predicate<T>) -> Option<T> [read values] {
    branch {
        values.empty? -> Option.None
        predicate(values.head) -> Option.Some(values.head)
        _ -> find_value(values.rest, predicate)
    }
}

/// Returns whether at least one element satisfies `predicate`.
pub func List.any?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
    sequence::any?(self, predicate)
}

/// Returns whether every element satisfies `predicate`.
pub func List.all?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
    sequence::all?(self, predicate)
}

/// Returns a list containing the elements in reverse order.
pub func List.reverse<T>(self: List<T>) -> List<T> {
    reverse_values(self, [])
}

/// Prepends remaining values to the reverse accumulator.
func reverse_values<T>(values: List<T>, result: List<T>) -> List<T> [read values, consume result] {
    branch {
        values.empty? -> result
        _ -> reverse_values(values.rest, [values.head].concat(move result))
    }
}

/// Appends every element of `right` to `left`, consuming the left list.
pub func List.concat<T>(self: List<T>, right: List<T>) -> List<T> [consume self, read right] {
    right.fold(move self, (result: List<T>, value: T) -> result.append(value))
}

/// Returns the element at `index`, or `None` when the index is outside the list.
pub func List.get<T>(self: List<T>, index: Int) -> Option<T> {
    get_at(self, index)
}

/// Finds an element at the remaining zero-based index.
func get_at<T>(values: List<T>, index: Int) -> Option<T> [read values] {
    branch {
        index < 0 -> Option.None
        values.empty? -> Option.None
        index == 0 -> Option.Some(values.head)
        _ -> get_at(values.rest, index - 1)
    }
}

/// Returns at most the first `count` elements.
pub func List.take<T>(self: List<T>, count: Int) -> List<T> {
    sequence::take(self, count)
}

/// Consumes the list and returns the elements after the first `count` entries.
pub func List.drop<T>(self: List<T>, count: Int) -> List<T> [consume self] {
    drop_values(move self, count)
}

/// Consumes leading values until the requested count is exhausted.
func drop_values<T>(values: List<T>, count: Int) -> List<T> [consume values] {
    branch {
        count <= 0 -> values
        values.empty? -> values
        _ -> drop_values(values.rest, count - 1)
    }
}

/// Maps each element to a list and concatenates the produced lists.
pub func List.flat_map<T, U>(self: List<T>, transform: func(T) -> List<U>) -> List<U> {
    flat_map_into(self, transform, [])
}

/// Accumulates the lists produced from the remaining source elements.
func flat_map_into<T, U>(values: List<T>, transform: func(T) -> List<U>, result: List<U>) -> List<U> [consume result] {
    branch {
        values.empty? -> result
        _ -> flat_map_next(values, transform, move result)
    }
}

/// Transforms the next element and appends its values to the accumulator.
func flat_map_next<T, U>(values: List<T>, transform: func(T) -> List<U>, result: List<U>) -> List<U> [consume result] {
    let mapped = transform(values.head)
    let next = (move result).concat(mapped)
    flat_map_into(values.rest, transform, move next)
}

/// Concatenates a list of lists into one list.
pub func List.flatten<T>(self: List<List<T>>) -> List<T> {
    flatten_values(self)
}

/// Concatenates the remaining nested lists.
func flatten_values<T>(values: List<List<T>>) -> List<T> [read values] {
    branch {
        values.empty? -> []
        _ -> flatten_next(values)
    }
}

/// Copies the next nested list before joining it with the flattened tail.
func flatten_next<T>(values: List<List<T>>) -> List<T> [read values] {
    let head = values.head.fold([], (result: List<T>, value: T) -> result.append(value))
    let tail = flatten_values(values.rest)
    (move head).concat(tail)
}

/// Counts the elements satisfying `predicate`.
pub func List.count<T>(self: List<T>, predicate: Predicate<T>) -> Int {
    sequence::count(self, predicate)
}

/// Returns whether no element satisfies `predicate`.
pub func List.none?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {
    sequence::none?(self, predicate)
}

/// Combines a nonempty list into one value, or returns `None` for an empty list.
pub func List.reduce<T>(self: List<T>, combine: func(T, T) -> T) -> Option<T> {
    branch {
        self.empty? -> Option.None
        _ -> Option.Some(fold_values(self.rest, self.head, combine))
    }
}

/// Joins strings with `separator` between adjacent values.
pub func List.join(self: List<String>, separator: String) -> String {
    branch {
        self.empty? -> ""
        _ -> join_rest(self.rest, separator, self.head)
    }
}

test "list algorithms transform and aggregate values" {
    let values = [1, 2, 3].map((value: Int) -> value * 2)
    assert(values.length == 3)
    assert(values[0] == 2)
    assert(values[2] == 6)
    assert(values.fold(0, (total: Int, value: Int) -> total + value) == 12)
    ()
}

/// Appends the remaining strings and separators to the accumulated result.
func join_rest(values: List<String>, separator: String, result: String) -> String [consume result] {
    branch {
        values.empty? -> result
        _ -> join_next(values, separator, move result)
    }
}

/// Builds the next joined accumulator value.
func join_next(values: List<String>, separator: String, result: String) -> String {
    let next = result + separator + values.head
    join_rest(values.rest, separator, move next)
}
