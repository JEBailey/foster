//! Owned homogeneous lists and their sequence and iterator operations.

import core.option
import std.sequence

/// Private host-backed contiguous list storage.
intrinsic type RawList<T>

/// An immutable ordered collection backed by private contiguous storage.
pub type List<T> = {
    value: RawList<T>
}

/// Returns the first element, or `None` when the list is empty.
pub func first<T>(values: List<T>) -> Option<T> {
    branch {
        values.empty? -> Option.None
        _ -> Option.Some(values.head)
    }
}

/// Returns the final element, or `None` when the list is empty.
pub func last<T>(values: List<T>) -> Option<T> {
    branch {
        values.empty? -> Option.None
        values.rest.empty? -> Option.Some(values.head)
        _ -> last(values.rest)
    }
}

/// Applies `transform` to every element and returns the transformed list.
pub func map<T, U>(values: List<T>, transform: func(T) -> U) -> List<U> {
    sequence.map(values, transform)
}

/// Returns the elements for which `include` evaluates to true.
pub func filter<T>(values: List<T>, include: func(T) -> Bool) -> List<T> {
    sequence.filter(values, include)
}

/// Reduces the list from left to right, beginning with `initial`.
pub func fold<T, U>(values: List<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [consume initial] {
    branch {
        values.empty? -> initial
        _ -> fold(values.rest, combine(move initial, values.head), combine)
    }
}

/// Returns the first element satisfying `predicate`, or `None` if none does.
pub func find<T>(values: List<T>, predicate: func(T) -> Bool) -> Option<T> {
    branch {
        values.empty? -> Option.None
        predicate(values.head) -> Option.Some(values.head)
        _ -> find(values.rest, predicate)
    }
}

/// Returns whether at least one element satisfies `predicate`.
pub func any?<T>(values: List<T>, predicate: func(T) -> Bool) -> Bool {
    sequence.any?(values, predicate)
}

/// Returns whether every element satisfies `predicate`.
pub func all?<T>(values: List<T>, predicate: func(T) -> Bool) -> Bool {
    sequence.all?(values, predicate)
}

/// Returns whether the list contains an element equal to `expected`.
pub func contains?<T>(values: List<T>, expected: T) -> Bool {
    sequence.contains?(values, expected)
}

/// Returns a list containing the elements in reverse order.
pub func reverse<T>(values: List<T>) -> List<T> {
    branch {
        values.empty? -> []
        _ -> reverse(values.rest).append(values.head)
    }
}

/// Appends every element of `right` to `left`, consuming the left list.
pub func concat<T>(left: List<T>, right: List<T>) -> List<T> [consume left] {
    fold(right, move left, (result: List<T>, value: T) -> result.append(value))
}

/// Returns whether the list contains no elements.
pub func empty?<T>(values: List<T>) -> Bool {
    values.empty?
}

/// Returns the number of elements in the list.
pub func length<T>(values: List<T>) -> Int {
    values.length
}

/// Returns the element at `index`, or `None` when the index is outside the list.
pub func get<T>(values: List<T>, index: Int) -> Option<T> {
    branch {
        index < 0 -> Option.None
        values.empty? -> Option.None
        index == 0 -> Option.Some(values.head)
        _ -> get(values.rest, index - 1)
    }
}

/// Returns at most the first `count` elements.
pub func take<T>(values: List<T>, count: Int) -> List<T> {
    sequence.take(values, count)
}

/// Consumes the list and returns the elements after the first `count` entries.
pub func drop<T>(values: List<T>, count: Int) -> List<T> [consume values] {
    branch {
        count <= 0 -> values
        values.empty? -> values
        _ -> drop(values.rest, count - 1)
    }
}

/// Maps each element to a list and concatenates the produced lists.
pub func flat_map<T, U>(values: List<T>, transform: func(T) -> List<U>) -> List<U> {
    flat_map_into(values, transform, [])
}

/// Accumulates the lists produced from the remaining source elements.
func flat_map_into<T, U>(values: List<T>, transform: func(T) -> List<U>, result: List<U>) -> List<U> [consume result] {
    branch {
        values.empty? -> result
        _ -> flat_map_next(values, transform, move result)
    }
}

/// Transforms the next element and appends its values to the accumulator.
func flat_map_next<T, U>(values: List<T>, transform: func(T) -> List<U>, result: List<U>) -> List<U> [consume result] {
    let mapped = transform(values.head)
    let next = concat(move result, mapped)
    flat_map_into(values.rest, transform, move next)
}

/// Concatenates a list of lists into one list.
pub func flatten<T>(values: List<List<T>>) -> List<T> {
    branch {
        values.empty? -> []
        _ -> concat(values.head, flatten(values.rest))
    }
}

/// Counts the elements satisfying `predicate`.
pub func count<T>(values: List<T>, predicate: func(T) -> Bool) -> Int {
    sequence.count(values, predicate)
}

/// Returns whether no element satisfies `predicate`.
pub func none?<T>(values: List<T>, predicate: func(T) -> Bool) -> Bool {
    sequence.none?(values, predicate)
}

/// Combines a nonempty list into one value, or returns `None` for an empty list.
pub func reduce<T>(values: List<T>, combine: func(T, T) -> T) -> Option<T> {
    branch {
        values.empty? -> Option.None
        _ -> Option.Some(fold(values.rest, values.head, combine))
    }
}

/// Joins strings with `separator` between adjacent values.
pub func join(values: List<String>, separator: String) -> String {
    branch {
        values.empty? -> ""
        _ -> join_rest(values.rest, separator, values.head)
    }
}

test "list algorithms transform and aggregate values" {
    let values = map([1, 2, 3], (value: Int) -> value * 2)
    return [()][1] if values.length != 3
    return [()][1] if values[0] != 2
    return [()][1] if values[2] != 6
    return [()][1] if fold(values, 0, (total: Int, value: Int) -> total + value) != 12
    ()
}

/// Appends the remaining strings and separators to the accumulated result.
func join_rest(values: List<String>, separator: String, result: String) -> String [consume result] {
    branch {
        values.empty? -> result
        _ -> join_next(values, separator, move result)
    }
}

/// Builds the next joined accumulator value.
func join_next(values: List<String>, separator: String, result: String) -> String {
    let next = result + separator + values.head
    join_rest(values.rest, separator, move next)
}
