//! Unsigned eight-bit values and checked integer conversion.
//!
//! Use `Byte`.from when input may be outside 0..255. `Byte`.unchecked is intended
//! for values whose range has already been established; invalid input is a runtime error.
//!
//! Supports [Copy](core-copy.html#Copy): copying preserves the source and returns an independent scalar value.

import core.result

impl Byte {
    /// Explicitly copies this scalar value.
    pub func copy(self: Byte) -> self [read self] { self }

    /// Returns whether an integer fits in a byte.
    pub func valid(value: Int) -> Bool {
        value >= 0 && value <= 255
    }

    /// Constructs a byte from a value known to be in the inclusive range `0..255`.
    /// Invalid input fails at runtime; use `from` to receive a typed `ByteError`.
    pub func unchecked(value: Int) -> Byte = intrinsic("byte.unchecked")

    /// Converts an integer in the inclusive range 0 through 255 to `Byte`.
    pub func from(value: Int) -> Result<Byte, ByteError> {
        return Result.Ok(Byte.unchecked(value)) if Byte.valid(value)
        Result.Error(ByteError { value, message: "Byte must be between 0 and 255" })
    }
}

/// Describes an integer that cannot be represented by `Byte`.
pub type ByteError = {
    pub value: Int
    pub message: String
}

test "byte conversion preserves values in range" {
    let valid = branch Byte.from(255) {
        Result.Ok(value) -> value.int == 255
        Result.Error(_) -> false
    }
    assert(valid)
}
