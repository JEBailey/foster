//! Checked byte construction and integer conversion.

import core.result

/// Returns whether an integer fits in a byte.
pub func Byte.valid(value: Int) -> Bool = intrinsic("byte.valid")

/// Constructs a byte without repeating range validation.
pub func Byte.unchecked(value: Int) -> Byte = intrinsic("byte.unchecked")

/// Describes an integer that cannot be represented by `Byte`.
pub type ByteError = {
    pub value: Int
    pub message: String
}

/// Converts an integer in the inclusive range 0 through 255 to `Byte`.
pub func Byte.from(value: Int) -> Result<Byte, ByteError> {
    return Result.Ok(Byte.unchecked(value)) if Byte.valid(value)
    Result.Error(ByteError { value, message: "Byte must be between 0 and 255" })
}

/// Converts a byte to its nonnegative integer value.
pub func to_int(value: Byte) -> Int {
    value.int
}

test "byte conversion preserves values in range" {
    branch Byte.from(255) {
        Result.Ok(value) -> branch {
            to_int(value) == 255 -> ()
            _ -> [()][1]
        }
        Result.Error(_) -> [()][1]
    }
}
