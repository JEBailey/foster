//! Immutable UTF-8 text and Unicode-aware sequence operations.

import core.code_point
import core.functions
import core.list
import core.option

/// Immutable Unicode text stored as validated UTF-8 bytes.
///
/// The backing bytes are private so every `String` value preserves the UTF-8
/// validity invariant. String literals and checked decoding are its trusted
/// construction paths.
pub type String = {
    value: Bytes
}

/// Returns the first code point, or `None` when the string is empty.
pub func String.first(self: String) -> Option<CodePoint> {
    branch {
        self.empty? -> Option.None
        _ -> Option.Some(self.head)
    }
}

/// Returns the final code point, or `None` when the string is empty.
pub func String.last(self: String) -> Option<CodePoint> {
    last_code_point(self)
}

/// Finds the final code point in the remaining string.
func last_code_point(value: String) -> Option<CodePoint> [read value] {
    branch {
        value.empty? -> Option.None
        value.rest.empty? -> Option.Some(value.head)
        _ -> last_code_point(value.rest)
    }
}

/// Returns the string with its code points in reverse order.
pub func String.reverse(self: String) -> String {
    reverse_into(self, "")
}

/// Prepends remaining code points to the reversed-string accumulator.
func reverse_into(value: String, result: String) -> String [consume result] {
    branch {
        value.empty? -> result
        _ -> reverse_into(value.rest, value.head.string + result)
    }
}


/// Returns whether `value` begins with `prefix`.
pub func String.starts_with?(self: String, prefix: String) -> Bool {
    starts_with(self, prefix)
}

/// Compares the remaining value and prefix code points.
func starts_with(value: String, prefix: String) -> Bool [read value, read prefix] {
    branch {
        prefix.empty? -> true
        value.empty? -> false
        value.head != prefix.head -> false
        _ -> starts_with(value.rest, prefix.rest)
    }
}


/// Returns whether `value` ends with `suffix`.
pub func String.ends_with?(self: String, suffix: String) -> Bool {
    self.reverse().starts_with?(suffix.reverse())
}

/// Returns whether `value` contains `fragment`.
pub func String.contains?(self: String, fragment: String) -> Bool {
    contains_fragment(self, fragment)
}

/// Searches the remaining string for the fragment.
func contains_fragment(value: String, fragment: String) -> Bool [read value, read fragment] {
    branch {
        fragment.empty? -> true
        value.empty? -> false
        starts_with(value, fragment) -> true
        _ -> contains_fragment(value.rest, fragment)
    }
}

/// Consumes the string and removes leading Unicode whitespace.
pub func String.trim_start(self: String) -> String [consume self] {
    trim_start_value(move self)
}

/// Consumes leading whitespace from the remaining string.
func trim_start_value(value: String) -> String [consume value] {
    branch {
        value.empty? -> value
        value.head.whitespace? -> trim_start_value(value.rest)
        _ -> value
    }
}

/// Returns the string without trailing Unicode whitespace.
pub func String.trim_end(self: String) -> String {
    self.reverse().trim_start().reverse()
}

/// Consumes the string and removes leading and trailing Unicode whitespace.
pub func String.trim(self: String) -> String [consume self] {
    (move self).trim_start().trim_end()
}

/// Materializes the string's Unicode scalar values as a list of code points.
pub func String.code_points(self: String) -> List<CodePoint> {
    to_code_points_into(self, [])
}

/// Appends remaining string code points to the list accumulator.
func to_code_points_into(value: String, result: List<CodePoint>) -> List<CodePoint> [consume result] {
    branch {
        value.empty? -> result
        _ -> to_code_points_into(value.rest, result.append(value.head))
    }
}

/// Concatenates a sequence of code points into a string.
pub func String.from_code_points(characters: Sequence<CodePoint>) -> String {
    from_code_points(characters)
}

/// Concatenates the remaining code points into text.
func from_code_points(characters: Sequence<CodePoint>) -> String [read characters] {
    branch {
        characters.empty?() -> ""
        _ -> characters.head().string + from_code_points(characters.rest())
    }
}

/// Returns the longest leading substring whose code points satisfy `predicate`.
///
/// The predicate is evaluated from left to right and is not called after the first rejection.
pub func String.take_while(self: String, predicate: Predicate<CodePoint>) -> String {
    take_while_into(self, predicate, "")
}

/// Appends matching leading code points to the result accumulator.
func take_while_into(value: String, predicate: Predicate<CodePoint>, result: String) -> String [consume result] {
    branch {
        value.empty? -> result
        predicate(value.head) -> take_while_into(value.rest, predicate, result + value.head.string)
        _ -> result
    }
}

/// Returns whether a code point is an ASCII decimal digit.
func ascii_digit?(value: CodePoint) -> Bool {
    branch {
        value < '0' -> false
        value > '9' -> false
        _ -> true
    }
}

/// Returns the code points in the half-open range from `start` through `end`.
pub func String.slice(self: String, start: Int, end: Int) -> String {
    slice_into(self, 0, start, end, "")
}

/// Copies code points in the selected range into the string accumulator.
func slice_into(value: String, index: Int, start: Int, end: Int, result: String) -> String [consume result] {
    branch {
        value.empty? -> result
        index >= end -> result
        index >= start -> slice_into(value.rest, index + 1, start, end, result + value.head.string)
        _ -> slice_into(value.rest, index + 1, start, end, move result)
    }
}

/// Consumes and splits a string around each occurrence of `separator`.
///
/// An empty separator produces one single-code-point string per element.
pub func String.split(self: String, separator: String) -> List<String> [consume self] {
    branch {
        separator.empty? -> split_characters(self, [])
        _ -> split_into(move self, separator, "", [])
    }
}

/// Splits the remaining value into single-code-point strings.
func split_characters(value: String, result: List<String>) -> List<String> [consume result] {
    branch {
        value.empty? -> result
        _ -> split_characters(value.rest, result.append(value.head.string))
    }
}

/// Scans separator-delimited segments into the result accumulator.
func split_into(value: String, separator: String, current: String, result: List<String>) -> List<String> [consume value, consume current, consume result] {
    branch {
        value.empty? -> result.append(current)
        value.starts_with?(separator) -> split_into(drop_prefix(move value, separator.length), separator, "", result.append(current))
        _ -> split_into(value.rest, separator, current + value.head.string, move result)
    }
}

/// Consumes and removes at most `count` leading code points.
func drop_prefix(value: String, count: Int) -> String [consume value] {
    branch {
        count <= 0 -> value
        value.empty? -> value
        _ -> drop_prefix(value.rest, count - 1)
    }
}

/// Returns an ASCII-lowercase version of the string.
pub func String.lower(self: String) -> String {
    lower_into(self, "")
}

/// Appends lowercased ASCII code points to the result accumulator.
func lower_into(value: String, result: String) -> String [read value, consume result] {
    branch {
        value.empty? -> result
        _ -> lower_into(value.rest, move result + lower_character(value.head))
    }
}

/// Converts one ASCII uppercase code point to lowercase text.
func lower_character(value: CodePoint) -> String {
    branch {
        value < 'A' -> from_code_point(value).string
        value > 'Z' -> from_code_point(value).string
        _ -> from_code_point(value + 32).string
    }
}

/// Returns an ASCII-uppercase version of the string.
pub func String.upper(self: String) -> String {
    upper_into(self, "")
}

/// Appends uppercased ASCII code points to the result accumulator.
func upper_into(value: String, result: String) -> String [read value, consume result] {
    branch {
        value.empty? -> result
        _ -> upper_into(value.rest, move result + upper_character(value.head))
    }
}

/// Converts one ASCII lowercase code point to uppercase text.
func upper_character(value: CodePoint) -> String {
    branch {
        value < 'a' -> from_code_point(value).string
        value > 'z' -> from_code_point(value).string
        _ -> from_code_point(value - 32).string
    }
}

/// Returns the number of bytes required by the string's UTF-8 encoding.
pub func String.byte_length(self: String) -> Int {
    self.length
}

test "string algorithms preserve Unicode text" {
    let value = "  Foster λ  "
    assert((move value).trim() == "Foster λ")
    assert("abλ".reverse() == "λba")
    assert("Foster".starts_with?("Fos"))
    assert("123abc".take_while(ascii_digit?) == "123")
    assert("abc".take_while((_: CodePoint) -> false) == "")
    assert("λδ1".take_while((value: CodePoint) -> value > 127) == "λδ")
    assert("".take_while((_: CodePoint) -> true) == "")
    ()
}
