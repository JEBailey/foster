//! Immutable Unicode text, UTF-8 cursors, and text construction.
//!
//! String lengths and slice bounds count Unicode scalars, not bytes or grapheme
//! clusters. byte_length and StringCursor checkpoints count UTF-8 bytes. Use a
//! cursor for repeated sequential reads and StringBuilder for incremental output.
//! Case conversion uses Unicode 17.0.0 without normalization or locale tailoring.
//!
//! ```foster
//! import core.string
//! func main() -> Int {
//!     let text = "Aλ🙂"
//!     assert(text.length == 3)
//!     assert(text.byte_length() == 7)
//!     assert(text.slice(1, 2) == "λ")
//!     0
//! }
//! ```

import core.byte
import core.bytes
import core.bytes.buffer
import core.code_point
import core.functions
import core.list
import core.option
import core.result
import std.iter
import std.cursor as cursors
import core.unicode as unicode

/// Immutable Unicode text stored as validated UTF-8 bytes.
/// Private storage preserves the validity invariant across every construction path.
pub type String = {
    value: Bytes

    // Required public operations; implementations live in impl blocks.
    /// Returns an independent text value; immutable byte storage may be shared.
    pub func copy(self) -> self [read self]
    /// Creates an independent UTF-8 cursor over a stable byte snapshot.
    pub func iterator(self) -> Iterator<CodePoint> [read self]
    /// Returns the first code point, or `None` when the string is empty.
    pub func first(self) -> Option<CodePoint> [read self]
    /// Returns the final Unicode scalar, or `None` for an empty string.
    pub func last(self) -> Option<CodePoint> [read self]
    /// Returns the string with its Unicode scalar values in reverse order.
    pub func reverse(self) -> String [read self]
    /// Returns whether the text begins with `prefix`; an empty prefix always matches.
    pub func starts_with?(self, prefix: String) -> Bool [read prefix, read self]
    /// Returns whether the text ends with `suffix`; an empty suffix always matches.
    pub func ends_with?(self, suffix: String) -> Bool [read self, read suffix]
    /// Returns whether `fragment` occurs as an exact substring.
    /// An empty fragment matches. No normalization or case folding is performed.
    pub func contains?(self, fragment: String) -> Bool [read fragment, read self]
    /// Consumes the string and removes leading Unicode whitespace.
    pub func trim_start(self) -> String [consume self]
    /// Removes trailing Unicode whitespace, copying the retained range once.
    pub func trim_end(self) -> String [read self]
    /// Removes both whitespace boundaries in one Unicode scan.
    pub func trim(self) -> String [consume self]
    /// Materializes Unicode scalar values by scanning the UTF-8 bytes once.
    pub func code_points(self) -> List<CodePoint> [read self]
    /// Returns the longest prefix whose scalars satisfy `predicate`.
    /// Calls the predicate once per inspected scalar, stopping at the first false result.
    /// An empty input or a rejected first scalar returns `""`.
    pub func take_while(self, predicate: Predicate<CodePoint>) -> String [read predicate, read self]
    /// Returns the half-open range `[start, end)` measured in Unicode scalars.
    /// Bounds are clamped to the available text; reversed or empty ranges return `""`.
    /// This differs from the asserting bounds checks on `List.slice` and `Bytes.slice`.
    pub func slice(self, start: Int, end: Int) -> String [read end, read self, read start]
    /// Splits around nonoverlapping separators, preserving empty fields.
    /// An empty separator produces one string per Unicode scalar, with no extra empty fields.
    /// Empty input yields `[]` with an empty separator and `[""]` otherwise.
    pub func split(self, separator: String) -> List<String> [consume self]
    /// Returns full Unicode lowercase text, including contextual final sigma.
    pub func lower(self) -> String [read self]
    /// Returns full Unicode uppercase text, including multi-scalar expansions.
    pub func upper(self) -> String [read self]
    /// Changes ASCII letters to uppercase, preserving all other scalars.
    pub func ascii_upper(self) -> String [read self]
    /// Changes ASCII letters to lowercase, preserving all other scalars.
    pub func ascii_lower(self) -> String [read self]
    /// Returns full default Unicode case folding without normalization or locale tailoring.
    pub func case_fold(self) -> String [read self]
    /// Returns the number of bytes required by the UTF-8 encoding.
    pub func byte_length(self) -> Int [read self.value]

    // Required accessors supplied by the builtin storage implementation.
    /// Returns whether this string contains no Unicode scalars.
    pub func empty?(self) -> Bool
    /// Returns the number of Unicode scalars, not UTF-8 bytes or grapheme clusters.
    pub func length(self) -> Int
    /// Returns the first Unicode scalar; the string must not be empty.
    pub func head(self) -> CodePoint
    /// Returns the text after the first Unicode scalar.
    pub func rest(self) -> String
    /// Returns the UTF-8 bytes underlying the text.
    pub func bytes(self) -> Bytes
}

impl String {
    /// Returns an independent text value; immutable byte storage may be shared.
    pub func copy(self: String) -> self [read self] { self + "" }

    /// Validates UTF-8 in Foster and takes ownership of the immutable byte storage without decoding or copying it.
    pub func from_utf8(value: Bytes) -> Result<String, Utf8Error> [consume value] {
        branch {
            value.utf8_valid?() -> Result.Ok(String { value })
            _ -> Result.Error(Utf8Error { offset: -1, message: "Bytes are not valid UTF-8" })
        }
    }
}

/// A Foster text builder that encodes code points and appends UTF-8 without prefix concatenation.
pub type StringBuilder = {
    value: ByteBuffer

    // Required public operations; implementations live in impl blocks.
    /// Appends validated text to this builder.
    pub func append(self, text: String) -> () [reshape self.value.value.items]
    /// Encodes one Unicode scalar into UTF-8; encoding policy stays in Foster.
    pub func push(self, character: CodePoint) -> () [reshape self.value.value.items]
    /// Consumes the builder and constructs one validated immutable String.
    pub func finish(self) -> String [consume self]
}

impl StringBuilder {
    /// Creates an empty text builder.
    pub func empty() -> StringBuilder {
        StringBuilder { value: ByteBuffer.empty() }
    }

    /// Appends validated text to this builder.
    pub func append(self: StringBuilder, text: String) -> () [reshape self.value.value.items] {
        self.value.extend(text.bytes)
    }

    /// Encodes one Unicode scalar into UTF-8; encoding policy stays in Foster.
    pub func push(self: StringBuilder, character: CodePoint) -> () [reshape self.value.value.items] {
        let scalar = character.as_int()
        branch {
            scalar < 128 -> self.value.push(Byte.unchecked(scalar))
            scalar < 2048 -> {
                self.value.push(Byte.unchecked(192 + scalar / 64))
                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))
            }
            scalar < 65536 -> {
                self.value.push(Byte.unchecked(224 + scalar / 4096))
                self.value.push(Byte.unchecked(128 + scalar / 64 - scalar / 4096 * 64))
                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))
            }
            _ -> {
                self.value.push(Byte.unchecked(240 + scalar / 262144))
                self.value.push(Byte.unchecked(128 + scalar / 4096 - scalar / 262144 * 64))
                self.value.push(Byte.unchecked(128 + scalar / 64 - scalar / 4096 * 64))
                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))
            }
        }
    }

    /// Consumes the builder and constructs one validated immutable String.
    pub func finish(self: StringBuilder) -> String [consume self] {
        decode_bytes((move self.value).freeze())
    }
}

/// Decodes bytes produced by the text algorithms, retaining a checked construction boundary.
func decode_bytes(data: Bytes) -> String {
    branch String.from_utf8(move data) {
        Result.Ok(text) -> text
        Result.Error(_) -> {
            assert(false, "text construction must preserve valid UTF-8")
            ""
        }
    }
}

/// A cursor over one stable UTF-8 byte snapshot, never over copied suffix strings.
pub type StringCursor = & Cursor<CodePoint> & {
    data: Bytes
    offset: Int
}

/// Creates a byte cursor over validated text.
func cursor(text: String) -> StringCursor {
    StringCursor { data: text.bytes, offset: 0 }
}

impl String {
    /// Creates an independent UTF-8 cursor over a stable byte snapshot.
    pub func iterator(self: String) -> Iterator<CodePoint> [read self] {
        cursor(self)
    }
}

impl StringCursor {
    /// Creates an independent reader at UTF-8 byte offset zero.
    /// Preserves `text`; subsequent reads advance only the new cursor.
    pub func from(text: String) -> StringCursor { cursor(text) }
    /// Returns the current UTF-8 byte offset.
    pub func checkpoint(self: StringCursor) -> Int { self.offset }
    /// Reads the next scalar without changing the position.
    pub func peek(self: StringCursor) -> Option<CodePoint> {
        branch { self.offset >= self.data.length -> Option.None _ -> Option.Some(self.scalar()) }
    }
    /// Moves to a scalar-aligned UTF-8 byte offset in `[0, byte_length]`.
    /// Returns false for an invalid boundary or out-of-range offset without moving.
    /// Offsets do not encode source identity; use checkpoints from this snapshot.
    pub func restore(self: StringCursor, position: Int) -> Bool {
        return false if !self.boundary?(position)
        self.offset = position
        true
    }
    /// Copies scalars between two valid byte checkpoints into an item list.
    pub func span(self: StringCursor, start: Int, end: Int) -> Option<List<CodePoint>> {
        branch self.text_span(start, end) {
            Option.None -> Option.None
            Option.Some(text) -> Option.Some(text.code_points())
        }
    }
    /// Copies text between scalar-aligned byte offsets `[start, end)` without moving.
    /// Returns `None` for reversed bounds, out-of-range offsets, or split UTF-8 scalars.
    pub func text_span(self: StringCursor, start: Int, end: Int) -> Option<String> {
        return Option.None if end < start || !self.boundary?(start) || !self.boundary?(end)
        Option.Some(decode_bytes(self.data.slice(start, end)))
    }
    /// Copies the text from the current position to the end.
    pub func remaining(self: StringCursor) -> String { decode_bytes(self.data.slice(self.offset, self.data.length)) }
    /// Reports whether the reader has reached the end.
    pub func empty?(self: StringCursor) -> Bool { self.offset == self.data.length }
    /// Checks that an offset does not split a UTF-8 encoding.
    func boundary?(self: StringCursor, position: Int) -> Bool {
        return false if position < 0 || position > self.data.length
        return true if position == self.data.length
        let first = self.data[position].int
        first < 128 || first >= 192
    }
}
/// Returns the encoded width of a valid UTF-8 leading byte.
func scalar_width(first: Int) -> Int {
    branch {
        first < 128 -> 1
        first < 224 -> 2
        first < 240 -> 3
        _ -> 4
    }
}

impl StringCursor {
    /// Returns the next complete Unicode scalar, or None after exhaustion.
    pub func next(self: StringCursor) -> Option<CodePoint> {
        branch {
            self.offset >= self.data.length -> Option.None
            _ -> Option.Some(self.next_scalar())
        }
    }

    /// Reads one scalar and advances the byte offset; callers ensure the cursor is nonempty.
    func next_scalar(self: StringCursor) -> CodePoint {
        let value = self.scalar()
        self.offset = self.offset + scalar_width(self.data[self.offset].int)
        value
    }

    /// Decodes the scalar at the current nonempty position without advancing.
    func scalar(self: StringCursor) -> CodePoint {
        let first = self.data[self.offset].int
        let width = scalar_width(first)
        let scalar = branch {
            width == 1 -> first
            width == 2 -> first - 192
            width == 3 -> first - 224
            _ -> first - 240
        }
        let index = 1
        loop {
            break if index >= width
            scalar = scalar * 64 + self.data[self.offset + index].int - 128
            index = index + 1
        }
        from_code_point(scalar)
    }
}

impl String {
    /// Returns the first code point, or `None` when the string is empty.
    pub func first(self: String) -> Option<CodePoint> {
        branch {
            self.empty? -> Option.None
            _ -> Option.Some(self.head)
        }
    }

    /// Returns the final Unicode scalar, or `None` for an empty string.
    pub func last(self: String) -> Option<CodePoint> {
        let source = cursor(self)
        let last = Option.None
        loop {
            break if source.offset >= source.data.length
            last = Option.Some(source.next_scalar())
        }
        last
    }

    /// Returns the string with its Unicode scalar values in reverse order.
    pub func reverse(self: String) -> String {
        let data = self.bytes
        let output = ByteBuffer.empty()
        let end = data.length
        loop {
            break if end == 0
            let start = end - 1
            loop {
                break if start == 0 || data[start].int < 128 || data[start].int >= 192
                start = start - 1
            }
            let index = start
            loop {
                break if index >= end
                output.push(data[index])
                index = index + 1
            }
            end = start
        }
        decode_bytes((move output).freeze())
    }
}

/// Compares a candidate byte range with a complete validated UTF-8 pattern.
func matches_at(data: Bytes, pattern: Bytes, start: Int) -> Bool {
    return false if pattern.length > data.length - start
    let index = 0
    loop {
        break if index >= pattern.length
        return false if data[start + index] != pattern[index]
        index = index + 1
    }
    true
}

impl String {
    /// Returns whether the text begins with `prefix`; an empty prefix always matches.
    pub func starts_with?(self: String, prefix: String) -> Bool {
        matches_at(self.bytes, prefix.bytes, 0)
    }

    /// Returns whether the text ends with `suffix`; an empty suffix always matches.
    pub func ends_with?(self: String, suffix: String) -> Bool {
        let data = self.bytes
        let pattern = suffix.bytes
        return false if pattern.length > data.length
        matches_at(data, pattern, data.length - pattern.length)
    }

    /// Returns whether `fragment` occurs as an exact substring.
    /// An empty fragment matches. No normalization or case folding is performed.
    pub func contains?(self: String, fragment: String) -> Bool {
        let data = self.bytes
        let pattern = fragment.bytes
        return true if pattern.empty?
        let index = 0
        loop {
            break if pattern.length > data.length - index
            return true if matches_at(data, pattern, index)
            index = index + 1
        }
        false
    }

    /// Consumes the string and removes leading Unicode whitespace.
    pub func trim_start(self: String) -> String [consume self] {
        let source = cursor(self)
        let start = 0
        loop {
            break if source.offset >= source.data.length
            break if !source.next_scalar().whitespace?
            start = source.offset
        }
        decode_bytes(source.data.slice(start, source.data.length))
    }

    /// Removes trailing Unicode whitespace, copying the retained range once.
    pub func trim_end(self: String) -> String {
        let source = cursor(self)
        let end = 0
        loop {
            break if source.offset >= source.data.length
            branch {
                !source.next_scalar().whitespace? -> {
                    end = source.offset
                    ()
                }
                _ -> ()
            }
        }
        decode_bytes(source.data.slice(0, end))
    }

    /// Removes both whitespace boundaries in one Unicode scan.
    pub func trim(self: String) -> String [consume self] {
        let source = cursor(self)
        let start = 0
        let end = 0
        let leading = true
        loop {
            break if source.offset >= source.data.length
            let whitespace = source.next_scalar().whitespace?
            branch {
                leading && whitespace -> {
                    start = source.offset
                    ()
                }
                !whitespace -> {
                    leading = false
                    end = source.offset
                    ()
                }
                _ -> ()
            }
        }
        return "" if leading
        decode_bytes(source.data.slice(start, end))
    }

    /// Materializes Unicode scalar values by scanning the UTF-8 bytes once.
    pub func code_points(self: String) -> List<CodePoint> {
        let source = cursor(self)
        let output = []
        loop {
            break if source.offset >= source.data.length
            output.push(source.next_scalar())
        }
        output
    }

    /// Concatenates a sequence of Unicode scalar values using one UTF-8 builder.
    pub func from_code_points(characters: List<CodePoint>) -> String {
        let output = StringBuilder.empty()
        let index = 0
        loop {
            break if index >= characters.length
            output.push(characters[index])
            index = index + 1
        }
        (move output).finish()
    }

    /// Concatenates a general head/rest sequence without recursive calls or prefix concatenation.
    pub func from_code_points(characters: Sequence<CodePoint>) -> String {
        let remaining = characters
        let output = StringBuilder.empty()
        loop {
            break if remaining.empty?()
            output.push(remaining.head())
            remaining = remaining.rest()
        }
        (move output).finish()
    }

    /// Returns the longest prefix whose scalars satisfy `predicate`.
    /// Calls the predicate once per inspected scalar, stopping at the first false result.
    /// An empty input or a rejected first scalar returns `""`.
    pub func take_while(self: String, predicate: Predicate<CodePoint>) -> String {
        let source = cursor(self)
        let end = 0
        loop {
            break if source.offset >= source.data.length
            break if !predicate(source.next_scalar())
            end = source.offset
        }
        decode_bytes(source.data.slice(0, end))
    }

    /// Returns the half-open range `[start, end)` measured in Unicode scalars.
    /// Bounds are clamped to the available text; reversed or empty ranges return `""`.
    /// This differs from the asserting bounds checks on `List.slice` and `Bytes.slice`.
    pub func slice(self: String, start: Int, end: Int) -> String {
        return "" if end <= 0 || end <= start
        let source = cursor(self)
        let index = 0
        let first = 0
        loop {
            break if source.offset >= source.data.length || index >= end
            source.next_scalar()
            index = index + 1
            branch {
                index <= start -> {
                    first = source.offset
                    ()
                }
                _ -> ()
            }
        }
        decode_bytes(source.data.slice(first, source.offset))
    }

    /// Splits around nonoverlapping separators, preserving empty fields.
    /// An empty separator produces one string per Unicode scalar, with no extra empty fields.
    /// Empty input yields `[]` with an empty separator and `[""]` otherwise.
    pub func split(self: String, separator: String) -> List<String> [consume self] {
        let data = self.bytes
        let pattern = separator.bytes
        let output = []
        let start = 0
        let index = 0
        loop {
            break if index >= data.length
            branch {
                pattern.empty? -> {
                    let end = index + scalar_width(data[index].int)
                    output.push(decode_bytes(data.slice(index, end)))
                    index = end
                    ()
                }
                matches_at(data, pattern, index) -> {
                    output.push(decode_bytes(data.slice(start, index)))
                    index = index + pattern.length
                    start = index
                    ()
                }
                _ -> {
                    index = index + 1
                    ()
                }
            }
        }
        branch {
            !pattern.empty? -> output.push(decode_bytes(data.slice(start, data.length)))
            _ -> ()
        }
        output
    }

    /// Returns full Unicode lowercase text, including contextual final sigma.
    pub func lower(self: String) -> String {
        unicode::change_case(self, 0)
    }

    /// Returns full default Unicode case folding without normalization or locale tailoring.
    pub func case_fold(self: String) -> String { unicode::change_case(self, 2) }

    /// Changes ASCII letters to lowercase, preserving all other scalars.
    pub func ascii_lower(self: String) -> String { ascii_case(self, true) }

    /// Changes ASCII letters to uppercase, preserving all other scalars.
    pub func ascii_upper(self: String) -> String { ascii_case(self, false) }

    /// Returns full Unicode uppercase text, including multi-scalar expansions.
    pub func upper(self: String) -> String {
        unicode::change_case(self, 1)
    }
}

/// Changes ASCII letters in one byte scan; multibyte UTF-8 scalars are copied unchanged.
func ascii_case(text: String, lower: Bool) -> String {
    let data = text.bytes
    let output = ByteBuffer.empty()
    let index = 0
    loop {
        break if index >= data.length
        let current = data[index].int
        let changed = branch {
            lower && current >= 65 && current <= 90 -> current + 32
            !lower && current >= 97 && current <= 122 -> current - 32
            _ -> current
        }
        output.push(Byte.unchecked(changed))
        index = index + 1
    }
    decode_bytes((move output).freeze())
}

impl String {
    /// Returns the number of bytes required by the UTF-8 encoding.
    pub func byte_length(self: String) -> Int {
        self.value.length
    }
}

/// Returns whether a code point is an ASCII decimal digit.
func ascii_digit?(value: CodePoint) -> Bool {
    value >= '0' && value <= '9'
}

test "string algorithms preserve Unicode text" {
    assert("  Foster λ  ".trim() == "Foster λ")
    assert("abλ🙂".reverse() == "🙂λba")
    assert("Foster".starts_with?("Fos"))
    assert("aλ🙂".ends_with?("λ🙂"))
    assert("aλ🙂".contains?("λ"))
    assert("123abc".take_while(ascii_digit?) == "123")
    assert("abc".take_while((_: CodePoint) -> false) == "")
    assert("λδ1".take_while((value: CodePoint) -> value > 127) == "λδ")
    assert("".take_while((_: CodePoint) -> true) == "")
    assert("aλ🙂z".slice(1, 3) == "λ🙂")
    assert("aλ".slice(-9, 1) == "a")
    assert("aλ".slice(9, 99) == "")
    assert("aλ".slice(2, 1) == "")
    assert("λ,,🙂,".split(",") == ["λ", "", "🙂", ""])
    assert("λ🙂".split("") == ["λ", "🙂"])
    assert("".split("") == [])
    assert("".split(",") == [""])
    assert("AZλ🙂".lower() == "azλ🙂")
    assert("azλ🙂".upper() == "AZΛ🙂")
    ()
}

test "text builders encode every UTF-8 width" {
    let output = StringBuilder.empty()
    output.append("start:")
    output.push('a')
    output.push('λ')
    output.push('€')
    output.push('🙂')
    assert((move output).finish() == "start:aλ€🙂")
}
