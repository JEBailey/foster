//! Checkpointable readers over stable collection snapshots.
import core.option
import core.result
import core.list
import core.bytes
import core.byte
import std.iter

/// A reader whose checkpoints are offsets in its source (bytes for UTF-8 text).
/// Checkpoints must come from the same source snapshot. Invalid offsets are rejected.
pub type Cursor<T> = & Iterator<T> & {
    /// Reads the current item without advancing.
    pub func peek(self) -> Option<T> [read self]
    /// Returns the current source offset.
    pub func checkpoint(self) -> Int [read self]
    /// Restores a valid source offset, leaving the position unchanged on failure.
    pub func restore(self, position: Int) -> Bool [mut self]
    /// Copies a valid half-open source region, or returns None for invalid bounds.
    pub func span(self, start: Int, end: Int) -> Option<List<T>> [read self]
}

/// A checkpointable list snapshot; reading elements requires their Copy capability.
pub type ListCursor<T> = & Cursor<T> & {
    values: List<T>
    offset: Int
}

impl ListCursor {
    /// Takes ownership of a stable list snapshot.
    pub func from<T>(values: List<T>) -> ListCursor<T> [consume values] {
        ListCursor { values: move values, offset: 0 }
    }
    /// Reads the current element without advancing.
    pub func peek<T>(self: ListCursor<T>) -> Option<T> {
        branch {
            self.offset >= self.values.length -> Option.None
            _ -> branch self.values.at(self.offset) { Result.Ok(value) -> Option.Some(value) Result.Error(_) -> { assert(false, "cursor elements must support Copy")
                Option.None } }
        }
    }
    /// Reads one element and advances, remaining exhausted at the end.
    pub func next<T>(self: ListCursor<T>) -> Option<T> {
        let value = self.peek()
        branch { self.offset < self.values.length -> { self.offset = self.offset + 1 } _ -> () }
        value
    }
    /// Returns the current element offset.
    pub func checkpoint<T>(self: ListCursor<T>) -> Int { self.offset }
    /// Restores an in-bounds element offset.
    pub func restore<T>(self: ListCursor<T>, position: Int) -> Bool {
        return false if position < 0 || position > self.values.length
        self.offset = position
        true
    }
    /// Copies a valid element range.
    pub func span<T>(self: ListCursor<T>, start: Int, end: Int) -> Option<List<T>> {
        return Option.None if start < 0 || end < start || end > self.values.length
        Option.Some(self.values.slice(start, end))
    }
}

/// A checkpointable immutable byte snapshot.
pub type BytesCursor = & Cursor<Byte> & {
    data: Bytes
    offset: Int
}
impl BytesCursor {
    /// Takes ownership of a byte snapshot.
    pub func from(data: Bytes) -> BytesCursor [consume data] { BytesCursor { data: move data, offset: 0 } }
    /// Reads the current byte without advancing.
    pub func peek(self: BytesCursor) -> Option<Byte> {
        branch { self.offset >= self.data.length -> Option.None
            _ -> Option.Some(self.data[self.offset]) }
    }
    /// Reads one byte and advances.
    pub func next(self: BytesCursor) -> Option<Byte> {
        let value = self.peek()
        branch { self.offset < self.data.length -> { self.offset = self.offset + 1 } _ -> () }
        value
    }
    /// Returns the byte offset.
    pub func checkpoint(self: BytesCursor) -> Int { self.offset }
    /// Restores an in-bounds byte offset.
    pub func restore(self: BytesCursor, position: Int) -> Bool {
        return false if position < 0 || position > self.data.length
        self.offset = position
        true
    }
    /// Copies the bytes in a valid range into an item list.
    pub func span(self: BytesCursor, start: Int, end: Int) -> Option<List<Byte>> {
        return Option.None if start < 0 || end < start || end > self.data.length
        let values = []
        let index = start
        loop {
            break if index >= end
            values.push(self.data[index])
            index = index + 1
        }
        Option.Some(values)
    }
    /// Copies a valid byte range.
    pub func byte_span(self: BytesCursor, start: Int, end: Int) -> Option<Bytes> {
        return Option.None if start < 0 || end < start || end > self.data.length
        Option.Some(self.data.slice(start, end))
    }
}
