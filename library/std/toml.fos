//! TOML 1.1 parsing, typed documents, lookup, and rendering.
//!
//! `parse` returns a typed document or the first positioned error. Tables and array values
//! can be inspected without converting to untyped host objects. Rendering emits
//! TOML from the value model; it is not a source-preserving editor for comments
//! and original formatting.

import core.copy

import core.code_point
import core.float
import core.int
import core.list
import core.option
import core.result
import core.string

/// A complete TOML document whose root is a table.
pub type TomlDocument = {
    pub entries: List<TomlEntry>

    // Required public operations; implementations live in impl blocks.
    /// Consumes the document and renders entries in stored order, using inline tables.
    /// Returns an error for duplicate keys or invalid `DateTime` text; comments and formatting are not retained.
    pub func render(self) -> Result<String, TomlError> [consume self]
    /// Consumes the document and `key`, returning the first exact top-level match.
    /// Returns `None` when absent; dots in `key` are literal, not path separators.
    pub func get(self, key: String) -> Option<TomlValue> [consume key, consume self]
}

/// A key-value entry in a TOML table.
pub type TomlEntry = & Copy & {
    pub key: String
    pub value: TomlValue
}

/// A scalar, date-time, list, or table value in the TOML data model.
///
/// Date, time, and date-time values retain their validated TOML text in the
/// `DateTime` case so parsing does not depend on a platform clock library.
/// A separating space becomes `T`; other accepted spellings are retained.
pub enum TomlValue = String(String)
    | Int(Int)
    | Float(Float)
    | Bool(Bool)
    | DateTime(String)
    | Array(List<TomlValue>)
    | Table(List<TomlEntry>)
    & Copy
    & {
        // Required public operations; implementations live in impl blocks.
        /// Consumes `self` and `key`, returning the first exact entry when `self` is a table.
        /// Returns `None` for a missing key or a non-table value; dots in `key` are literal.
        pub func get(self, key: String) -> Option<TomlValue> [consume key, consume self]
    }

/// A TOML parsing or rendering failure.
///
/// `line` and `column` are one-based; columns count Unicode scalars.
/// Rendering errors use zero for both fields because values have no source positions.
pub type TomlError = {
    pub message: String
    pub line: Int
    pub column: Int
}

enum PathPart = Key(String)
    | ArrayItem(String, Int)

enum FlatValue = Value(TomlValue)
    | TableMarker
    | ArrayTableMarker

type FlatEntry = {
    path: List<PathPart>
    value: FlatValue
}

// Parsing has two phases: collect flat paths and declaration markers, then
// materialize the public tree only if no diagnostic was recorded. Array indexes
// distinguish repeated table headers, including their nested child tables.
// `remaining` starts at the next scalar; line and column are one-based. Columns
// count scalars, not grapheme clusters or UTF-8 bytes. Newline helpers reset them.
// Errors are sticky: only the first is retained. Error helpers may return partial
// or placeholder values so callers can unwind; parse_document discards those values.
type Parser = {
    remaining: String
    line: Int
    column: Int
    entries: List<FlatEntry>
    context: List<PathPart>
    errors: List<TomlError>
}

impl PathPart {
    /// Copies a path component while preserving the original path.
    func copy(self) -> self {
        branch self {
            PathPart.Key(key) -> PathPart.Key(key.copy())
            PathPart.ArrayItem(key, index) -> PathPart.ArrayItem(key.copy(), index)
        }
    }
}

impl TomlEntry {
    /// Copies this entry and its complete TOML value.
    pub func copy(self) -> self {
        TomlEntry {
            key: self.key.copy(), value: self.value.copy()
        }
    }
}

impl TomlValue {
    /// Copies the complete TOML tree without consuming the source.
    pub func copy(self) -> self {
        branch self {
            TomlValue.String(value) -> TomlValue.String(value.copy())
            TomlValue.Int(value) -> TomlValue.Int(value)
            TomlValue.Float(value) -> TomlValue.Float(value)
            TomlValue.Bool(value) -> TomlValue.Bool(value)
            TomlValue.DateTime(value) -> TomlValue.DateTime(value.copy())
            TomlValue.Array(values) -> TomlValue.Array(values.map((value: TomlValue) -> value.copy()))
            TomlValue.Table(entries) -> TomlValue.Table(entries.map((entry: TomlEntry) -> entry.copy()))
        }
    }

    /// Consumes `self` and `key`, returning the first exact entry when `self` is a table.
    /// Returns `None` for a missing key or a non-table value; dots in `key` are literal.
    pub func get(self, key: String) -> Option<TomlValue> [consume key, consume self] {
        branch self {
            TomlValue.Table(entries) -> find_entry(move entries, move key)
            _ -> Option.None
        }
    }
}

/// Parses source text, returning the document or the first positioned error.
/// Lines and Unicode-scalar columns are one-based; CRLF counts as one line break.
pub func parse(source: String) -> Result<TomlDocument, TomlError> {
    let parser = Parser {
        remaining: move source,
        line: 1,
        column: 1,
        entries: [],
        context: [],
        errors: []
    }
    parser.parse_document()
}

impl TomlDocument {
    /// Consumes the document and renders entries in stored order, using inline tables.
    /// Returns an error for duplicate keys or invalid `DateTime` text; comments and formatting are not retained.
    pub func render(self) -> Result<String, TomlError> [consume self] {
        render_entries(move self.entries, "")
    }

    /// Consumes the document and `key`, returning the first exact top-level match.
    /// Returns `None` when absent; dots in `key` are literal, not path separators.
    pub func get(self, key: String) -> Option<TomlValue> [consume key, consume self] {
        find_entry(move self.entries, move key)
    }
}

/// Returns the first exact key match; dotted keys are not interpreted as paths.
func find_entry(entries: List<TomlEntry>, key: String) -> Option<TomlValue> {
    branch {
        entries.empty? -> Option.None
        entries.head.key == key -> Option.Some(entries.head.value)
        _ -> find_entry(entries.rest, key)
    }
}

impl Parser {
    /// Stops at the first recorded error; materializes the flat paths only on success.
    func parse_document(self) -> Result<TomlDocument, TomlError> [mut self] {
        self.skip_document_space()
        self.parse_statements()
        branch {
            not self.errors.empty? -> Result.Error(self.errors.head)
            _ -> Result.Ok(TomlDocument {
                entries: materialize(self.entries, [])
            })
        }
    }

    /// Reads assignments and table headers until input ends or an error is recorded.
    func parse_statements(self) -> () [mut self] {
        while !self.failed?() && !self.remaining.empty? {
            branch {
                self.remaining.starts_with?("[[") -> self.parse_header(true)
                self.remaining.starts_with?("[") -> self.parse_header(false)
                _ -> self.parse_key_value()
            }
            self.finish_statement()
            self.skip_document_space()
        }
    }

    /// Resolves a dotted assignment relative to the active table context.
    func parse_key_value(self) -> () [mut self] {
        let keys = self.parse_key_path()
        self.skip_horizontal_space()
        return self.fail("expected `=` after key") if not self.peek?('=')
        self.take()
        self.skip_horizontal_space()
        let value = self.parse_value()
        return () if self.failed?()
        let path = [].concat(self.context)
        self.insert_value((move path).concat(key_parts(move keys)), move value)
    }

    /// Reads a table header and changes the context used by subsequent assignments.
    func parse_header(self, array_header: Bool) -> () [mut self] {
        self.take()
        self.take_array_header_open(array_header)
        self.skip_horizontal_space()
        let keys = self.parse_key_path()
        self.skip_horizontal_space()
        return self.close_array_header(move keys) if array_header
        return self.fail("expected `]` after table header") if not self.peek?(']')
        self.take()
        self.declare_table(move keys)
    }

    /// Consumes the second opening bracket only for an array-of-tables header.
    func take_array_header_open(self, array_header: Bool) -> () [mut self(remaining, column)] {
        return () if not array_header
        self.take()
        ()
    }

    /// Requires both closing brackets before declaring the next array table.
    func close_array_header(self, keys: List<String>) -> () [consume self.errors, read self.line, mut self(errors, remaining, column), consume self.entries, mut self(entries, context), consume keys] {
        return self.fail("expected `]]` after array-of-tables header") if not self.remaining.starts_with?("]]" )
        self.take()
        self.take()
        self.declare_array_table(move keys)
    }

    /// Accepts only horizontal space, a comment, and a newline or EOF after a statement.
    func finish_statement(self) -> () [mut self] {
        return () if self.failed?()
        self.skip_horizontal_space()
        self.skip_comment()
        branch {
            self.remaining.empty? -> ()
            self.newline?() -> self.take_newline()
            _ -> self.fail("expected a newline or comment after statement")
        }
    }

    /// Skips blank lines and comments while maintaining diagnostic positions.
    func skip_document_space(self) -> () [mut self] {
        while !self.failed?() {
            self.skip_horizontal_space()
            self.skip_comment()
            break if not self.newline?()
            self.take_newline()
        }
    }

    /// Consumes spaces and tabs without crossing a line boundary.
    func skip_horizontal_space(self) -> () [mut self] {
        let prefix = self.remaining.scalar_take_while((character: CodePoint) -> character == ' ' || character == '\t')
        self.consume_text(prefix)
    }

    /// Consumes a comment when present, leaving its newline for the caller.
    func skip_comment(self) -> () [mut self] {
        return () if not self.peek?('#')
        self.take()
        self.skip_comment_text()
    }

    /// Stops before the newline and rejects control characters other than tabs.
    func skip_comment_text(self) -> () [mut self] {
        return () if self.remaining.empty?
        return () if self.newline?()
        return self.fail("control character is not allowed in a comment") if control_character?(self.remaining.scalar_head())
        self.take()
        self.skip_comment_text()
    }

    /// Recognizes LF and CRLF; a bare carriage return is not a newline.
    func newline?(self) -> Bool {
        self.remaining.starts_with?("\n") || self.remaining.starts_with?("\r\n")
    }

    /// Consumes LF or CRLF as one line break; records an error for other input.
    func take_newline(self) -> () [mut self(remaining, line, column), consume self.errors, mut self.errors] {
        return self.take_crlf() if self.remaining.starts_with?("\r\n")
        return self.take_lf() if self.remaining.starts_with?("\n")
        self.fail("expected a newline")
    }

    /// Consumes a known CRLF pair and resets the one-based column.
    func take_crlf(self) -> () [mut self(remaining, line, column)] {
        self.remaining = self.remaining.scalar_rest().scalar_rest()
        self.line = self.line + 1
        self.column = 1
        ()
    }

    /// Consumes a known LF and resets the one-based column.
    func take_lf(self) -> () [mut self(remaining, line, column)] {
        self.remaining = self.remaining.scalar_rest()
        self.line = self.line + 1
        self.column = 1
        ()
    }

    /// Compares the next Unicode scalar without advancing; EOF never matches.
    func peek?(self, expected: CodePoint) -> Bool {
        branch {
            self.remaining.empty? -> false
            _ -> self.remaining.scalar_head() == expected
        }
    }

    /// Consumes one scalar and increments the column; requires nonempty input. Newlines use `take_newline`.
    func take(self) -> CodePoint [mut self(remaining, column)] {
        let character = self.remaining.scalar_head()
        self.remaining = self.remaining.scalar_rest()
        self.column = self.column + 1
        character
    }

    /// Reports whether a diagnostic has already been recorded.
    func failed?(self) -> Bool {
        not self.errors.empty?
    }

    /// Records only the first error at the current scalar position.
    func fail(self, message: String) -> () [consume self.errors, read self(line, column), mut self.errors, consume message] {
        return () if self.failed?()
        self.errors = self.errors.append(TomlError {
            message: move message,
            line: self.line,
            column: self.column
        })
        ()
    }

    /// Records only the first error at a saved position, such as an opening delimiter.
    func fail_at(self, message: String, line: Int, column: Int) -> () [consume self.errors, mut self.errors, consume message] {
        return () if self.failed?()
        self.errors = self.errors.append(TomlError {
            message: move message,
            line,
            column
        })
        ()
    }

    /// Reads a dotted key as separate components, preserving quoted components.
    func parse_key_path(self) -> List<String> [mut self] {
        let first = self.parse_key()
        return [] if self.failed?()
        self.parse_key_tail([first])
    }

    /// Accepts whitespace around dots and extends the parsed key path.
    func parse_key_tail(self, keys: List<String>) -> List<String> [mut self, consume keys] {
        self.skip_horizontal_space()
        return keys if not self.peek?('.')
        self.take()
        self.skip_horizontal_space()
        let key = self.parse_key()
        self.parse_key_tail(keys.append(move key))
    }

    /// Selects quoted or bare key syntax; quoted dots remain part of the key.
    func parse_key(self) -> String [mut self] {
        branch {
            self.remaining.starts_with?("\"") -> self.parse_basic_string(false)
            self.remaining.starts_with?("'") -> self.parse_literal_string(false)
            _ -> self.parse_bare_key()
        }
    }

    /// Consumes ASCII letters, digits, underscores, and hyphens; rejects an empty key.
    func parse_bare_key(self) -> String [mut self] {
        let output = self.remaining.scalar_take_while(bare_key_character?)
        self.consume_text(output)
        self.finish_bare_key(move output)
    }

    /// Returns the scanned key after recording an error if it is empty.
    func finish_bare_key(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail_empty_key(output.empty?)
        output
    }

    /// Records a missing-key error only when the bare-key scan produced no text.
    func fail_empty_key(self, empty: Bool) -> () [consume self.errors, read self(line, column), mut self.errors] {
        return () if not empty
        self.fail("expected a key")
    }

    /// Reads a double-quoted string, interpreting escapes and multiline folding.
    func parse_basic_string(self, multiline: Bool) -> String [mut self] {
        self.open_basic_string(multiline)
        self.parse_basic_characters("", multiline)
    }

    /// Consumes the known single or multiline basic-string opener.
    func open_basic_string(self, multiline: Bool) -> () [mut self] {
        return self.open_multiline_basic() if multiline
        self.take()
        ()
    }

    /// Consumes the known triple-quote opener and discards one initial newline.
    func open_multiline_basic(self) -> () [mut self] {
        self.consume_text("\"\"\"")
        self.trim_multiline_first_newline()
    }

    /// Accumulates decoded text until a closing delimiter or a string error.
    func parse_basic_characters(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        return self.unterminated_basic(move output) if self.remaining.empty?
        return self.close_multiline_basic(move output) if multiline && self.remaining.starts_with?("\"\"\"")
        return self.close_basic(move output) if not multiline && self.peek?('\"')
        return self.start_escape(move output, multiline) if self.peek?('\\')
        return self.basic_newline(move output, multiline) if self.newline?()
        return self.forbidden_basic(move output) if forbidden_string_character?(self.remaining.scalar_head())
        let character = self.take()
        self.parse_basic_characters(output + character.string, multiline)
    }

    /// Records a missing closing quote and returns the partial text for error unwinding.
    func unterminated_basic(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("unterminated basic string")
        output
    }

    /// Consumes the terminator; a fourth or fifth quote contributes literal text.
    func close_multiline_basic(self, output: String) -> String [mut self, consume output] {
        self.consume_text("\"\"\"")
        self.take_extra_quotes(move output, 0)
    }

    /// Consumes the known closing quote and returns decoded text.
    func close_basic(self, output: String) -> String [mut self(remaining, column), consume output] {
        self.take()
        output
    }

    /// Consumes the backslash before dispatching the escape that follows.
    func start_escape(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        self.take()
        self.parse_escape(move output, multiline)
    }

    /// Normalizes LF or CRLF to LF in multiline strings; rejects single-line newlines.
    func basic_newline(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        return self.invalid_basic_newline(move output) if not multiline
        self.take_newline()
        self.parse_basic_characters(output + "\n", true)
    }

    /// Records a forbidden single-line newline and returns partial text for error unwinding.
    func invalid_basic_newline(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("newline is not allowed in a basic string")
        output
    }

    /// Records an unescaped control scalar and returns partial text for error unwinding.
    func forbidden_basic(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("control character is not allowed in a string")
        output
    }

    /// Decodes an escape after its backslash has been consumed.
    func parse_escape(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        branch {
            multiline && self.escape_fold_start?() -> self.fold_escape(move output)
            self.remaining.empty? -> self.unterminated_escape(move output)
            self.peek?('b') -> self.escaped_code_point(move output, 8, multiline)
            self.peek?('t') -> self.escaped_character(move output, "\t", multiline)
            self.peek?('n') -> self.escaped_character(move output, "\n", multiline)
            self.peek?('f') -> self.escaped_code_point(move output, 12, multiline)
            self.peek?('r') -> self.escaped_character(move output, "\r", multiline)
            self.peek?('e') -> self.escaped_code_point(move output, 27, multiline)
            self.peek?('\"') -> self.escaped_character(move output, "\"", multiline)
            self.peek?('\\') -> self.escaped_character(move output, "\\", multiline)
            self.peek?('x') -> self.parse_unicode_escape(move output, 2, multiline)
            self.peek?('u') -> self.parse_unicode_escape(move output, 4, multiline)
            self.peek?('U') -> self.parse_unicode_escape(move output, 8, multiline)
            _ -> self.invalid_escape(move output)
        }
    }

    /// Discards a multiline continuation and resumes without adding whitespace.
    func fold_escape(self, output: String) -> String [mut self, consume output] {
        self.skip_escape_fold()
        self.parse_basic_characters(move output, true)
    }

    /// Records EOF after a backslash and returns partial text for error unwinding.
    func unterminated_escape(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("unterminated escape sequence")
        output
    }

    /// Records an unknown escape and returns partial text for error unwinding.
    func invalid_escape(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("invalid basic-string escape sequence")
        output
    }

    /// Consumes the escape letter and appends its decoded text before resuming.
    func escaped_character(self, output: String, escaped: String, multiline: Bool) -> String [mut self, consume output] {
        self.take()
        self.parse_basic_characters(output + escaped, multiline)
    }

    /// Consumes the escape letter and appends its known-valid scalar before resuming.
    func escaped_code_point(self, output: String, value: Int, multiline: Bool) -> String [mut self, consume output] {
        self.take()
        self.parse_basic_characters(output + from_code_point(value).string, multiline)
    }

    /// Reads the selected escape width and rejects values outside the Unicode scalar range.
    func parse_unicode_escape(self, output: String, digits: Int, multiline: Bool) -> String [mut self, consume output] {
        self.take()
        let value = self.take_hex_digits(digits, 0)
        branch CodePoint.from(value) {
            Option.Some(character) -> self.parse_basic_characters(output + character.string, multiline)
            Option.None -> self.invalid_unicode_escape(move output)
        }
    }

    /// Records a non-scalar escape value and returns partial text for error unwinding.
    func invalid_unicode_escape(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("escape does not name a Unicode scalar value")
        output
    }

    /// Accumulates exactly `remaining` hexadecimal digits or records the first malformed digit.
    func take_hex_digits(self, remaining: Int, value: Int) -> Int [mut self] {
        return value if remaining == 0
        return self.incomplete_hex(value) if self.remaining.empty?
        return self.invalid_hex(value) if not hex_digit?(self.remaining.scalar_head())
        let digit = hex_value(self.take())
        self.take_hex_digits(remaining - 1, value * 16 + digit)
    }

    /// Records EOF within an escape and returns the partial numeric accumulator.
    func incomplete_hex(self, value: Int) -> Int [consume self.errors, read self(line, column), mut self.errors] {
        self.fail("incomplete hexadecimal escape")
        value
    }

    /// Records a non-hexadecimal escape digit and returns the partial accumulator.
    func invalid_hex(self, value: Int) -> Int [consume self.errors, read self(line, column), mut self.errors] {
        self.fail("expected a hexadecimal digit in escape")
        value
    }

    /// Checks whether spaces or tabs lead to a newline after an escape backslash.
    func escape_fold_start?(self) -> Bool {
        fold_space_then_newline?(self.remaining)
    }

    /// Consumes the continuation newline and all following multiline whitespace.
    func skip_escape_fold(self) -> () [mut self] {
        self.skip_horizontal_space()
        self.take_newline()
        self.skip_multiline_whitespace()
    }

    /// Skips spaces, tabs, LF, and CRLF while updating line and column.
    func skip_multiline_whitespace(self) -> () [mut self] {
        return self.skip_one_multiline_space() if self.peek?(' ') || self.peek?('\t')
        return self.skip_one_multiline_newline() if self.newline?()
        ()
    }

    /// Consumes one known space or tab before continuing whitespace folding.
    func skip_one_multiline_space(self) -> () [mut self] {
        self.take()
        self.skip_multiline_whitespace()
    }

    /// Updates line state for one newline before continuing whitespace folding.
    func skip_one_multiline_newline(self) -> () [mut self] {
        self.take_newline()
        self.skip_multiline_whitespace()
    }

    /// Reads single-quoted text without interpreting backslash escapes.
    func parse_literal_string(self, multiline: Bool) -> String [mut self] {
        self.open_literal_string(multiline)
        self.parse_literal_characters("", multiline)
    }

    /// Consumes the known single or multiline literal-string opener.
    func open_literal_string(self, multiline: Bool) -> () [mut self] {
        return self.open_multiline_literal() if multiline
        self.take()
        ()
    }

    /// Consumes the known triple-apostrophe opener and discards one initial newline.
    func open_multiline_literal(self) -> () [mut self] {
        self.consume_text("'''")
        self.trim_multiline_first_newline()
    }

    /// Accumulates literal scalars until the matching delimiter or a string error.
    func parse_literal_characters(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        return self.unterminated_literal(move output) if self.remaining.empty?
        return self.close_multiline_literal(move output) if multiline && self.remaining.starts_with?("'''")
        return self.close_literal(move output) if not multiline && self.peek?('\'')
        return self.literal_newline(move output, multiline) if self.newline?()
        return self.forbidden_literal(move output) if forbidden_string_character?(self.remaining.scalar_head())
        let character = self.take()
        self.parse_literal_characters(output + character.string, multiline)
    }

    /// Records a missing closing apostrophe and returns partial text for error unwinding.
    func unterminated_literal(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("unterminated literal string")
        output
    }

    /// Consumes the terminator; a fourth or fifth apostrophe contributes literal text.
    func close_multiline_literal(self, output: String) -> String [mut self, consume output] {
        self.consume_text("'''")
        self.take_extra_apostrophes(move output, 0)
    }

    /// Consumes the known closing apostrophe and returns the literal text.
    func close_literal(self, output: String) -> String [mut self(remaining, column), consume output] {
        self.take()
        output
    }

    /// Normalizes multiline line breaks to LF; rejects them in single-line literals.
    func literal_newline(self, output: String, multiline: Bool) -> String [mut self, consume output] {
        return self.invalid_literal_newline(move output) if not multiline
        self.take_newline()
        self.parse_literal_characters(output + "\n", true)
    }

    /// Records a forbidden single-line newline and returns partial text for error unwinding.
    func invalid_literal_newline(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("newline is not allowed in a literal string")
        output
    }

    /// Records a forbidden control scalar and returns partial text for error unwinding.
    func forbidden_literal(self, output: String) -> String [consume self.errors, read self(line, column), mut self.errors, consume output] {
        self.fail("control character is not allowed in a string")
        output
    }

    /// Includes at most two quotes beyond a multiline closing delimiter in the value.
    func take_extra_quotes(self, output: String, count: Int) -> String [mut self, consume output] {
        return output if count >= 2 || not self.peek?('\"')
        self.take()
        self.take_extra_quotes(output + "\"", count + 1)
    }

    /// Includes at most two apostrophes beyond a multiline closing delimiter in the value.
    func take_extra_apostrophes(self, output: String, count: Int) -> String [mut self, consume output] {
        return output if count >= 2 || not self.peek?('\'')
        self.take()
        self.take_extra_apostrophes(output + "'", count + 1)
    }

    /// Drops one optional newline immediately after a multiline opener.
    func trim_multiline_first_newline(self) -> () [mut self(remaining, line, column), consume self.errors, mut self.errors] {
        return () if not self.newline?()
        self.take_newline()
    }

    /// Advances by the scalar length of a known newline-free prefix; does not compare its contents.
    func consume_text(self, text: String) -> () [mut self] {
        return () if text.empty?
        self.take()
        self.consume_text(text.scalar_rest())
    }

    /// Dispatches on delimiters before scanning an unquoted scalar token.
    func parse_value(self) -> TomlValue [mut self] {
        branch {
            self.remaining.starts_with?("\"\"\"") -> TomlValue.String(self.parse_basic_string(true))
            self.remaining.starts_with?("'''") -> TomlValue.String(self.parse_literal_string(true))
            self.remaining.starts_with?("\"") -> TomlValue.String(self.parse_basic_string(false))
            self.remaining.starts_with?("'") -> TomlValue.String(self.parse_literal_string(false))
            self.peek?('[') -> self.parse_array()
            self.peek?('{') -> self.parse_inline_table()
            _ -> self.parse_bare_value()
        }
    }

    /// Saves the opening position so an unterminated array can report its origin.
    func parse_array(self) -> TomlValue [mut self] {
        let {
            line: start_line, column: start_column
        } = self
        self.take()
        self.skip_value_space()
        return self.empty_array() if self.peek?(']')
        self.parse_array_values([], start_line, start_column)
    }

    /// Consumes the known closing bracket of an empty array.
    func empty_array(self) -> TomlValue [mut self(remaining, column)] {
        self.take()
        TomlValue.Array([])
    }

    /// Reads comma-separated values, accepting comments, line breaks, and a trailing comma.
    func parse_array_values(self, values: List<TomlValue>, start_line: Int, start_column: Int) -> TomlValue [mut self, consume values] {
        return self.unterminated_array(move values, start_line, start_column) if self.remaining.empty?
        let value = self.parse_value()
        return TomlValue.Array(move values) if self.failed?()
        let next = values.append(move value)
        self.skip_value_space()
        return self.close_array(move next) if self.peek?(']')
        return self.invalid_array(move next) if not self.peek?(',')
        self.take()
        self.skip_value_space()
        return self.close_array(move next) if self.peek?(']')
        return self.unterminated_array(move next, start_line, start_column) if self.remaining.empty?
        self.parse_array_values(move next, start_line, start_column)
    }

    /// Reports the opening position and returns partial data that the failed parse will discard.
    func unterminated_array(self, values: List<TomlValue>, line: Int, column: Int) -> TomlValue [consume self.errors, mut self.errors, consume values] {
        self.fail_at("unterminated array", line, column)
        TomlValue.Array(move values)
    }

    /// Consumes the known closing bracket and wraps the accumulated values.
    func close_array(self, values: List<TomlValue>) -> TomlValue [mut self(remaining, column), consume values] {
        self.take()
        TomlValue.Array(move values)
    }

    /// Records a missing separator or closing bracket and retains partial values for error unwinding.
    func invalid_array(self, values: List<TomlValue>) -> TomlValue [consume self.errors, read self(line, column), mut self.errors, consume values] {
        self.fail("expected `,` or `]` in array")
        TomlValue.Array(move values)
    }

    /// Reads a braced table, including TOML 1.1 line breaks and trailing commas.
    func parse_inline_table(self) -> TomlValue [mut self] {
        self.take()
        self.skip_value_space()
        return self.empty_inline_table() if self.peek?('}')
        self.parse_inline_entries([])
    }

    /// Consumes the known closing brace of an empty inline table.
    func empty_inline_table(self) -> TomlValue [mut self(remaining, column)] {
        self.take()
        TomlValue.Table([])
    }

    /// Expands dotted keys and rejects duplicate or conflicting inline-table entries.
    func parse_inline_entries(self, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {
        let keys = self.parse_key_path()
        self.skip_horizontal_space()
        return TomlValue.Table(move entries) if not self.expect_character('=', "expected `=` after inline-table key")
        self.skip_horizontal_space()
        let value = self.parse_value()
        return TomlValue.Table(move entries) if self.failed?()
        let inserted = insert_table_value(move entries, move keys, move value)
        branch inserted {
            Result.Error(message) -> self.invalid_inline_insert(move message)
            Result.Ok(next) -> self.finish_inline_entry(move next)
        }
    }

    /// Records a duplicate or conflicting inline key; the empty table is an error placeholder.
    func invalid_inline_insert(self, message: String) -> TomlValue [consume self.errors, read self(line, column), mut self.errors, consume message] {
        self.fail(move message)
        TomlValue.Table([])
    }

    /// Requires a closing brace or comma; permits a trailing comma before the brace.
    func finish_inline_entry(self, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {
        self.skip_value_space()
        return self.close_inline_table(move entries) if self.peek?('}')
        return self.invalid_inline_table(move entries) if not self.peek?(',')
        self.take()
        self.skip_value_space()
        return self.close_inline_table(move entries) if self.peek?('}')
        self.parse_inline_entries(move entries)
    }

    /// Consumes the known closing brace and wraps the accumulated entries.
    func close_inline_table(self, entries: List<TomlEntry>) -> TomlValue [mut self(remaining, column), consume entries] {
        self.take()
        TomlValue.Table(move entries)
    }

    /// Records a missing separator or closing brace and retains partial entries for error unwinding.
    func invalid_inline_table(self, entries: List<TomlEntry>) -> TomlValue [consume self.errors, read self(line, column), mut self.errors, consume entries] {
        self.fail("expected `,` or `}` in inline table")
        TomlValue.Table(move entries)
    }

    /// Skips whitespace and comments between array or inline-table components.
    func skip_value_space(self) -> () [mut self] {
        self.skip_horizontal_space()
        self.skip_comment()
        return () if not self.newline?()
        self.take_newline()
        self.skip_value_space()
    }

    /// Consumes a matching scalar, or records the supplied diagnostic without advancing.
    func expect_character(self, expected: CodePoint, message: String) -> Bool [mut self(remaining, column), consume self.errors, read self.line, mut self.errors, consume message] {
        return self.take_expected_character() if self.peek?(expected)
        self.fail(move message)
        false
    }

    /// Consumes an already matched scalar and reports success.
    func take_expected_character(self) -> Bool [mut self(remaining, column)] {
        self.take()
        true
    }

    /// Classifies a complete unquoted token before converting numbers or retaining date-time text.
    func parse_bare_value(self) -> TomlValue [mut self] {
        let token = self.take_bare_value("")
        branch {
            token.empty? -> self.missing_value()
            token == "true" -> TomlValue.Bool(true)
            token == "false" -> TomlValue.Bool(false)
            token == "inf" || token == "+inf" -> TomlValue.Float(parse_float("inf"))
            token == "-inf" -> TomlValue.Float(parse_float("-inf"))
            token == "nan" || token == "+nan" -> TomlValue.Float(parse_float("NaN"))
            token == "-nan" -> TomlValue.Float(-parse_float("NaN"))
            date_time?(token) -> TomlValue.DateTime(move token)
            float_text?(token) -> TomlValue.Float(parse_float(remove_underscores(move token)))
            integer_text?(token) -> TomlValue.Int(self.parse_integer(move token))
            _ -> self.invalid_value()
        }
    }

    /// Records a missing value; the empty string is discarded when the parse fails.
    func missing_value(self) -> TomlValue [consume self.errors, read self(line, column), mut self.errors] {
        self.fail("expected a TOML value")
        TomlValue.String("")
    }

    /// Records invalid token syntax; the empty string is discarded when the parse fails.
    func invalid_value(self) -> TomlValue [consume self.errors, read self(line, column), mut self.errors] {
        self.fail("invalid TOML value")
        TomlValue.String("")
    }

    /// Stops at whitespace or delimiters except for a date/time separator space.
    func take_bare_value(self, output: String) -> String [mut self, consume output] {
        return output if self.remaining.empty?
        return self.take_date_time_space(move output) if date_time_space?(output, self.remaining)
        return output if bare_value_end?(self.remaining.scalar_head())
        let character = self.take()
        self.take_bare_value(output + character.string)
    }

    /// Replaces the recognized date/time separator space with `T` in retained text.
    func take_date_time_space(self, output: String) -> String [mut self, consume output] {
        self.take()
        self.take_bare_value(output + "T")
    }

    /// Converts validated integer syntax using its radix and sign.
    func parse_integer(self, text: String) -> Int [mut self, consume text] {
        let negative = text.starts_with?("-")
        let unsigned = drop_sign(move text)
        branch {
            unsigned.starts_with?("0x") -> self.accumulate_integer(unsigned.scalar_rest().scalar_rest(), 16, negative, 0)
            unsigned.starts_with?("0o") -> self.accumulate_integer(unsigned.scalar_rest().scalar_rest(), 8, negative, 0)
            unsigned.starts_with?("0b") -> self.accumulate_integer(unsigned.scalar_rest().scalar_rest(), 2, negative, 0)
            _ -> self.accumulate_integer(move unsigned, 10, negative, 0)
        }
    }

    /// Checks signed 64-bit bounds before each multiply and add or subtract. Negative accumulation admits Int minimum.
    func accumulate_integer(self, text: String, base: Int, negative: Bool, value: Int) -> Int [mut self] {
        return value if text.empty?
        return self.accumulate_integer(text.scalar_rest(), base, negative, value) if text.scalar_head() == '_'
        let digit = hex_value(text.scalar_head())
        let minimum = -9223372036854775807 - 1
        let maximum = 9223372036854775807
        return self.integer_overflow() if negative && value < (minimum + digit) / base
        return self.accumulate_integer(text.scalar_rest(), base, true, value * base - digit) if negative
        return self.integer_overflow() if value > (maximum - digit) / base
        self.accumulate_integer(text.scalar_rest(), base, false, value * base + digit)
    }

    /// Records overflow; the zero placeholder cannot become a successful parse result.
    func integer_overflow(self) -> Int [consume self.errors, read self(line, column), mut self.errors] {
        self.fail("integer is outside the signed 64-bit range")
        0
    }

    /// Rejects duplicate paths and value/table conflicts before adding a flat entry.
    func insert_value(self, path: List<PathPart>, value: TomlValue) -> () [consume self.errors, read self(line, column), mut self.errors, consume self.entries, mut self.entries, consume path, consume value] {
        return self.fail("duplicate key or table/value conflict") if path_conflict?(self.entries, path)
        self.entries = self.entries.append(FlatEntry {
            path: move path, value: FlatValue.Value(move value)
        })
        ()
    }

    /// Resolves array ancestors, rejects redefinition, and sets the assignment context.
    func declare_table(self, keys: List<String>) -> () [consume self.errors, read self(line, column), mut self.errors, consume self.entries, mut self(entries, context), consume keys] {
        let path = resolve_header_path(self.entries, [], move keys)
        return self.fail("table is already defined") if exact_path?(self.entries, path)
        return self.fail("table conflicts with an existing value") if scalar_prefix_conflict?(self.entries, path)
        let context = [].concat(path)
        self.entries = self.entries.append(FlatEntry {
            path: move path, value: FlatValue.TableMarker
        })
        self.context = move context
        ()
    }

    /// Appends the next indexed table and makes it the active assignment context.
    func declare_array_table(self, keys: List<String>) -> () [consume self.errors, read self(line, column), mut self.errors, consume self.entries, mut self(entries, context), consume keys] {
        return self.fail("array-of-tables header requires a key") if keys.empty?
        let parents = keys.take(keys.length - 1)
        let name = keys.last().unwrap_or("")
        let parent = resolve_header_path(self.entries, [], move parents)
        return self.fail("array of tables conflicts with an existing value") if child_key_conflict?(self.entries, parent, name)
        let index = next_array_index(self.entries, parent, name)
        let path = parent.append(PathPart.ArrayItem(move name, index))
        let context = [].concat(path)
        self.entries = self.entries.append(FlatEntry {
            path: move path, value: FlatValue.ArrayTableMarker
        })
        self.context = move context
        ()
    }
}

/// Converts dotted key components into ordinary path components.
func key_parts(keys: List<String>) -> List<PathPart> {
    branch {
        keys.empty? -> []
        _ -> [PathPart.Key(keys.head)].concat(key_parts(keys.rest))
    }
}

/// Accepts the ASCII letters, digits, underscore, and hyphen allowed in bare keys.
func bare_key_character?(character: CodePoint) -> Bool {
    (ascii_letter?(character) || decimal_digit?(character)) || character == '_' || character == '-'
}

/// Recognizes an optional horizontal prefix followed by LF or CRLF.
func fold_space_then_newline?(value: String) -> Bool {
    branch {
        value.starts_with?("\n") || value.starts_with?("\r\n") -> true
        value.empty? -> false
        value.scalar_head() == ' ' || value.scalar_head() == '\t' -> fold_space_then_newline?(value.scalar_rest())
        _ -> false
    }
}

/// Rejects C0 controls and DEL, except for the permitted literal tab.
func forbidden_string_character?(character: CodePoint) -> Bool {
    let value = character.as_int()
    branch {
        value == 9 -> false
        value < 32 -> true
        value == 127 -> true
        _ -> false
    }
}

/// Identifies forbidden comment controls, excluding tabs.
func control_character?(character: CodePoint) -> Bool {
    let value = character.as_int()
    return false if value == 9
    value < 32 || value == 127
}

/// Recognizes ASCII letters without accepting other Unicode alphabetic scalars.
func ascii_letter?(character: CodePoint) -> Bool {
    (character >= 'A' && character <= 'Z') || (character >= 'a' && character <= 'z')
}

/// Recognizes ASCII decimal digits.
func decimal_digit?(character: CodePoint) -> Bool {
    character >= '0' && character <= '9'
}

/// Recognizes ASCII hexadecimal digits in either letter case.
func hex_digit?(character: CodePoint) -> Bool {
    decimal_digit?(character) || (character >= 'A' && character <= 'F') || (character >= 'a' && character <= 'f')
}

/// Decodes an already validated ASCII hexadecimal digit.
func hex_value(character: CodePoint) -> Int {
    branch {
        character <= '9' -> character.as_int() - 48
        character <= 'F' -> character.as_int() - 55
        _ -> character.as_int() - 87
    }
}

/// Recognizes a space after a valid date when a time digit follows.
func date_time_space?(output: String, remaining: String) -> Bool {
    return false if output.scalar_length() != 10
    return false if not local_date?(output)
    return false if not remaining.starts_with?(" ")
    return false if remaining.scalar_rest().empty?
    decimal_digit?(remaining.scalar_rest().scalar_head())
}

/// Recognizes whitespace or punctuation that terminates an unquoted token.
func bare_value_end?(character: CodePoint) -> Bool {
    bare_space?(character) || bare_delimiter?(character)
}

/// Recognizes the ASCII whitespace that separates unquoted tokens.
func bare_space?(character: CodePoint) -> Bool {
    character == ' ' || character == '\t' || character == '\n' || character == '\r'
}

/// Recognizes comments and array or table punctuation that ends an unquoted token.
func bare_delimiter?(character: CodePoint) -> Bool {
    character == '#' || character == ',' || character == ']' || character == '}'
}

/// Removes separators after numeric syntax has already been validated.
func remove_underscores(value: String) -> String {
    branch {
        value.empty? -> ""
        value.scalar_head() == '_' -> remove_underscores(value.scalar_rest())
        _ -> value.scalar_head().string + remove_underscores(value.scalar_rest())
    }
}

/// Validates radix prefixes, signs, leading zeros, and underscore placement before conversion.
func integer_text?(value: String) -> Bool {
    let unsigned = drop_sign(value)
    let signed = value.starts_with?("+") || value.starts_with?("-")
    return false if signed && based_prefix?(unsigned)
    branch {
        unsigned.starts_with?("0x") -> based_digits?(unsigned.scalar_rest().scalar_rest(), 16)
        unsigned.starts_with?("0o") -> based_digits?(unsigned.scalar_rest().scalar_rest(), 8)
        unsigned.starts_with?("0b") -> based_digits?(unsigned.scalar_rest().scalar_rest(), 2)
        unsigned.empty? -> false
        unsigned.scalar_head() == '0' && not unsigned.scalar_rest().empty? -> false
        _ -> based_digits?(unsigned, 10)
    }
}

/// Recognizes the lowercase radix prefixes allowed for TOML integers.
func based_prefix?(value: String) -> Bool {
    value.starts_with?("0x") || value.starts_with?("0o") || value.starts_with?("0b")
}

/// Removes one optional leading sign, preserving an empty input.
func drop_sign(value: String) -> String {
    branch {
        value.empty? -> ""
        value.scalar_head() == '+' || value.scalar_head() == '-' -> value.scalar_slice(1, value.scalar_length())
        _ -> value.scalar_slice(0, value.scalar_length())
    }
}

/// Requires a nonempty digit sequence with underscores only between digits.
func based_digits?(value: String, base: Int) -> Bool {
    return false if value.empty?
    based_digit_tail?(value, base, false, false)
}

/// Tracks digit and underscore state so leading, repeated, and trailing underscores fail.
func based_digit_tail?(value: String, base: Int, saw_digit: Bool, previous_underscore: Bool) -> Bool {
    branch {
        value.empty? -> saw_digit && not previous_underscore
        value.scalar_head() == '_' -> branch {
            not saw_digit || previous_underscore -> false
            _ -> based_digit_tail?(value.scalar_rest(), base, true, true)
        }
        digit_for_base?(value.scalar_head(), base) -> based_digit_tail?(value.scalar_rest(), base, true, false)
        _ -> false
    }
}

/// Checks a digit for one of the parser radices: 2, 8, 10, or 16.
func digit_for_base?(character: CodePoint, base: Int) -> Bool {
    branch {
        base <= 10 -> character >= '0' && character.as_int() < 48 + base
        _ -> hex_digit?(character)
    }
}

/// Requires decimal-point or exponent syntax; special infinities and NaNs are handled separately.
func float_text?(value: String) -> Bool {
    let unsigned = drop_sign(value)
    branch {
        unsigned.empty? -> false
        unsigned.contains?(".") -> decimal_float?(unsigned)
        unsigned.contains?("e") || unsigned.contains?("E") -> decimal_float?(unsigned)
        _ -> false
    }
}

/// Validates the whole-number part before checking fraction and exponent syntax.
func decimal_float?(value: String) -> Bool {
    let whole = take_decimal_prefix(value)
    let normalized = remove_underscores(whole.scalar_slice(0, whole.scalar_length()))
    branch {
        whole.empty? -> false
        normalized.empty? -> false
        normalized.scalar_length() > 1 && normalized.scalar_head() == '0' -> false
        not decimal_component?(whole) -> false
        _ -> decimal_float_suffix?(value.scalar_slice(whole.scalar_length(), value.scalar_length()))
    }
}

/// Scans decimal digits and underscores; a later check validates separator placement.
func take_decimal_prefix(value: String) -> String {
    value.scalar_take_while((character: CodePoint) -> decimal_digit?(character) || character == '_')
}

/// Requires a fraction or exponent after the validated whole-number part.
func decimal_float_suffix?(suffix: String) -> Bool {
    branch {
        suffix.starts_with?(".") -> fraction_and_exponent?(suffix.scalar_rest())
        suffix.starts_with?("e") || suffix.starts_with?("E") -> exponent?(suffix.scalar_rest())
        _ -> false
    }
}

/// Validates fractional digits and any following exponent.
func fraction_and_exponent?(value: String) -> Bool {
    let fraction = take_decimal_prefix(value)
    branch {
        not decimal_component?(fraction) -> false
        fraction.scalar_length() == value.scalar_length() -> true
        _ -> exponent_marker?(value.scalar_slice(fraction.scalar_length(), value.scalar_length()))
    }
}

/// Requires an exponent marker followed by valid exponent digits.
func exponent_marker?(value: String) -> Bool {
    branch {
        value.starts_with?("e") || value.starts_with?("E") -> exponent?(value.scalar_rest())
        _ -> false
    }
}

/// Validates an optional sign and a nonempty decimal exponent.
func exponent?(value: String) -> Bool {
    decimal_component?(drop_sign(value))
}

/// Validates decimal digits with underscores only between digits.
func decimal_component?(value: String) -> Bool {
    based_digits?(value, 10)
}

/// Binds array-of-tables ancestors to their most recently declared element.
func resolve_header_path(entries: List<FlatEntry>, prefix: List<PathPart>, keys: List<String>) -> List<PathPart> [consume prefix, consume keys] {
    return prefix if keys.empty?
    let name = keys.head
    let index = latest_array_index(entries, prefix, name, -1)
    let next = branch {
        index >= 0 -> prefix.append(PathPart.ArrayItem(move name, index))
        _ -> prefix.append(PathPart.Key(move name))
    }
    resolve_header_path(entries, move next, keys.rest)
}

/// Finds the greatest matching array index, retaining `latest` when no match exists.
func latest_array_index(entries: List<FlatEntry>, prefix: List<PathPart>, name: String, latest: Int) -> Int {
    return latest if entries.empty?
    let candidate = direct_item_index(entries.head.path, prefix, name)
    let next = branch {
        candidate > latest -> candidate
        _ -> latest
    }
    latest_array_index(entries.rest, prefix, name, next)
}

/// Allocates contiguous zero-based indexes for an array of tables.
func next_array_index(entries: List<FlatEntry>, prefix: List<PathPart>, name: String) -> Int {
    latest_array_index(entries, prefix, name, -1) + 1
}

/// Returns the matching array component immediately below `prefix`, or -1.
func direct_item_index(path: List<PathPart>, prefix: List<PathPart>, name: String) -> Int {
    return -1 if not path_starts_with?(path, prefix)
    branch path.borrow(prefix.length) {
        Option.Some(part) -> branch part {
            PathPart.ArrayItem(key, index) -> branch {
                key == name -> index
                _ -> -1
            }
            _ -> -1
        }
        Option.None -> -1
    }
}

/// Tests whether a value or declaration marker occupies this exact path.
func exact_path?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {
    branch {
        entries.empty? -> false
        entries.head.path == path -> true
        _ -> exact_path?(entries.rest, path)
    }
}

/// Rejects an exact redefinition or a stored value on either side of a prefix relationship.
func path_conflict?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {
    return false if entries.empty?
    return true if entries.head.path == path
    return true if flat_scalar_prefix_conflict?(entries.head, path)
    path_conflict?(entries.rest, path)
}

/// Checks all stored values for conflicts with an ancestor or descendant path.
func scalar_prefix_conflict?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {
    return false if entries.empty?
    return true if flat_scalar_prefix_conflict?(entries.head, path)
    scalar_prefix_conflict?(entries.rest, path)
}

/// Stored values block parent/child paths; table markers alone do not.
func flat_scalar_prefix_conflict?(entry: FlatEntry, path: List<PathPart>) -> Bool {
    branch entry.value {
        FlatValue.Value(_) -> branch {
            path_starts_with?(path, entry.path) -> true
            path_starts_with?(entry.path, path) -> true
            _ -> false
        }
        _ -> false
    }
}

/// Detects an ordinary key where a new array-of-tables component would be created.
func child_key_conflict?(entries: List<FlatEntry>, prefix: List<PathPart>, name: String) -> Bool {
    return false if entries.empty?
    return true if direct_key_child?(entries.head.path, prefix, name)
    child_key_conflict?(entries.rest, prefix, name)
}

/// Checks the component immediately below `prefix`, including paths to deeper descendants.
func direct_key_child?(path: List<PathPart>, prefix: List<PathPart>, name: String) -> Bool {
    return false if not path_starts_with?(path, prefix)
    branch path.borrow(prefix.length) {
        Option.Some(part) -> branch part {
            PathPart.Key(candidate) -> candidate == name
            _ -> false
        }
        Option.None -> false
    }
}

/// Compares path components, including array indexes; an empty prefix always matches.
func path_starts_with?(path: List<PathPart>, prefix: List<PathPart>) -> Bool {
    branch {
        prefix.empty? -> true
        path.empty? -> false
        path.head != prefix.head -> false
        _ -> path_starts_with?(path.rest, prefix.rest)
    }
}

enum Child = Table(String)
    | Array(String)

/// Builds a nested table from validated flat entries, preserving first-seen child order.
func materialize(entries: List<FlatEntry>, prefix: List<PathPart>) -> List<TomlEntry> {
    let children = direct_children(entries, prefix, [])
    materialize_children(move children, entries, prefix, [])
}

/// Collects each immediate child once, preserving its first appearance in the document.
func direct_children(entries: List<FlatEntry>, prefix: List<PathPart>, output: List<Child>) -> List<Child> [consume output] {
    return output if entries.empty?
    let child = direct_child(entries.head.path, prefix)
    let next = branch child {
        Option.None -> output
        Option.Some(value) -> append_unique_child(move output, move value)
    }
    direct_children(entries.rest, prefix, move next)
}

/// Projects the first path component below `prefix` into a table or array child.
func direct_child(path: List<PathPart>, prefix: List<PathPart>) -> Option<Child> {
    return Option.None if not path_starts_with?(path, prefix)
    branch path.borrow(prefix.length) {
        Option.Some(part) -> branch part {
            PathPart.Key(name) -> Option.Some(Child.Table(name.copy()))
            PathPart.ArrayItem(key, _) -> Option.Some(Child.Array(key.copy()))
        }
        Option.None -> Option.None
    }
}

/// Adds a child only when its name has not appeared, preserving first-seen order.
func append_unique_child(children: List<Child>, child: Child) -> List<Child> [consume children, consume child] {
    return children if contains_child?(children, child)
    children.append(move child)
}

/// Compares child names; earlier conflict checks keep table and array names disjoint.
func contains_child?(children: List<Child>, expected: Child) -> Bool {
    branch {
        children.empty? -> false
        child_name(children.head) == child_name(expected) -> true
        _ -> contains_child?(children.rest, expected)
    }
}

/// Extracts the common name from table and array child descriptors.
func child_name(child: Child) -> String {
    branch child {
        Child.Table(name) -> name
        Child.Array(name) -> name
    }
}

/// Builds ordered entries while retaining the full flat index for descendant lookup.
func materialize_children(children: List<Child>, entries: List<FlatEntry>, prefix: List<PathPart>, output: List<TomlEntry>) -> List<TomlEntry> [consume output] {
    return output if children.empty?
    let child_prefix = [].concat(prefix)
    let entry = materialize_child(children.head, entries, move child_prefix)
    materialize_children(children.rest, entries, prefix, output.append(move entry))
}

/// Dispatches reconstruction according to the child's table or array shape.
func materialize_child(child: Child, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry {
    branch child {
        Child.Table(name) -> materialize_table_child(move name, entries, move prefix)
        Child.Array(name) -> materialize_array_child(move name, entries, move prefix)
    }
}

/// Builds one named array-of-tables entry from its indexed descendants.
func materialize_array_child(name: String, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry [consume name, consume prefix] {
    let key = name.slice(0, name.length)
    TomlEntry {
        key: move key,
        value: TomlValue.Array(materialize_array_items(entries, move prefix, move name, 0, []))
    }
}

/// Uses a stored value when present, otherwise builds the implicit or declared table.
func materialize_table_child(name: String, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry {
    let path = prefix.append(PathPart.Key(name))
    branch exact_scalar(entries, path) {
        Option.Some(value) -> TomlEntry {
            key: name, value: move value
        }
        Option.None -> TomlEntry {
            key: name, value: TomlValue.Table(materialize(entries, path))
        }
    }
}

/// Finds a stored value at an exact path; declaration markers yield no value.
func exact_scalar(entries: List<FlatEntry>, path: List<PathPart>) -> Option<TomlValue> {
    return Option.None if entries.empty?
    return flat_scalar(entries.head) if entries.head.path == path
    exact_scalar(entries.rest, path)
}

/// Extracts a stored TOML value, ignoring table declaration markers.
func flat_scalar(entry: FlatEntry) -> Option<TomlValue> {
    branch entry.value {
        FlatValue.Value(value) -> Option.Some(move value)
        _ -> Option.None
    }
}

/// Builds consecutive table elements starting at `index`; stops at the first missing marker.
func materialize_array_items(entries: List<FlatEntry>, prefix: List<PathPart>, name: String, index: Int, output: List<TomlValue>) -> List<TomlValue> [consume output] {
    let path = prefix.append(PathPart.ArrayItem(name.slice(0, name.length), index))
    return output if not exact_path?(entries, path)
    let table = TomlValue.Table(materialize(entries, path))
    materialize_array_items(entries, prefix, name, index + 1, output.append(move table))
}

/// Expands an inline-table dotted key, returning a message for duplicate or conflicting values.
func insert_table_value(entries: List<TomlEntry>, keys: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume keys, consume value] {
    return Result.Error("inline table key cannot be empty") if keys.empty?
    return insert_direct_table_value(move entries, keys.head, move value) if keys.rest.empty?
    insert_nested_table_value(move entries, keys.head, keys.rest, move value)
}

/// Appends a new inline entry, rejecting an existing equal key.
func insert_direct_table_value(entries: List<TomlEntry>, key: String, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume value] {
    return Result.Error("duplicate key in inline table") if table_contains_key?(entries, key)
    Result.Ok(entries.append(TomlEntry {
        key: move key, value: move value
    }))
}

/// Tests exact key equality within one table level.
func table_contains_key?(entries: List<TomlEntry>, key: String) -> Bool {
    branch {
        entries.empty? -> false
        entries.head.key == key -> true
        _ -> table_contains_key?(entries.rest, key)
    }
}

/// Creates a missing intermediate table or rebuilds an existing one.
func insert_nested_table_value(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value] {
    return create_nested_table(move entries, move key, move rest, move value) if not table_contains_key?(entries, key)
    rewrite_nested_table(move entries, move key, move rest, move value, [])
}

/// Constructs missing nested tables for the rest of a dotted inline key.
func create_nested_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value] {
    let nested = try insert_table_value([], move rest, move value)
    Result.Ok(entries.append(TomlEntry {
        key: move key, value: TomlValue.Table(move nested)
    }))
}

/// Accumulates preceding entries so nested insertion preserves the original entry order.
func rewrite_nested_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue, prefix: List<TomlEntry>) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value, consume prefix] {
    return Result.Error("inline table key conflicts with a value") if entries.empty?
    return rewrite_matching_table(move entries, move key, move rest, move value, move prefix) if entries.head.key == key
    rewrite_nested_table(entries.rest, move key, move rest, move value, prefix.append(entries.head))
}

/// Rebuilds only a table-valued matching entry; a scalar at that key is a conflict.
func rewrite_matching_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue, prefix: List<TomlEntry>) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value, consume prefix] {
    branch entries.head.value {
        TomlValue.Table(nested) -> {
            let updated = try insert_table_value(move nested, move rest, move value)
            Result.Ok(prefix.append(TomlEntry {
                key: move key, value: TomlValue.Table(move updated)
            }).concat(entries.rest))
        }
        _ -> Result.Error("inline table key conflicts with a value")
    }
}

/// Recognizes a valid local date, local time, or combined date-time.
func date_time?(value: String) -> Bool {
    local_date?(value) || local_time?(value) || full_date_time?(value)
}

/// Validates fixed-width date syntax and Gregorian month/day bounds.
func local_date?(value: String) -> Bool {
    return false if value.scalar_length() != 10
    return false if not digits_at?(value, 0, 4)
    return false if not character_at?(value, 4, '-')
    return false if not digits_at?(value, 5, 2)
    return false if not character_at?(value, 7, '-')
    return false if not digits_at?(value, 8, 2)
    let year = decimal_at(value, 0, 4, 0)
    let month = decimal_at(value, 5, 2, 0)
    let day = decimal_at(value, 8, 2, 0)
    valid_calendar_day?(year, month, day)
}

/// Checks a one-based month and day against Gregorian calendar rules.
func valid_calendar_day?(year: Int, month: Int, day: Int) -> Bool {
    return false if month < 1
    return false if month > 12
    return false if day < 1
    day <= days_in_month(year, month)
}

/// Returns Gregorian month length; the caller must validate the month range first.
func days_in_month(year: Int, month: Int) -> Int {
    branch {
        month == 2 -> branch {
            leap_year?(year) -> 29
            _ -> 28
        }
        month == 4 -> 30
        month == 6 -> 30
        month == 9 -> 30
        month == 11 -> 30
        _ -> 31
    }
}

/// Applies the Gregorian divisible-by-4, century, and divisible-by-400 rules.
func leap_year?(year: Int) -> Bool {
    return true if year.modulo(400) == 0
    return false if year.modulo(100) == 0
    year.modulo(4) == 0
}

/// Accepts hours and minutes with optional seconds and fractional seconds; leap seconds are rejected.
func local_time?(value: String) -> Bool {
    return false if value.scalar_length() < 5
    return false if not digits_at?(value, 0, 2)
    return false if not character_at?(value, 2, ':')
    return false if not digits_at?(value, 3, 2)
    let hour = decimal_at(value, 0, 2, 0)
    let minute = decimal_at(value, 3, 2, 0)
    return false if hour > 23
    return false if minute > 59
    return true if value.scalar_length() == 5
    return false if value.scalar_length() < 8
    return false if not character_at?(value, 5, ':')
    return false if not digits_at?(value, 6, 2)
    return false if decimal_at(value, 6, 2, 0) > 59
    return true if value.scalar_length() == 8
    return false if not character_at?(value, 8, '.')
    fraction_digits?(value, 9)
}

/// Requires at least one decimal digit from the fraction's start through the end.
func fraction_digits?(value: String, index: Int) -> Bool {
    return false if index >= value.scalar_length()
    digits_at?(value, index, value.scalar_length() - index)
}

/// Validates a date, separator, and time with an optional offset.
func full_date_time?(value: String) -> Bool {
    return false if value.scalar_length() < 16
    return false if not local_date?(value.scalar_slice(0, 10))
    return false if not date_time_separator?(value.scalar_slice(10, 11))
    valid_time_and_offset?(value.scalar_slice(11, value.scalar_length()))
}

/// Accepts uppercase or lowercase T and the TOML space separator.
func date_time_separator?(value: String) -> Bool {
    value == "T" || value == "t" || value == " "
}

/// Accepts local time alone, a UTC suffix, or a signed hours-and-minutes offset.
func valid_time_and_offset?(value: String) -> Bool {
    return local_time?(value.scalar_slice(0, value.scalar_length() - 1)) if ends_in_z?(value)
    let offset = find_offset(value, 0)
    return local_time?(value) if offset < 0
    return false if offset + 6 != value.scalar_length()
    return false if not local_time?(value.scalar_slice(0, offset))
    valid_offset?(value.scalar_slice(offset, value.scalar_length()))
}

/// Accepts either spelling of the UTC suffix.
func ends_in_z?(value: String) -> Bool {
    value.ends_with?("Z") || value.ends_with?("z")
}

/// Finds the first sign at a scalar offset, or returns -1 when none occurs.
func find_offset(value: String, index: Int) -> Int {
    return -1 if value.empty?
    return index if value.scalar_head() == '+' || value.scalar_head() == '-'
    find_offset(value.scalar_rest(), index + 1)
}

/// Checks signed HH:MM syntax with hours 0..23 and minutes 0..59.
func valid_offset?(value: String) -> Bool {
    return false if value.scalar_length() != 6
    return false if not (character_at?(value, 0, '+') || character_at?(value, 0, '-'))
    return false if not digits_at?(value, 1, 2)
    return false if not character_at?(value, 3, ':')
    return false if not digits_at?(value, 4, 2)
    return false if decimal_at(value, 1, 2, 0) > 23
    decimal_at(value, 4, 2, 0) <= 59
}

/// Compares a scalar at a zero-based index; out-of-range indexes return false.
func character_at?(value: String, index: Int, expected: CodePoint) -> Bool {
    branch value.code_points().borrow(index) {
        Option.Some(character) -> character == expected
        Option.None -> false
    }
}

/// Checks `count` ASCII digits from a scalar index; a zero count succeeds.
func digits_at?(value: String, start: Int, count: Int) -> Bool {
    return true if count == 0
    branch value.code_points().borrow(start) {
        Option.Some(character) -> branch {
            decimal_digit?(character) -> digits_at?(value, start + 1, count - 1)
            _ -> false
        }
        Option.None -> false
    }
}

/// Accumulates previously validated decimal scalars; callers validate syntax and bounds first.
func decimal_at(value: String, start: Int, count: Int, output: Int) -> Int {
    return output if count == 0
    branch value.code_points().borrow(start) {
        Option.Some(character) -> decimal_at(value, start + 1, count - 1, output * 10 + hex_value(character))
        Option.None -> output
    }
}

/// Rejects duplicate root keys and emits entries in their stored order.
func render_entries(entries: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entries, consume output] {
    let validation_entries = [].concat(entries)
    return Result.Error(render_error("duplicate key in TOML document")) if duplicate_entries?(move validation_entries)
    return Result.Ok(move output) if entries.empty?
    render_entry_line(entries.head, entries.rest, move output)
}

/// Renders one root assignment followed by a newline, then the remaining entries.
func render_entry_line(entry: TomlEntry, remaining: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entry, consume remaining, consume output] {
    let value = try render_value(move entry.value)
    render_entries(move remaining, output + render_key(move entry.key) + " = " + value + "\n")
}

/// Renders typed values recursively; tables are emitted in inline form.
func render_value(value: TomlValue) -> Result<String, TomlError> {
    branch value {
        TomlValue.String(text) -> Result.Ok("\"" + escape_basic(text) + "\"")
        TomlValue.Int(number) -> Result.Ok(number.as_string())
        TomlValue.Float(number) -> Result.Ok(render_float(number))
        TomlValue.Bool(flag) -> Result.Ok(render_bool(flag))
        TomlValue.DateTime(text) -> render_date_time(move text)
        TomlValue.Array(values) -> render_array(move values, "[")
        TomlValue.Table(entries) -> render_inline_table(move entries)
    }
}

/// Emits TOML's lowercase Boolean literals.
func render_bool(value: Bool) -> String {
    branch {
        value -> "true"
        _ -> "false"
    }
}

/// Keeps integral floats distinguishable from integers and emits TOML NaN spelling.
func render_float(value: Float) -> String {
    let text = value.as_string()
    return "nan" if text == "NaN"
    return text if text.contains?(".") || text.contains?("e") || text.contains?("inf")
    text + ".0"
}

/// Validates manually constructed date/time text before emitting it unquoted.
func render_date_time(text: String) -> Result<String, TomlError> [consume text] {
    return Result.Error(render_error("TomlValue.DateTime contains invalid TOML date/time text")) if not date_time?(text)
    Result.Ok(move text)
}

/// Closes an empty array or renders its first value without a comma.
func render_array(values: List<TomlValue>, output: String) -> Result<String, TomlError> [consume values, consume output] {
    return Result.Ok(output + "]") if values.empty?
    render_array_first(values.head, values.rest, move output)
}

/// Appends the first rendered value before entering the comma-separated tail.
func render_array_first(value: TomlValue, remaining: List<TomlValue>, output: String) -> Result<String, TomlError> [consume value, consume remaining, consume output] {
    let text = try render_value(move value)
    render_array_tail(move remaining, output + text)
}

/// Closes the array or renders another comma-prefixed value.
func render_array_tail(values: List<TomlValue>, output: String) -> Result<String, TomlError> [consume values, consume output] {
    return Result.Ok(output + "]") if values.empty?
    render_array_next(values.head, values.rest, move output)
}

/// Appends a comma and the next value, propagating rendering errors.
func render_array_next(value: TomlValue, remaining: List<TomlValue>, output: String) -> Result<String, TomlError> [consume value, consume remaining, consume output] {
    let text = try render_value(move value)
    render_array_tail(move remaining, output + ", " + text)
}

/// Rejects duplicate keys before rendering an inline table in stored order.
func render_inline_table(entries: List<TomlEntry>) -> Result<String, TomlError> [consume entries] {
    let validation_entries = [].concat(entries)
    return Result.Error(render_error("duplicate key in TomlValue.Table")) if duplicate_entries?(move validation_entries)
    return Result.Ok("{}") if entries.empty?
    render_inline_first(entries.head, entries.rest)
}

/// Opens an inline table with its first key-value assignment.
func render_inline_first(entry: TomlEntry, remaining: List<TomlEntry>) -> Result<String, TomlError> [consume entry, consume remaining] {
    let value = try render_value(move entry.value)
    render_inline_tail(move remaining, "{ " + render_key(move entry.key) + " = " + value)
}

/// Closes the inline table or renders another comma-prefixed assignment.
func render_inline_tail(entries: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entries, consume output] {
    return Result.Ok(output + " }") if entries.empty?
    render_inline_next(entries.head, entries.rest, move output)
}

/// Appends one inline assignment, propagating nested rendering errors.
func render_inline_next(entry: TomlEntry, remaining: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entry, consume remaining, consume output] {
    let value = try render_value(move entry.value)
    render_inline_tail(move remaining, output + ", " + render_key(move entry.key) + " = " + value)
}

/// Detects repeated keys within one table; nested tables are checked when rendered.
func duplicate_entries?(entries: List<TomlEntry>) -> Bool {
    branch {
        entries.empty? -> false
        table_contains_key?(entries.rest, entries.head.key) -> true
        _ -> duplicate_entries?(entries.rest)
    }
}

/// Leaves nonempty bare keys unquoted and escapes all other keys.
func render_key(key: String) -> String {
    branch {
        key.empty? -> "\"\""
        bare_key?(key) -> key
        _ -> "\"" + escape_basic(key) + "\""
    }
}

/// Checks allowed bare-key scalars; the empty case is handled separately by `render_key`.
func bare_key?(key: String) -> Bool {
    branch {
        key.empty? -> true
        bare_key_character?(key.scalar_head()) -> bare_key?(key.scalar_rest())
        _ -> false
    }
}

/// Escapes each scalar for a single-line basic string without adding delimiters.
func escape_basic(value: String) -> String {
    return "" if value.empty?
    escape_character(value.scalar_head()) + escape_basic(value.scalar_rest())
}

/// Escapes quotes, backslashes, and control scalars; preserves other Unicode text.
func escape_character(character: CodePoint) -> String {
    let value = character.as_int()
    branch {
        value == 8 -> "\\b"
        value == 9 -> "\\t"
        value == 10 -> "\\n"
        value == 12 -> "\\f"
        value == 13 -> "\\r"
        value == 27 -> "\\e"
        value == 34 -> "\\\""
        value == 92 -> "\\\\"
        value < 32 -> "\\u" + fixed_hex(value, 4)
        value == 127 -> "\\u007F"
        _ -> character.string
    }
}

/// Renders a nonnegative value fitting within `digits` hexadecimal places, padding with zeros.
func fixed_hex(value: Int, digits: Int) -> String {
    return "" if digits == 0
    let divisor = 16.power(digits - 1)
    hex_character(value / divisor) + fixed_hex(value.modulo(divisor), digits - 1)
}

/// Converts a digit in 0..15 to uppercase hexadecimal text.
func hex_character(value: Int) -> String {
    branch {
        value < 10 -> from_code_point(48 + value).string
        _ -> from_code_point(55 + value).string
    }
}

/// Uses zero positions because constructed values have no source location.
func render_error(message: String) -> TomlError {
    TomlError {
        message: move message, line: 0, column: 0
    }
}

test "TOML parses queries renders and reports positioned errors" {
    branch parse("title = \"Foster\"\n[package]\nenabled = true\n") {
        Result.Error(_) -> {
            panic("valid TOML was rejected")
        }
        Result.Ok(document) -> branch (move document).get("package") {
            Option.None -> {
                panic("package table was missing")
            }
            Option.Some(value) -> branch (move value).get("enabled") {
                Option.Some(TomlValue.Bool(enabled)) -> {
                    assert(enabled)
                    ()
                }
                _ -> {
                    panic("nested boolean was missing")
                }
            }
        }
    }

    let document = TomlDocument {
        entries: [TomlEntry {
            key: "count", value: TomlValue.Int(3)
        }, TomlEntry {
            key: "title", value: TomlValue.String("Foster")
        }]
    }
    branch (move document).render() {
        Result.Ok(source) -> {
            assert(source == "count = 3\ntitle = \"Foster\"\n")
            ()
        }
        Result.Error(_) -> {
            panic("typed TOML failed to render")
        }
    }

    branch parse("title = \"ok\"\nbroken = [\n") {
        Result.Error(error) -> {
            assert(error.line == 2)
            assert(error.column > 0)
            ()
        }
        Result.Ok(_) -> {
            panic("malformed TOML was accepted")
        }
    }
}

/// Scores one TOML value category for round-trip test coverage.
func test_score_value(value: TomlValue) -> Int {
    branch value {
        TomlValue.String(_) -> 1
        TomlValue.Int(_) -> 2
        TomlValue.Float(_) -> 4
        TomlValue.Bool(_) -> 8
        TomlValue.DateTime(_) -> 16
        TomlValue.Array(values) -> 32 + values.length
        TomlValue.Table(entries) -> 64 + test_score_entries(move entries)
    }
}

/// Accumulates TOML value-category scores across test entries.
func test_score_entries(entries: List<TomlEntry>) -> Int {
    return 0 if entries.empty?
    test_score_value(entries.head.value) + test_score_entries(entries.rest)
}

/// Confirms that a failed parse retains a positioned diagnostic.
func test_error_score(outcome: Result<TomlDocument, TomlError>) -> Int {
    branch outcome {
        Result.Ok(_) -> 0
        Result.Error(error) -> branch {
            error.message.empty? -> 0
            error.line <= 0 -> 0
            error.column <= 0 -> 0
            _ -> 1
        }
    }
}

/// Asserts one TOML test condition while keeping branch result types uniform.
func test_require(condition: Bool, message: String) -> () {
    assert(condition, message)
    ()
}

test "TOML round trips every value category" {
    let source = "array = [1, 2]\nboolean = true\ndatetime = 1979-05-27T07:32:00Z\nfloat = 1.5\ninteger = 3\nstring = \"x\"\n[table]\nnested = false\n"
    branch parse(move source) {
        Result.Error(_) -> test_require(false, "valid TOML was rejected")
        Result.Ok(document) -> branch (move document).render() {
            Result.Error(_) -> test_require(false, "valid document did not render")
            Result.Ok(rendered) -> branch parse(move rendered) {
                Result.Error(_) -> test_require(false, "rendered TOML did not parse")
                Result.Ok(round_trip) -> test_require(test_score_entries(move round_trip.entries) == 137, "round trip changed TOML value categories")
            }
        }
    }
}

test "TOML renderer rejects invalid date-time values" {
    let document = TomlDocument {
        entries: [TomlEntry {
            key: "when", value: TomlValue.DateTime("not-a-date")
        }]
    }
    branch (move document).render() {
        Result.Ok(_) -> test_require(false, "invalid date-time rendered successfully")
        Result.Error(error) -> {
            assert(error.line == 0)
            assert(error.column == 0)
            ()
        }
    }
}

test "TOML rejects common malformed inputs with positions" {
    let score = 0
    score = score + test_error_score(parse("value = 1\nvalue = 2\n"))
    score = score + test_error_score(parse("value = 1__0\n"))
    score = score + test_error_score(parse("value = +0x10\n"))
    score = score + test_error_score(parse("value = 01.2\n"))
    score = score + test_error_score(parse("value = 2025-02-30\n"))
    score = score + test_error_score(parse("value = \"\\q\"\n"))
    score = score + test_error_score(parse("[table]\n[table]\n"))
    score = score + test_error_score(parse("value = 1\n[value.child]\n"))
    score = score + test_error_score(parse("value = { key = 1, key = 2 }\n"))
    score = score + test_error_score(parse("value = [1, 2\n"))
    assert(score == 10)
}
