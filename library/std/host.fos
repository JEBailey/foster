//! Explicit provider contracts for applications. Pass a provider to choose resource
//! implementations; the default adapters use the embedding runtime's HostContext.
//! Clock providers use the existing std.time.Clock<T> contract.
//! Require Connector<C> for outgoing connections and ListenerProvider<L> for
//! binding endpoints. NetworkProvider<C, L> composes both capabilities.

import core.result.Result

import std.fs.File
import static std.fs.*
import std.io.IoError

import std.net.tcp
import std.net.tcp.NetworkError
import std.net.tcp.Connection
import std.net.tcp.Listener
import static std.net.tcp.*
import std.path as paths
import std.path.Path

/// Supplies located file resources. Implementations choose their own resource type.
pub type FileProvider<F> = {
    /// Resolves a location to a resource without requiring an OS file handle.
    pub func file(self: Self, location: paths::Path) -> Result<F, IoError> [read self, consume location]
}

/// Supplies outgoing connections, including application-defined stream types.
/// Does not require endpoint binding or a listener type.
pub type Connector<C> = {
    /// Connects to an endpoint using this provider's namespace and policy.
    pub func connect(self: Self, address: String, port: Int) -> Result<C, NetworkError> [read self, consume address]
}

/// Supplies bound listeners, including application-defined listener types.
/// Does not require outgoing connections or a connected-stream type.
pub type ListenerProvider<L> = {
    /// Binds an endpoint using this provider's namespace and policy.
    pub func listen(self: Self, address: String, port: Int) -> Result<L, NetworkError> [read self, consume address]
}

/// Supplies both outgoing connections and bound listeners.
/// Require Connector<C> or ListenerProvider<L> when only one operation is needed.
pub type NetworkProvider<C, L> = & Connector<C> & ListenerProvider<L> & {}

/// File and TCP adapters backed by the runtime's installed host provider.
pub type RuntimeHost = & FileProvider<File> & NetworkProvider<Connection, Listener> & {}

impl RuntimeHost {
    /// Creates an adapter without performing host I/O.
    pub func new() -> RuntimeHost {
        RuntimeHost {}
    }
    /// Creates a located file; actual I/O may subsequently fail.
    pub func file(self: Self, location: paths::Path) -> Result<File, IoError> [consume location] {
        Result.Ok(File.at(move location))
    }
    /// Connects through the installed runtime provider.
    pub func connect(self: Self, address: String, port: Int) -> Result<Connection, NetworkError> [consume address] {
        tcp::connect(move address, port)
    }
    /// Binds through the installed runtime provider.
    pub func listen(self: Self, address: String, port: Int) -> Result<Listener, NetworkError> [consume address] {
        tcp::listen(move address, port)
    }
}
