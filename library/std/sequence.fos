//! Generic algorithms over immutable indexed sequences.

import core.functions
import core.option

/// Applies `transform` to every element of a string or list and returns the results as a list.
pub func map<T, U>(values: Sequence<T>, transform: func(T) -> U) -> List<U> {
    map_into(values, transform, [])
}

/// Maps the remaining sequence elements into the result accumulator.
func map_into<T, U>(values: Sequence<T>, transform: func(T) -> U, result: List<U>) -> List<U> [consume result] {
    branch {
        values.empty?() -> result
        _ -> map_next(values, transform, move result)
    }
}

/// Transforms the next sequence element and appends it to the accumulator.
func map_next<T, U>(values: Sequence<T>, transform: func(T) -> U, result: List<U>) -> List<U> {
    let mapped = transform(values.head())
    map_into(values.rest(), transform, result.append(mapped))
}

/// Returns sequence elements for which `include` evaluates to true.
pub func filter<T>(values: Sequence<T>, include: Predicate<T>) -> List<T> {
    filter_into(values, include, [])
}

/// Filters the remaining sequence elements into the result accumulator.
func filter_into<T>(values: Sequence<T>, include: Predicate<T>, result: List<T>) -> List<T> [consume result] {
    branch {
        values.empty?() -> result
        include(values.head()) -> filter_into(values.rest(), include, result.append(values.head()))
        _ -> filter_into(values.rest(), include, move result)
    }
}

/// Returns the first element of a sequence, if one exists.
///
/// The sequence is consumed because the returned generic element is owned.
pub func first<T>(values: Sequence<T>) -> Option<T> [consume values] {
    branch {
        values.empty?() -> Option.None
        _ -> Option.Some(values.head())
    }
}

/// Returns the final element of a sequence, if one exists.
///
/// The sequence is consumed because the returned generic element is owned.
pub func last<T>(values: Sequence<T>) -> Option<T> [consume values] {
    branch {
        values.empty?() -> Option.None
        values.rest().empty?() -> Option.Some(values.head())
        _ -> last(values.rest())
    }
}

/// Reduces the sequence from left to right, consuming its elements and the initial accumulator.
pub func fold<T, U>(values: Sequence<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [consume values, consume initial] {
    branch {
        values.empty?() -> initial
        _ -> fold(values.rest(), combine(move initial, values.head()), combine)
    }
}

/// Returns the first element satisfying `predicate`, consuming the sequence to return an owned value.
pub func find<T>(values: Sequence<T>, predicate: Predicate<T>) -> Option<T> [consume values] {
    branch {
        values.empty?() -> Option.None
        predicate(values.head()) -> Option.Some(values.head())
        _ -> find(values.rest(), predicate)
    }
}

/// Returns whether at least one sequence element satisfies `predicate`.
pub func any?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {
    branch {
        values.empty?() -> false
        predicate(values.head()) -> true
        _ -> any?(values.rest(), predicate)
    }
}

/// Returns whether every sequence element satisfies `predicate`.
pub func all?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {
    branch {
        values.empty?() -> true
        predicate(values.head()) -> all?(values.rest(), predicate)
        _ -> false
    }
}

/// Returns whether no sequence element satisfies `predicate`.
pub func none?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {
    !any?(values, predicate)
}

/// Returns whether the sequence contains an element equal to `expected`.
pub func contains?<T>(values: Sequence<T>, expected: T) -> Bool {
    branch {
        values.empty?() -> false
        values.head() == expected -> true
        _ -> contains?(values.rest(), expected)
    }
}

/// Counts the sequence elements satisfying `predicate`.
pub func count<T>(values: Sequence<T>, predicate: Predicate<T>) -> Int {
    branch {
        values.empty?() -> 0
        predicate(values.head()) -> 1 + count(values.rest(), predicate)
        _ -> count(values.rest(), predicate)
    }
}

/// Returns at most the first `count` sequence elements as a list.
pub func take<T>(values: Sequence<T>, count: Int) -> List<T> {
    take_into(values, count, [])
}

test "sequence algorithms operate on lists without conversion" {
    let values = map([1, 2, 3], (value: Int) -> value + 10)
    assert(values.length == 3)
    assert(values[0] == 11)
    assert(count(values, (value: Int) -> value > 11) == 2)
    ()
}

/// Copies at most `count` remaining elements into the result accumulator.
func take_into<T>(values: Sequence<T>, count: Int, result: List<T>) -> List<T> [consume result] {
    branch {
        count <= 0 -> result
        values.empty?() -> result
        _ -> take_into(values.rest(), count - 1, result.append(values.head()))
    }
}
