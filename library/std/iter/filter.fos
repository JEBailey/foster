//! Lazy iterator filtering.

import core.functions
import core.option
import std.iter

type FilterIterator<T> = & Iterator<T> & {
    source: Iterator<T>
    predicate: Predicate<T>
}

/// Pulls until a filtered iterator finds a matching value or reaches exhaustion.
func FilterIterator.next<T>(self: FilterIterator<T>) -> Option<T> {
    loop {
        branch self.source.next() {
            Option.Some(value) -> {
                return Option.Some(value) if self.predicate(value)
                ()
            }
            Option.None -> { break }
        }
    }
    Option.None
}

/// Lazily retains this iterator's remaining elements that satisfy `predicate`.
pub func Iterator.filter<T>(self: Iterator<T>, predicate: Predicate<T>) -> Iterator<T> [consume self, consume predicate] {
    FilterIterator { source: move self, predicate: move predicate }
}

test "filtered iterators retain matching values" {
    let values = [1, 2, 3, 4].iterator().filter((value: Int) -> value > 2).collect()
    assert(values.length == 2)
    assert(values[0] == 3)
    ()
}
