//! A lazy upper bound on the number of yielded items.
//!
//! take owns its source. Once the requested count is reached it returns `None`
//! without requesting another source item. Nonpositive counts yield no items.

import core.option.Option

import std.iter.Iterator

type TakeIterator<T> = & Iterator<T> & {
    source: Iterator<T>
    remaining: Int
}

impl TakeIterator<T> {
    /// Pulls one value while the take limit remains positive.
    func next(self: Self) -> Option<T> {
        branch {
            self.remaining <= 0 -> Option.None
            _ -> self.take_next()
        }
    }

    /// Decrements a positive take limit before pulling from the source iterator.
    func take_next(self: Self) -> Option<T> {
        self.remaining = self.remaining - 1
        self.source.next()
    }
}

impl Iterator<T> {
    /// Consumes this iterator and lazily yields at most `amount` remaining elements.
    /// Nonpositive amounts never pull the source; reaching the limit makes no extra source call.
    pub func take(self: Self, amount: Int) -> Iterator<T> [consume self] {
        TakeIterator {
            source: move self, remaining: amount
        }
    }
}

test "taking limits iterator output" {
    let values = [1, 2, 3].iterator().take(2).collect()
    assert(values.length == 2)
    assert(values[1] == 2)
    ()
}
