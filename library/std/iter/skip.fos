//! Lazy omission of an iterator prefix.

import core.option
import std.iter

type SkipIterator<T> = & Iterator<T> & {
    source: Iterator<T>
    remaining: Int
}

/// Discards the configured prefix before yielding source values.
func SkipIterator.next<T>(self: SkipIterator<T>) -> Option<T> {
    branch {
        self.remaining <= 0 -> self.source.next()
        _ -> self.skip_next()
    }
}

/// Discards one source value while the skip count remains positive.
func SkipIterator.skip_next<T>(self: SkipIterator<T>) -> Option<T> {
    branch self.source.next() {
        Option.Some(_) -> self.decrement_and_continue()
        Option.None -> Option.None
    }
}

/// Decrements the skip count and continues looking for the first yielded value.
func SkipIterator.decrement_and_continue<T>(self: SkipIterator<T>) -> Option<T> {
    self.remaining = self.remaining - 1
    self.next()
}

/// Lazily discards the first `amount` remaining elements.
pub func Iterator.skip<T>(self: Iterator<T>, amount: Int) -> Iterator<T> [consume self] {
    SkipIterator { source: move self, remaining: amount }
}

test "skipping removes an iterator prefix" {
    let values = [1, 2, 3].iterator.skip(2).collect()
    assert(values.length == 1)
    assert(values[0] == 3)
    ()
}
