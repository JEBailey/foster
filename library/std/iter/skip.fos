//! Lazy removal of an iterator prefix.
//!
//! skip owns its source and discards the requested prefix when iteration begins.
//! Nonpositive counts discard nothing. Skipping beyond the source exhausts it.

import core.option.Option

import std.iter.Iterator

type SkipIterator<T> = & Iterator<T> & {
    source: Iterator<T>
    remaining: Int
}

impl SkipIterator<T> {
    /// Discards the configured prefix before yielding source values.
    func next(self: Self) -> Option<T> {
        while self.remaining > 0 {
            branch self.source.next() {
                Option.Some(_) -> {
                    self.remaining = self.remaining - 1
                    ()
                }
                Option.None -> {
                    return Option.None
                }
            }
        }
        self.source.next()
    }
}

impl Iterator<T> {
    /// Consumes this iterator and discards up to `amount` elements on the first pull.
    /// Nonpositive amounts discard nothing; construction does not advance the source.
    pub func skip(self: Self, amount: Int) -> Iterator<T> [consume self] {
        SkipIterator {
            source: move self, remaining: amount
        }
    }
}

test "skipping removes an iterator prefix" {
    let values = [1, 2, 3].iterator().skip(2).collect()
    assert(values.length == 1)
    assert(values[0] == 3)
    ()
}
