//! Lazy iterator transformation.

import core.option
import std.iter

type MapIterator<T, U> = & Iterator<U> & {
    source: Iterator<T>
    transform: func(consume T) -> U
}

/// Pulls and transforms one value from a mapped iterator.
func next<T, U>(self: MapIterator<T, U>) -> Option<U> {
    branch self.source.next() {
        Option.Some(value) -> Option.Some(self.transform(move value))
        Option.None -> Option.None
    }
}

/// Lazily transforms this iterator's remaining elements.
pub func map<T, U>(self: Iterator<T>, transform: func(consume T) -> U) -> Iterator<U> [consume self, consume transform] {
    MapIterator { source: move self, transform: move transform }
}

test "mapped iterators transform lazily" {
    let values = map([1, 2, 3].iterator, (value: Int) -> value * 3).collect()
    assert(values.length == 3)
    assert(values[2] == 9)
    ()
}
