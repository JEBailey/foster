//! Lazy transformation of iterator items.
//!
//! map owns its input iterator and invokes the transform when an item is requested.
//! Constructing the adaptor does not traverse the source or materialize a list.

import core.option.Option

import std.iter.Iterator

type MapIterator<T, U> = & Iterator<U> & {
    source: Iterator<T>
    transform: func(consume T) -> U [reshape captures]
}

impl MapIterator<T, U> {
    /// Pulls and transforms one value from a mapped iterator.
    func next(self: Self) -> Option<U> {
        branch self.source.next() {
            Option.Some(value) -> Option.Some(self.transform(move value))
            Option.None -> Option.None
        }
    }
}

impl Iterator<T> {
    /// Consumes this iterator and `transform`; calls the transform once per yielded source item.
    /// Each input is transferred to the callback. Construction does not evaluate the callback.
    /// The callback may mutate borrowed captures; the iterator must not outlive those captures.
    pub func map<U>(self: Self, transform: func(consume T) -> U [reshape captures]) -> Iterator<U> [consume self, consume transform] {
        MapIterator {
            source: move self, transform: move transform
        }
    }
}

test "mapped iterators transform lazily" {
    let values = [1, 2, 3].iterator().map((value: Int) -> value * 3).collect()
    assert(values.length == 3)
    assert(values[2] == 9)
    ()
}
