//! Stateful iterators, consumers, and lazy pipeline construction.

import core.functions
import core.option
import core.list
import core.bytes
import core.byte

/// A stateful source that yields one value at a time.
///
/// Calling `next` mutates the iterator cursor and returns `None` after exhaustion.
pub type Iterator<T> = {
    /// Advances this iterator and returns its next value, if one remains.
    pub func next(self) -> Option<T> [mut self]
}

/// A value that can create an independent iterator over a read-only view of its elements.
pub type Iterable<T> = {
    /// Creates an iterator positioned before this iterable's first element.
    pub func iterator(self) -> Iterator<T>
}

type SequenceIterator<T> = & Iterator<T> & {
    remaining: Sequence<T>
}

/// Keeps one stable list snapshot and advances without constructing suffix lists.
type ListIterator<T> = & Iterator<T> & {
    values: List<T>
    index: Int
}

impl ListIterator {
    /// Reads the next indexed element, retaining the backing snapshot until release.
    func next<T>(self: ListIterator<T>) -> Option<T> {
        branch {
            self.index >= self.values.length -> Option.None
            _ -> {
                let value = self.values[self.index]
                self.index = self.index + 1
                Option.Some(value)
            }
        }
    }
}

/// Advances through one immutable byte snapshot.
type BytesIterator = & Iterator<Byte> & {
    data: Bytes
    index: Int
}

impl BytesIterator {
    /// Returns the next byte, or None after exhaustion.
    func next(self: BytesIterator) -> Option<Byte> {
        branch {
            self.index >= self.data.length -> Option.None
            _ -> {
                let value = self.data[self.index]
                self.index = self.index + 1
                Option.Some(value)
            }
        }
    }
}

impl SequenceIterator {
    /// Advances a sequence-backed iterator unless it has been exhausted.
    func next<T>(self: SequenceIterator<T>) -> Option<T> {
        branch {
            self.remaining.empty?() -> Option.None
            _ -> self.advance()
        }
    }

    /// Removes and returns the current head of a non-empty sequence cursor.
    func advance<T>(self: SequenceIterator<T>) -> Option<T> {
        let value = self.remaining.head()
        self.remaining = self.remaining.rest()
        Option.Some(value)
    }
}

impl Iterator {
    /// Compiler-selected constructor for a list snapshot.
    func from_list<T>(values: List<T>) -> Iterator<T> [consume values] {
        ListIterator { values: move values, index: 0 }
    }

    /// Compiler-selected constructor for a byte snapshot.
    func from_bytes(values: Bytes) -> Iterator<Byte> [consume values] {
        BytesIterator { data: move values, index: 0 }
    }

    /// Consumes a sequence into an independent stateful iterator.
    pub func from_sequence<T>(values: Sequence<T>) -> Iterator<T> [consume values] {
        SequenceIterator { remaining: move values }
    }

    /// Calls `action` once for every remaining element without growing the call stack.
    pub func for_each<T>(self: Iterator<T>, action: Consumer<T>) -> () [mut self] {
        loop {
            branch self.next() {
                Option.Some(value) -> action(move value)
                Option.None -> { break }
            }
        }
        ()
    }

    /// Reduces every remaining element into one owned accumulator, from left to right.
    pub func fold<T, U>(self: Iterator<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [mut self, consume initial] {
        let accumulated = move initial
        loop {
            branch self.next() {
                Option.Some(value) -> {
                    accumulated = combine(move accumulated, move value)
                    ()
                }
                Option.None -> { break }
            }
        }
        accumulated
    }

    /// Returns the first match, leaving later elements unconsumed.
    pub func find<T>(self: Iterator<T>, predicate: Predicate<T>) -> Option<T> [mut self] {
        loop {
            branch self.next() {
                Option.Some(value) -> {
                    return Option.Some(value) if predicate(value)
                    ()
                }
                Option.None -> { break }
            }
        }
        Option.None
    }

    /// Stops pulling as soon as an element satisfies `predicate`.
    pub func any?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {
        loop {
            branch self.next() {
                Option.Some(value) -> {
                    return true if predicate(value)
                    ()
                }
                Option.None -> { break }
            }
        }
        false
    }

    /// Stops pulling as soon as an element fails `predicate`.
    pub func all?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {
        loop {
            branch self.next() {
                Option.Some(value) -> {
                    return false if !predicate(value)
                    ()
                }
                Option.None -> { break }
            }
        }
        true
    }

    /// Counts every remaining element and leaves the iterator exhausted.
    pub func count<T>(self: Iterator<T>) -> Int [mut self] {
        let total = 0
        loop {
            branch self.next() {
                Option.Some(_) -> {
                    total = total + 1
                    ()
                }
                Option.None -> { break }
            }
        }
        total
    }

    /// Collects the remaining elements into one growing list.
    pub func collect<T>(self: Iterator<T>) -> List<T> [mut self] {
        let output = []
        loop {
            branch self.next() {
                Option.Some(value) -> output.push(value)
                Option.None -> { break }
            }
        }
        output
    }
}

test "iterator consumers process every remaining value" {
    let iterator = [1, 2, 3].iterator()
    let total = iterator.fold(0, (sum: Int, value: Int) -> sum + value)
    assert(total == 6)
}

test "iterator predicates stop before pulling later values" {
    let source = [1, 2, 3, 4].iterator()
    assert(source.any?((value: Int) -> value == 2))
    assert(source.next() == Option.Some(3))
    assert(!source.all?((value: Int) -> value < 4))
    assert(source.next() == Option.None)
}
