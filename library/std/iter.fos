//! Stateful iterators, consumers, and lazy pipeline construction.

import core.functions
import core.option

/// A stateful source that yields one value at a time.
///
/// Calling `next` mutates the iterator cursor and returns `None` after exhaustion.
pub type Iterator<T> = {
    /// Advances this iterator and returns its next value, if one remains.
    pub func next(self) -> Option<T> [mut self]
}

/// A value that can create an independent iterator over a read-only view of its elements.
pub type Iterable<T> = {
    /// Creates an iterator positioned before this iterable's first element.
    pub func iterator(self) -> Iterator<T>
}

type SequenceIterator<T> = & Iterator<T> & {
    remaining: Sequence<T>
}

/// Advances a sequence-backed iterator unless it has been exhausted.
func SequenceIterator.next<T>(self: SequenceIterator<T>) -> Option<T> {
    branch {
        self.remaining.empty? -> Option.None
        _ -> self.advance()
    }
}

/// Removes and returns the current head of a non-empty sequence cursor.
func SequenceIterator.advance<T>(self: SequenceIterator<T>) -> Option<T> {
    let value = self.remaining.head
    self.remaining = self.remaining.rest
    Option.Some(value)
}

/// Consumes a sequence into an independent stateful iterator.
pub func Iterator.from_sequence<T>(values: Sequence<T>) -> Iterator<T> [consume values] {
    SequenceIterator { remaining: move values }
}

/// Calls `action` once for every remaining element in this iterator.
pub func Iterator.for_each<T>(self: Iterator<T>, action: Consumer<T>) -> () [mut self] {
    branch self.next() {
        Option.Some(value) -> self.apply_and_continue(action, move value)
        Option.None -> finish_iteration()
    }
}

/// Produces the unit result when iteration finishes.
func finish_iteration() -> () {}

/// Applies one action and continues consuming the iterator.
func Iterator.apply_and_continue<T>(self: Iterator<T>, action: Consumer<T>, value: T) -> () [mut self, consume value] {
    action(move value)
    self.for_each(action)
}

/// Reduces every remaining element into `initial` from left to right.
pub func Iterator.fold<T, U>(self: Iterator<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [mut self, consume initial] {
    branch self.next() {
        Option.Some(value) -> self.fold(combine(move initial, move value), combine)
        Option.None -> initial
    }
}

/// Returns the first remaining element satisfying `predicate`.
pub func Iterator.find<T>(self: Iterator<T>, predicate: Predicate<T>) -> Option<T> [mut self] {
    branch self.next() {
        Option.Some(value) -> branch {
            predicate(value) -> Option.Some(value)
            _ -> self.find(predicate)
        }
        Option.None -> Option.None
    }
}

/// Returns whether any remaining element satisfies `predicate`.
pub func Iterator.any?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {
    branch self.next() {
        Option.Some(value) -> branch {
            predicate(value) -> true
            _ -> self.any?(predicate)
        }
        Option.None -> false
    }
}

/// Returns whether every remaining element satisfies `predicate`.
pub func Iterator.all?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {
    branch self.next() {
        Option.Some(value) -> branch {
            predicate(value) -> self.all?(predicate)
            _ -> false
        }
        Option.None -> true
    }
}

/// Counts every remaining element and leaves the iterator exhausted.
pub func Iterator.count<T>(self: Iterator<T>) -> Int [mut self] {
    branch self.next() {
        Option.Some(_) -> 1 + self.count()
        Option.None -> 0
    }
}

/// Collects every remaining element into a list and leaves this iterator exhausted.
pub func Iterator.collect<T>(self: Iterator<T>) -> List<T> [mut self] {
    self.collect_into([])
}

test "iterator consumers process every remaining value" {
    let iterator = [1, 2, 3].iterator
    let total = iterator.fold(0, (sum: Int, value: Int) -> sum + value)
    assert(total == 6)
}

/// Pulls remaining elements into the owned list accumulator.
func Iterator.collect_into<T>(self: Iterator<T>, result: List<T>) -> List<T> [mut self, consume result] {
    branch self.next() {
        Option.Some(value) -> self.collect_into(result.append(value))
        Option.None -> result
    }
}
