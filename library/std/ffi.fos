//! Synchronous calls through explicitly compiled C bridges on Windows x86-64.
//!
//! Binding manifests and native libraries are trusted code. Build them with
//! `foster bridge`; loading never compiles sources. Arguments and results are
//! copied. C cannot retain input pointers. Reviewed callback/context pairs
//! invoke handlers on their owning thread or queue copied notifications. Resources
//! have one owner, close on scope exit, and cannot cross a remote boundary.

import core.byte

import core.bytes.Bytes

import core.bytes.buffer.ByteBuffer

import core.int.Int

import core.list

import core.result.Result

import core.string.String

/// Private access to the shared VM/native bridge runtime.
type CHost = {}
impl CHost {
    /// Transfers an adapter into the owner-thread callback registry.
    func callback_new<F>(callback: F, signature: String, mode: Int) -> Bytes [consume callback] = intrinsic("c.callback_new")
    /// Releases an unregistered callback and its owned captures.
    func callback_release(token: Int) -> () = intrinsic("c.callback_release")
    /// Delivers a bounded snapshot of queued notifications on the owning thread.
    func callback_poll(token: Int) -> Bytes = intrinsic("c.callback_poll")
    /// Retrieves and clears the first callback failure.
    func callback_error(token: Int) -> Bytes = intrinsic("c.callback_error")
    /// Executes a validated operation; resource construction is a separate mode.
    func exchange(path: String, schema: String, operation: Int, token: Int, create: Bool, payload: Bytes) -> Bytes = intrinsic("c.exchange")
    /// Returns the consumed flag and native close status.
    func close(token: Int) -> Bytes = intrinsic("c.close")
    /// Performs unconditional cleanup of a still-owned resource.
    func release(token: Int) -> () = intrinsic("c.release")
    /// Encodes a signed integer's exact eight bytes.
    func encode_int(value: Int) -> Bytes = intrinsic("c.encode_int")
    /// Encodes IEEE binary64 bytes without decimal conversion.
    func encode_float(value: Float) -> Bytes = intrinsic("c.encode_float")
    /// Decodes a checked eight-byte integer payload.
    func decode_int(value: Bytes) -> Int = intrinsic("c.decode_int")
    /// Decodes a checked eight-byte float payload.
    func decode_float(value: Bytes) -> Float = intrinsic("c.decode_float")
}

/// A bridge or C operation failure. Native close codes appear in `status`;
/// validation/loading failures use zero and explain the failure in `message`.
pub type CError = {
    pub message: String, pub status: Int
}
impl CError {
    /// Encodes a callback failure without allowing an exception through C.
    pub func callback_reply(self) -> Bytes {
        envelope(Byte.unchecked(1), self.message.bytes)
    }
}

/// Copied wire arguments. Integer slots contain all 64 bits; unsigned C values
/// use the same bits. Narrow integer parameters are range checked by the bridge.
pub type CArguments = {
    payload: ByteBuffer
}
impl CArguments {
    /// Encodes a successful callback reply; generated adapters validate its shape.
    pub func reply(self) -> Bytes {
        envelope(Byte.unchecked(0), self.payload.snapshot())
    }
    /// Starts an empty argument list.
    pub func empty() -> CArguments {
        CArguments {
            payload: ByteBuffer.empty()
        }
    }
    /// Appends one exact integer slot. U64 interprets its bits as unsigned.
    pub func integer(self, value: Int) -> () [reshape self.payload.value.items] {
        self.payload.extend(CHost.encode_int(value))
        ()
    }
    /// Appends one binary64 slot. C float narrows with an overflow check.
    pub func floating(self, value: Float) -> () [reshape self.payload.value.items] {
        self.payload.extend(CHost.encode_float(value))
        ()
    }
    /// Copies a length-delimited buffer, including embedded zero bytes.
    pub func bytes(self, value: Bytes) -> () [reshape self.payload.value.items] {
        self.payload.extend(CHost.encode_int(value.length))
        self.payload.extend(value)
        ()
    }
    /// Copies UTF-8 and appends one NUL terminator. The bridge rejects interior
    /// NUL bytes before calling C; C must not retain this temporary pointer.
    pub func c_string(self, value: String) -> () [reshape self.payload.value.items] {
        self.payload.extend(CHost.encode_int(value.bytes.length + 1))
        self.payload.extend(value.bytes)
        self.payload.push(Byte.unchecked(0))
        ()
    }
}

/// A copied result. Scalar conversions check the exact payload length.
pub type CValue = {
    data: Bytes
}
impl CValue {
    /// Decodes a copied callback argument packet. This never exposes native memory.
    pub func callback_packet(payload: Bytes) -> Result<CValue, CError> {
        Result.Ok(CValue {
            data: payload.copy()
        })
    }
    /// Copies one length-prefixed component of a compound result. Every frame
    /// is validated, including frames after the requested index. Native pointers
    /// never escape through this interface; lengths are bounded by the packet.
    pub func part(self, index: Int) -> Result<CValue, CError> {
        return Result.Error(CError {
            message: "negative C result component", status: 0
        }) if index < 0
        let offset = 0
        let current = 0
        let selected = Bytes.empty()
        let found = false
        while offset < self.data.length {
            return Result.Error(CError {
                message: "truncated C result frame", status: 0
            }) if self.data.length - offset < 8
            let length = CHost.decode_int(self.data.slice(offset, offset + 8))
            offset = offset + 8
            return Result.Error(CError {
                message: "invalid C result frame length", status: 0
            }) if length < 0 || length > self.data.length - offset
            if current == index {
                selected = self.data.slice(offset, offset + length)
                found = true
            }
            offset = offset + length
            current = current + 1
        }
        return Result.Error(CError {
            message: "missing C result component", status: 0
        }) if !found
        Result.Ok(CValue {
            data: move selected
        })
    }
    /// Checks the exact number of eight-byte scalar slots in a copied record.
    /// Counts outside 0..8191 fail without arithmetic overflow.
    pub func check_slots(self, count: Int) -> Result<(), CError> {
        return Result.Error(CError {
            message: "invalid C record slot count", status: 0
        }) if count < 0 || count > 8191
        return Result.Error(CError {
            message: "C record payload size mismatch", status: 0
        }) if self.data.length != count * 8
        Result.Ok(())
    }
    /// Copies one eight-byte scalar slot from a record. The index is zero-based;
    /// negative/out-of-range indexes and partial-slot payloads return an error.
    pub func slot(self, index: Int) -> Result<CValue, CError> {
        return Result.Error(CError {
            message: "invalid C record slot", status: 0
        }) if index < 0 || self.data.length / 8 * 8 != self.data.length || index >= self.data.length / 8
        Result.Ok(CValue {
            data: self.data.slice(index * 8, index * 8 + 8)
        })
    }
    /// Reads a signed integer; U64 results preserve their bits in an Int.
    pub func integer(self) -> Result<Int, CError> {
        return Result.Error(CError {
            message: "C integer requires eight bytes", status: 0
        }) if self.data.length != 8
        Result.Ok(CHost.decode_int(self.data))
    }
    /// Reads a binary64 result, including widened C float results.
    pub func floating(self) -> Result<Float, CError> {
        return Result.Error(CError {
            message: "C float requires eight bytes", status: 0
        }) if self.data.length != 8
        Result.Ok(CHost.decode_float(self.data))
    }
    /// Returns an independent buffer copy.
    pub func bytes(self) -> Bytes {
        self.data.copy()
    }
    /// Validates copied UTF-8; embedded NUL bytes remain ordinary text content.
    pub func text(self) -> Result<String, CError> {
        branch String.from_utf8(self.data.copy()) {
            Result.Ok(value) -> Result.Ok(value)
            Result.Error(_) -> Result.Error(CError {
                message: "C result is not UTF-8", status: 0
            })
        }
    }
}

/// A name for an explicitly built bridge. Operations use manifest order, starting
/// at zero. Relative names resolve against FOSTER_BRIDGE_DIR, the current
/// directory, and the executable directory, trying the full name before the
/// bare file name; absolute names load as given. Dependent DLLs resolve beside
/// the bridge or in System32. Opening stores the name; first use resolves it
/// and validates the library ABI. Successful resolutions stay pinned in the
/// thread's bridge registry, even if directories or environment settings change.
/// Failed resolutions are retried on the next call.
pub type CBridge = {
    path: String, schema: String
}
impl CBridge {
    /// Calls C with a callback borrowed for this call only. The adapter is consumed
    /// and released before return; its borrowed captures must remain live throughout.
    /// One callback/context pair is inserted between the two argument packets.
    pub func call_with<F>(self, operation: Int, before: CArguments, after: CArguments, callback: F, signature: String) -> Result<CValue, CError> [read self.path, read self.schema, read before.payload.value, read after.payload.value, read signature, consume callback] {
        let token = try (try decode_response(CHost.callback_new(move callback, signature, 0))).integer()
        let lease = CCallbackLease {
            token
        }
        let packet = ByteBuffer.empty()
        packet.extend(before.payload.snapshot())
        packet.extend(CHost.encode_int(token))
        packet.extend(after.payload.snapshot())
        let payload = (move packet).freeze()
        let response = CHost.exchange(self.path, self.schema, operation, 0, false, payload)
        try decode_response(CHost.callback_error(token))
        decode_response(response)
    }
    /// Creates a native registration owning its callback. Retained captures must
    /// contain no borrowed references. Queued notifications are delivered by
    /// poll_callbacks; direct callbacks run only on the registering thread.
    /// The native destructor must unregister and quiesce before returning.
    pub func subscribe<F>(self, operation: Int, before: CArguments, after: CArguments, callback: F, signature: String, queued: Bool) -> Result<CResource, CError> [read self.path, read self.schema, read before.payload.value, read after.payload.value, read signature, consume callback] {
        let mode = branch {
            queued -> 2 _ -> 1
        }
        let token = try (try decode_response(CHost.callback_new(move callback, signature, mode))).integer()
        let lease = CCallbackLease {
            token
        }
        let packet = ByteBuffer.empty()
        packet.extend(before.payload.snapshot())
        packet.extend(CHost.encode_int(token))
        packet.extend(after.payload.snapshot())
        let payload = (move packet).freeze()
        let value = try decode_response(CHost.exchange(self.path, self.schema, operation, 0, true, payload))
        let resource = CResource {
            token: try value.integer(), callback: token
        }
        lease.token = 0
        try resource.check_callbacks()
        Result.Ok(move resource)
    }
    /// Selects a reviewed native bridge by name and the schema identifier
    /// emitted by `foster bridge`. A mismatched schema fails before calling C.
    pub func at(path: String, schema: String) -> CBridge [consume path, consume schema] {
        CBridge {
            path: move path, schema: move schema
        }
    }
    /// Calls a scalar, value-record, void or copied-buffer operation. Rejects constructors.
    pub func call(self, operation: Int, arguments: CArguments) -> Result<CValue, CError> {
        decode_response(CHost.exchange(self.path, self.schema, operation, 0, false, arguments.payload.snapshot()))
    }
    /// Adopts exactly one non-null C allocation, or returns an error without
    /// leaking a partial result. Only constructor operations are accepted.
    pub func create(self, operation: Int, arguments: CArguments) -> Result<CResource, CError> {
        let value = try decode_response(CHost.exchange(self.path, self.schema, operation, 0, true, arguments.payload.snapshot()))
        let token = try value.integer()
        Result.Ok(CResource {
            token, callback: 0
        })
    }
}

/// An opaque, non-copyable owner. Private fields prevent fabrication or extracting
/// a C pointer. Receiver calls mutate conservatively. Close errors can retain the
/// resource; deinit always destroys a remaining owner using its cleanup function.
pub type CResource = {
    token: Int, callback: Int
}
impl CResource {
    /// Appends this live owner's token. The bridge checks its kind, module,
    /// thread, and call lease before resolving it to a native pointer.
    pub func argument(self, arguments: CArguments) -> Result<(), CError> [read self.token, reshape arguments.payload.value.items] {
        return Result.Error(CError {
            message: "C resource is closed", status: 0
        }) if self.token == 0
        arguments.integer(self.token)
        Result.Ok(())
    }
    /// Delivers queued notifications on the registering thread. Processes only
    /// the events pending at entry and returns the first handler/queue failure.
    pub func poll_callbacks(self) -> Result<(), CError> [mut self.callback] {
        return Result.Ok(()) if self.callback == 0
        self.callback = self.callback
        try decode_response(CHost.callback_poll(self.callback))
        Result.Ok(())
    }
    /// Reports and clears a callback failure without invoking queued handlers.
    pub func check_callbacks(self) -> Result<(), CError> [mut self.callback] {
        return Result.Ok(()) if self.callback == 0
        self.callback = self.callback
        try decode_response(CHost.callback_error(self.callback))
        Result.Ok(())
    }
    /// Calls an operation for this resource type. Errors leave ownership intact.
    pub func call(self, operation: Int, arguments: CArguments) -> Result<CValue, CError> [mut self.token, mut self.callback] {
        return Result.Error(CError {
            message: "C resource is closed", status: 0
        }) if self.token == 0
        // Native state changes must participate in the slot's mutation effect.
        self.token = self.token
        let response = CHost.exchange("", "", operation, self.token, false, arguments.payload.snapshot())
        try self.check_callbacks()
        decode_response(response)
    }
    /// Attempts close. Success destroys the owner; an error preserves or clears
    /// it according to the reviewed native close contract. Repeated close succeeds.
    pub func close(self) -> Result<(), CError> [mut self.token, mut self.callback] {
        return Result.Ok(()) if self.token == 0
        let response = try decode_response(CHost.close(self.token))
        let callback_response = branch {
            self.callback == 0 -> envelope(Byte.unchecked(0), Bytes.empty()) _ -> CHost.callback_error(self.callback)
        }
        if response.data[0] != Byte.unchecked(0) {
            self.token = 0
            CHost.callback_release(self.callback)
            self.callback = 0
        }
        let status = CHost.decode_int(response.data.slice(1, 9))
        branch {
            status == 0 -> {
                try decode_response(callback_response)
                Result.Ok(())
            }
            _ -> Result.Error(CError {
                message: "C close failed", status
            })
        }
    }
    /// Unconditionally destroys any remaining allocation on ownership cleanup.
    func deinit(self) -> () {
        CHost.release(self.token)
        return () if self.callback == 0
        let response = CHost.callback_error(self.callback)
        CHost.callback_release(self.callback)
        branch decode_response(response) {
            Result.Ok(_) -> ()
            Result.Error(error) -> panic(error.message)
        }
    }
}

// Private so a borrowed callback cannot escape call_with through a token owner.
type CCallbackLease = {
    token: Int
}
impl CCallbackLease {
    func deinit(self) -> () {
        CHost.callback_release(self.token)
    }
}

// Builds a binary status byte followed by copied payload bytes.
func envelope(status: Byte, payload: Bytes) -> Bytes {
    let packet = ByteBuffer.empty()
    packet.push(status)
    packet.extend(payload)
    (move packet).freeze()
}

/// Validates the private response envelope and exposes only copied bytes.
func decode_response(octets: Bytes) -> Result<CValue, CError> {
    return Result.Error(CError {
        message: "empty C response", status: 0
    }) if octets.length == 0
    let payload = octets.slice(1, octets.length)
    branch {
        octets[0] == Byte.unchecked(0) -> Result.Ok(CValue {
            data: move payload
        })
        _ -> Result.Error(CError {
            message: String.from_utf8(move payload).unwrap_or("C bridge failure"), status: 0
        })
    }
}

test "record slots reject partial payloads and overflowing indexes" {
    let value = CValue {
        data: Bytes.from_hex("01000000000000000200000000000000").unwrap_or(Bytes.empty())
    }
    branch value.check_slots(2) {
        Result.Ok(_) -> () Result.Error(_) -> panic("valid record rejected")
    }
    let first = branch value.slot(0) {
        Result.Ok(slot) -> slot Result.Error(_) -> panic("valid slot rejected")
    }
    assert(first.integer().unwrap_or(0) == 1)
    for index in [-1, 2, 9223372036854775807] {
        branch value.slot(index) {
            Result.Error(_) -> () Result.Ok(_) -> panic("invalid slot accepted")
        }
    }
    for count in [-1, 1, 8192, 9223372036854775807] {
        branch value.check_slots(count) {
            Result.Error(_) -> () Result.Ok(_) -> panic("invalid size accepted")
        }
    }
    let partial = CValue {
        data: Bytes.from_hex("00").unwrap_or(Bytes.empty())
    }
    branch partial.slot(0) {
        Result.Error(_) -> () Result.Ok(_) -> panic("partial slot accepted")
    }
}

test "compound results validate every frame before copying a component" {
    let value = CValue {
        data: Bytes.from_hex("01000000000000002a0000000000000000").unwrap_or(Bytes.empty())
    }
    let first = branch value.part(0) {
        Result.Ok(part) -> part Result.Error(_) -> panic("valid frame rejected")
    }
    assert(first.bytes().hex() == "2a")
    let empty = branch value.part(1) {
        Result.Ok(part) -> part Result.Error(_) -> panic("empty frame rejected")
    }
    assert(empty.bytes().length == 0)
    for index in [-1, 2, 9223372036854775807] {
        branch value.part(index) {
            Result.Error(_) -> () Result.Ok(_) -> panic("missing frame accepted")
        }
    }
    for packet in ["00", "ffffffffffffffff", "ffffffffffffff7f", "02000000000000002a", "01000000000000002a00"] {
        let malformed = CValue {
            data: Bytes.from_hex(packet).unwrap_or(Bytes.empty())
        }
        branch malformed.part(0) {
            Result.Error(_) -> () Result.Ok(_) -> panic("malformed frame accepted")
        }
    }
}

test "binary argument packets preserve zeros and prior snapshots" {
    let arguments = CArguments.empty()
    arguments.integer(-1)
    let first = arguments.reply()
    arguments.bytes(Bytes.from_hex("00ff0080").unwrap_or(Bytes.empty()))
    assert(first.length == 9)
    assert(first[0] == Byte.unchecked(0))
    let value = decode_response(arguments.reply()).unwrap_or(CValue {
        data: Bytes.empty()
    })
    assert(value.data.length == 20)
    assert(CHost.decode_int(value.data.slice(0, 8)) == -1)
    assert(CHost.decode_int(value.data.slice(8, 16)) == 4)
    assert(value.data.slice(16, 20).hex() == "00ff0080")
    let error = CError {
        message: "failure: λ", status: 0
    }
    branch decode_response(error.callback_reply()) {
        Result.Error(decoded) -> {
            assert(decoded.message == error.message)
            ()
        }
        Result.Ok(_) -> panic("error response accepted as success")
    }
}
