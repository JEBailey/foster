//! Associative collection contracts and insertion-ordered list maps.
//!
//! `Map<K, V>` defines the shared API. `Map.empty` constructs `ListMap`, whose key searches
//! are linear. Use std.collections.hash_map for hashed lookup. borrow returns a reference;
//! remove transfers a value and preserves the map. put consumes and returns the updated collection.

import core.option.Option

import std.collections.Collection

import std.iter.Iterator

/// A key-value pair yielded while iterating a map.
pub type Entry<K, V> = {
    pub key: K
    pub value: V
}

/// An associative collection with unique keys and implementation-defined iteration order.
/// Lookup borrows the stored value. Removal mutates the map and transfers the selected value.
/// put consumes and returns the concrete implementation; membership checks borrow it.
pub type Map<K, V> = & Collection<Entry<K, V>> & {
    /// Borrows the stored value; absent keys return `None`. No `Copy` is required.
    /// The reference permits mutation and cannot outlive or survive reshaping the map.
    pub func borrow(self: Self, key: K) -> Option<ref[self] V> [read self, read key]
    /// Removes and returns the owned value, preserving all other entries; absent keys return `None`.
    pub func remove(self: Self, key: K) -> Option<V> [read key, reshape self]
    /// Tests key membership without consuming the map.
    pub func contains_key?(self: Self, key: K) -> Bool [read self, read key]
    /// Consumes the map, `key`, and `value`, returning the updated concrete implementation.
    /// Replaces an equal key and releases its previous entry; iteration order depends on the implementation.
    pub func put(self: Self, key: K, value: V) -> Self [mut self, consume self, consume key, consume value]
    /// Consumes the map and returns its keys in iteration order.
    pub func keys(self: Self) -> List<K> [consume self]
    /// Consumes the map and returns its values in iteration order.
    pub func values(self: Self) -> List<V> [consume self]
}

impl Map {
    /// Creates an insertion-ordered list-backed map; use HashMap.empty for hashed storage.
    pub func empty<K, V>() -> ListMap<K, V> {
        ListMap.empty()
    }
}

/// An insertion-ordered associative collection.
pub type ListMap<K, V> = & Map<K, V> & {
    entries: List<Entry<K, V>>
}

impl ListMap<K, V> {
    /// Creates an empty map.
    pub func empty() -> ListMap<K, V> {
        ListMap {
            entries: []
        }
    }

    /// Borrows the stored value; absent keys return `None`. No `Copy` is required.
    /// The reference permits mutation and cannot outlive or survive reshaping the map.
    pub func borrow(self: Self, key: K) -> Option<ref[self] V> [read self.entries, read key] {
        let index = find_index(self.entries, key)
        branch {
            index < 0 -> Option.None
            _ -> Option.Some(ref self.entries[index].value)
        }
    }

    /// Removes and returns the owned value, preserving the map and remaining insertion order.
    /// An absent key returns `None` and leaves the map unchanged.
    pub func remove(self: Self, key: K) -> Option<V> {
        let index = find_index(self.entries, key)
        return Option.None if index < 0
        // Rebuild before replacing storage so traversal retains every unselected entry.
        let remaining = []
        let removed = Option.None
        let cursor = 0
        for entry in self.entries {
            branch {
                cursor == index -> {
                    removed = Option.Some(entry.value)
                }
                _ -> remaining.push(entry)
            }
            cursor = cursor + 1
        }
        self.entries = remaining
        removed
    }

    /// Returns whether the map contains `key` without consuming the map.
    pub func contains_key?(self: Self, key: K) -> Bool {
        find_index(self.entries, key) >= 0
    }

    /// Consumes the map, `key`, and `value`, returning the updated map.
    /// Replacing an equal key releases the old entry and preserves its insertion position.
    pub func put(self: Self, key: K, value: V) -> ListMap<K, V> [mut self.entries, consume key, consume self, consume value] {
        let index = find_index(self.entries, key)
        branch {
            index >= 0 -> {
                self.entries[index] = Entry {
                    key, value
                }
            }
            _ -> {
                self.entries = self.entries.append(Entry {
                    key, value
                })
            }
        }
        self
    }

    /// Returns the number of entries in the map.
    pub func length(self: Self) -> Int {
        self.entries.length
    }

    /// Returns whether the map contains no entries.
    pub func empty?(self: Self) -> Bool {
        self.entries.empty?
    }

    /// Creates an independent iterator in insertion order.
    /// Replacing an existing key does not move its entry to the end.
    pub func iterator(self: Self) -> Iterator<Entry<K, V>> {
        self.entries.iterator()
    }

    /// Consumes the map and returns its keys in storage order.
    pub func keys(self: Self) -> List<K> [consume self] {
        let result = []
        for entry in self {
            result.push(entry.key)
        }
        result
    }

    /// Consumes the map and returns its values in storage order.
    pub func values(self: Self) -> List<V> [consume self] {
        let result = []
        for entry in self {
            result.push(entry.value)
        }
        result
    }
}

/// Finds a key without extracting owned entries or growing the call stack.
func find_index<K, V>(entries: List<Entry<K, V>>, key: K) -> Int {
    let index = 0
    while index < entries.length {
        return index if entries[index].key == key
        index = index + 1
    }
    -1
}

test "maps replace values without duplicating keys" {
    let values = Map.empty().put("a", 1).put("a", 2)
    assert(values.length() == 1)
    assert(not values.empty?())
    assert(values.contains_key?("a"))
    assert(not values.contains_key?("missing"))
    let found = branch values.borrow("a") {
        Option.Some(value) -> value == 2
        Option.None -> false
    }
    assert(found)
    let keys = Map.empty().put("a", 2).put("b", 3).keys()
    assert(keys.length == 2)
    assert(keys[0] == "a")
    assert(keys[1] == "b")
    let stored = Map.empty().put("a", 2).put("b", 3).values()
    assert(stored.length == 2)
    assert(stored[0] == 2)
    assert(stored[1] == 3)
}
