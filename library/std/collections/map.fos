//! Associative collection contracts and an insertion-ordered list-backed implementation.

import core.option
import std.collections
import std.iter

/// A key-value pair yielded while iterating a map.
pub type Entry<K, V> = {
    pub key: K
    pub value: V
}

/// An associative collection with unique keys and implementation-defined iteration order.
/// Updates consume and return the concrete implementation. Lookup consumes the map so that
/// values need not implement Copy; membership checks borrow it.
pub type Map<K, V> = & Collection<Entry<K, V>> & {
    /// Consumes the map and returns the value associated with `key`, if present.
    pub func get(self, key: K) -> Option<V> [consume self]
    /// Tests key membership without consuming the map.
    pub func contains_key?(self, key: K) -> Bool [read self, read key]
    /// Associates `key` with `value`, replacing an existing entry while preserving the implementation.
    pub func put(self, key: K, value: V) -> self [mut self, consume self, consume key, consume value]
    /// Consumes the map and returns its keys in iteration order.
    pub func keys(self) -> List<K> [consume self]
    /// Consumes the map and returns its values in iteration order.
    pub func values(self) -> List<V> [consume self]
}

impl Map {
    /// Creates an insertion-ordered list-backed map; use HashMap.empty for hashed storage.
    pub func empty<K, V>() -> ListMap<K, V> { ListMap.empty() }
}

/// An insertion-ordered associative collection.
pub type ListMap<K, V> = & Map<K, V> & {
    entries: List<Entry<K, V>>
}

impl ListMap {
    /// Creates an empty map.
    pub func empty<K, V>() -> ListMap<K, V> {
        ListMap { entries: [] }
    }

    /// Consumes the map and returns the value associated with `key`, if present.
    pub func get<K, V>(self: ListMap<K, V>, key: K) -> Option<V> [consume self] {
        let index = find_index(self.entries, key)
        branch {
            index < 0 -> Option.None
            _ -> Option.Some(self.entries[index].value)
        }
    }
}

/// Finds a key without extracting owned entries or growing the call stack.
func find_index<K, V>(entries: List<Entry<K, V>>, key: K) -> Int {
    let index = 0
    loop {
        break if index >= entries.length
        return index if entries[index].key == key
        index = index + 1
    }
    -1
}

impl ListMap {
    /// Returns whether the map contains `key` without consuming the map.
    pub func contains_key?<K, V>(self: ListMap<K, V>, key: K) -> Bool {
        find_index(self.entries, key) >= 0
    }
}

impl ListMap {
    /// Returns a map with `key` associated with `value`, replacing an existing entry when present.
    pub func put<K, V>(self: ListMap<K, V>, key: K, value: V) -> ListMap<K, V> [mut self.entries, consume key, consume self, consume value] {
        let index = find_index(self.entries, key)
        branch {
            index >= 0 -> { self.entries[index] = Entry { key, value } }
            _ -> { self.entries = self.entries.append(Entry { key, value }) }
        }
        self
    }
}

impl ListMap {
    /// Returns the number of entries in the map.
    pub func length<K, V>(self: ListMap<K, V>) -> Int {
        self.entries.length
    }

    /// Returns whether the map contains no entries.
    pub func empty?<K, V>(self: ListMap<K, V>) -> Bool {
        self.entries.empty?
    }

    /// Creates an independent iterator over entries in storage order.
    pub func iterator<K, V>(self: ListMap<K, V>) -> Iterator<Entry<K, V>> {
        self.entries.iterator()
    }

    /// Consumes the map and returns its keys in storage order.
    pub func keys<K, V>(self: ListMap<K, V>) -> List<K> [consume self] {
        let result = []
        let entries = self.iterator()
        loop {
            branch entries.next() {
                Option.None -> { break }
                Option.Some(entry) -> result.push(entry.key)
            }
        }
        result
    }
}

impl ListMap {
    /// Consumes the map and returns its values in storage order.
    pub func values<K, V>(self: ListMap<K, V>) -> List<V> [consume self] {
        let result = []
        let entries = self.iterator()
        loop {
            branch entries.next() {
                Option.None -> { break }
                Option.Some(entry) -> result.push(entry.value)
            }
        }
        result
    }
}

test "maps replace values without duplicating keys" {
    let values = Map.empty().put("a", 1).put("a", 2)
    assert(values.length() == 1)
    assert(not values.empty?())
    assert(values.contains_key?("a"))
    assert(not values.contains_key?("missing"))
    let found = branch (move values).get("a") {
        Option.Some(value) -> value == 2
        Option.None -> false
    }
    assert(found)
    let keys = Map.empty().put("a", 2).put("b", 3).keys()
    assert(keys.length == 2)
    assert(keys[0] == "a")
    assert(keys[1] == "b")
    let stored = Map.empty().put("a", 2).put("b", 3).values()
    assert(stored.length == 2)
    assert(stored[0] == 2)
    assert(stored[1] == 3)
}
