//! An owned first-in, first-out collection.
//!
//! push adds at the back and pop removes from the front. Iteration follows
//! the same front-to-back order. Updates transfer ownership to the returned queue.

//! Queue defines the storage-free contract; ListQueue supplies list-backed storage.

import std.collections
import std.iter
import core.option

/// A first-in, first-out collection.
pub type Queue<T> = & Collection<T> & {
    /// Returns a queue with `value` added at the back.
    pub func push(self, value: T) -> self [consume self, consume value]
    /// Removes the front value and returns the remaining queue.
    pub func pop(self) -> Option<QueueItem<T, self>> [consume self]
}

impl Queue {
    /// Creates an empty list-backed collection.
    pub func empty<T>() -> ListQueue<T> { ListQueue.empty() }
}

/// A list-backed implementation of Queue. Updates do not promise constant-time work.
pub type ListQueue<T> = & Queue<T> & {
    values: List<T>
}

impl ListQueue {
    /// Creates an empty queue.
    pub func empty<T>() -> ListQueue<T> {
        ListQueue { values: [] }
    }

    /// Returns the number of queued values.
    pub func length<T>(self: ListQueue<T>) -> Int {
        self.values.length
    }

    /// Returns whether the queue contains no values.
    pub func empty?<T>(self: ListQueue<T>) -> Bool {
        self.values.empty?
    }

    /// Creates an independent iterator from front to back.
    pub func iterator<T>(self: ListQueue<T>) -> Iterator<T> {
        self.values.iterator()
    }

    /// Returns a queue with `value` added at the back.
    pub func push<T>(self: ListQueue<T>, value: T) -> ListQueue<T> [consume self, consume value] {
        ListQueue { values: self.values.append(value) }
    }

    /// Removes the front value and returns the remaining queue.
    pub func pop<T>(self: ListQueue<T>) -> Option<QueueItem<T, ListQueue<T>>> [consume self] {
        branch {
            self.values.empty? -> Option.None
            _ -> Option.Some(QueueItem { value: self.values.head, remaining: ListQueue { values: self.values.rest } })
        }
    }
}

/// The result of removing one value from a queue.
pub type QueueItem<T, C> = {
    pub value: T
    // The remaining collection preserves its implementation type.
    pub remaining: C
}

test "queues retain pushed values" {
    let queue = ListQueue { values: [1, 2] }
    assert(queue.length() == 2)
    ()
}
