//! An owned last-in, first-out collection.
//!
//! push returns the updated stack and pop removes its top value. Iteration visits
//! the top first. Use the empty and length queries before operations that require
//! an element, or handle the optional result of pop.

//! Stack defines the storage-free contract; ListStack supplies list-backed storage.

import std.collections
import std.iter
import core.option

/// A last-in, first-out collection.
pub type Stack<T> = & Collection<T> & {
    /// Returns a stack with `value` placed on top.
    pub func push(self, value: T) -> self [consume self, consume value]
    /// Removes the top value and returns the remaining stack.
    pub func pop(self) -> Option<StackItem<T, self>> [consume self]
}

impl Stack {
    /// Creates an empty list-backed collection.
    pub func empty<T>() -> ListStack<T> { ListStack.empty() }
}

/// A list-backed implementation of Stack. Updates do not promise constant-time work.
pub type ListStack<T> = & Stack<T> & {
    values: List<T>
}

impl ListStack {
    /// Creates an empty stack.
    pub func empty<T>() -> ListStack<T> {
        ListStack { values: [] }
    }

    /// Returns the number of stacked values.
    pub func length<T>(self: ListStack<T>) -> Int {
        self.values.length
    }

    /// Returns whether the stack contains no values.
    pub func empty?<T>(self: ListStack<T>) -> Bool {
        self.values.empty?
    }

    /// Creates an independent iterator from top to bottom.
    pub func iterator<T>(self: ListStack<T>) -> Iterator<T> {
        reverse(self.values, []).iterator()
    }

    /// Returns a stack with `value` placed on top.
    pub func push<T>(self: ListStack<T>, value: T) -> ListStack<T> [consume self, consume value] {
        ListStack { values: self.values.append(value) }
    }

    /// Removes the top value and returns the remaining stack.
    pub func pop<T>(self: ListStack<T>) -> Option<StackItem<T, ListStack<T>>> [consume self] {
        branch {
            self.values.empty? -> Option.None
            _ -> pop_values(move self.values, [])
        }
    }
}

/// The result of removing one value from a stack.
pub type StackItem<T, C> = {
    pub value: T
    // The remaining collection preserves its implementation type.
    pub remaining: C
}

test "stacks retain pushed values" {
    let stack = ListStack { values: [1, 2] }
    assert(stack.length() == 2)
    ()
}

/// Walks to the final stored value while rebuilding the remaining prefix.
func pop_values<T>(remaining: List<T>, prefix: List<T>) -> Option<StackItem<T, ListStack<T>>> [consume remaining, consume prefix] {
    branch {
        remaining.rest.empty? -> Option.Some(StackItem { value: remaining.head, remaining: ListStack { values: prefix } })
        _ -> pop_values(remaining.rest, prefix.append(remaining.head))
    }
}

/// Reverses stored values into iterator order.
func reverse<T>(remaining: List<T>, result: List<T>) -> List<T> [consume result] {
    branch {
        remaining.empty? -> result
        _ -> reverse(remaining.rest, move result).append(remaining.head)
    }
}
