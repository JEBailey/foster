//! Unique-value contracts and insertion-ordered list sets.
//!
//! `Set` factories construct `ListSet`. `Equality` determines membership; adding an
//! existing value does not create a duplicate. Use std.collections.hash_set for
//! hashed membership. Iteration follows insertion order for `ListSet`.

import std.collections
import std.iter

/// A collection of unique values with implementation-defined iteration order.
/// Membership borrows the set; updates consume and preserve the concrete implementation.
pub type Set<T> = & Collection<T> & {
    /// Tests membership without consuming the set.
    pub func contains?(self, value: T) -> Bool [read self, read value]
    /// Returns this implementation containing `value`.
    pub func insert(self, value: T) -> self [mut self, consume self, consume value]
    /// Returns this implementation without `value`.
    pub func remove(self, value: T) -> self [mut self, consume self]
}

impl Set {
    /// Creates an insertion-ordered list-backed set; use HashSet.empty for hashed storage.
    pub func empty<T>() -> ListSet<T> { ListSet.empty() }
    /// Creates an insertion-ordered list-backed set containing each input value once.
    pub func from<T>(values: List<T>) -> ListSet<T> [consume values] { ListSet.from(move values) }
}

/// An insertion-ordered collection containing no duplicate values.
pub type ListSet<T> = & Set<T> & {
    values: List<T>
}

impl ListSet {
    /// Creates an empty set.
    pub func empty<T>() -> ListSet<T> {
        ListSet { values: [] }
    }

    /// Creates a set containing each input value once.
    pub func from<T>(values: List<T>) -> ListSet<T> [consume values] {
        ListSet { values: unique(move values, []) }
    }

    /// Returns the number of values in the set.
    pub func length<T>(self: ListSet<T>) -> Int {
        self.values.length
    }

    /// Returns whether the set contains no values.
    pub func empty?<T>(self: ListSet<T>) -> Bool {
        self.values.empty?
    }

    /// Creates an independent iterator in insertion order.
    pub func iterator<T>(self: ListSet<T>) -> Iterator<T> {
        self.values.iterator()
    }

    /// Returns whether `value` is present.
    pub func contains?<T>(self: ListSet<T>, value: T) -> Bool {
        contains_value?(self.values, value)
    }

    /// Returns a set containing `value`.
    pub func insert<T>(self: ListSet<T>, value: T) -> ListSet<T> [consume self, consume value] {
        branch {
            self.contains?(value) -> self
            _ -> ListSet { values: self.values.append(value) }
        }
    }

    /// Returns a set without `value`.
    pub func remove<T>(self: ListSet<T>, value: T) -> ListSet<T> [consume self] {
        ListSet { values: without(move self.values, value, []) }
    }
}

test "sets preserve insertion order while removing duplicates" {
    let values = Set.from([1, 2, 1])
    assert(values.length() == 2)
    assert(values.contains?(1))
    assert(values.contains?(2))
    ()
}

/// Searches the remaining backing values for `expected`.
func contains_value?<T>(values: List<T>, expected: T) -> Bool {
    branch {
        values.empty? -> false
        values.head == expected -> true
        _ -> contains_value?(values.rest, expected)
    }
}

/// Appends values not already present in the result accumulator.
func unique<T>(remaining: List<T>, result: List<T>) -> List<T> [consume remaining, consume result] {
    branch {
        remaining.empty? -> result
        contains_value?(result, remaining.head) -> unique(remaining.rest, move result)
        _ -> unique(remaining.rest, result.append(remaining.head))
    }
}

/// Copies values other than `expected` into the result accumulator.
func without<T>(remaining: List<T>, expected: T, result: List<T>) -> List<T> [consume remaining, consume result] {
    branch {
        remaining.empty? -> result
        remaining.head == expected -> without(remaining.rest, expected, move result)
        _ -> without(remaining.rest, expected, result.append(remaining.head))
    }
}
