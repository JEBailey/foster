//! An owned collection with access at both ends.
//!
//! Insert and remove at the front or back. Iteration runs from front to back.
//! Deque defines the contract; ListDeque supplies list-backed storage. Neither promises
//! constant-time insertion or removal at both ends.

import std.collections
import std.iter
import core.option

/// A double-ended queue.
pub type Deque<T> = & Collection<T> & {
    /// Returns a deque with `value` added at the front.
    pub func push_front(self, value: T) -> self [consume self, consume value]
    /// Returns a deque with `value` added at the back.
    pub func push_back(self, value: T) -> self [consume self, consume value]
    /// Removes the front value and returns the remaining deque.
    pub func pop_front(self) -> Option<DequeItem<T, self>> [consume self]
    /// Removes the back value and returns the remaining deque.
    pub func pop_back(self) -> Option<DequeItem<T, self>> [consume self]
}

impl Deque {
    /// Creates an empty list-backed collection.
    pub func empty<T>() -> ListDeque<T> { ListDeque.empty() }
}

/// A list-backed implementation of Deque. Updates do not promise constant-time work.
pub type ListDeque<T> = & Deque<T> & {
    values: List<T>
}

impl ListDeque {
    /// Creates an empty deque.
    pub func empty<T>() -> ListDeque<T> {
        ListDeque { values: [] }
    }

    /// Returns the number of values in the deque.
    pub func length<T>(self: ListDeque<T>) -> Int {
        self.values.length
    }

    /// Returns whether the deque contains no values.
    pub func empty?<T>(self: ListDeque<T>) -> Bool {
        self.values.empty?
    }

    /// Creates an independent iterator from front to back.
    pub func iterator<T>(self: ListDeque<T>) -> Iterator<T> {
        self.values.iterator()
    }

    /// Returns a deque with `value` added at the front.
    pub func push_front<T>(self: ListDeque<T>, value: T) -> ListDeque<T> [consume self, consume value] {
        ListDeque { values: append_all(move self.values, [value]) }
    }

    /// Returns a deque with `value` added at the back.
    pub func push_back<T>(self: ListDeque<T>, value: T) -> ListDeque<T> [consume self, consume value] {
        ListDeque { values: self.values.append(value) }
    }

    /// Removes the front value and returns the remaining deque.
    pub func pop_front<T>(self: ListDeque<T>) -> Option<DequeItem<T, ListDeque<T>>> [consume self] {
        branch {
            self.values.empty? -> Option.None
            _ -> Option.Some(DequeItem { value: self.values.head, remaining: ListDeque { values: self.values.rest } })
        }
    }

    /// Removes the back value and returns the remaining deque.
    pub func pop_back<T>(self: ListDeque<T>) -> Option<DequeItem<T, ListDeque<T>>> [consume self] {
        branch {
            self.values.empty? -> Option.None
            _ -> pop_back_values(move self.values, [])
        }
    }
}

/// The result of removing one value from a deque.
pub type DequeItem<T, C> = {
    pub value: T
    // The remaining collection preserves its implementation type.
    pub remaining: C
}

test "deques accept values at both ends" {
    let deque = ListDeque { values: [1, 2] }
    assert(deque.length() == 2)
    ()
}

/// Walks to the final value while rebuilding the preceding values.
func pop_back_values<T>(remaining: List<T>, prefix: List<T>) -> Option<DequeItem<T, ListDeque<T>>> [consume remaining, consume prefix] {
    branch {
        remaining.rest.empty? -> Option.Some(DequeItem { value: remaining.head, remaining: ListDeque { values: prefix } })
        _ -> pop_back_values(remaining.rest, prefix.append(remaining.head))
    }
}

/// Appends all remaining values to the result accumulator.
func append_all<T>(remaining: List<T>, result: List<T>) -> List<T> [consume remaining, consume result] {
    branch {
        remaining.empty? -> result
        _ -> append_all(remaining.rest, result.append(remaining.head))
    }
}
