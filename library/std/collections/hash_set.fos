//! Unordered hash sets implemented in Foster over HashMap.

import core.option
import std.collections.set
import std.collections.hash_map
import std.iter

/// A hash-backed collection of distinct values with unspecified iteration order.
/// Equal values must have equal, stable hashes. Updates consume the set.
pub type HashSet<T> = & Set<T> & {
    table: HashMap<T, ()>

    /// Consumes the set and returns its values in unspecified order.
    pub func values(self) -> List<T> [consume self]
}

impl HashSet {
    /// Creates an empty set using the supplied stable hash function.
    pub func empty<T>(hasher: func(T) -> Int) -> HashSet<T> [consume hasher] {
        HashSet { table: HashMap.empty(move hasher) }
    }

    /// Creates a set containing each input value once.
    pub func from<T>(values: List<T>, hasher: func(T) -> Int) -> HashSet<T> [consume values, consume hasher] {
        let result = HashSet.empty(move hasher)
        let iterator = values.iterator()
        loop {
            branch iterator.next() {
                Option.None -> { break }
                Option.Some(value) -> { result = (move result).insert(move value) }
            }
        }
        result
    }

    /// Returns the number of distinct values.
    pub func length<T>(self: HashSet<T>) -> Int { self.table.length() }

    /// Returns whether the set has no values.
    pub func empty?<T>(self: HashSet<T>) -> Bool { self.table.empty?() }

    /// Tests membership without consuming the set.
    pub func contains?<T>(self: HashSet<T>, value: T) -> Bool { self.table.contains_key?(value) }

    /// Returns a set containing the supplied value.
    pub func insert<T>(self: HashSet<T>, value: T) -> HashSet<T> [consume self, consume value] {
        HashSet { table: (move self.table).put(move value, ()) }
    }

    /// Returns a set without the supplied value; absent values leave it unchanged.
    pub func remove<T>(self: HashSet<T>, value: T) -> HashSet<T> [consume self] {
        HashSet { table: (move self.table).remove(value) }
    }

    /// Creates a snapshot iterator in unspecified order.
    pub func iterator<T>(self: HashSet<T>) -> Iterator<T> {
        let values = []
        let entries = self.table.iterator()
        loop {
            let next = entries.next()
            branch next {
                Option.None -> { break }
                Option.Some(entry) -> values.push(entry.key)
            }
        }
        values.iterator()
    }

    /// Consumes the set and returns its values in unspecified order.
    pub func values<T>(self: HashSet<T>) -> List<T> [consume self] {
        (move self.table).keys()
    }
}

test "hash sets deduplicate and remove colliding values" {
    let values = HashSet.from([1, 2, 1, 3], (key: Int) -> 0)
    assert(values.length() == 3)
    assert(values.contains?(2))
    values = (move values).remove(2).remove(99).insert(3)
    assert(values.length() == 2)
    assert(not values.contains?(2))
    assert(values.contains?(1))
    assert(values.contains?(3))
    values = (move values).remove(1).remove(3)
    assert(values.empty?())
}
