//! Queries against the process environment.
//!
//! current_directory returns the host context's working directory as path text,
//! or `IoError` if it cannot be obtained. This module does not currently expose
//! arbitrary environment-variable lookup or mutation.

import core.result
import std.io

type EnvHost = {}

impl EnvHost {
    /// Returns the host process working directory.
    func current_directory() -> Result<String, IoError> = intrinsic("io.current_directory")
}

/// Returns the process's current working directory.
pub func current_directory() -> Result<String, IoError> { EnvHost.current_directory() }
