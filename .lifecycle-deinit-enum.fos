
import core.drop
enum Choice = Value(Int) | Empty & Drop
impl Choice {
    func deinit(self) -> () {
        branch self { Choice.Value(value) -> println(value)
 Choice.Empty -> println(0) }
    }
}
func main() -> Int {
    let first = Choice.Value(1)
    let second = Choice.Empty
    println(10)
    42
}
