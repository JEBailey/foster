import core.code_point
import core.string

func main() -> Int {
    assert("中".scalar_head().letter?())
    assert("𐐀".scalar_head().uppercase?())
    assert("Ᲊ".scalar_head().uppercase?())
    assert("٣".scalar_head().digit?())
    assert("Ⅷ".scalar_head().numeric?())
    assert(!"Ⅷ".scalar_head().digit?())
    assert(from_code_point(837).alphabetic?())
    assert(!from_code_point(837).letter?())
    assert(from_code_point(837).mark?())
    assert("😀".scalar_head().category() == GeneralCategory.OtherSymbol)
    assert("—".scalar_head().punctuation?())
    assert("€".scalar_head().symbol?())
    assert(from_code_point(160).separator?())
    assert(from_code_point(160).whitespace?)
    assert(!from_code_point(8203).whitespace?)
    assert(from_code_point(0).control?())
    assert(!from_code_point(888).assigned?())
    assert("λ".scalar_head().identifier_start?())
    assert("٣".scalar_head().identifier_part?())
    assert(!"٣".scalar_head().identifier_start?())
    assert("ǅ".scalar_head().titlecase?())
    assert("中".scalar_head().alphanumeric?())
    assert("ß".scalar_head().simple_upper() == "ß".scalar_head())
    assert("ß".scalar_head().upper() == "SS")
    assert("İ".scalar_head().simple_lower() == "i".scalar_head())
    assert("İ".scalar_head().lower() == "i" + from_code_point(775).string)
    assert("ǆ".scalar_head().simple_title() == "ǅ".scalar_head())
    assert("ς".scalar_head().case_fold() == "σ")
    let original = "Straße ﬃ"
    assert(original.upper() == "STRASSE FFI")
    assert(original == "Straße ﬃ")
    assert("Éİ𐐀".lower() == "éi" + from_code_point(775).string + "𐐨")
    assert("ΟΣ ΟΣΑ Σ".lower() == "ος οσα σ")
    assert(("ΟΣ" + from_code_point(769).string + "Α").lower() == "οσ" + from_code_point(769).string + "α")
    assert(("ΟΣ" + from_code_point(769).string).lower() == "ος" + from_code_point(769).string)
    assert(("Σ" + from_code_point(837).string).lower() == "σ" + from_code_point(837).string)
    assert("Α Σ AΣ.A".lower() == "α σ aσ.a")
    assert(("Α" + from_code_point(837).string + "Σ").lower() == "α" + from_code_point(837).string + "ς")
    assert("Straße Σςσ ﬃ".case_fold() == "strasse σσσ ffi")
    assert("Straße".case_fold() == "STRASSE".case_fold())
    assert("I".lower() == "i")
    assert("é".case_fold() != ("e" + from_code_point(769).string).case_fold())
    assert("😀中".upper() == "😀中")
    assert("".lower() == "")
    assert("ÉAb".ascii_lower() == "Éab")
    assert("éAb".ascii_upper() == "éAB")
    42
}
