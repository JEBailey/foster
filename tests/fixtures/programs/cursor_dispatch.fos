import core.string
import std.cursor
import core.option

func rewind<T>(reader: Cursor<T>) -> Int {
    let start = reader.checkpoint()
    reader.peek()
    assert(reader.checkpoint() == start)
    reader.next()
    branch reader.span(start, reader.checkpoint()) {
        Option.Some(items) -> { assert(items.length == 1) }
        Option.None -> { assert(false) }
    }
    assert(reader.restore(start))
    reader.checkpoint()
}
func drain<T>(reader: Cursor<T>) -> Int { reader.count() }

func main() -> Int {
    let text = StringCursor.from("λ🙂")
    assert(rewind(text) == 0)
    assert(text.next() == Option.Some('λ'))
    assert(rewind(text) == 2)
    assert(text.peek() == Option.Some('🙂'))
    let values = ListCursor.from([1, 2])
    assert(rewind(values) == 0)
    assert(values.next() == Option.Some(1))
    let byte_reader = BytesCursor.from("abc".bytes)
    assert(rewind(byte_reader) == 0)
    assert(byte_reader.checkpoint() == 0)
    assert(drain(byte_reader) == 3)
    assert(byte_reader.checkpoint() == 3)
    42
}
