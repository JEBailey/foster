import core.option.Option

// `LinkedList<T>` owns the first link. Each Node case owns its value and the rest of the chain.
enum Link<T> = End
    | Node(T, Link<T>)

type LinkedList<T> = {
    head: Link<T>
    size: Int
}

type LinkedListItem<T> = {
    value: T
    remaining: LinkedList<T>
}

// Creates an empty linked list for any element type.
impl LinkedList {
    func empty<T>() -> LinkedList<T> {
        LinkedList {
            head: Link.End, size: 0
        }
    }
}

// Returns the number of elements in constant time.
impl LinkedList<T> {
    func length(self: Self) -> Int {
        self.size
    }
}

// Returns whether this list contains no elements.
impl LinkedList<T> {
    func empty?(self: Self) -> Bool {
        self.size == 0
    }
}

// Consumes the list and adds `value` at its front in constant time.
impl LinkedList<T> {
    func prepend(self: Self, value: T) -> LinkedList<T> [consume self, consume value] {
        LinkedList {
            head: Link.Node(move value, move self.head)
            size: self.size + 1
        }
    }
}

// Consumes the list and returns its first value together with the remaining list.
impl LinkedList<T> {
    func pop_front(self: Self) -> Option<LinkedListItem<T>> [consume self] {
        branch self.head {
            Link.End -> Option.None
            Link.Node(value, next) -> Option.Some(LinkedListItem {
                value: move value
                remaining: LinkedList {
                    head: move next, size: self.size - 1
                }
            })
        }
    }
}

// Consumes this list and returns its elements in reverse order.
impl LinkedList<T> {
    func reverse(self: Self) -> LinkedList<T> [consume self] {
        LinkedList {
            head: reverse_links(move self.head, Link.End)
            size: self.size
        }
    }
}

// Consumes this list and transforms every element without using the built-in `List<T>` type.
impl LinkedList<T> {
    func map<U>(self: Self, transform: func(consume T) -> U) -> LinkedList<U> [consume self] {
        LinkedList {
            head: map_links(move self.head, transform)
            size: self.size
        }
    }
}

// Consumes this list and combines its values from front to back.
impl LinkedList<T> {
    func fold<U>(self: Self, initial: U, combine: func(consume U, consume T) -> U) -> U [consume self, consume initial] {
        fold_links(move self.head, move initial, combine)
    }
}

// Consumes this linked list and materializes a built-in list in the same order.
impl LinkedList<T> {
    func to_list(self: Self) -> List<T> [consume self] {
        collect_links(move self.head, [])
    }
}

// Reverses owned links into the accumulating chain.
func reverse_links<T>(remaining: Link<T>, result: Link<T>) -> Link<T> [consume remaining, consume result] {
    branch remaining {
        Link.End -> result
        Link.Node(value, next) -> reverse_links(move next, Link.Node(move value, move result))
    }
}

// Transforms an owned chain recursively.
func map_links<T, U>(remaining: Link<T>, transform: func(consume T) -> U) -> Link<U> [consume remaining] {
    branch remaining {
        Link.End -> Link.End
        Link.Node(value, next) -> Link.Node(transform(move value), map_links(move next, transform))
    }
}

// Reduces an owned chain recursively.
func fold_links<T, U>(remaining: Link<T>, result: U, combine: func(consume U, consume T) -> U) -> U [consume remaining, consume result] {
    branch remaining {
        Link.End -> result
        Link.Node(value, next) -> fold_links(move next, combine(move result, move value), combine)
    }
}

// Appends owned node values to a built-in list accumulator.
func collect_links<T>(remaining: Link<T>, result: List<T>) -> List<T> [consume remaining, consume result] {
    branch remaining {
        Link.End -> result
        Link.Node(value, next) -> collect_links(move next, result.append(move value))
    }
}

func render(item: Option<LinkedListItem<Int>>) -> Int {
    branch item {
        Option.None -> -1
        Option.Some(found) -> found.value + LinkedList.length(found.remaining)
    }
}

func numbers() -> LinkedList<Int> {
    LinkedList.empty().prepend(3).prepend(2).prepend(1)
}

func main() -> Int {
    let doubled = LinkedList.map(numbers(), (value: Int) -> value * 2)
    let first_score = render(LinkedList.pop_front(move doubled))

    let total = LinkedList.fold(numbers(), 0, (result: Int, value: Int) -> result + value)
    let reversed = LinkedList.to_list(LinkedList.reverse(numbers()))

    first_score + total + reversed[0]
}
