import core.drop
import core.drop.Drop

type Resource = & Drop & {
    id: Int
}
impl Resource {
    func deinit(self: Self) -> () {
        println(self.id)
    }
}

type Pair = & Drop & {
    first: Resource, second: Resource, number: Int
}
impl Pair {
    func deinit(self: Self) -> () {
        println(self.number)
    }
}

func complete(flag: Bool) -> Pair {
    let pair = Pair {
        first: Resource {
            id: 1
        }, second: ??, number: ??
    }
    branch {
        flag -> {
            pair.second = Resource {
                id: 1
            }
        }
        _ -> {
            pair.second = Resource {
                id: 3
            }
        }
    }
    pair.number = 10
    pair
}

func main() -> Int {
    :scalar_missing {
        let pair = Pair {
            first: Resource {
                id: 9
            }, second: Resource {
                id: 9
            }, number: ??
        }
        ()
    }
    :abandoned {
        let pair = Pair {
            first: Resource {
                id: 4
            }, second: ??, number: ??
        }
        ()
    }
    :finished {
        let pair = complete(true)
        assert(pair.second.id == 1)
        ()
    }
    :overwritten {
        let pair = Pair {
            first: ??, second: Resource {
                id: 5
            }, number: ??
        }
        pair = Pair {
            first: Resource {
                id: 6
            }, second: Resource {
                id: 6
            }, number: 20
        }
        ()
    }
    42
}
