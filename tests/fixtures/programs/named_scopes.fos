import core.drop

type Resource = & Drop & { id: Int }

impl Resource {
    func deinit(self) -> () { println(self.id) }
}

func early() -> Int {
    :returning {
        let resource = Resource { id: 7 }
        return 42
    }
}

func main() -> Int {
    let result = :request {
        let first = Resource { id: 1 }
        :nested {
            let second = Resource { id: 2 }
            let third = Resource { id: 3 }
            ()
        }
        println(4)
        let transferred = Resource { id: 5 }
        move transferred
    }
    println(6)
    assert(result.id == 5)
    assert(early() == 42)
    let iteration = 0
    loop {
        :iteration {
            let resource = Resource { id: 8 + iteration }
            iteration = iteration + 1
            continue if iteration == 1
            break
        }
    }
    42
}
