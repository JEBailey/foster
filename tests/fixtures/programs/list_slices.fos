import core.list.List
import core.option.Option
import std.collections.hash_map.HashMap

type Item = {
    value: Int
}

enum Token = Number(Int) | Word(String)

pub type CopyItem = {
    pub value: Int
}

impl CopyItem {
    pub func copy(self: Self) -> Self [read self.value] {
        CopyItem {
            value: self.value + 1
        }
    }
}

func main() -> Int {
    let map = HashMap.empty((key: Int) -> key).put(1, [Item {
        value: 20
    }, Item {
        value: 22
    }])
    let answer = branch map.borrow(1) {
        Option.Some(body) -> {
            let selected = body.slice(0, 2)
            assert(selected.length == 2)
            assert(selected.borrow(-1) == Option.None)
            assert(selected.borrow(2) == Option.None)
            let total = 0
            for item in selected {
                total = total + item.value
            }
            for item in body.slice(0, 2) {
                assert(item.value > 0)
            }
            let empty = body.slice(1, 1)
            for item in empty {
                panic("empty slice yielded an element")
            }
            total
        }
        Option.None -> 0
    }
    let numbers = [1, 2, 3]
    let copied = numbers.copy_slice(1, 3)
    numbers.push(4)
    assert(copied == [2, 3])
    assert(numbers.copy_slice(0, 0).length == 0)
    let original = [CopyItem {
        value: 41
    }]
    let independent = original.copy_slice(0, 1)
    assert(original[0].value == 41 && independent[0].value == 42)
    let tokens = HashMap.empty((key: Int) -> key).put(1, [Token.Number(42), Token.Word("word")])
    branch tokens.borrow(1) {
        Option.Some(body) -> {
            let view = body.slice(0, 2)
            let total = 0
            for token in view {
                branch token {
                    Token.Number(value) -> {
                        total = total + value
                    }
                    Token.Word(value) -> {
                        assert(value == "word")
                    }
                }
            }
            assert(total == 42)
        }
        Option.None -> panic("missing token body")
    }
    answer
}
