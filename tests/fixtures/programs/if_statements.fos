type Counter = {
    value: Int
}

func mark(counter: Counter, digit: Int) -> Int {
    counter.value = counter.value * 10 + digit
    0
}

func condition(counter: Counter, flag: Bool) -> Bool {
    mark(counter, 1)
    flag
}

func action(counter: Counter) -> () {
    if true mark(counter, 4)
}

func assignment(counter: Counter, flag: Bool) -> () {
    if flag counter.value = 42
}

func block_value(flag: Bool) -> () {
    if flag {
        99
    }
}

func main() -> Int {
    let counter = Counter {
        value: 0
    }
    let values = [0]
    if condition(counter, false) values[mark(counter, 3)] = mark(counter, 2)
    assert(counter.value == 1)
    counter.value = 0
    if condition(counter, true) values[mark(counter, 3)] = mark(counter, 2)
    assert(counter.value == 123)
    assert(action(counter) == ())
    assert(counter.value == 1234)
    let answer = 0
    if true answer = 42
    if false answer = 99
    if false panic("skipped action")
    if false mark(counter, mark(counter, 9))
    assert(counter.value == 1234)
    assert(assignment(counter, false) == ())
    assert(counter.value == 1234)
    assert(assignment(counter, true) == ())
    assert(counter.value == 42)
    assert(block_value(true) == ())
    assert(block_value(false) == ())
    if (Counter {
        value: 42
    }).value == 42 assert(true)
    if false {
        counter.value = 99
        assert(false)
    }
    if true {
        let local = 1
        counter.value = counter.value + local
        counter.value = counter.value - local
    }
    if true if false counter.value = 99
    if false {}
    if true
    {
        assert(counter.value == 42)
    }
    let index = 0
    loop {
        index = index + 1
        if index == 1 continue
        if index == 2 {
            continue
        }
        if index == 3 break
    }
    assert(index == 3)
    if counter.value == 42 return answer
    answer
}
