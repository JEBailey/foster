import core.string
import core.option
import core.bytes
import core.byte
import std.cursor

func main() -> Int {
    let text = StringCursor.from("Aλ€🙂Z")
    assert(text.peek() == Option.Some('A'))
    assert(text.peek() == Option.Some('A'))
    assert(text.checkpoint() == 0)
    assert(text.next() == Option.Some('A'))
    let start = text.checkpoint()
    assert(start == 1)
    assert(text.next() == Option.Some('λ'))
    assert(text.checkpoint() == 3)
    assert(!text.restore(2))
    assert(text.checkpoint() == 3)
    assert(text.next() == Option.Some('€'))
    assert(text.checkpoint() == 6)
    assert(text.next() == Option.Some('🙂'))
    assert(text.checkpoint() == 10)
    assert(text.text_span(start, text.checkpoint()) == Option.Some("λ€🙂"))
    assert(text.text_span(2, 3) == Option.None)
    assert(text.text_span(1, 2) == Option.None)
    assert(text.text_span(3, 1) == Option.None)
    assert(!text.restore(-1))
    assert(!text.restore(12))
    assert(text.remaining() == "Z")
    assert(text.restore(start))
    assert(text.peek() == Option.Some('λ'))
    assert(text.restore(11))
    assert(text.empty?())
    assert(text.next() == Option.None)
    assert(text.next() == Option.None)
    assert(text.checkpoint() == 11)
    assert(text.text_span(11, 11) == Option.Some(""))
    assert(text.span(1, 6) == Option.Some(['λ', '€']))
    let empty = StringCursor.from("")
    assert(empty.peek() == Option.None)
    assert(empty.restore(0))
    assert(!empty.restore(1))
    let byte_reader = BytesCursor.from("abc".bytes)
    assert(byte_reader.peek() == Option.Some(Byte.unchecked(97)))
    assert(byte_reader.next() == Option.Some(Byte.unchecked(97)))
    assert(byte_reader.byte_span(1, 3) == Option.Some("bc".bytes))
    assert(byte_reader.byte_span(-1, 3) == Option.None)
    assert(!byte_reader.restore(4))
    assert(byte_reader.checkpoint() == 1)
    assert(byte_reader.restore(3))
    assert(byte_reader.next() == Option.None)
    let values = ListCursor.from([10, 20, 30])
    assert(values.peek() == Option.Some(10))
    assert(values.next() == Option.Some(10))
    assert(values.next() == Option.Some(20))
    assert(values.restore(0))
    assert(values.next() == Option.Some(10))
    assert(values.span(0, 2) == Option.Some([10, 20]))
    assert(values.span(2, 1) == Option.None)
    assert(values.span(0, 4) == Option.None)
    assert(!values.restore(-1))
    assert(values.restore(3))
    assert(values.next() == Option.None)
    42
}
