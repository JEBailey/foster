import core.copy
import core.copy.Copy
import static core.copy.*

pub type Item = {
    value: Int
}

impl Item {
    pub func copy(self: Self) -> Self [read self] {
        Item {
            value: self.value
        }
    }
}

type Box<T> = {
    value: T
}

impl Box<T & Copy> {
    func copied(self: Self) -> T [read self] {
        self.value.copy()
    }
}

func main() -> Int {
    Box {
        value: Item {
            value: 42
        }
    }.copied().value
}
