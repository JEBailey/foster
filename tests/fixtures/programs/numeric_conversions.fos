import core.float

import core.int
import core.int.Int
import core.int.IntConversionError

import core.result
import core.result.Result

import core.bytes

func converted(value: Float, expected: Int) -> () {
    branch Int.from(value) {
        Result.Ok(actual) -> {
            assert(actual == expected)
        }
        Result.Error(_) -> {
            panic("conversion failed")
        }
    }
}

func rejected(value: Float, nonfinite: Bool) -> () {
    branch Int.from(value) {
        Result.Ok(_) -> {
            panic("invalid conversion succeeded")
        }
        Result.Error(error) -> branch error {
            IntConversionError.NotFinite -> {
                assert(nonfinite)
            }
            IntConversionError.OutOfRange -> {
                assert(!nonfinite)
            }
        }
    }
}

func propagated(value: Float) -> Result<Int, IntConversionError> {
    let integer = try int::Int.from(value)
    Result.Ok(integer)
}

func main() -> Int {
    assert(Float.from(42) == 42.0)
    assert(Float.from(-42) == -42.0)
    assert(Float.from(9007199254740993) == 9007199254740992.0)
    assert(Float.from(9007199254740995) == 9007199254740996.0)
    assert(Float.from(-9007199254740993) == -9007199254740992.0)
    assert(Float.from(9223372036854775807) == 9223372036854775808.0)
    assert(Float.from(-9223372036854775807 - 1) == -9223372036854775808.0)
    converted(19.9, 19)
    converted(-19.9, -19)
    converted(0.0, 0)
    converted(-0.0, 0)
    converted(0.999, 0)
    converted(-0.999, 0)
    converted(-9223372036854775808.0, -9223372036854775807 - 1)
    converted(9223372036854774784.0, 9223372036854774784)
    rejected(9223372036854775808.0, false)
    rejected(-9223372036854777856.0, false)
    rejected(1e100, false)
    let infinity = parse_float("inf")
    let invalid = parse_float("NaN")
    rejected(infinity, true)
    rejected(-infinity, true)
    rejected(invalid, true)
    assert((-1.2).floor() == -2.0)
    assert((-1.2).ceil() == -1.0)
    assert(1.2.floor() == 1.0)
    assert(1.2.ceil() == 2.0)
    assert(2.5.round() == 2.0)
    assert(3.5.round() == 4.0)
    assert((-2.5).round() == -2.0)
    assert((-3.5).round() == -4.0)
    assert((-1.9).truncate() == -1.0)
    assert(1.9.truncate() == 1.0)
    for value in [-0.0, -0.25] {
        assert(value.ceil().bytes.hex() == "0000000000000080")
        assert(value.round().bytes.hex() == "0000000000000080")
        assert(value.truncate().bytes.hex() == "0000000000000080")
    }
    assert((-0.0).floor().bytes.hex() == "0000000000000080")
    for value in [infinity, -infinity, 0.0, 1e100] {
        assert(value.floor() == value)
        assert(value.ceil() == value)
        assert(value.round() == value)
        assert(value.truncate() == value)
    }
    assert(invalid.floor() != invalid.floor())
    assert(invalid.ceil() != invalid.ceil())
    assert(invalid.round() != invalid.round())
    assert(invalid.truncate() != invalid.truncate())
    let original = 42.9
    branch propagated(original) {
        Result.Ok(value) -> {
            assert(value == 42)
        }
        Result.Error(_) -> {
            panic("propagation failed")
        }
    }
    assert(original == 42.9)
    42
}
