func verify_simple(input: String, expected: String, mode: Int) -> () {
    let points = input.code_points()
    let targets = expected.code_points()
    assert(points.length == targets.length)
    let index = 0
    loop {
        break if index == points.length
        let point = points[index]
        let actual = branch {
            mode == 0 -> point.simple_lower()
            mode == 1 -> point.simple_upper()
            _ -> point.simple_title()
        }
        assert(actual == targets[index])
        index = index + 1
    }
}
