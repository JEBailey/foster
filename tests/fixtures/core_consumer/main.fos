import core.list
import core.option
import core.result

func double(value: Int) -> Int { value * 2 }

func initial() -> Result<Int, String> {
    Result.Ok(20)
}

func main() -> Int {
    let values = [1, 2, 3].map(double)
    let first = (move values).first()
    let mapped = initial().map(double)
    branch first {
        Option.Some(value) -> branch mapped {
            Result.Ok(other) -> value + other
            Result.Error(_) -> 0
        }
        Option.None -> 0
    }
}
