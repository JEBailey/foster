//! Remote objects, futures, borrowed messages, and persistent read loans.

import core.result

type Counter = {
    value: Int
}

type Inspector = {}

impl Counter {
    func increment(self: Counter, amount: Int) -> Int [mut self] {
        self.value = self.value + amount
        self.value
    }

    func snapshot(self: Counter) -> Int [read self.value] {
        self.value
    }

    func assign(self: Counter, value: Int) -> Int [mut self] {
        self.value = value
        self.value
    }
}

impl Inspector {
    func inspect(self: Inspector, counter: Counter) -> Int [read counter.value] {
        counter.value
    }
}

test "remote objects process messages in FIFO order" {
    let counter = remote Counter { value: 0 }
    let first = counter.increment(2)
    let second = counter.increment(3)
    assert((await first).unwrap_or(0) + (await second).unwrap_or(0) == 7)
}

test "persistent remote read loans observe owner mutation" {
    let counter = Counter { value: 0 }
    let reader = remote ref counter
    let before = (await reader.snapshot()).unwrap_or(0)
    counter.assign(42)
    let after = (await reader.snapshot()).unwrap_or(0)
    assert(before + after == 42)
}

test "remote borrowed arguments remain live read-only loans" {
    let counter = Counter { value: 0 }
    let inspector = remote Inspector {}
    let before = (await inspector.inspect(counter)).unwrap_or(0)
    counter.assign(42)
    let after = (await inspector.inspect(counter)).unwrap_or(0)
    assert(before + after == 42)
}
