//! Group-parameterized references and explicit callable effect contracts.

type Counters = { accepted: Int, rejected: Int, limit: Int }

func record_batch[g: group Counters](counts: ref[g] Counters) -> () [mut g(accepted, rejected)] {
    counts.accepted = counts.accepted + 2
    counts.rejected = counts.rejected + 1
    ()
}

test "grouped effects mutate named fields and preserve other fields" {
    let counts = Counters { accepted: 0, rejected: 0, limit: 10 }
    record_batch(ref counts)
    assert(counts.accepted == 2)
    assert(counts.rejected == 1)
    assert(counts.limit == 10)
}

func replace[g: group Int](value: ref[g] Int) -> Int [mut g] {
    value = 2
    value
}

func incrementer[g: group Int](value: ref[g] Int) -> func() -> Int [mut g] {
    [ref value] () -> [mut g] {
        value = value + 1
        value
    }
}

func transfer[source: group Int, destination: group Int](from: ref[source] Int, to: ref[destination] Int) -> Int [read source, mut destination] {
    to = from
    to
}

test "group mutation effects write through references" {
    let value = 1
    assert(replace(ref value) == 2)
    assert(value == 2)
}

test "returned closures retain projected group effects" {
    let values = [40]
    let increment = incrementer(ref values[0])
    increment()
    increment()
    assert(values[0] == 42)
}

test "multiple groups instantiate independently" {
    let left = 42
    let right = 0
    assert(transfer(ref left, ref right) == 42)
    assert(left == 42)
    assert(right == 42)
    left = 7
    assert(right == 42)
}
