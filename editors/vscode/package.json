{
  "name": "foster-language-support",
  "displayName": "Foster Language Support",
  "description": "Language support and compiler diagnostics for Foster.",
  "version": "0.1.0",
  "publisher": "foster-lang",
  "license": "MIT OR Apache-2.0",
  "pricing": "Free",
  "keywords": [
    "foster",
    "programming language",
    "language server",
    "lsp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:foster",
    "workspaceContains:**/*.fos",
    "onCommand:foster.restartLanguageServer",
    "onCommand:foster.showLanguageServerOutput",
    "onCommand:foster.runCurrentFile",
    "onCommand:foster.runCurrentPackage",
    "onTaskType:foster",
    "onDebug:foster"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "foster",
        "aliases": [
          "Foster",
          "foster"
        ],
        "extensions": [
          ".fos"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "foster",
        "scopeName": "source.foster",
        "path": "./syntaxes/foster.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "foster.restartLanguageServer",
        "title": "Foster: Restart Language Server"
      },
      {
        "command": "foster.showLanguageServerOutput",
        "title": "Foster: Show Language Server Output"
      },
      {
        "command": "foster.runCurrentFile",
        "title": "Foster: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "foster.runCurrentPackage",
        "title": "Foster: Run Current Package"
      },
      {
        "command": "foster.debugCurrentFile",
        "title": "Foster: Debug Current File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "foster.debugCurrentPackage",
        "title": "Foster: Debug Current Package"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "foster.runCurrentFile",
          "when": "resourceLangId == foster",
          "group": "navigation@1"
        },
        {
          "command": "foster.debugCurrentFile",
          "when": "resourceLangId == foster",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Foster",
      "properties": {
        "foster.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a Foster compiler executable. When empty, the extension uses its bundled compiler, a workspace development build, or Foster on PATH."
        },
        "foster.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication between VS Code and the Foster language server."
        },
        "foster.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Program arguments for Run Current File/Package."
        },
        "foster.run.cwd": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Working directory for Run commands. Relative paths use the workspace folder; empty uses the program directory."
        },
        "foster.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "description": "Environment overrides for Run commands."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "foster",
        "required": [
          "command",
          "program"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "check",
              "build",
              "test"
            ],
            "description": "Foster command to execute."
          },
          "program": {
            "type": "string",
            "description": "Source file, package directory, or foster.toml."
          },
          "cwd": {
            "type": "string",
            "description": "Working directory; defaults to the program directory."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Program arguments passed after -- (run only)."
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment overrides for the task."
          },
          "optimize": {
            "type": "boolean",
            "default": true,
            "description": "Enable bytecode optimization for run/build."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "foster"
      }
    ],
    "debuggers": [
      {
        "type": "foster",
        "label": "Foster",
        "languages": [
          "foster"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Foster source file, package directory, or foster.toml."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory; defaults to the program directory."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to main."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment overrides."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Pause at the first executable source line."
              },
              "optimize": {
                "type": "boolean",
                "default": true,
                "description": "Optimization for Run Without Debugging; debugging always disables optimization."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "foster",
            "request": "launch",
            "name": "Debug Foster package",
            "program": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Foster: Debug package",
            "body": {
              "type": "foster",
              "request": "launch",
              "name": "Debug Foster package",
              "program": "${workspaceFolder}",
              "args": [],
              "stopOnEntry": true
            }
          },
          {
            "label": "Foster: Debug current file",
            "body": {
              "type": "foster",
              "request": "launch",
              "name": "Debug Foster file",
              "program": "${file}",
              "args": [],
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "check-types": "tsc -p ./ --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "npm run check-types && node scripts/test-grammar.cjs",
    "package": "npm run check && node esbuild.js --production",
    "stage": "node scripts/stage-server.cjs",
    "vscode:prepublish": "npm run stage && npm run package",
    "test:run-debug": "tsc -p ./ --outDir ../../target/vscode-test-out && node --test scripts/test-run-debug.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Foster tasks and debugging execute workspace code."
    }
  }
}
