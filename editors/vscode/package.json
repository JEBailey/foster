{
  "name": "foster-language-support",
  "displayName": "Foster Language Support",
  "description": "Language support and compiler diagnostics for Foster.",
  "version": "0.1.0",
  "publisher": "foster-lang",
  "license": "MIT OR Apache-2.0",
  "pricing": "Free",
  "keywords": [
    "foster",
    "programming language",
    "language server",
    "lsp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:foster",
    "onCommand:foster.restartLanguageServer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "foster",
        "aliases": [
          "Foster",
          "foster"
        ],
        "extensions": [
          ".fos"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "foster",
        "scopeName": "source.foster",
        "path": "./syntaxes/foster.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "foster.restartLanguageServer",
        "title": "Foster: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Foster",
      "properties": {
        "foster.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a Foster compiler executable. When empty, the extension uses its bundled compiler, a workspace development build, or Foster on PATH."
        },
        "foster.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication between VS Code and the Foster language server."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc -p ./ --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "npm run check-types && node scripts/test-grammar.cjs",
    "package": "npm run check && node esbuild.js --production",
    "stage": "node scripts/stage-server.cjs",
    "vscode:prepublish": "npm run stage && npm run package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
