
import core.drop
import core.result
type Item = & Drop & { id: Int }
impl Item { func deinit(self) -> () { println(self.id) } }
type Worker = { id: Int }
impl Worker {
    func inspect(self, item: Item) -> Int [consume item] {
        println(10)
        item.id
    }
}
func main() -> Int {
    let worker = remote Worker { id: 0 }
    assert(await worker.inspect(Item { id: 1 }) == Result.Ok(1))
    println(20)
    42
}
