//! Transport-independent request parsing, dispatch, and response rendering.
// The TCP transport in `main` feeds raw peer text into these pure functions.

import core.int
import core.string

/// A request parsed from a single line of peer text.
pub enum Request = Get(String)
    | Unknown(String)

/// A response ready to be rendered for the peer.
pub type Response = {
    pub status: Int
    pub reason: String
    pub body: String
}

/// Parses one line of request text into a typed request.
pub func parse_request(source: String) -> Request {
    let text = source.trim()
    branch {
        text.empty? -> Unknown("empty request")
        text.starts_with?("GET ") -> Get(path_from(move text))
        _ -> Unknown(text)
    }
}

/// Extracts the path token from a `GET` request line.
func path_from(line: String) -> String {
    let parts = line.split(" ")
    branch {
        parts.length >= 2 -> parts[1]
        _ -> "/"
    }
}

/// Routes a parsed request to its response.
pub func dispatch(request: Request) -> Response {
    branch request {
        Get(path) -> route(path)
        Unknown(detail) -> bad_request(detail)
    }
}

/// Routes a GET path to its response.
func route(path: String) -> Response {
    branch path {
        "/" -> ok_response(banner())
        "/health" -> ok_response("healthy")
        _ -> not_found(path)
    }
}

/// The banner served at the root path.
func banner() -> String {
    "foster service"
}

/// Builds a 200 OK response with the given body.
func ok_response(body: String) -> Response {
    Response { status: 200, reason: "OK", body: body }
}

/// Builds a 400 Bad Request response describing the offending line.
func bad_request(detail: String) -> Response {
    Response { status: 400, reason: "Bad Request", body: "bad request: " + detail }
}

/// Builds a 404 Not Found response for an unmapped path.
func not_found(path: String) -> Response {
    Response { status: 404, reason: "Not Found", body: "not found: " + path }
}

/// Renders a complete HTTP/1.0 response with CRLF line endings.
pub func render(response: Response) -> String {
    let head = "HTTP/1.0 " + response.status.as_string() + " " + response.reason + "\r\n"
    let length = "Content-Length: " + response.body.byte_length().as_string() + "\r\n"
    let frame = "Content-Type: text/plain\r\n" + length + "\r\n"
    head + frame + response.body
}

/// Reports whether the request is a GET for the expected path.
func path_of?(request: Request, expected: String) -> Bool {
    branch request {
        Get(path) -> path == expected
        Get(_) -> false
        _ -> false
    }
}

/// Reports whether the request failed to parse.
func unknown_of?(request: Request) -> Bool {
    branch request {
        Get(_) -> false
        _ -> true
    }
}

test "a health line parses to a GET request" {
    let request = parse_request("GET /health HTTP/1.1\r\n\r\n")
    assert(path_of?(request, "/health"), "health line did not parse to GET /health")
}

test "a root line parses to a GET request" {
    let request = parse_request("GET /")
    assert(path_of?(request, "/"), "root line did not parse to GET /")
}

test "an empty line parses as unknown" {
    let request = parse_request("   ")
    assert(unknown_of?(request), "empty line should be unknown")
}

test "an unsupported verb parses as unknown" {
    let request = parse_request("DELETE /health")
    assert(unknown_of?(request), "DELETE should be unknown")
}

test "health dispatches to a 200 response" {
    let response = dispatch(Request.Get("/health"))
    assert(response.status == 200, "health should be 200")
    assert(response.body == "healthy", "health body changed")
}

test "unknown lines dispatch to a 400 response" {
    let response = dispatch(Request.Unknown("DELETE /x"))
    assert(response.status == 400, "unknown verb should be 400")
}

test "unmapped paths dispatch to a 404 response" {
    let response = dispatch(Request.Get("/missing"))
    assert(response.status == 404, "unmapped path should be 404")
}

test "the renderer frames the response body" {
    let response = Response { status: 200, reason: "OK", body: "healthy" }
    let text = render(response)
    assert(text.starts_with?("HTTP/1.0 200 OK\r\n"), "status line changed")
    assert(text.contains?("Content-Length: 7"), "content length changed")
    assert(text.ends_with?("healthy"), "body changed")
}
