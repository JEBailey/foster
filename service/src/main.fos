//! TCP transport for the service: the accept loop, per-connection handling,
// and a built-in client for smoke tests.

import core.code_point
import core.int
import core.list
import core.option
import core.result
import core.string
import protocol
import std.net.tcp
import std.process

/// Runs the service: serves by default, or acts as a client in client mode.
func main(arguments: Arguments) -> Int {
    let values = arguments.values
    branch {
        values.empty? -> serve("127.0.0.1", 8080)
        values[0] == "client" -> client_mode(values)
        values.length == 2 -> branch parse_port(values[1]) {
            Option.Some(port) -> serve(values[0], port)
            _ -> usage("the port must be a decimal integer")
        }
        _ -> usage("expected [host port] or client host port")
    }
}

/// Binds the listener and handles each accepted connection in turn.
func serve(host: String, port: Int) -> Int {
    branch listen(host, port) {
        Result.Ok(listener) -> {
            println("service listening on", host, ":", port)
            loop {
                let accepted = listener.accept()
                branch accepted {
                    Result.Ok(connection) -> handle_connection(move connection)
                    Result.Error(error) -> println("accept failed:", error.message)
                }
            }
            0
        }
        Result.Error(error) -> {
            println("listen failed:", error.operation, error.message)
            1
        }
    }
}

/// Reads one request, dispatches it, and replies over the connection.
func handle_connection(connection: Connection) -> () {
    let text = branch connection.read_text(8192) {
        Result.Ok(text) -> text
        Result.Error(error) -> {
            println("read failed:", error.message)
            ""
        }
    }
    let response = protocol::dispatch(protocol::parse_request(move text))
    let rendered = protocol::render(response)
    branch connection.write_text(rendered) {
        Result.Ok(_) -> println("responded:", response.status.as_string())
        Result.Error(error) -> println("write failed:", error.message)
    }
    branch connection.close() {
        Result.Ok(_) -> ()
        Result.Error(error) -> println("close failed:", error.message)
    }
}

/// Sends one health request to the service at host:port and prints the reply.
func client_mode(values: List<String>) -> Int {
    branch {
        values.length == 3 -> branch parse_port(values[2]) {
            Option.Some(port) -> client_request(values[1], port)
            _ -> usage("the port must be a decimal integer")
        }
        _ -> usage("client mode expects: client host port")
    }
}

func client_request(host: String, port: Int) -> Int {
    branch connect(host, port) {
        Result.Ok(connection) -> {
            branch connection.write_text("GET /health HTTP/1.1\r\n\r\n") {
                Result.Ok(_) -> ()
                Result.Error(error) -> println("write failed:", error.message)
            }
            let reply = branch connection.read_text(8192) {
                Result.Ok(text) -> text
                Result.Error(error) -> "read failed: " + error.message
            }
            println(reply)
            branch connection.close() {
                Result.Ok(_) -> ()
                Result.Error(error) -> println("close failed:", error.message)
            }
            0
        }
        Result.Error(error) -> {
            println("connect failed:", error.message)
            1
        }
    }
}

/// Prints a usage message and returns a non-zero exit code.
func usage(detail: String) -> Int {
    println("service:", detail)
    println("usage: foster run service [host port] | foster run service -- client host port")
    2
}

/// Parses a decimal port number from a command-line argument.
func parse_port(text: String) -> Option<Int> {
    branch {
        text.empty? -> Option.None
        _ -> parse_digits(text.code_points(), 0)
    }
}

/// Folds decimal code points into a port value.
func parse_digits(remaining: List<CodePoint>, value: Int) -> Option<Int> {
    branch remaining.first() {
        Option.None -> Option.Some(value)
        Option.Some(character) -> {
            let code = character.as_int()
            branch {
                code >= 48 && code <= 57 -> parse_digits(remaining.drop(1), value * 10 + (code - 48))
                _ -> Option.None
            }
        }
    }
}
