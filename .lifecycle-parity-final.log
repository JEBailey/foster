= 1\n[value.child]\n"), span: 74926..74954 }] }, span: 74920..74955 }] }, span: 74903..74956 } }, span: 74895..74956 } }, span: 74887..74956 }, Spanned { value: Assign { name: "score", value: Spanned { expression: Binary { left: Spanned { expression: Name("score"), span: 74970..74975 }, operator: Add, right: Spanned { expression: Call { callee: Spanned { expression: Name("test_error_score"), span: 74978..74994 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Name("parse"), span: 74995..75000 }, arguments: [Spanned { expression: String("value = { key = 1, key = 2 }\n"), span: 75001..75033 }] }, span: 74995..75034 }] }, span: 74978..75035 } }, span: 74970..75035 } }, span: 74962..75035 }, Spanned { value: Assign { name: "score", value: Spanned { expression: Binary { left: Spanned { expression: Name("score"), span: 75049..75054 }, operator: Add, right: Spanned { expression: Call { callee: Spanned { expression: Name("test_error_score"), span: 75057..75073 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Name("parse"), span: 75074..75079 }, arguments: [Spanned { expression: String("value = [1, 2\n"), span: 75080..75097 }] }, span: 75074..75098 }] }, span: 75057..75099 } }, span: 75049..75099 } }, span: 75041..75099 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Name("score"), span: 75112..75117 }, operator: Equal, right: Spanned { expression: Integer(10), span: 75121..75123 } }, span: 75112..75123 }, message: None }, span: 75105..75124 }] } }] }), source: Some("//! A TOML 1.1 parser and deterministic renderer written in Foster.\r\n\r\nimport core.code_point\r\nimport core.float\r\nimport core.int\r\nimport core.list\r\nimport core.option\r\nimport core.result\r\nimport core.string\r\n\r\n/// A complete TOML document whose root is a table.\r\npub type TomlDocument = {\r\n    pub entries: List<TomlEntry>\r\n}\r\n\r\n/// A key-value entry in a TOML table.\r\npub type TomlEntry = {\r\n    pub key: String\r\n    pub value: TomlValue\r\n}\r\n\r\n/// A scalar, date-time, list, or table value in the TOML data model.\r\n///\r\n/// Date, time, and date-time values retain their normalized TOML text in the\r\n/// `DateTime` case so parsing does not depend on a platform clock library.\r\npub enum TomlValue = String(String)\r\n    | Int(Int)\r\n    | Float(Float)\r\n    | Bool(Bool)\r\n    | DateTime(String)\r\n    | Array(List<TomlValue>)\r\n    | Table(List<TomlEntry>)\r\n\r\n/// A TOML parsing or rendering failure.\r\n///\r\n/// Parse positions are one-based. Rendering errors use zero for both fields.\r\npub type TomlError = {\r\n    pub message: String\r\n    pub line: Int\r\n    pub column: Int\r\n}\r\n\r\ntype PathItem = { key: String, index: Int }\r\n\r\nenum PathPart = Key(String)\r\n    | ArrayItem(PathItem)\r\n\r\nenum FlatValue = Value(TomlValue)\r\n    | TableMarker\r\n    | ArrayTableMarker\r\n\r\ntype FlatEntry = {\r\n    path: List<PathPart>\r\n    value: FlatValue\r\n}\r\n\r\ntype Parser = {\r\n    remaining: String\r\n    line: Int\r\n    column: Int\r\n    entries: List<FlatEntry>\r\n    context: List<PathPart>\r\n    errors: List<TomlError>\r\n}\r\n\r\nimpl PathPart {\r\n    /// Copies a path component while preserving the original path.\r\n    func copy(self) -> self {\r\n        branch self {\r\n            PathPart.Key(key) -> PathPart.Key(key.copy())\r\n            PathPart.ArrayItem(item) -> PathPart.ArrayItem(PathItem { key: item.key.copy(), index: item.index })\r\n        }\r\n    }\r\n}\r\n\r\nimpl TomlEntry {\r\n    /// Copies this entry and its complete TOML value.\r\n    pub func copy(self) -> self { TomlEntry { key: self.key.copy(), value: self.value.copy() } }\r\n}\r\n\r\nimpl TomlValue {\r\n    /// Copies the complete TOML tree without consuming the source.\r\n    pub func copy(self) -> self {\r\n        branch self {\r\n            TomlValue.String(value) -> TomlValue.String(value.copy())\r\n            TomlValue.Int(value) -> TomlValue.Int(value)\r\n            TomlValue.Float(value) -> TomlValue.Float(value)\r\n            TomlValue.Bool(value) -> TomlValue.Bool(value)\r\n            TomlValue.DateTime(value) -> TomlValue.DateTime(value.copy())\r\n            TomlValue.Array(values) -> TomlValue.Array(values.map((value: TomlValue) -> value.copy()))\r\n            TomlValue.Table(entries) -> TomlValue.Table(entries.map((entry: TomlEntry) -> entry.copy()))\r\n        }\r\n    }\r\n}\r\n\r\n/// Parses source text into a typed TOML document.\r\npub func parse(source: String) -> Result<TomlDocument, TomlError> {\r\n    let parser = Parser {\r\n        remaining: move source,\r\n        line: 1,\r\n        column: 1,\r\n        entries: [],\r\n        context: [],\r\n        errors: []\r\n    }\r\n    parser.parse_document()\r\n}\r\n\r\nimpl TomlDocument {\r\n    /// Renders a typed TOML document as deterministic TOML text.\r\n    pub func render(self: TomlDocument) -> Result<String, TomlError> [consume self] {\r\n        render_entries(move self.entries, \"\")\r\n    }\r\n\r\n    /// Finds a top-level document value by key.\r\n    pub func get(self: TomlDocument, key: String) -> Option<TomlValue> [consume self, consume key] {\r\n        find_entry(move self.entries, move key)\r\n    }\r\n}\r\n\r\nimpl TomlValue {\r\n    /// Finds a value by key when `value` is a table, returning `None` otherwise.\r\n    pub func get(self: TomlValue, key: String) -> Option<TomlValue> [consume self, consume key] {\r\n        branch self {\r\n            TomlValue.Table(entries) -> find_entry(move entries, move key)\r\n            _ -> Option.None\r\n        }\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc find_entry(entries: List<TomlEntry>, key: String) -> Option<TomlValue> {\r\n    branch {\r\n        entries.empty? -> Option.None\r\n        entries.head.key == key -> Option.Some(entries.head.value)\r\n        _ -> find_entry(entries.rest, key)\r\n    }\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_document(self: Parser) -> Result<TomlDocument, TomlError> [mut self] {\r\n        self.skip_document_space()\r\n        self.parse_statements()\r\n        branch {\r\n            not self.errors.empty? -> Result.Error(self.errors.head)\r\n            _ -> Result.Ok(TomlDocument { entries: materialize(self.entries, []) })\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_statements(self: Parser) -> () [mut self] {\r\n        return () if self.failed?()\r\n        return () if self.remaining.empty?\r\n        branch {\r\n            self.remaining.starts_with?(\"[[\") -> self.parse_header(true)\r\n            self.remaining.starts_with?(\"[\") -> self.parse_header(false)\r\n            _ -> self.parse_key_value()\r\n        }\r\n        self.finish_statement()\r\n        self.skip_document_space()\r\n        self.parse_statements()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_key_value(self: Parser) -> () [mut self] {\r\n        let keys = self.parse_key_path()\r\n        self.skip_horizontal_space()\r\n        return self.fail(\"expected `=` after key\") if not self.peek?('=')\r\n        self.take()\r\n        self.skip_horizontal_space()\r\n        let value = self.parse_value()\r\n        return () if self.failed?()\r\n        let path = [].concat(self.context)\r\n        self.insert_value((move path).concat(key_parts(move keys)), move value)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc key_parts(keys: List<String>) -> List<PathPart> {\r\n    branch {\r\n        keys.empty? -> []\r\n        _ -> [PathPart.Key(keys.head)].concat(key_parts(keys.rest))\r\n    }\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_header(self: Parser, array_header: Bool) -> () [mut self] {\r\n        self.take()\r\n        self.take_array_header_open(array_header)\r\n        self.skip_horizontal_space()\r\n        let keys = self.parse_key_path()\r\n        self.skip_horizontal_space()\r\n        return self.close_array_header(move keys) if array_header\r\n        return self.fail(\"expected `]` after table header\") if not self.peek?(']')\r\n        self.take()\r\n        self.declare_table(move keys)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_array_header_open(self: Parser, array_header: Bool) -> () [mut self] {\r\n        return () if not array_header\r\n        self.take()\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_array_header(self: Parser, keys: List<String>) -> () [mut self, consume keys] {\r\n        return self.fail(\"expected `]]` after array-of-tables header\") if not self.remaining.starts_with?(\"]]\" )\r\n        self.take()\r\n        self.take()\r\n        self.declare_array_table(move keys)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func finish_statement(self: Parser) -> () [mut self] {\r\n        return () if self.failed?()\r\n        self.skip_horizontal_space()\r\n        self.skip_comment()\r\n        branch {\r\n            self.remaining.empty? -> ()\r\n            self.newline?() -> self.take_newline()\r\n            _ -> self.fail(\"expected a newline or comment after statement\")\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_document_space(self: Parser) -> () [mut self] {\r\n        return () if self.failed?()\r\n        self.skip_horizontal_space()\r\n        self.skip_comment()\r\n        return () if not self.newline?()\r\n        self.take_newline()\r\n        self.skip_document_space()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_horizontal_space(self: Parser) -> () [mut self] {\r\n        let prefix = self.remaining.take_while((character: CodePoint) -> character == ' ' || character == '\\t')\r\n        self.consume_text(prefix)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_comment(self: Parser) -> () [mut self] {\r\n        return () if not self.peek?('#')\r\n        self.take()\r\n        self.skip_comment_text()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_comment_text(self: Parser) -> () [mut self] {\r\n        return () if self.remaining.empty?\r\n        return () if self.newline?()\r\n        return self.fail(\"control character is not allowed in a comment\") if control_character?(self.remaining.head)\r\n        self.take()\r\n        self.skip_comment_text()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func newline?(self: Parser) -> Bool {\r\n        self.remaining.starts_with?(\"\\n\") || self.remaining.starts_with?(\"\\r\\n\")\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_newline(self: Parser) -> () [mut self] {\r\n        return self.take_crlf() if self.remaining.starts_with?(\"\\r\\n\")\r\n        return self.take_lf() if self.remaining.starts_with?(\"\\n\")\r\n        self.fail(\"expected a newline\")\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_crlf(self: Parser) -> () [mut self] {\r\n        self.remaining = self.remaining.rest.rest\r\n        self.line = self.line + 1\r\n        self.column = 1\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_lf(self: Parser) -> () [mut self] {\r\n        self.remaining = self.remaining.rest\r\n        self.line = self.line + 1\r\n        self.column = 1\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func peek?(self: Parser, expected: CodePoint) -> Bool {\r\n        branch {\r\n            self.remaining.empty? -> false\r\n            _ -> self.remaining.head == expected\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take(self: Parser) -> CodePoint [mut self] {\r\n        let character = self.remaining.head\r\n        self.remaining = self.remaining.rest\r\n        self.column = self.column + 1\r\n        character\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func failed?(self: Parser) -> Bool { not self.errors.empty? }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func fail(self: Parser, message: String) -> () [mut self, consume message] {\r\n        return () if self.failed?()\r\n        self.errors = self.errors.append(TomlError {\r\n            message: move message,\r\n            line: self.line,\r\n            column: self.column\r\n        })\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func fail_at(self: Parser, message: String, line: Int, column: Int) -> () [mut self, consume message] {\r\n        return () if self.failed?()\r\n        self.errors = self.errors.append(TomlError {\r\n            message: move message,\r\n            line: line,\r\n            column: column\r\n        })\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_key_path(self: Parser) -> List<String> [mut self] {\r\n        let first = self.parse_key()\r\n        return [] if self.failed?()\r\n        self.parse_key_tail([first])\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_key_tail(self: Parser, keys: List<String>) -> List<String> [mut self, consume keys] {\r\n        self.skip_horizontal_space()\r\n        return keys if not self.peek?('.')\r\n        self.take()\r\n        self.skip_horizontal_space()\r\n        let key = self.parse_key()\r\n        self.parse_key_tail(keys.append(move key))\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_key(self: Parser) -> String [mut self] {\r\n        branch {\r\n            self.remaining.starts_with?(\"\\\"\") -> self.parse_basic_string(false)\r\n            self.remaining.starts_with?(\"'\") -> self.parse_literal_string(false)\r\n            _ -> self.parse_bare_key()\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_bare_key(self: Parser) -> String [mut self] {\r\n        let output = self.remaining.take_while(bare_key_character?)\r\n        self.consume_text(output)\r\n        self.finish_bare_key(move output)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func finish_bare_key(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail_empty_key(output.empty?)\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func fail_empty_key(self: Parser, empty: Bool) -> () [mut self] {\r\n        return () if not empty\r\n        self.fail(\"expected a key\")\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc bare_key_character?(character: CodePoint) -> Bool {\r\n    (ascii_letter?(character) || decimal_digit?(character)) || character == '_' || character == '-'\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_basic_string(self: Parser, multiline: Bool) -> String [mut self] {\r\n        self.open_basic_string(multiline)\r\n        self.parse_basic_characters(\"\", multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func open_basic_string(self: Parser, multiline: Bool) -> () [mut self] {\r\n        return self.open_multiline_basic() if multiline\r\n        self.take()\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func open_multiline_basic(self: Parser) -> () [mut self] {\r\n        self.consume_text(\"\\\"\\\"\\\"\")\r\n        self.trim_multiline_first_newline()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_basic_characters(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        return self.unterminated_basic(move output) if self.remaining.empty?\r\n        return self.close_multiline_basic(move output) if multiline && self.remaining.starts_with?(\"\\\"\\\"\\\"\")\r\n        return self.close_basic(move output) if not multiline && self.peek?('\\\"')\r\n        return self.start_escape(move output, multiline) if self.peek?('\\\\')\r\n        return self.basic_newline(move output, multiline) if self.newline?()\r\n        return self.forbidden_basic(move output) if forbidden_string_character?(self.remaining.head)\r\n        let character = self.take()\r\n        self.parse_basic_characters(output + character.string, multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func unterminated_basic(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"unterminated basic string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_multiline_basic(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.consume_text(\"\\\"\\\"\\\"\")\r\n        self.take_extra_quotes(move output, 0)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_basic(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.take()\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func start_escape(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        self.take()\r\n        self.parse_escape(move output, multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func basic_newline(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        return self.invalid_basic_newline(move output) if not multiline\r\n        self.take_newline()\r\n        self.parse_basic_characters(output + \"\\n\", true)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_basic_newline(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"newline is not allowed in a basic string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func forbidden_basic(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"control character is not allowed in a string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_escape(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        branch {\r\n            multiline && self.escape_fold_start?() -> self.fold_escape(move output)\r\n            self.remaining.empty? -> self.unterminated_escape(move output)\r\n            self.peek?('b') -> self.escaped_code_point(move output, 8, multiline)\r\n            self.peek?('t') -> self.escaped_character(move output, \"\\t\", multiline)\r\n            self.peek?('n') -> self.escaped_character(move output, \"\\n\", multiline)\r\n            self.peek?('f') -> self.escaped_code_point(move output, 12, multiline)\r\n            self.peek?('r') -> self.escaped_character(move output, \"\\r\", multiline)\r\n            self.peek?('e') -> self.escaped_code_point(move output, 27, multiline)\r\n            self.peek?('\\\"') -> self.escaped_character(move output, \"\\\"\", multiline)\r\n            self.peek?('\\\\') -> self.escaped_character(move output, \"\\\\\", multiline)\r\n            self.peek?('x') -> self.parse_unicode_escape(move output, 2, multiline)\r\n            self.peek?('u') -> self.parse_unicode_escape(move output, 4, multiline)\r\n            self.peek?('U') -> self.parse_unicode_escape(move output, 8, multiline)\r\n            _ -> self.invalid_escape(move output)\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func fold_escape(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.skip_escape_fold()\r\n        self.parse_basic_characters(move output, true)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func unterminated_escape(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"unterminated escape sequence\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_escape(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"invalid basic-string escape sequence\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func escaped_character(self: Parser, output: String, escaped: String, multiline: Bool) -> String [mut self, consume output] {\r\n        self.take()\r\n        self.parse_basic_characters(output + escaped, multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func escaped_code_point(self: Parser, output: String, value: Int, multiline: Bool) -> String [mut self, consume output] {\r\n        self.take()\r\n        self.parse_basic_characters(output + from_code_point(value).string, multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_unicode_escape(self: Parser, output: String, digits: Int, multiline: Bool) -> String [mut self, consume output] {\r\n        self.take()\r\n        let value = self.take_hex_digits(digits, 0)\r\n        branch CodePoint.from(value) {\r\n            Option.Some(character) -> self.parse_basic_characters(output + character.string, multiline)\r\n            Option.None -> self.invalid_unicode_escape(move output)\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_unicode_escape(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"escape does not name a Unicode scalar value\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_hex_digits(self: Parser, remaining: Int, value: Int) -> Int [mut self] {\r\n        return value if remaining == 0\r\n        return self.incomplete_hex(value) if self.remaining.empty?\r\n        return self.invalid_hex(value) if not hex_digit?(self.remaining.head)\r\n        let digit = hex_value(self.take())\r\n        self.take_hex_digits(remaining - 1, value * 16 + digit)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func incomplete_hex(self: Parser, value: Int) -> Int [mut self] {\r\n        self.fail(\"incomplete hexadecimal escape\")\r\n        value\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_hex(self: Parser, value: Int) -> Int [mut self] {\r\n        self.fail(\"expected a hexadecimal digit in escape\")\r\n        value\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func escape_fold_start?(self: Parser) -> Bool {\r\n        fold_space_then_newline?(self.remaining)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc fold_space_then_newline?(value: String) -> Bool {\r\n    branch {\r\n        value.starts_with?(\"\\n\") || value.starts_with?(\"\\r\\n\") -> true\r\n        value.empty? -> false\r\n        value.head == ' ' || value.head == '\\t' -> fold_space_then_newline?(value.rest)\r\n        _ -> false\r\n    }\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_escape_fold(self: Parser) -> () [mut self] {\r\n        self.skip_horizontal_space()\r\n        self.take_newline()\r\n        self.skip_multiline_whitespace()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_multiline_whitespace(self: Parser) -> () [mut self] {\r\n        return self.skip_one_multiline_space() if self.peek?(' ') || self.peek?('\\t')\r\n        return self.skip_one_multiline_newline() if self.newline?()\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_one_multiline_space(self: Parser) -> () [mut self] {\r\n        self.take()\r\n        self.skip_multiline_whitespace()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_one_multiline_newline(self: Parser) -> () [mut self] {\r\n        self.take_newline()\r\n        self.skip_multiline_whitespace()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_literal_string(self: Parser, multiline: Bool) -> String [mut self] {\r\n        self.open_literal_string(multiline)\r\n        self.parse_literal_characters(\"\", multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func open_literal_string(self: Parser, multiline: Bool) -> () [mut self] {\r\n        return self.open_multiline_literal() if multiline\r\n        self.take()\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func open_multiline_literal(self: Parser) -> () [mut self] {\r\n        self.consume_text(\"'''\")\r\n        self.trim_multiline_first_newline()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_literal_characters(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        return self.unterminated_literal(move output) if self.remaining.empty?\r\n        return self.close_multiline_literal(move output) if multiline && self.remaining.starts_with?(\"'''\")\r\n        return self.close_literal(move output) if not multiline && self.peek?('\\'')\r\n        return self.literal_newline(move output, multiline) if self.newline?()\r\n        return self.forbidden_literal(move output) if forbidden_string_character?(self.remaining.head)\r\n        let character = self.take()\r\n        self.parse_literal_characters(output + character.string, multiline)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func unterminated_literal(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"unterminated literal string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_multiline_literal(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.consume_text(\"'''\")\r\n        self.take_extra_apostrophes(move output, 0)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_literal(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.take()\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func literal_newline(self: Parser, output: String, multiline: Bool) -> String [mut self, consume output] {\r\n        return self.invalid_literal_newline(move output) if not multiline\r\n        self.take_newline()\r\n        self.parse_literal_characters(output + \"\\n\", true)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_literal_newline(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"newline is not allowed in a literal string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func forbidden_literal(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.fail(\"control character is not allowed in a string\")\r\n        output\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_extra_quotes(self: Parser, output: String, count: Int) -> String [mut self, consume output] {\r\n        return output if count >= 2 || not self.peek?('\\\"')\r\n        self.take()\r\n        self.take_extra_quotes(output + \"\\\"\", count + 1)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_extra_apostrophes(self: Parser, output: String, count: Int) -> String [mut self, consume output] {\r\n        return output if count >= 2 || not self.peek?('\\'')\r\n        self.take()\r\n        self.take_extra_apostrophes(output + \"'\", count + 1)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func trim_multiline_first_newline(self: Parser) -> () [mut self] {\r\n        return () if not self.newline?()\r\n        self.take_newline()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func consume_text(self: Parser, text: String) -> () [mut self] {\r\n        return () if text.empty?\r\n        self.take()\r\n        self.consume_text(text.rest)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc forbidden_string_character?(character: CodePoint) -> Bool {\r\n    let value = character.as_int()\r\n    branch {\r\n        value == 9 -> false\r\n        value < 32 -> true\r\n        value == 127 -> true\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc control_character?(character: CodePoint) -> Bool {\r\n    let value = character.as_int()\r\n    return false if value == 9\r\n    value < 32 || value == 127\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc ascii_letter?(character: CodePoint) -> Bool {\r\n    (character >= 'A' && character <= 'Z') || (character >= 'a' && character <= 'z')\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc decimal_digit?(character: CodePoint) -> Bool { character >= '0' && character <= '9' }\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc hex_digit?(character: CodePoint) -> Bool {\r\n    decimal_digit?(character) || (character >= 'A' && character <= 'F') || (character >= 'a' && character <= 'f')\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc hex_value(character: CodePoint) -> Int {\r\n    branch {\r\n        character <= '9' -> character.as_int() - 48\r\n        character <= 'F' -> character.as_int() - 55\r\n        _ -> character.as_int() - 87\r\n    }\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_value(self: Parser) -> TomlValue [mut self] {\r\n        branch {\r\n            self.remaining.starts_with?(\"\\\"\\\"\\\"\") -> TomlValue.String(self.parse_basic_string(true))\r\n            self.remaining.starts_with?(\"'''\") -> TomlValue.String(self.parse_literal_string(true))\r\n            self.remaining.starts_with?(\"\\\"\") -> TomlValue.String(self.parse_basic_string(false))\r\n            self.remaining.starts_with?(\"'\") -> TomlValue.String(self.parse_literal_string(false))\r\n            self.peek?('[') -> self.parse_array()\r\n            self.peek?('{') -> self.parse_inline_table()\r\n            _ -> self.parse_bare_value()\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_array(self: Parser) -> TomlValue [mut self] {\r\n        let start_line = self.line\r\n        let start_column = self.column\r\n        self.take()\r\n        self.skip_value_space()\r\n        return self.empty_array() if self.peek?(']')\r\n        self.parse_array_values([], start_line, start_column)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func empty_array(self: Parser) -> TomlValue [mut self] {\r\n        self.take()\r\n        TomlValue.Array([])\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_array_values(self: Parser, values: List<TomlValue>, start_line: Int, start_column: Int) -> TomlValue [mut self, consume values] {\r\n        return self.unterminated_array(move values, start_line, start_column) if self.remaining.empty?\r\n        let value = self.parse_value()\r\n        return TomlValue.Array(move values) if self.failed?()\r\n        let next = values.append(move value)\r\n        self.skip_value_space()\r\n        return self.close_array(move next) if self.peek?(']')\r\n        return self.invalid_array(move next) if not self.peek?(',')\r\n        self.take()\r\n        self.skip_value_space()\r\n        return self.close_array(move next) if self.peek?(']')\r\n        return self.unterminated_array(move next, start_line, start_column) if self.remaining.empty?\r\n        self.parse_array_values(move next, start_line, start_column)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func unterminated_array(self: Parser, values: List<TomlValue>, line: Int, column: Int) -> TomlValue [mut self, consume values] {\r\n        self.fail_at(\"unterminated array\", line, column)\r\n        TomlValue.Array(move values)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_array(self: Parser, values: List<TomlValue>) -> TomlValue [mut self, consume values] {\r\n        self.take()\r\n        TomlValue.Array(move values)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_array(self: Parser, values: List<TomlValue>) -> TomlValue [mut self, consume values] {\r\n        self.fail(\"expected `,` or `]` in array\")\r\n        TomlValue.Array(move values)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_inline_table(self: Parser) -> TomlValue [mut self] {\r\n        self.take()\r\n        self.skip_value_space()\r\n        return self.empty_inline_table() if self.peek?('}')\r\n        self.parse_inline_entries([])\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func empty_inline_table(self: Parser) -> TomlValue [mut self] {\r\n        self.take()\r\n        TomlValue.Table([])\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_inline_entries(self: Parser, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {\r\n        let keys = self.parse_key_path()\r\n        self.skip_horizontal_space()\r\n        return TomlValue.Table(move entries) if not self.expect_character('=', \"expected `=` after inline-table key\")\r\n        self.skip_horizontal_space()\r\n        let value = self.parse_value()\r\n        return TomlValue.Table(move entries) if self.failed?()\r\n        let inserted = insert_table_value(move entries, move keys, move value)\r\n        branch inserted {\r\n            Result.Error(message) -> self.invalid_inline_insert(move message)\r\n            Result.Ok(next) -> self.finish_inline_entry(move next)\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_inline_insert(self: Parser, message: String) -> TomlValue [mut self, consume message] {\r\n        self.fail(move message)\r\n        TomlValue.Table([])\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func finish_inline_entry(self: Parser, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {\r\n        self.skip_value_space()\r\n        return self.close_inline_table(move entries) if self.peek?('}')\r\n        return self.invalid_inline_table(move entries) if not self.peek?(',')\r\n        self.take()\r\n        self.skip_value_space()\r\n        return self.close_inline_table(move entries) if self.peek?('}')\r\n        self.parse_inline_entries(move entries)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func close_inline_table(self: Parser, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {\r\n        self.take()\r\n        TomlValue.Table(move entries)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_inline_table(self: Parser, entries: List<TomlEntry>) -> TomlValue [mut self, consume entries] {\r\n        self.fail(\"expected `,` or `}` in inline table\")\r\n        TomlValue.Table(move entries)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func skip_value_space(self: Parser) -> () [mut self] {\r\n        self.skip_horizontal_space()\r\n        self.skip_comment()\r\n        return () if not self.newline?()\r\n        self.take_newline()\r\n        self.skip_value_space()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func expect_character(self: Parser, expected: CodePoint, message: String) -> Bool [mut self, consume message] {\r\n        return self.take_expected_character() if self.peek?(expected)\r\n        self.fail(move message)\r\n        false\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_expected_character(self: Parser) -> Bool [mut self] {\r\n        self.take()\r\n        true\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_bare_value(self: Parser) -> TomlValue [mut self] {\r\n        let token = self.take_bare_value(\"\")\r\n        branch {\r\n            token.empty? -> self.missing_value()\r\n            token == \"true\" -> TomlValue.Bool(true)\r\n            token == \"false\" -> TomlValue.Bool(false)\r\n            token == \"inf\" || token == \"+inf\" -> TomlValue.Float(parse_float(\"inf\"))\r\n            token == \"-inf\" -> TomlValue.Float(parse_float(\"-inf\"))\r\n            token == \"nan\" || token == \"+nan\" -> TomlValue.Float(parse_float(\"NaN\"))\r\n            token == \"-nan\" -> TomlValue.Float(-parse_float(\"NaN\"))\r\n            date_time?(token) -> TomlValue.DateTime(move token)\r\n            float_text?(token) -> TomlValue.Float(parse_float(remove_underscores(move token)))\r\n            integer_text?(token) -> TomlValue.Int(self.parse_integer(move token))\r\n            _ -> self.invalid_value()\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func missing_value(self: Parser) -> TomlValue [mut self] {\r\n        self.fail(\"expected a TOML value\")\r\n        TomlValue.String(\"\")\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func invalid_value(self: Parser) -> TomlValue [mut self] {\r\n        self.fail(\"invalid TOML value\")\r\n        TomlValue.String(\"\")\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_bare_value(self: Parser, output: String) -> String [mut self, consume output] {\r\n        return output if self.remaining.empty?\r\n        return self.take_date_time_space(move output) if date_time_space?(output, self.remaining)\r\n        return output if bare_value_end?(self.remaining.head)\r\n        let character = self.take()\r\n        self.take_bare_value(output + character.string)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func take_date_time_space(self: Parser, output: String) -> String [mut self, consume output] {\r\n        self.take()\r\n        self.take_bare_value(output + \"T\")\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc date_time_space?(output: String, remaining: String) -> Bool {\r\n    return false if output.length != 10\r\n    return false if not local_date?(output)\r\n    return false if not remaining.starts_with?(\" \")\r\n    return false if remaining.rest.empty?\r\n    decimal_digit?(remaining.rest.head)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc bare_value_end?(character: CodePoint) -> Bool {\r\n    bare_space?(character) || bare_delimiter?(character)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc bare_space?(character: CodePoint) -> Bool {\r\n    character == ' ' || character == '\\t' || character == '\\n' || character == '\\r'\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc bare_delimiter?(character: CodePoint) -> Bool {\r\n    character == '#' || character == ',' || character == ']' || character == '}'\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc remove_underscores(value: String) -> String {\r\n    branch {\r\n        value.empty? -> \"\"\r\n        value.head == '_' -> remove_underscores(value.rest)\r\n        _ -> value.head.string + remove_underscores(value.rest)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc integer_text?(value: String) -> Bool {\r\n    let unsigned = drop_sign(value)\r\n    let signed = value.starts_with?(\"+\") || value.starts_with?(\"-\")\r\n    return false if signed && based_prefix?(unsigned)\r\n    branch {\r\n        unsigned.starts_with?(\"0x\") -> based_digits?(unsigned.rest.rest, 16)\r\n        unsigned.starts_with?(\"0o\") -> based_digits?(unsigned.rest.rest, 8)\r\n        unsigned.starts_with?(\"0b\") -> based_digits?(unsigned.rest.rest, 2)\r\n        unsigned.empty? -> false\r\n        unsigned.head == '0' && not unsigned.rest.empty? -> false\r\n        _ -> based_digits?(unsigned, 10)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc based_prefix?(value: String) -> Bool {\r\n    value.starts_with?(\"0x\") || value.starts_with?(\"0o\") || value.starts_with?(\"0b\")\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc drop_sign(value: String) -> String {\r\n    branch {\r\n        value.empty? -> \"\"\r\n        value.head == '+' || value.head == '-' -> value.slice(1, value.length)\r\n        _ -> value.slice(0, value.length)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc based_digits?(value: String, base: Int) -> Bool {\r\n    return false if value.empty?\r\n    based_digit_tail?(value, base, false, false)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc based_digit_tail?(value: String, base: Int, saw_digit: Bool, previous_underscore: Bool) -> Bool {\r\n    branch {\r\n        value.empty? -> saw_digit && not previous_underscore\r\n        value.head == '_' -> branch {\r\n            not saw_digit || previous_underscore -> false\r\n            _ -> based_digit_tail?(value.rest, base, true, true)\r\n        }\r\n        digit_for_base?(value.head, base) -> based_digit_tail?(value.rest, base, true, false)\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc digit_for_base?(character: CodePoint, base: Int) -> Bool {\r\n    branch {\r\n        base <= 10 -> character >= '0' && character.as_int() < 48 + base\r\n        _ -> hex_digit?(character)\r\n    }\r\n}\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func parse_integer(self: Parser, text: String) -> Int [mut self, consume text] {\r\n        let negative = text.starts_with?(\"-\")\r\n        let unsigned = drop_sign(move text)\r\n        branch {\r\n            unsigned.starts_with?(\"0x\") -> self.accumulate_integer(unsigned.rest.rest, 16, negative, 0)\r\n            unsigned.starts_with?(\"0o\") -> self.accumulate_integer(unsigned.rest.rest, 8, negative, 0)\r\n            unsigned.starts_with?(\"0b\") -> self.accumulate_integer(unsigned.rest.rest, 2, negative, 0)\r\n            _ -> self.accumulate_integer(move unsigned, 10, negative, 0)\r\n        }\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func accumulate_integer(self: Parser, text: String, base: Int, negative: Bool, value: Int) -> Int [mut self] {\r\n        return value if text.empty?\r\n        return self.accumulate_integer(text.rest, base, negative, value) if text.head == '_'\r\n        let digit = hex_value(text.head)\r\n        let minimum = -9223372036854775807 - 1\r\n        let maximum = 9223372036854775807\r\n        return self.integer_overflow() if negative && value < (minimum + digit) / base\r\n        return self.accumulate_integer(text.rest, base, true, value * base - digit) if negative\r\n        return self.integer_overflow() if value > (maximum - digit) / base\r\n        self.accumulate_integer(text.rest, base, false, value * base + digit)\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func integer_overflow(self: Parser) -> Int [mut self] {\r\n        self.fail(\"integer is outside the signed 64-bit range\")\r\n        0\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc float_text?(value: String) -> Bool {\r\n    let unsigned = drop_sign(value)\r\n    branch {\r\n        unsigned.empty? -> false\r\n        unsigned.contains?(\".\") -> decimal_float?(unsigned)\r\n        unsigned.contains?(\"e\") || unsigned.contains?(\"E\") -> decimal_float?(unsigned)\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc decimal_float?(value: String) -> Bool {\r\n    let whole = take_decimal_prefix(value)\r\n    let normalized = remove_underscores(whole.slice(0, whole.length))\r\n    branch {\r\n        whole.empty? -> false\r\n        normalized.empty? -> false\r\n        normalized.length > 1 && normalized.head == '0' -> false\r\n        not decimal_component?(whole) -> false\r\n        _ -> decimal_float_suffix?(value.slice(whole.length, value.length))\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc take_decimal_prefix(value: String) -> String {\r\n    value.take_while((character: CodePoint) -> decimal_digit?(character) || character == '_')\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc decimal_float_suffix?(suffix: String) -> Bool {\r\n    branch {\r\n        suffix.starts_with?(\".\") -> fraction_and_exponent?(suffix.rest)\r\n        suffix.starts_with?(\"e\") || suffix.starts_with?(\"E\") -> exponent?(suffix.rest)\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc fraction_and_exponent?(value: String) -> Bool {\r\n    let fraction = take_decimal_prefix(value)\r\n    branch {\r\n        not decimal_component?(fraction) -> false\r\n        fraction.length == value.length -> true\r\n        _ -> exponent_marker?(value.slice(fraction.length, value.length))\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc exponent_marker?(value: String) -> Bool {\r\n    branch {\r\n        value.starts_with?(\"e\") || value.starts_with?(\"E\") -> exponent?(value.rest)\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc exponent?(value: String) -> Bool {\r\n    decimal_component?(drop_sign(value))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc decimal_component?(value: String) -> Bool { based_digits?(value, 10) }\r\n\r\nimpl Parser {\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func insert_value(self: Parser, path: List<PathPart>, value: TomlValue) -> () [mut self, consume path, consume value] {\r\n        return self.fail(\"duplicate key or table/value conflict\") if path_conflict?(self.entries, path)\r\n        self.entries = self.entries.append(FlatEntry { path: move path, value: FlatValue.Value(move value) })\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func declare_table(self: Parser, keys: List<String>) -> () [mut self, consume keys] {\r\n        let path = resolve_header_path(self.entries, [], move keys)\r\n        return self.fail(\"table is already defined\") if exact_path?(self.entries, path)\r\n        return self.fail(\"table conflicts with an existing value\") if scalar_prefix_conflict?(self.entries, path)\r\n        let context = [].concat(path)\r\n        self.entries = self.entries.append(FlatEntry { path: move path, value: FlatValue.TableMarker })\r\n        self.context = move context\r\n        ()\r\n    }\r\n\r\n    /// Internal helper for the Foster TOML implementation.\r\n    func declare_array_table(self: Parser, keys: List<String>) -> () [mut self, consume keys] {\r\n        return self.fail(\"array-of-tables header requires a key\") if keys.empty?\r\n        let parents = keys.take(keys.length - 1)\r\n        let name = keys.last().unwrap_or(\"\")\r\n        let parent = resolve_header_path(self.entries, [], move parents)\r\n        return self.fail(\"array of tables conflicts with an existing value\") if child_key_conflict?(self.entries, parent, name)\r\n        let index = next_array_index(self.entries, parent, name)\r\n        let path = parent.append(PathPart.ArrayItem(PathItem { key: move name, index }))\r\n        let context = [].concat(path)\r\n        self.entries = self.entries.append(FlatEntry { path: move path, value: FlatValue.ArrayTableMarker })\r\n        self.context = move context\r\n        ()\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc resolve_header_path(entries: List<FlatEntry>, prefix: List<PathPart>, keys: List<String>) -> List<PathPart> [consume prefix, consume keys] {\r\n    return prefix if keys.empty?\r\n    let name = keys.head\r\n    let index = latest_array_index(entries, prefix, name, -1)\r\n    let next = branch {\r\n        index >= 0 -> prefix.append(PathPart.ArrayItem(PathItem { key: move name, index }))\r\n        _ -> prefix.append(PathPart.Key(move name))\r\n    }\r\n    resolve_header_path(entries, move next, keys.rest)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc latest_array_index(entries: List<FlatEntry>, prefix: List<PathPart>, name: String, latest: Int) -> Int {\r\n    return latest if entries.empty?\r\n    let candidate = direct_item_index(entries.head.path, prefix, name)\r\n    let next = branch {\r\n        candidate > latest -> candidate\r\n        _ -> latest\r\n    }\r\n    latest_array_index(entries.rest, prefix, name, next)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc next_array_index(entries: List<FlatEntry>, prefix: List<PathPart>, name: String) -> Int {\r\n    latest_array_index(entries, prefix, name, -1) + 1\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc direct_item_index(path: List<PathPart>, prefix: List<PathPart>, name: String) -> Int {\r\n    return -1 if not path_starts_with?(path, prefix)\r\n    branch path.get(prefix.length) {\r\n        Option.Some(part) -> branch part {\r\n            PathPart.ArrayItem(item) -> branch {\r\n                item.key == name -> item.index\r\n                _ -> -1\r\n            }\r\n            _ -> -1\r\n        }\r\n        Option.None -> -1\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc exact_path?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {\r\n    branch {\r\n        entries.empty? -> false\r\n        entries.head.path == path -> true\r\n        _ -> exact_path?(entries.rest, path)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc path_conflict?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {\r\n    return false if entries.empty?\r\n    return true if entries.head.path == path\r\n    return true if flat_scalar_prefix_conflict?(entries.head, path)\r\n    path_conflict?(entries.rest, path)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc scalar_prefix_conflict?(entries: List<FlatEntry>, path: List<PathPart>) -> Bool {\r\n    return false if entries.empty?\r\n    return true if flat_scalar_prefix_conflict?(entries.head, path)\r\n    scalar_prefix_conflict?(entries.rest, path)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc flat_scalar_prefix_conflict?(entry: FlatEntry, path: List<PathPart>) -> Bool {\r\n    branch entry.value {\r\n        FlatValue.Value(_) -> branch {\r\n            path_starts_with?(path, entry.path) -> true\r\n            path_starts_with?(entry.path, path) -> true\r\n            _ -> false\r\n        }\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc child_key_conflict?(entries: List<FlatEntry>, prefix: List<PathPart>, name: String) -> Bool {\r\n    return false if entries.empty?\r\n    return true if direct_key_child?(entries.head.path, prefix, name)\r\n    child_key_conflict?(entries.rest, prefix, name)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc direct_key_child?(path: List<PathPart>, prefix: List<PathPart>, name: String) -> Bool {\r\n    return false if not path_starts_with?(path, prefix)\r\n    branch path.get(prefix.length) {\r\n        Option.Some(part) -> branch part {\r\n            PathPart.Key(candidate) -> candidate == name\r\n            _ -> false\r\n        }\r\n        Option.None -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc path_starts_with?(path: List<PathPart>, prefix: List<PathPart>) -> Bool {\r\n    branch {\r\n        prefix.empty? -> true\r\n        path.empty? -> false\r\n        path.head != prefix.head -> false\r\n        _ -> path_starts_with?(path.rest, prefix.rest)\r\n    }\r\n}\r\n\r\nenum Child = Table(String)\r\n    | Array(String)\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize(entries: List<FlatEntry>, prefix: List<PathPart>) -> List<TomlEntry> {\r\n    let children = direct_children(entries, prefix, [])\r\n    materialize_children(move children, entries, prefix, [])\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc direct_children(entries: List<FlatEntry>, prefix: List<PathPart>, output: List<Child>) -> List<Child> [consume output] {\r\n    return output if entries.empty?\r\n    let child = direct_child(entries.head.path, prefix)\r\n    let next = branch child {\r\n        Option.None -> output\r\n        Option.Some(value) -> append_unique_child(move output, move value)\r\n    }\r\n    direct_children(entries.rest, prefix, move next)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc direct_child(path: List<PathPart>, prefix: List<PathPart>) -> Option<Child> {\r\n    return Option.None if not path_starts_with?(path, prefix)\r\n    branch path.get(prefix.length) {\r\n        Option.Some(part) -> branch part {\r\n            PathPart.Key(name) -> Option.Some(Child.Table(move name))\r\n            PathPart.ArrayItem(item) -> Option.Some(Child.Array(move item.key))\r\n        }\r\n        Option.None -> Option.None\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc append_unique_child(children: List<Child>, child: Child) -> List<Child> [consume children, consume child] {\r\n    return children if contains_child?(children, child)\r\n    children.append(move child)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc contains_child?(children: List<Child>, expected: Child) -> Bool {\r\n    branch {\r\n        children.empty? -> false\r\n        child_name(children.head) == child_name(expected) -> true\r\n        _ -> contains_child?(children.rest, expected)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc child_name(child: Child) -> String {\r\n    branch child {\r\n        Child.Table(name) -> name\r\n        Child.Array(name) -> name\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize_children(children: List<Child>, entries: List<FlatEntry>, prefix: List<PathPart>, output: List<TomlEntry>) -> List<TomlEntry> [consume output] {\r\n    return output if children.empty?\r\n    let child_prefix = [].concat(prefix)\r\n    let entry = materialize_child(children.head, entries, move child_prefix)\r\n    materialize_children(children.rest, entries, prefix, output.append(move entry))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize_child(child: Child, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry {\r\n    branch child {\r\n        Child.Table(name) -> materialize_table_child(move name, entries, move prefix)\r\n        Child.Array(name) -> materialize_array_child(move name, entries, move prefix)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize_array_child(name: String, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry [consume name, consume prefix] {\r\n    let key = name.slice(0, name.length)\r\n    TomlEntry {\r\n        key: move key,\r\n        value: TomlValue.Array(materialize_array_items(entries, move prefix, move name, 0, []))\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize_table_child(name: String, entries: List<FlatEntry>, prefix: List<PathPart>) -> TomlEntry {\r\n    let path = prefix.append(PathPart.Key(name))\r\n    branch exact_scalar(entries, path) {\r\n        Option.Some(value) -> TomlEntry { key: name, value: move value }\r\n        Option.None -> TomlEntry { key: name, value: TomlValue.Table(materialize(entries, path)) }\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc exact_scalar(entries: List<FlatEntry>, path: List<PathPart>) -> Option<TomlValue> {\r\n    return Option.None if entries.empty?\r\n    return flat_scalar(entries.head) if entries.head.path == path\r\n    exact_scalar(entries.rest, path)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc flat_scalar(entry: FlatEntry) -> Option<TomlValue> {\r\n    branch entry.value {\r\n        FlatValue.Value(value) -> Option.Some(move value)\r\n        _ -> Option.None\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc materialize_array_items(entries: List<FlatEntry>, prefix: List<PathPart>, name: String, index: Int, output: List<TomlValue>) -> List<TomlValue> [consume output] {\r\n    let path = prefix.append(PathPart.ArrayItem(PathItem { key: name.slice(0, name.length), index }))\r\n    return output if not exact_path?(entries, path)\r\n    let table = TomlValue.Table(materialize(entries, path))\r\n    materialize_array_items(entries, prefix, name, index + 1, output.append(move table))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc insert_table_value(entries: List<TomlEntry>, keys: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume keys, consume value] {\r\n    return Result.Error(\"inline table key cannot be empty\") if keys.empty?\r\n    return insert_direct_table_value(move entries, keys.head, move value) if keys.rest.empty?\r\n    insert_nested_table_value(move entries, keys.head, keys.rest, move value)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc insert_direct_table_value(entries: List<TomlEntry>, key: String, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume value] {\r\n    return Result.Error(\"duplicate key in inline table\") if table_contains_key?(entries, key)\r\n    Result.Ok(entries.append(TomlEntry { key: move key, value: move value }))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc table_contains_key?(entries: List<TomlEntry>, key: String) -> Bool {\r\n    branch {\r\n        entries.empty? -> false\r\n        entries.head.key == key -> true\r\n        _ -> table_contains_key?(entries.rest, key)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc insert_nested_table_value(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value] {\r\n    return create_nested_table(move entries, move key, move rest, move value) if not table_contains_key?(entries, key)\r\n    rewrite_nested_table(move entries, move key, move rest, move value, [])\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc create_nested_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value] {\r\n    let nested = try insert_table_value([], move rest, move value)\r\n    Result.Ok(entries.append(TomlEntry { key: move key, value: TomlValue.Table(move nested) }))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc rewrite_nested_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue, prefix: List<TomlEntry>) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value, consume prefix] {\r\n    return Result.Error(\"inline table key conflicts with a value\") if entries.empty?\r\n    return rewrite_matching_table(move entries, move key, move rest, move value, move prefix) if entries.head.key == key\r\n    rewrite_nested_table(entries.rest, move key, move rest, move value, prefix.append(entries.head))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc rewrite_matching_table(entries: List<TomlEntry>, key: String, rest: List<String>, value: TomlValue, prefix: List<TomlEntry>) -> Result<List<TomlEntry>, String> [consume entries, consume key, consume rest, consume value, consume prefix] {\r\n    branch entries.head.value {\r\n        TomlValue.Table(nested) -> {\r\n            let updated = try insert_table_value(move nested, move rest, move value)\r\n            Result.Ok(prefix.append(TomlEntry { key: move key, value: TomlValue.Table(move updated) }).concat(entries.rest))\r\n        }\r\n        _ -> Result.Error(\"inline table key conflicts with a value\")\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc date_time?(value: String) -> Bool {\r\n    local_date?(value) || local_time?(value) || full_date_time?(value)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc local_date?(value: String) -> Bool {\r\n    return false if value.length != 10\r\n    return false if not digits_at?(value, 0, 4)\r\n    return false if not character_at?(value, 4, '-')\r\n    return false if not digits_at?(value, 5, 2)\r\n    return false if not character_at?(value, 7, '-')\r\n    return false if not digits_at?(value, 8, 2)\r\n    let year = decimal_at(value, 0, 4, 0)\r\n    let month = decimal_at(value, 5, 2, 0)\r\n    let day = decimal_at(value, 8, 2, 0)\r\n    valid_calendar_day?(year, month, day)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc valid_calendar_day?(year: Int, month: Int, day: Int) -> Bool {\r\n    return false if month < 1\r\n    return false if month > 12\r\n    return false if day < 1\r\n    day <= days_in_month(year, month)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc days_in_month(year: Int, month: Int) -> Int {\r\n    branch {\r\n        month == 2 -> branch {\r\n            leap_year?(year) -> 29\r\n            _ -> 28\r\n        }\r\n        month == 4 -> 30\r\n        month == 6 -> 30\r\n        month == 9 -> 30\r\n        month == 11 -> 30\r\n        _ -> 31\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc leap_year?(year: Int) -> Bool {\r\n    return true if year.modulo(400) == 0\r\n    return false if year.modulo(100) == 0\r\n    year.modulo(4) == 0\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc local_time?(value: String) -> Bool {\r\n    return false if value.length < 5\r\n    return false if not digits_at?(value, 0, 2)\r\n    return false if not character_at?(value, 2, ':')\r\n    return false if not digits_at?(value, 3, 2)\r\n    let hour = decimal_at(value, 0, 2, 0)\r\n    let minute = decimal_at(value, 3, 2, 0)\r\n    return false if hour > 23\r\n    return false if minute > 59\r\n    return true if value.length == 5\r\n    return false if value.length < 8\r\n    return false if not character_at?(value, 5, ':')\r\n    return false if not digits_at?(value, 6, 2)\r\n    return false if decimal_at(value, 6, 2, 0) > 59\r\n    return true if value.length == 8\r\n    return false if not character_at?(value, 8, '.')\r\n    fraction_digits?(value, 9)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc fraction_digits?(value: String, index: Int) -> Bool {\r\n    return false if index >= value.length\r\n    digits_at?(value, index, value.length - index)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc full_date_time?(value: String) -> Bool {\r\n    return false if value.length < 16\r\n    return false if not local_date?(value.slice(0, 10))\r\n    return false if not date_time_separator?(value.slice(10, 11))\r\n    valid_time_and_offset?(value.slice(11, value.length))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc date_time_separator?(value: String) -> Bool {\r\n    value == \"T\" || value == \"t\" || value == \" \"\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc valid_time_and_offset?(value: String) -> Bool {\r\n    return local_time?(value.slice(0, value.length - 1)) if ends_in_z?(value)\r\n    let offset = find_offset(value, 0)\r\n    return local_time?(value) if offset < 0\r\n    return false if offset + 6 != value.length\r\n    return false if not local_time?(value.slice(0, offset))\r\n    valid_offset?(value.slice(offset, value.length))\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc ends_in_z?(value: String) -> Bool {\r\n    value.ends_with?(\"Z\") || value.ends_with?(\"z\")\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc find_offset(value: String, index: Int) -> Int {\r\n    return -1 if value.empty?\r\n    return index if value.head == '+' || value.head == '-'\r\n    find_offset(value.rest, index + 1)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc valid_offset?(value: String) -> Bool {\r\n    return false if value.length != 6\r\n    return false if not (character_at?(value, 0, '+') || character_at?(value, 0, '-'))\r\n    return false if not digits_at?(value, 1, 2)\r\n    return false if not character_at?(value, 3, ':')\r\n    return false if not digits_at?(value, 4, 2)\r\n    return false if decimal_at(value, 1, 2, 0) > 23\r\n    decimal_at(value, 4, 2, 0) <= 59\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc character_at?(value: String, index: Int, expected: CodePoint) -> Bool {\r\n    branch value.code_points().get(index) {\r\n        Option.Some(character) -> character == expected\r\n        Option.None -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc digits_at?(value: String, start: Int, count: Int) -> Bool {\r\n    return true if count == 0\r\n    branch value.code_points().get(start) {\r\n        Option.Some(character) -> branch {\r\n            decimal_digit?(character) -> digits_at?(value, start + 1, count - 1)\r\n            _ -> false\r\n        }\r\n        Option.None -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc decimal_at(value: String, start: Int, count: Int, output: Int) -> Int {\r\n    return output if count == 0\r\n    branch value.code_points().get(start) {\r\n        Option.Some(character) -> decimal_at(value, start + 1, count - 1, output * 10 + hex_value(character))\r\n        Option.None -> output\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_entries(entries: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entries, consume output] {\r\n    let validation_entries = [].concat(entries)\r\n    return Result.Error(render_error(\"duplicate key in TOML document\")) if duplicate_entries?(move validation_entries)\r\n    return Result.Ok(move output) if entries.empty?\r\n    render_entry_line(entries.head, entries.rest, move output)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_entry_line(entry: TomlEntry, remaining: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entry, consume remaining, consume output] {\r\n    let value = try render_value(move entry.value)\r\n    render_entries(move remaining, output + render_key(move entry.key) + \" = \" + value + \"\\n\")\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_value(value: TomlValue) -> Result<String, TomlError> {\r\n    branch value {\r\n        TomlValue.String(text) -> Result.Ok(\"\\\"\" + escape_basic(text) + \"\\\"\")\r\n        TomlValue.Int(number) -> Result.Ok(number.as_string())\r\n        TomlValue.Float(number) -> Result.Ok(render_float(number))\r\n        TomlValue.Bool(flag) -> Result.Ok(render_bool(flag))\r\n        TomlValue.DateTime(text) -> render_date_time(move text)\r\n        TomlValue.Array(values) -> render_array(move values, \"[\")\r\n        TomlValue.Table(entries) -> render_inline_table(move entries)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_bool(value: Bool) -> String {\r\n    branch {\r\n        value -> \"true\"\r\n        _ -> \"false\"\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_float(value: Float) -> String {\r\n    let text = value.as_string()\r\n    return \"nan\" if text == \"NaN\"\r\n    return text if text.contains?(\".\") || text.contains?(\"e\") || text.contains?(\"inf\")\r\n    text + \".0\"\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_date_time(text: String) -> Result<String, TomlError> [consume text] {\r\n    return Result.Error(render_error(\"TomlValue.DateTime contains invalid TOML date/time text\")) if not date_time?(text)\r\n    Result.Ok(move text)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_array(values: List<TomlValue>, output: String) -> Result<String, TomlError> [consume values, consume output] {\r\n    return Result.Ok(output + \"]\") if values.empty?\r\n    render_array_first(values.head, values.rest, move output)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_array_first(value: TomlValue, remaining: List<TomlValue>, output: String) -> Result<String, TomlError> [consume value, consume remaining, consume output] {\r\n    let text = try render_value(move value)\r\n    render_array_tail(move remaining, output + text)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_array_tail(values: List<TomlValue>, output: String) -> Result<String, TomlError> [consume values, consume output] {\r\n    return Result.Ok(output + \"]\") if values.empty?\r\n    render_array_next(values.head, values.rest, move output)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_array_next(value: TomlValue, remaining: List<TomlValue>, output: String) -> Result<String, TomlError> [consume value, consume remaining, consume output] {\r\n    let text = try render_value(move value)\r\n    render_array_tail(move remaining, output + \", \" + text)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_inline_table(entries: List<TomlEntry>) -> Result<String, TomlError> [consume entries] {\r\n    let validation_entries = [].concat(entries)\r\n    return Result.Error(render_error(\"duplicate key in TomlValue.Table\")) if duplicate_entries?(move validation_entries)\r\n    return Result.Ok(\"{}\") if entries.empty?\r\n    render_inline_first(entries.head, entries.rest)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_inline_first(entry: TomlEntry, remaining: List<TomlEntry>) -> Result<String, TomlError> [consume entry, consume remaining] {\r\n    let value = try render_value(move entry.value)\r\n    render_inline_tail(move remaining, \"{ \" + render_key(move entry.key) + \" = \" + value)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_inline_tail(entries: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entries, consume output] {\r\n    return Result.Ok(output + \" }\") if entries.empty?\r\n    render_inline_next(entries.head, entries.rest, move output)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_inline_next(entry: TomlEntry, remaining: List<TomlEntry>, output: String) -> Result<String, TomlError> [consume entry, consume remaining, consume output] {\r\n    let value = try render_value(move entry.value)\r\n    render_inline_tail(move remaining, output + \", \" + render_key(move entry.key) + \" = \" + value)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc duplicate_entries?(entries: List<TomlEntry>) -> Bool {\r\n    branch {\r\n        entries.empty? -> false\r\n        table_contains_key?(entries.rest, entries.head.key) -> true\r\n        _ -> duplicate_entries?(entries.rest)\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_key(key: String) -> String {\r\n    branch {\r\n        key.empty? -> \"\\\"\\\"\"\r\n        bare_key?(key) -> key\r\n        _ -> \"\\\"\" + escape_basic(key) + \"\\\"\"\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc bare_key?(key: String) -> Bool {\r\n    branch {\r\n        key.empty? -> true\r\n        bare_key_character?(key.head) -> bare_key?(key.rest)\r\n        _ -> false\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc escape_basic(value: String) -> String {\r\n    return \"\" if value.empty?\r\n    escape_character(value.head) + escape_basic(value.rest)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc escape_character(character: CodePoint) -> String {\r\n    let value = character.as_int()\r\n    branch {\r\n        value == 8 -> \"\\\\b\"\r\n        value == 9 -> \"\\\\t\"\r\n        value == 10 -> \"\\\\n\"\r\n        value == 12 -> \"\\\\f\"\r\n        value == 13 -> \"\\\\r\"\r\n        value == 27 -> \"\\\\e\"\r\n        value == 34 -> \"\\\\\\\"\"\r\n        value == 92 -> \"\\\\\\\\\"\r\n        value < 32 -> \"\\\\u\" + fixed_hex(value, 4)\r\n        value == 127 -> \"\\\\u007F\"\r\n        _ -> character.string\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc fixed_hex(value: Int, digits: Int) -> String {\r\n    return \"\" if digits == 0\r\n    let divisor = 16.power(digits - 1)\r\n    hex_character(value / divisor) + fixed_hex(value.modulo(divisor), digits - 1)\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc hex_character(value: Int) -> String {\r\n    branch {\r\n        value < 10 -> from_code_point(48 + value).string\r\n        _ -> from_code_point(55 + value).string\r\n    }\r\n}\r\n\r\n/// Internal helper for the Foster TOML implementation.\r\nfunc render_error(message: String) -> TomlError {\r\n    TomlError { message: move message, line: 0, column: 0 }\r\n}\r\n\r\ntest \"TOML parses queries renders and reports positioned errors\" {\r\n    branch parse(\"title = \\\"Foster\\\"\\n[package]\\nenabled = true\\n\") {\r\n        Result.Error(_) -> {\r\n            assert(false, \"valid TOML was rejected\")\r\n            ()\r\n        }\r\n        Result.Ok(document) -> branch (move document).get(\"package\") {\r\n            Option.None -> {\r\n                assert(false, \"package table was missing\")\r\n                ()\r\n            }\r\n            Option.Some(value) -> branch (move value).get(\"enabled\") {\r\n                Option.Some(TomlValue.Bool(enabled)) -> {\r\n                    assert(enabled)\r\n                    ()\r\n                }\r\n                _ -> {\r\n                    assert(false, \"nested boolean was missing\")\r\n                    ()\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    let document = TomlDocument { entries: [TomlEntry { key: \"count\", value: TomlValue.Int(3) }, TomlEntry { key: \"title\", value: TomlValue.String(\"Foster\") }] }\r\n    branch (move document).render() {\r\n        Result.Ok(source) -> {\r\n            assert(source == \"count = 3\\ntitle = \\\"Foster\\\"\\n\")\r\n            ()\r\n        }\r\n        Result.Error(_) -> {\r\n            assert(false, \"typed TOML failed to render\")\r\n            ()\r\n        }\r\n    }\r\n\r\n    branch parse(\"title = \\\"ok\\\"\\nbroken = [\\n\") {\r\n        Result.Error(error) -> {\r\n            assert(error.line == 2)\r\n            assert(error.column > 0)\r\n            ()\r\n        }\r\n        Result.Ok(_) -> {\r\n            assert(false, \"malformed TOML was accepted\")\r\n            ()\r\n        }\r\n    }\r\n}\r\n\r\n/// Scores one TOML value category for round-trip test coverage.\r\nfunc test_score_value(value: TomlValue) -> Int {\r\n    branch value {\r\n        TomlValue.String(_) -> 1\r\n        TomlValue.Int(_) -> 2\r\n        TomlValue.Float(_) -> 4\r\n        TomlValue.Bool(_) -> 8\r\n        TomlValue.DateTime(_) -> 16\r\n        TomlValue.Array(values) -> 32 + values.length\r\n        TomlValue.Table(entries) -> 64 + test_score_entries(move entries)\r\n    }\r\n}\r\n\r\n/// Accumulates TOML value-category scores across test entries.\r\nfunc test_score_entries(entries: List<TomlEntry>) -> Int {\r\n    return 0 if entries.empty?\r\n    test_score_value(entries.head.value) + test_score_entries(entries.rest)\r\n}\r\n\r\n/// Confirms that a failed parse retains a positioned diagnostic.\r\nfunc test_error_score(outcome: Result<TomlDocument, TomlError>) -> Int {\r\n    branch outcome {\r\n        Result.Ok(_) -> 0\r\n        Result.Error(error) -> branch {\r\n            error.message.empty? -> 0\r\n            error.line <= 0 -> 0\r\n            error.column <= 0 -> 0\r\n            _ -> 1\r\n        }\r\n    }\r\n}\r\n\r\n/// Asserts one TOML test condition while keeping branch result types uniform.\r\nfunc test_require(condition: Bool, message: String) -> () {\r\n    assert(condition, message)\r\n    ()\r\n}\r\n\r\ntest \"TOML round trips every value category\" {\r\n    let source = \"array = [1, 2]\\nboolean = true\\ndatetime = 1979-05-27T07:32:00Z\\nfloat = 1.5\\ninteger = 3\\nstring = \\\"x\\\"\\n[table]\\nnested = false\\n\"\r\n    branch parse(move source) {\r\n        Result.Error(_) -> test_require(false, \"valid TOML was rejected\")\r\n        Result.Ok(document) -> branch (move document).render() {\r\n            Result.Error(_) -> test_require(false, \"valid document did not render\")\r\n            Result.Ok(rendered) -> branch parse(move rendered) {\r\n                Result.Error(_) -> test_require(false, \"rendered TOML did not parse\")\r\n                Result.Ok(round_trip) -> test_require(test_score_entries(move round_trip.entries) == 137, \"round trip changed TOML value categories\")\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\ntest \"TOML renderer rejects invalid date-time values\" {\r\n    let document = TomlDocument { entries: [TomlEntry { key: \"when\", value: TomlValue.DateTime(\"not-a-date\") }] }\r\n    branch (move document).render() {\r\n        Result.Ok(_) -> test_require(false, \"invalid date-time rendered successfully\")\r\n        Result.Error(error) -> {\r\n            assert(error.line == 0)\r\n            assert(error.column == 0)\r\n            ()\r\n        }\r\n    }\r\n}\r\n\r\ntest \"TOML rejects common malformed inputs with positions\" {\r\n    let score = 0\r\n    score = score + test_error_score(parse(\"value = 1\\nvalue = 2\\n\"))\r\n    score = score + test_error_score(parse(\"value = 1__0\\n\"))\r\n    score = score + test_error_score(parse(\"value = +0x10\\n\"))\r\n    score = score + test_error_score(parse(\"value = 01.2\\n\"))\r\n    score = score + test_error_score(parse(\"value = 2025-02-30\\n\"))\r\n    score = score + test_error_score(parse(\"value = \\\"\\\\q\\\"\\n\"))\r\n    score = score + test_error_score(parse(\"[table]\\n[table]\\n\"))\r\n    score = score + test_error_score(parse(\"value = 1\\n[value.child]\\n\"))\r\n    score = score + test_error_score(parse(\"value = { key = 1, key = 2 }\\n\"))\r\n    score = score + test_error_score(parse(\"value = [1, 2\\n\"))\r\n    assert(score == 10)\r\n}\r\n"), origin: Embedded }, "std.uri": Module { name: "std.uri", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/uri.fos"), program: Some(Program { documentation: Some("URI resource identities without protocol-specific network access."), imports: [Import { span: 71..89, path: ["core", "result"], alias: None }, Import { span: 90..109, path: ["std", "resource"], alias: None }], constants: [], records: [RecordDecl { span: 163..232, documentation: Some("Describes an invalid URI passed to `Uri.parse`."), name: "UriError", public: true, intrinsic: false, parameters: [], compositions: [], fields: [RecordField { name: "value", public: true, ty: Named("String", []) }, RecordField { name: "message", public: true, ty: Named("String", []) }], methods: [] }, RecordDecl { span: 522..629, documentation: Some("A parsed URI resource identifier.\n\n`Uri` implements `ResourceIdentifier` but deliberately provides no resource or I/O capability.\nProtocol providers convert it into their typed locations—such as `TcpEndpoint`—before creating\nan appropriate res