{ expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Name("characters"), span: 12732..12742 }, name: "head" }, span: 12732..12747 }, operator: Less, right: Spanned { expression: CodePoint("0"), span: 12750..12753 } }, span: 12732..12753 }, operator: Or, right: Spanned { expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Name("characters"), span: 12757..12767 }, name: "head" }, span: 12757..12772 }, operator: Greater, right: Spanned { expression: CodePoint("9"), span: 12775..12778 } }, span: 12757..12778 } }, span: 12732..12778 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Member { object: Spanned { expression: Name("Option"), span: 12782..12788 }, name: "None" }, span: 12782..12793 }), span: 12782..12793 }] } }, BranchArm { test: Wildcard, body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Name("append_port_digit"), span: 12807..12824 }, arguments: [Spanned { expression: Name("characters"), span: 12825..12835 }, Spanned { expression: Name("value"), span: 12837..12842 }, Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Member { object: Spanned { expression: Name("characters"), span: 12844..12854 }, name: "head" }, span: 12844..12859 }, name: "as_int" }, span: 12844..12866 }, arguments: [] }, span: 12844..12868 }, operator: Subtract, right: Spanned { expression: Integer(48), span: 12871..12873 } }, span: 12844..12873 }] }, span: 12807..12874 }), span: 12807..12874 }] } }] }, span: 12667..12880 }), span: 12667..12880 }] } }, Function { body_is_recovery_stub: false, span: 12950..13210, documentation: Some("Appends one port digit when the result remains at most 65535."), name: "append_port_digit", owner: None, receiver: false, public: false, intrinsic: None, type_parameters: [], groups: [], parameters: [Parameter { span: 12973..12983, name: "characters", ty: Some(Named("List", [Named("CodePoint", [])])), type_span: Some(12985..13000) }, Parameter { span: 13002..13007, name: "value", ty: Some(Named("Int", [])), type_span: Some(13009..13012) }, Parameter { span: 13014..13019, name: "digit", ty: Some(Named("Int", [])), type_span: Some(13021..13024) }], return_type: Some(Named("Option", [Named("Int", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Branch { subject: None, arms: [BranchArm { test: Condition(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 13064..13069 }, operator: Greater, right: Spanned { expression: Integer(6553), span: 13072..13076 } }, span: 13064..13076 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Member { object: Spanned { expression: Name("Option"), span: 13080..13086 }, name: "None" }, span: 13080..13091 }), span: 13080..13091 }] } }, BranchArm { test: Condition(Spanned { expression: Logical { left: Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 13100..13105 }, operator: Equal, right: Spanned { expression: Integer(6553), span: 13109..13113 } }, span: 13100..13113 }, operator: And, right: Spanned { expression: Binary { left: Spanned { expression: Name("digit"), span: 13117..13122 }, operator: Greater, right: Spanned { expression: Integer(5), span: 13125..13126 } }, span: 13117..13126 } }, span: 13100..13126 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Member { object: Spanned { expression: Name("Option"), span: 13130..13136 }, name: "None" }, span: 13130..13141 }), span: 13130..13141 }] } }, BranchArm { test: Wildcard, body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Name("parse_port"), span: 13155..13165 }, arguments: [Spanned { expression: Member { object: Spanned { expression: Name("characters"), span: 13166..13176 }, name: "rest" }, span: 13166..13181 }, Spanned { expression: Binary { left: Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 13183..13188 }, operator: Multiply, right: Spanned { expression: Integer(10), span: 13191..13193 } }, span: 13183..13193 }, operator: Add, right: Spanned { expression: Name("digit"), span: 13196..13201 } }, span: 13183..13201 }] }, span: 13155..13202 }), span: 13155..13202 }] } }] }, span: 13047..13208 }), span: 13047..13208 }] } }, Function { body_is_recovery_stub: false, span: 13264..13452, documentation: Some("Constructs a typed endpoint validation failure."), name: "invalid_endpoint", owner: None, receiver: false, public: false, intrinsic: None, type_parameters: [], groups: [], parameters: [Parameter { span: 13286..13291, name: "value", ty: Some(Named("String", [])), type_span: Some(13293..13299) }, Parameter { span: 13301..13308, name: "message", ty: Some(Named("String", [])), type_span: Some(13310..13316) }], return_type: Some(Named("Result", [Named("TcpEndpoint", []), Named("NetworkError", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Result"), span: 13361..13367 }, name: "Error" }, span: 13361..13373 }, arguments: [Spanned { expression: Record { constructor: Spanned { expression: Name("NetworkError"), span: 13374..13386 }, fields: [RecordFieldValue { name: "operation", value: Spanned { expression: String("tcp.endpoint"), span: 13400..13414 } }, RecordFieldValue { name: "message", value: Spanned { expression: Binary { left: Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 13425..13430 }, operator: Add, right: Spanned { expression: String(": "), span: 13433..13437 } }, span: 13425..13437 }, operator: Add, right: Spanned { expression: Name("message"), span: 13440..13447 } }, span: 13425..13447 } }] }, span: 13374..13449 }] }, span: 13361..13450 }), span: 13361..13450 }] } }], implementations: [Implementation { span: 320..2014, owner_span: 325..332, owner: "TcpHost", parameters: [] }, Implementation { span: 2849..4352, owner_span: 2854..2865, owner: "TcpEndpoint", parameters: [] }, Implementation { span: 6452..6795, owner_span: 6457..6465, owner: "Listener", parameters: [] }, Implementation { span: 7116..8899, owner_span: 7121..7131, owner: "Connection", parameters: [] }, Implementation { span: 8901..9083, owner_span: 8906..8914, owner: "Listener", parameters: [] }, Implementation { span: 9085..9277, owner_span: 9090..9100, owner: "Connection", parameters: [] }], tests: [] }), source: Some("//! Endpoint-identified TCP listeners, connections, and network errors.\n\nimport core.bytes\nimport core.code_point\nimport core.int\nimport core.list\nimport core.option\nimport core.result\nimport core.string\nimport std.io\nimport std.resource\nimport std.uri\n\n/// Private namespace for TCP host operations.\ntype TcpHost = {}\n\nimpl TcpHost {\n    /// Binds a host TCP listener.\n    func listen(address: String, port: Int) -> Result<Int, NetworkError> = intrinsic(\"tcp.listen\")\n    /// Connects a host TCP stream.\n    func connect(address: String, port: Int) -> Result<Int, NetworkError> = intrinsic(\"tcp.connect\")\n    /// Accepts a host TCP connection.\n    func accept(listener: Int) -> Result<Int, NetworkError> = intrinsic(\"tcp.accept\")\n    /// Reads UTF-8 text from a host TCP connection.\n    func read(connection: Int, maximum: Int) -> Result<String, NetworkError> {\n        branch TcpHost.read_bytes(connection, maximum) {\n            Result.Error(error) -> Result.Error(error)\n            Result.Ok(contents) -> decode_text(move contents)\n        }\n    }\n    /// Writes UTF-8 text to a host TCP connection.\n    func write(connection: Int, contents: String) -> Result<(), NetworkError> {\n        TcpHost.write_bytes(connection, contents.bytes)\n    }\n    /// Reads bytes from a host TCP connection.\n    func read_bytes(connection: Int, maximum: Int) -> Result<Bytes, NetworkError> = intrinsic(\"tcp.read_bytes\")\n    /// Writes bytes to a host TCP connection.\n    func write_bytes(connection: Int, contents: Bytes) -> Result<(), NetworkError> = intrinsic(\"tcp.write_bytes\")\n    /// Sets host TCP read and write timeouts.\n    func set_timeout(connection: Int, milliseconds: Int) -> Result<(), NetworkError> = intrinsic(\"tcp.set_timeout\")\n    /// Closes a host TCP listener.\n    func close_listener(listener: Int) -> Result<(), NetworkError> = intrinsic(\"tcp.close_listener\")\n    /// Closes a host TCP connection.\n    func close_connection(connection: Int) -> Result<(), NetworkError> = intrinsic(\"tcp.close_connection\")\n}\n\n/// Validates received bytes before exposing them as text.\nfunc decode_text(contents: Bytes) -> Result<String, NetworkError> [consume contents] {\n    branch String.from_utf8(move contents) {\n        Result.Ok(text) -> Result.Ok(text)\n        Result.Error(error) -> Result.Error(NetworkError {\n            operation: \"tcp.read\"\n            message: error.message\n        })\n    }\n}\n\n/// Describes a failed TCP operation at the host boundary.\npub type NetworkError = {\n    pub operation: String\n    pub message: String\n}\n\n/// A TCP endpoint identifier rendered as a `tcp://host:port` URI.\n///\n/// Endpoint construction does not open a socket. IPv6 addresses are stored without brackets and\n/// rendered with brackets in the URI spelling.\npub type TcpEndpoint = & ResourceIdentifier & {\n    address_value: String\n    port_value: Int\n}\n\nimpl TcpEndpoint {\n    /// Associates a host address and port with a typed TCP endpoint identifier.\n    pub func at(address: String, port: Int) -> TcpEndpoint [consume address] {\n        TcpEndpoint { address_value: move address, port_value: port }\n    }\n\n    /// Parses a `tcp://host:port` URI into a TCP endpoint.\n    pub func from_uri(value: Uri) -> Result<TcpEndpoint, NetworkError> {\n        branch {\n            value.scheme().lower() != \"tcp\" -> invalid_endpoint(value.as_string(), \"URI scheme must be tcp\")\n            !value.path().starts_with?(\"//\") -> invalid_endpoint(value.as_string(), \"TCP URI must use //host:port\")\n            _ -> parse_authority(value.as_string(), value.path().slice(2, value.path().length))\n        }\n    }\n\n    /// Returns this endpoint's URI spelling.\n    pub func as_string(self: TcpEndpoint) -> String {\n        branch {\n            self.address_value.contains?(\":\") -> \"tcp://[\" + self.address_value + \"]:\" + self.port_value.as_string()\n            _ -> \"tcp://\" + self.address_value + \":\" + self.port_value.as_string()\n        }\n    }\n\n    /// Returns the stable endpoint identifier supplied to the TCP provider.\n    pub func resource_id(self: TcpEndpoint) -> String { self.as_string() }\n\n    /// Returns the host address without URI brackets.\n    pub func address(self: TcpEndpoint) -> String {\n        self.address_value.slice(0, self.address_value.length)\n    }\n\n    /// Returns the TCP port.\n    pub func port(self: TcpEndpoint) -> Int { self.port_value }\n}\n\n/// An opaque connected TCP stream associated with the endpoint that created it.\npub type Connection = & Resource<TcpEndpoint> & Duplex<NetworkError> & Closable<NetworkError> & {\n    pub location: TcpEndpoint\n    handle: Int\n}\n\n/// An opaque listening TCP socket associated with its bound endpoint.\npub type Listener = & Resource<TcpEndpoint> & Accepting<Connection, NetworkError> & Closable<NetworkError> & {\n    pub location: TcpEndpoint\n    handle: Int\n}\n\n/// Binds a TCP listener to an address and port.\npub func listen(address: String, port: Int) -> Result<Listener, NetworkError> {\n    listen_at(TcpEndpoint.at(move address, port))\n}\n\n/// Connects to a TCP server.\npub func connect(address: String, port: Int) -> Result<Connection, NetworkError> {\n    connect_to(TcpEndpoint.at(move address, port))\n}\n\n/// Binds a listener identified by `endpoint`.\npub func listen_at(endpoint: TcpEndpoint) -> Result<Listener, NetworkError> [consume endpoint] {\n    let outcome = TcpHost.listen(endpoint.address(), endpoint.port())\n    wrap_listener(move endpoint, move outcome)\n}\n\n/// Connects a stream identified by `endpoint`.\npub func connect_to(endpoint: TcpEndpoint) -> Result<Connection, NetworkError> [consume endpoint] {\n    let outcome = TcpHost.connect(endpoint.address(), endpoint.port())\n    wrap_connection(move endpoint, move outcome)\n}\n\n/// Parses and binds a `tcp://host:port` URI.\npub func listen_uri(value: Uri) -> Result<Listener, NetworkError> [consume value] {\n    let endpoint = try TcpEndpoint.from_uri(move value)\n    listen_at(move endpoint)\n}\n\n/// Parses and connects to a `tcp://host:port` URI.\npub func connect_uri(value: Uri) -> Result<Connection, NetworkError> [consume value] {\n    let endpoint = try TcpEndpoint.from_uri(move value)\n    connect_to(move endpoint)\n}\n\n/// Converts a successful listener handle into an opaque `Listener`.\nfunc wrap_listener(endpoint: TcpEndpoint, outcome: Result<Int, NetworkError>) -> Result<Listener, NetworkError> [consume endpoint, consume outcome] {\n    let handle = try move outcome\n    Ok(Listener { location: move endpoint, handle })\n}\n\nimpl Listener {\n    /// Waits for and accepts one incoming connection.\n    pub func accept(self: Listener) -> Result<Connection, NetworkError> [mut self.handle, read self.location] {\n        let endpoint = TcpEndpoint.at(self.location.address(), self.location.port())\n        wrap_connection(move endpoint, TcpHost.accept(self.handle))\n    }\n}\n\n/// Converts a successful connection handle into an opaque `Connection`.\nfunc wrap_connection(endpoint: TcpEndpoint, outcome: Result<Int, NetworkError>) -> Result<Connection, NetworkError> [consume endpoint, consume outcome] {\n    let handle = try move outcome\n    Ok(Connection { location: move endpoint, handle })\n}\n\nimpl Connection {\n    /// Reads at most `maximum` bytes, returning empty bytes after an orderly peer shutdown.\n    pub func read(self: Connection, maximum: Int) -> Result<Bytes, NetworkError> [mut self.handle] {\n        TcpHost.read_bytes(self.handle, maximum)\n    }\n\n    /// Writes the complete byte sequence and reports its length.\n    pub func write(self: Connection, contents: Bytes) -> Result<Int, NetworkError> [mut self.handle] {\n        written_bytes(TcpHost.write_bytes(self.handle, contents), contents.length)\n    }\n\n    /// Flushes the TCP stream's host writer.\n    pub func flush(self: Connection) -> Result<(), NetworkError> [mut self.handle] {\n        TcpHost.write_bytes(self.handle, Bytes.empty())\n    }\n\n    /// Reads at most `maximum` bytes of UTF-8 text from a connection.\n    pub func read_text(self: Connection, maximum: Int) -> Result<String, NetworkError> [mut self.handle] {\n        TcpHost.read(self.handle, maximum)\n    }\n\n    /// Writes the complete UTF-8 string to a connection.\n    pub func write_text(self: Connection, text: String) -> Result<(), NetworkError> [mut self.handle] {\n        TcpHost.write(self.handle, text)\n    }\n\n    /// Compatibility spelling for binary `read`.\n    pub func read_bytes(self: Connection, maximum: Int) -> Result<Bytes, NetworkError> [mut self.handle] {\n        self.read(maximum)\n    }\n\n    /// Explicit binary spelling for `write`.\n    pub func write_bytes(self: Connection, contents: Bytes) -> Result<Int, NetworkError> [mut self.handle] {\n        self.write(contents)\n    }\n\n    /// Sets the connection's read and write timeout in milliseconds.\n    pub func set_timeout(self: Connection, milliseconds: Int) -> Result<(), NetworkError> [mut self.handle] {\n        TcpHost.set_timeout(self.handle, milliseconds)\n    }\n}\n\nimpl Listener {\n    /// Closes a listening socket.\n    pub func close(self: Listener) -> Result<(), NetworkError> [consume self] {\n        TcpHost.close_listener(self.handle)\n    }\n}\n\nimpl Connection {\n    /// Closes a connected TCP stream.\n    pub func close(self: Connection) -> Result<(), NetworkError> [consume self] {\n        TcpHost.close_connection(self.handle)\n    }\n}\n\n/// Converts a completed host write into the stream writer's byte count.\nfunc written_bytes(outcome: Result<(), NetworkError>, length: Int) -> Result<Int, NetworkError> [consume outcome] {\n    try move outcome\n    Result.Ok(length)\n}\n\n/// Parses a bracketed or unbracketed TCP authority.\nfunc parse_authority(value: String, authority: String) -> Result<TcpEndpoint, NetworkError> {\n    branch {\n        authority.empty? -> invalid_endpoint(move value, \"TCP URI host must not be empty\")\n        authority.starts_with?(\"[\") -> parse_bracketed_authority(move value, authority)\n        _ -> parse_unbracketed_authority(move value, authority)\n    }\n}\n\n/// Parses a DNS name or IPv4 authority using its final colon as the port separator.\nfunc parse_unbracketed_authority(value: String, authority: String) -> Result<TcpEndpoint, NetworkError> {\n    let separator = final_colon(authority.code_points(), 0, -1)\n    branch {\n        separator <= 0 -> invalid_endpoint(move value, \"TCP URI must include a host and port\")\n        separator + 1 >= authority.length -> invalid_endpoint(move value, \"TCP URI port must not be empty\")\n        authority.slice(0, separator).contains?(\":\") -> invalid_endpoint(move value, \"IPv6 TCP URI hosts must be enclosed in brackets\")\n        _ -> endpoint_with_port(move value, authority.slice(0, separator), authority.slice(separator + 1, authority.length))\n    }\n}\n\n/// Parses a bracketed IPv6 authority followed by a port.\nfunc parse_bracketed_authority(value: String, authority: String) -> Result<TcpEndpoint, NetworkError> {\n    let closing = first_closing_bracket(authority.code_points(), 0)\n    branch {\n        closing <= 1 -> invalid_endpoint(move value, \"TCP URI contains an invalid bracketed host\")\n        closing + 2 >= authority.length -> invalid_endpoint(move value, \"TCP URI must include a port after its host\")\n        authority.slice(closing + 1, closing + 2) != \":\" -> invalid_endpoint(move value, \"TCP URI must separate its host and port with a colon\")\n        _ -> endpoint_with_port(move value, authority.slice(1, closing), authority.slice(closing + 2, authority.length))\n    }\n}\n\n/// Validates a decimal port and constructs the endpoint.\nfunc endpoint_with_port(value: String, address: String, port_text: String) -> Result<TcpEndpoint, NetworkError> [consume value, consume address] {\n    branch parse_port(port_text.code_points(), 0) {\n        Option.None -> invalid_endpoint(move value, \"TCP URI port must be a decimal integer from 0 through 65535\")\n        Option.Some(port) -> Result.Ok(TcpEndpoint.at(move address, port))\n    }\n}\n\n/// Returns the final colon index or `found` when none remains.\nfunc final_colon(characters: List<CodePoint>, index: Int, found: Int) -> Int {\n    branch {\n        characters.empty? -> found\n        characters.head == ':' -> final_colon(characters.rest, index + 1, index)\n        _ -> final_colon(characters.rest, index + 1, found)\n    }\n}\n\n/// Returns the first closing-bracket index or `-1` when absent.\nfunc first_closing_bracket(characters: List<CodePoint>, index: Int) -> Int {\n    branch {\n        characters.empty? -> -1\n        characters.head == ']' -> index\n        _ -> first_closing_bracket(characters.rest, index + 1)\n    }\n}\n\n/// Parses a bounded decimal TCP port without overflowing Foster's integer representation.\nfunc parse_port(characters: List<CodePoint>, value: Int) -> Option<Int> {\n    branch {\n        characters.empty? -> Option.Some(value)\n        characters.head < '0' || characters.head > '9' -> Option.None\n        _ -> append_port_digit(characters, value, characters.head.as_int() - 48)\n    }\n}\n\n/// Appends