lendar = IsoCalendar.new()\n    assert(calendar.id() == \"iso8601\")\n    assert(calendar.leap_year?(2000))\n    assert(not calendar.leap_year?(1900))\n    assert(calendar.days_in_month(2024, 2) == 29)\n    assert(TimeOfDay.from(24, 0, 0, 0).error?())\n    branch TimeOfDay.from(12, 34, 56, 789) {\n        Result.Error(_) -> {\n            assert(false, \"valid civil time was rejected\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.hour() == 12 && value.minute() == 34)\n            assert(value.second() == 56 && value.nanosecond() == 789)\n            assert(TimeOfDay.from_nanosecond_of_day(value.nanosecond_of_day()).equal?(value))\n            ()\n        }\n    }\n    branch YearMonth.from(2024, 2) {\n        Result.Error(_) -> {\n            assert(false, \"valid year-month was rejected\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.year() == 2024 && value.month() == 2 && value.days() == 29)\n            assert(value.on_day(29).success?())\n            ()\n        }\n    }\n    assert(YearMonth.from(2024, 13).error?())\n    branch MonthDay.from(2, 29) {\n        Result.Error(_) -> {\n            assert(false, \"valid recurring leap day was rejected\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.month() == 2 && value.day() == 29)\n            assert(value.in_year(2023).error?())\n            ()\n        }\n    }\n}\n\ntest \"calendar spans and civil intervals keep non-exact units explicit\" {\n    let span = Span.from(1, 2, 3, 4, 5, 6, 7, 8)\n    assert(span.years() == 1 && span.months() == 2 && span.weeks() == 3 && span.days() == 4)\n    assert(span.hours() == 5 && span.minutes() == 6 && span.seconds() == 7 && span.nanoseconds() == 8)\n    assert(span.add(span.negated()).years() == 0)\n    assert(Date.from_epoch_day(0).add(Span.from(0, 0, 0, 0, 1, 0, 0, 0), Overflow.Reject).error?())\n    assert(DateInterval.from(Date.from_epoch_day(2), Date.from_