d { expression: Integer(2), span: 4458..4459 }, Spanned { expression: Integer(3), span: 4461..4462 }]), span: 4454..4463 }, Spanned { expression: Closure { captures: [], parameters: [Parameter { span: 4466..4471, name: "value", ty: Some(Named("Int", [])), type_span: Some(4473..4476) }], effects: [], suspends: false, body: Expression(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 4481..4486 }, operator: Add, right: Spanned { expression: Integer(10), span: 4489..4491 } }, span: 4481..4491 }) }, span: 4465..4491 }] }, span: 4450..4492 } }, span: 4437..4492 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Name("values"), span: 4504..4510 }, name: "length" }, span: 4504..4517 }, operator: Equal, right: Spanned { expression: Integer(3), span: 4521..4522 } }, span: 4504..4522 }, message: None }, span: 4497..4523 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Index { object: Spanned { expression: Name("values"), span: 4535..4541 }, index: Spanned { expression: Integer(0), span: 4542..4543 } }, span: 4535..4544 }, operator: Equal, right: Spanned { expression: Integer(11), span: 4548..4550 } }, span: 4535..4550 }, message: None }, span: 4528..4551 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Name("count"), span: 4563..4568 }, arguments: [Spanned { expression: Name("values"), span: 4569..4575 }, Spanned { expression: Closure { captures: [], parameters: [Parameter { span: 4578..4583, name: "value", ty: Some(Named("Int", [])), type_span: Some(4585..4588) }], effects: [], suspends: false, body: Expression(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 4593..4598 }, operator: Greater, right: Spanned { expression: Integer(11), span: 4601..4603 } }, span: 4593..4603 }) }, span: 4577..4603 }] }, span: 4563..4604 }, operator: Equal, right: Spanned { expression: Integer(2), span: 4608..4609 } }, span: 4563..4609 }, message: None }, span: 4556..4610 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4615..4617 }), span: 4615..4617 }] } }] }), source: Some("//! Generic algorithms over immutable indexed sequences.\n\nimport core.functions\nimport core.option\n\n/// Applies `transform` to every element of a string or list and returns the results as a list.\npub func map<T, U>(values: Sequence<T>, transform: func(T) -> U) -> List<U> {\n    map_into(values, transform, [])\n}\n\n/// Maps the remaining sequence elements into the result accumulator.\nfunc map_into<T, U>(values: Sequence<T>, transform: func(T) -> U, result: List<U>) -> List<U> [consume result] {\n    branch {\n        values.empty?() -> result\n        _ -> map_next(values, transform, move result)\n    }\n}\n\n/// Transforms the next sequence element and appends it to the accumulator.\nfunc map_next<T, U>(values: Sequence<T>, transform: func(T) -> U, result: List<U>) -> List<U> {\n    let mapped = transform(values.head())\n    map_into(values.rest(), transform, result.append(mapped))\n}\n\n/// Returns sequence elements for which `include` evaluates to true.\npub func filter<T>(values: Sequence<T>, include: Predicate<T>) -> List<T> {\n    filter_into(values, include, [])\n}\n\n/// Filters the remaining sequence elements into the result accumulator.\nfunc filter_into<T>(values: Sequence<T>, include: Predicate<T>, result: List<T>) -> List<T> [consume result] {\n    branch {\n        values.empty?() -> result\n        include(values.head()) -> filter_into(values.rest(), include, result.append(values.head()))\n        _ -> filter_into(values.rest(), include, move result)\n    }\n}\n\n/// Returns the first element of a sequence, if one exists.\n///\n/// The sequence is consumed because the returned generic element is owned.\npub func first<T>(values: Sequence<T>) -> Option<T> [consume values] {\n    branch {\n        values.empty?() -> Option.None\n        _ -> Option.Some(values.head())\n    }\n}\n\n/// Returns the final element of a sequence, if one exists.\n///\n/// The sequence is consumed because the returned generic element is owned.\npub func last<T>(values: Sequence<T>) -> Option<T> [consume values] {\n    branch {\n        values.empty?() -> Option.None\n        values.rest().empty?() -> Option.Some(values.head())\n        _ -> last(values.rest())\n    }\n}\n\n/// Reduces the sequence from left to right, consuming its elements and the initial accumulator.\npub func fold<T, U>(values: Sequence<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [consume values, consume initial] {\n    branch {\n        values.empty?() -> initial\n        _ -> fold(values.rest(), combine(move initial, values.head()), combine)\n    }\n}\n\n/// Returns the first element satisfying `predicate`, consuming the sequence to return an owned value.\npub func find<T>(values: Sequence<T>, predicate: Predicate<T>) -> Option<T> [consume values] {\n    branch {\n        values.empty?() -> Option.None\n        predicate(values.head()) -> Option.Some(values.head())\n        _ -> find(values.rest(), predicate)\n    }\n}\n\n/// Returns whether at least one sequence element satisfies `predicate`.\npub func any?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {\n    branch {\n        values.empty?() -> false\n        predicate(values.head()) -> true\n        _ -> any?(values.rest(), predicate)\n    }\n}\n\n/// Returns whether every sequence element satisfies `predicate`.\npub func all?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {\n    branch {\n        values.empty?() -> true\n        predicate(values.head()) -> all?(values.rest(), predicate)\n        _ -> false\n    }\n}\n\n/// Returns whether no sequence element satisfies `predicate`.\npub func none?<T>(values: Sequence<T>, predicate: Predicate<T>) -> Bool {\n    !any?(values, predicate)\n}\n\n/// Returns whether the sequence contains an element equal to `expected`.\npub func contains?<T>(values: Sequence<T>, expected: T) -> Bool {\n    branch {\n        values.empty?() -> false\n        values.head() == expected -> true\n        _ -> contains?(values.rest(), expected)\n    }\n}\n\n/// Counts the sequence elements satisfying `predicate`.\npub func count<T>(values: Sequence<T>, predicate: Predicate<T>) -> Int {\n    branch {\n        values.empty?() -> 0\n        predicate(values.head()) -> 1 + count(values.rest(), predicate)\n        _ -> count(values.rest(), predicate)\n    }\n}\n\n/// Returns at most the first `count` sequence elements as a list.\npub func take<T>(values: Sequence<T>, count: Int) -> List<T> {\n    take_into(values, count, [])\n}\n\ntest \"sequence algorithms operate on lists without conversion\" {\n    let values = map([1, 2, 3], (value: Int) -> value + 10)\n    assert(values.length == 3)\n    assert(values[0] == 11)\n    assert(count(values, (value: Int) -> value > 11) == 2)\n    ()\n}\n\n/// Copies at most `count` remaining elements into the result accumulator.\nfunc take_into<T>(values: Sequence<T>, count: Int, result: List<T>) -> List<T> [consume result] {\n    branch {\n        count <= 0 -> result\n        values.empty?() -> result\n        _ -> take_into(values.rest(), count - 1, result.append(values.head()))\n    }\n}\n"), origin: Embedded }, "std.time": Module { name: "std.time", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/time.fos"), program: Some(Program { documentation: Some("Exact instants, elapsed durations, intervals, and injectable clocks."), imports: [Import { span: 74..94, path: ["core", "ordering"], alias: None }, Import { span: 95..113, path: ["core", "result"], alias: None }], constants: [], records: [RecordDecl { span: 115..133, documentation: None, name: "TimeHost", public: false, intrinsic: false, parameters: [], compositions: [], fields: [], methods: [] }, RecordDecl { span: 490..557, documentation: 