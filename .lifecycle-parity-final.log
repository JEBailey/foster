n: 1234..1250 }, arguments: [] }, span: 1234..1252 }, operator: NotEqual, right: Spanned { expression: Integer(955), span: 1256..1259 } }, span: 1234..1259 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(false), span: 1263..1268 }), span: 1263..1268 }] } }, BranchArm { test: Wildcard, body: Block { items: [Spanned { value: Expr(Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("character"), span: 1287..1296 }, name: "as_string" }, span: 1287..1306 }, arguments: [] }, span: 1287..1308 }, operator: Equal, right: Spanned { expression: String("λ"), span: 1312..1316 } }, span: 1287..1316 }), span: 1287..1316 }] } }] }, span: 1212..1327 }), span: 1212..1327 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Option", "None"], enum_accessor: true, fields: [] }, span: 1337..1348 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(false), span: 1352..1357 }), span: 1352..1357 }] } }] }, span: 1148..1364 } }, span: 1136..1364 }, Spanned { value: Assert { condition: Spanned { expression: Name("valid"), span: 1377..1382 }, message: None }, span: 1370..1383 }] } }] }), source: Some("//! Unicode scalar construction, classification, and UTF-8 encoding.\r\n\r\nimport core.option\r\n\r\nimpl CodePoint {\r\n    /// Explicitly copies this scalar value.\r\n    pub func copy(self: CodePoint) -> self [read self] { self }\r\n\r\n    /// Returns the Unicode scalar value represented by this code point.\r\n    pub func as_int(self: CodePoint) -> Int {\r\n        self\r\n    }\r\n\r\n    /// Returns the string representation of this code point.\r\n    pub func as_string(self: CodePoint) -> String {\r\n        self.string\r\n    }\r\n\r\n    /// Creates a code point from a valid Unicode scalar value.\r\n    ///\r\n    /// Returns `None` for negative values, surrogate code points, and values above `0x10FFFF`.\r\n    pub func from(value: Int) -> Option<CodePoint> {\r\n        branch {\r\n            value < 0 -> Option.None\r\n            value > 1114111 -> Option.None\r\n            value >= 55296 -> branch {\r\n                value <= 57343 -> Option.None\r\n                _ -> Option.Some(from_code_point(value))\r\n            }\r\n            _ -> Option.Some(from_code_point(value))\r\n        }\r\n    }\r\n}\r\n\r\ntest \"code points round-trip Unicode scalar values\" {\r\n    let valid = branch CodePoint.from(955) {\r\n        Option.Some(character) -> branch {\r\n            character.as_int() != 955 -> false\r\n            _ -> character.as_string() == \"λ\"\r\n        }\r\n        Option.None -> false\r\n    }\r\n    assert(valid)\r\n}\r\n"), origin: Embedded }, "core.copy": Module { name: "core.copy", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/copy.fos"), program: Some(Program { documentation: Some("Explicit creation of an independent owned value."), imports: [], constants: [], records: [RecordDecl { span: 144..207, documentation: Some("A value that can produce another value of its concrete type without consuming itself."), name: "Copy", public: true, intrinsic: false, parameters: [], compositions: [], fields: [], methods: [MethodRequirement { span: 166..205, documentation: None, name: "copy", receiver: true, public: true, type_parameters: [], groups: [], parameters: [Parameter { span: 180..184, name: "self", ty: None, type_span: None }], return_type: Some(Named("self", [])), effects: [Effect { kind: Read, target: GroupPath { root: "self", children: [] } }], suspends: false }] }], variants: [], functions: [], implementations: [], tests: [] }), source: Some("//! Explicit creation of an independent owned value.\n\n/// A value that can produce another value of its concrete type without consuming itself.\npub type Copy = {\n    pub func copy(self) -> self [read self]\n}\n"), origin: Embedded }, "core.drop": Module { name: "core.drop", source_path: Some("C:\\Users\\jason\\g