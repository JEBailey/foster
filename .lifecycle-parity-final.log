5562..15564 }] }, span: 15535..15565 }] }, span: 15481..15566 }] }, span: 15457..15567 }, Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("FixedOffsetZone"), span: 15569..15584 }, name: "utc" }, span: 15569..15588 }, arguments: [] }, span: 15569..15590 }, Spanned { expression: Member { object: Spanned { expression: Name("Disambiguation"), span: 15592..15606 }, name: "Later" }, span: 15592..15612 }] }, span: 15439..15613 } }, span: 15423..15613 }, Spanned { value: Expr(Spanned { expression: Branch { subject: Some(Spanned { expression: Name("gap_later"), span: 15625..15634 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 15658..15659 }] }, span: 15645..15660 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 15685..15690 }, message: Some(Spanned { expression: String("later gap resolution failed"), span: 15692..15721 }) }, span: 15678..15722 }, Spanned { value: Expr(Spanned { expression: Unit, span: 15735..15737 }), span: 15735..15737 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 15766..15771 }] }, span: 15756..15772 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 15797..15802 }, name: "instant" }, span: 15797..15810 }, arguments: [] }, span: 15797..15812 }, name: "epoch_seconds" }, span: 15797..15826 }, arguments: [] }, span: 15797..15828 }, operator: Equal, right: Spanned { expression: Integer(40), span: 15832..15834 } }, span: 15797..15834 }, message: None }, span: 15790..15835 }, Spanned { value: Expr(Spanned { expression: Unit, span: 15848..15850 }), span: 15848..15850 }] } }] }, span: 15618..15866 }), span: 15618..15866 }] } }] }), source: Some("//! UTC offsets, time-zone contracts, local-time resolution, and zoned values.\n\nimport core.ordering\nimport core.result\nimport std.time as exact\nimport std.time.civil as civil\n\n/// Describes an invalid offset, unknown zone, or rejected local-time resolution.\npub type ZoneError = {\n    pub zone: String\n    pub message: String\n}\n\n/// Controls how an ambiguous or skipped local time maps to an exact instant.\npub enum Disambiguation = Compatible\n    | Earlier\n    | Later\n    | Reject\n\n/// A fixed displacement east of UTC, measured in seconds.\npub type Offset = & Ordered<Offset> & {\n    seconds_value: Int\n}\n\nimpl Offset {\n    /// Validates and constructs an offset less than 24 hours from UTC.\n    pub func from_seconds(seconds: Int) -> Result<Offset, ZoneError> {\n        branch {\n            seconds <= -86400 || seconds >= 86400 -> Result.Error(ZoneError { zone: \"\", message: \"offset must be less than 24 hours from UTC\" })\n            _ -> Result.Ok(Offset { seconds_value: seconds })\n        }\n    }\n\n    /// Returns UTC's zero offset.\n    pub func utc() -> Offset { Offset { seconds_value: 0 } }\n\n    /// Returns seconds east of UTC.\n    pub func seconds(self: Offset) -> Int { self.seconds_value }\n\n    /// Compares two offsets.\n    pub func compare(self: Offset, other: Offset) -> Ordering {\n        branch { self.seconds_value < other.seconds_value -> Ordering.Less self.seconds_value > other.seconds_value -> Ordering.Greater _ -> Ordering.Equal }\n    }\n\n    /// Returns whether two offsets are equal.\n    pub func equal?(self: Offset, other: Offset) -> Bool { self.seconds_value == other.seconds_value }\n}\n\n/// The two possible instants for an overlapping local time.\npub type AmbiguousLocalTime = {\n    earlier_value: Instant\n    later_value: Instant\n}\n\nimpl AmbiguousLocalTime {\n    /// Constructs an ambiguous local-time result.\n    pub func from(earlier: Instant, later: Instant) -> AmbiguousLocalTime {\n        AmbiguousLocalTime { earlier_value: earlier, later_value: later }\n    }\n\n    /// Returns the earlier possible instant.\n    pub func earlier(self: AmbiguousLocalTime) -> Instant { clone_instant(self.earlier_value) }\n    /// Returns the later possible instant.\n    pub func later(self: AmbiguousLocalTime) -> Instant { clone_instant(self.later_value) }\n}\n\n/// The neighboring instants around a skipped local time.\npub type SkippedLocalTime = {\n    before_value: Instant\n    after_value: Instant\n}\n\nimpl SkippedLocalTime {\n    /// Constructs a skipped local-time result.\n    pub func from(before: Instant, after: Instant) -> SkippedLocalTime {\n        SkippedLocalTime { before_value: before, after_value: after }\n    }\n\n    /// Returns the last representable instant before the gap.\n    pub func before(self: SkippedLocalTime) -> Instant { clone_instant(self.before_value) }\n    /// Returns the first representable instant after the gap.\n    pub func after(self: SkippedLocalTime) -> Instant { clone_instant(self.after_value) }\n}\n\n/// The exact mapping cardinality for one local date-time in a time zone.\npub enum LocalResolution = Unique(Instant)\n    | Ambiguous(AmbiguousLocalTime)\n    | Skipped(SkippedLocalTime)\n\n/// A named rule set mapping exact instants to offsets and civil values back to\n/// zero, one, or two exact instants.\npub type TimeZone = {\n    /// Returns the stable zone identifier.\n    pub func id(self) -> String\n    /// Returns the offset active at an exact instant.\n    pub func offset_at(self, instant: Instant) -> Offset\n    /// Resolves a civil date-time without silently discarding gaps or overlaps.\n    pub func resolve(self, local: DateTime) -> LocalResolution\n}\n\n/// A provider of named time-zone rule sets, normally backed by the IANA database.\npub type TimeZoneDatabase = {\n    /// Looks up a time zone by stable identifier.\n    pub func find(self, identifier: String) -> Result<TimeZone, ZoneError>\n}\n\n/// A time zone whose offset never changes.\npub type FixedOffsetZone = & TimeZone & {\n    identifier_value: String\n    offset_value: Offset\n}\n\nimpl FixedOffsetZone {\n    /// Constructs a fixed-offset zone with an explicit identifier.\n    pub func from(identifier: String, offset: Offset) -> FixedOffsetZone {\n        FixedOffsetZone { identifier_value: identifier, offset_value: offset }\n    }\n\n    /// Constructs the UTC fixed-offset zone.\n    pub func utc() -> FixedOffsetZone {\n        FixedOffsetZone { identifier_value: \"UTC\", offset_value: Offset.utc() }\n    }\n\n    /// Returns the fixed zone identifier.\n    pub func id(self: FixedOffsetZone) -> String {\n        self.identifier_value.slice(0, self.identifier_value.length)\n    }\n\n    /// Returns the zone's constant offset.\n    pub func offset_at(self: FixedOffsetZone, instant: Instant) -> Offset {\n        offset_from_valid_seconds(self.offset_value.seconds())\n    }\n\n    /// Resolves every valid civil value uniquely under the constant offset.\n    pub func resolve(self: FixedOffsetZone, local: DateTime) -> LocalResolution {\n        LocalResolution.Unique(instant_from_local(local, self.offset_value))\n    }\n}\n\n/// An exact instant paired with a fixed offset but no regional transition rules.\npub type OffsetDateTime = & Ordered<OffsetDateTime> & {\n    instant_value: Instant\n    offset_value: Offset\n}\n\nimpl OffsetDateTime {\n    /// Pairs an exact instant with a fixed offset.\n    pub func from_instant(instant: Instant, offset: Offset) -> OffsetDateTime {\n        OffsetDateTime { instant_value: instant, offset_value: offset }\n    }\n\n    /// Interprets a civil date-time under a fixed offset.\n    pub func from_local(local: DateTime, offset: Offset) -> OffsetDateTime {\n        OffsetDateTime { instant_value: instant_from_local(local, offset), offset_value: offset }\n    }\n\n    /// Returns the exact instant.\n    pub func instant(self: OffsetDateTime) -> Instant { clone_instant(self.instant_value) }\n    /// Returns the fixed offset.\n    pub func offset(self: OffsetDateTime) -> Offset { offset_from_valid_seconds(self.offset_value.seconds()) }\n    /// Returns the corresponding civil date-time.\n    pub func local(self: OffsetDateTime) -> DateTime {\n        local_from_instant(self.instant_value, self.offset_value)\n    }\n\n    /// Advances the exact instant while preserving the offset.\n    pub func add(self: OffsetDateTime, duration: Duration) -> OffsetDateTime {\n        OffsetDateTime { instant_value: self.instant_value.add(duration), offset_value: self.offset_value }\n    }\n\n    /// Compares offset date-times by exact instant.\n    pub func compare(self: OffsetDateTime, other: OffsetDateTime) -> Ordering {\n        self.instant_value.compare(other.instant_value)\n    }\n\n    /// Returns whether two offset date-times identify the same exact instant.\n    pub func equal?(self: OffsetDateTime, other: OffsetDateTime) -> Bool {\n        self.instant_value.equal?(other.instant_value)\n    }\n}\n\n/// An exact instant interpreted through a named time-zone rule set.\npub type ZonedDateTime = & Ordered<ZonedDateTime> & {\n    instant_value: Instant\n    zone_value: TimeZone\n}\n\nimpl ZonedDateTime {\n    /// Interprets an exact instant in a time zone; this direction is always unambiguous.\n    pub func from_instant(instant: Instant, zone: TimeZone) -> ZonedDateTime {\n        ZonedDateTime { instant_value: instant, zone_value: zone }\n    }\n\n    /// Resolves a civil date-time using an explicit gap/overlap policy.\n    pub func from_local(local: DateTime, zone: TimeZone, disambiguation: Disambiguation) -> Result<ZonedDateTime, ZoneError> {\n        select_resolution(zone.resolve(local), move zone, disambiguation)\n    }\n\n    /// Returns the exact instant.\n    pub func instant(self: ZonedDateTime) -> Instant { clone