t(self: UniformInt) -> Int { self.start_value }\n\n    /// Returns the exclusive upper bound.\n    pub func end(self: UniformInt) -> Int { self.end_value }\n\n    /// Draws one uniformly distributed integer in this distribution's range.\n    pub func sample(self: UniformInt, source: RandomSource) -> Result<Int, RandomError> [read self.start_value, read self.end_value, mut source] {\n        random::between_with(source, self.start_value, self.end_value)\n    }\n}\n\n/// A uniform floating-point distribution over one half-open finite range.\npub type UniformFloat = & Distribution<Float> & {\n    start_value: Float\n    end_value: Float\n}\n\nimpl UniformFloat {\n    /// Validates and constructs a uniform floating-point distribution over `[start, end)`.\n    pub func from(start: Float, end: Float) -> Result<UniformFloat, RandomError> {\n        return failure(\"uniform_float\", 0, \"uniform float bounds must be ordered finite numbers\") if not finite?(start) || not finite?(end) || start >= end\n        Result.Ok(UniformFloat { start_value: start, end_value: end })\n    }\n\n    /// Returns the inclusive floating-point lower bound.\n    pub func start(self: UniformFloat) -> Float { self.start_value }\n\n    /// Returns the exclusive floating-point upper bound.\n    pub func end(self: UniformFloat) -> Float { self.end_value }\n\n    /// Draws one uniformly distributed floating-point value in this distribution's range.\n    pub func sample(self: UniformFloat, source: RandomSource) -> Result<Float, RandomError> [read self.start_value, read self.end_value, mut source] {\n        let capacity = try source_capacity(source, \"uniform_float\")\n        let raw = try random::below_with(source, capacity)\n        let unit = parse_float(raw.as_string()) / parse_float(capacity.as_string())\n        Result.Ok(self.start_value + (self.end_value - self.start_value) * unit)\n    }\n}\n\n/// A Bernoulli distribution returning true with a configured probability.\npub type Bernoulli = & Distribution<Bool> & {\n    probability_value: Float\n}\n\nimpl Bernoulli {\n    /// Validates and constructs a Bernoulli probability from zero through one.\n    pub func from(probability: Float) -> Result<Bernoulli, RandomError> {\n        return failure(\"bernoulli\", 0, \"Bernoulli probability must be between zero and one\") if probability != probability || probability < 0.0 || probability > 1.0\n        Result.Ok(Bernoulli { probability_value: probability })\n    }\n\n    /// Returns the probability of drawing true.\n    pub func probability(self: Bernoulli) -> Float { self.probability_value }\n\n    /// Draws one Boolean with the configured probability of true.\n    pub func sample(self: Bernoulli, source: RandomSource) -> Result<Bool, RandomError> [read self.probability_value, mut source] {\n        return Result.Ok(false) if self.probability_value == 0.0\n        return Result.Ok(true) if self.probability_value == 1.0\n        let capacity = try source_capacity(source, \"bernoulli\")\n        let raw = try random::below_with(source, capacity)\n        let unit = parse_float(raw.as_string()) / parse_float(capacity.as_string())\n        Result.Ok(unit < self.probability_value)\n    }\n}\n\n/// A discrete distribution returning an index in proportion to nonnegative integer weights.\npub type WeightedIndex = & Distribution<Int> & {\n    weights_value: List<Int>\n    total_value: Int\n}\n\nimpl WeightedIndex {\n    /// Validates nonnegative weights and constructs a discrete index distribution.\n    pub func from(weights: List<Int>) -> Result<WeightedIndex, RandomError> [consume weights] {\n        let total = try weight_total(weights, 0, 0)\n        return failure(\"weighted\", total, \"weighted distribution requires a positive total weight\") if total == 0\n        Result.Ok(WeightedIndex { weights_value: move weights, total_value: total })\n    }\n\n    /// Returns the number of weighted outcomes.\n    pub func length(self: WeightedIndex) -> Int { self.weights_value.length }\n\n    /// Returns the sum of all configured weights.\n    pub func total(self: WeightedIndex) -> Int { self.total_value }\n\n    /// Draws one index in proportion to its configured weight.\n    pub func sample(self: WeightedIndex, source: RandomSource) -> Result<Int, RandomError> [read self.weights_value, read self.total_value, mut source] {\n        let target = try random::below_with(source, self.total_value)\n        Result.Ok(weighted_index(self.weights_value, target, 0, 0))\n    }\n}\n\n/// Accumulates validated weights without exceeding the portable source capacity.\nfunc weight_total(weights: List<Int>, index: Int, total: Int) -> Result<Int, RandomError> {\n    return Result.Ok(total) if index >= weights.length\n    let weight = weights[index]\n    return failure(\"weighted\", weight, \"weights must not be negative\") if weight < 0\n    return failure(\"weighted\", weight, \"total weight must not exceed 2147483646\") if weight > 2147483646 - total\n    weight_total(weights, index + 1, total + weight)\n}\n\n/// Finds the first index whose cumulative weight exceeds `target`.\nfunc weighted_index(weights: List<Int>, target: Int, index: Int, cumulative: Int) -> Int {\n    let next = cumulative + weights[index]\n    branch { target < next -> index _ -> weighted_index(weights, target, index + 1, next) }\n}\n\n/// Reports whether a floating-point value is neither NaN nor an infinity.\nfunc finite?(value: Float) -> Bool {\n    let infinity = parse_float(\"inf\")\n    value == value && value != infinity && value != 0.0 - infinity\n}\n\n/// Returns a safe source capacity for floating-point sampling.\nfunc source_capacity(source: RandomSource, operation: String) -> Result<Int, RandomError> [consume operation] {\n    let maximum = source.maximum()\n    return failure(move operation, maximum, \"random source maximum must be between zero and 9223372036854775806\") if maximum < 0 || maximum == 9223372036854775807\n    Result.Ok(maximum + 1)\n}\n\n/// Constructs a typed distribution error for any failed sample shape.\nfunc failure<T>(operation: String, value: Int, message: String) -> Result<T, RandomError> {\n    Result.Error(RandomError { operation, value, message })\n}\n\n/// Extracts a successful integer sample for tests.\nfunc sampled_int(outcome: Result<Int, RandomError>) -> Int {\n    branch outcome { Result.Ok(value) -> value Result.Error(_) -> -1 }\n}\n\n/// Exercises a generic integer distribution contract for tests.\nfunc sampled_distribution(distribution: Distribution<Int>, source: RandomSource) -> Int [read distribution, mut source] {\n    sampled_int(distribution.sample(source))\n}\n\ntest \"uniform distributions stay inside their half-open ranges\" {\n    let source = LehmerRandom.from_seed(42)\n    branch UniformInt.from(-10, 21) {\n        Result.Error(_) -> {\n            assert(false, \"valid integer distribution was rejected\")\n            ()\n        }\n        Result.Ok(distribution) -> {\n            let value = sampled_distribution(distribution, source)\n            assert(value >= -10 && value < 21)\n            ()\n        }\n    }\n    assert(UniformInt.from(1, 1).error?())\n    assert(UniformInt.from(2, 1).error?())\n    assert(UniformFloat.from(parse_float(\"NaN\"), 1.0).error?())\n    assert(UniformFloat.from(0.0, parse_float(\"inf\")).error?())\n    branch UniformFloat.from(-1.0, 1.0) {\n        Result.Error(_) -> {\n            assert(false, \"valid float distribution was rejected\")\n            ()\n        }\n        Result.Ok(distribution) -> branch distribution.sample(source) {\n            Result.Error(_) -> {\n                assert(false, \"float sample failed\")\n                ()\n            }\n            Result.Ok(value) -> {\n                assert(value >= -1.0 && value < 1.0)\n                ()\n            }\n        }\n    }\n    ()\n}\n\ntest \"Bernoulli and weighted distributions validate probability models\" {\n    let source = LehmerRandom.from_seed(9)\n    branch Bernoulli.from(0.0) {\n        Result.Error(_) -> {\n            assert(false)\n            ()\n        }\n        Result.Ok(distribution) -> branch distribution.sample(source) {\n            Result.Error(_) -> {\n                assert(false)\n                ()\n            }\n            Result.Ok(value) -> {\n                assert(not value)\n                ()\n            }\n        }\n    }\n    branch WeightedIndex.from([0, 5, 0]) {\n        Result.Error(_) -> {\n            assert(false)\n            ()\n        }\n        Result.Ok(distribution) -> {\n            assert(sampled_int(distribution.sample(source)) == 1)\n            ()\n        }\n    }\n    assert(Bernoulli.from(-0.1).error?())\n    assert(Bernoulli.from(1.1).error?())\n    assert(Bernoulli.from(parse_float(\"NaN\")).error?())\n    assert(WeightedIndex.from([0, 0]).error?())\n    assert(WeightedIndex.from([1, -1]).error?())\n    assert(WeightedIndex.from([2147483646, 1]).error?())\n    ()\n}\n"), origin: Embedded }, "std.random.generator": Module { name: "std.random.generator", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/random/generator.fos"), program: Some(Program { documentation: Some("Deterministic seeded random generators with explicit reproducibility guarantees."), imports: [Import { span: 86..104, path: ["core", "result"], alias: None }, Import { span: 105..122, path: ["std", "random"], alias: None }], constants: [ConstDecl { span: 181..214, documentation: Some("Prime modulus used by the portable Lehmer generator."), name: "LEHMER_MODULUS", public: false, value: Spanned { expression: Integer(2147483647), span: 204..214 } }, ConstDecl { span: 270..301, documentation: Some("Multiplier used by the portable Lehmer generator."), name: "LEHMER_MULTIPLIER", public: false, value: Spanned { expression: Integer(48271), span: 296..301 } }, ConstDecl { span: 374..407, documentation: Some("Largest zero-based value emitted by the portable Lehmer generator."), name: "LEHMER_MAXIMUM", public: false, value: Spanned { expression: Integer(2147483645), span: 397..407 } }], records: [RecordDecl { span: 714..794, documentation: Some("A named portable Lehmer generator using the `minstd_rand` multiplier.\n\nThe same seed and sequence of calls produce the same values on every Foster target. This\ngenerator is suitable for tests, procedural generation, and modest simulations, but not for\ncryptographic or adversarial use."), name: "LehmerRandom", public: true, intrinsic: false, parameters: [], compositions: [Named("SeedableRandom", []), Named("SplittableRandom", [])], fields: [RecordField { name: "state", public: false, ty: Named("Int", []) }], methods: [] }, RecordDecl { span: 2015..2093, documentation: Some("The standard fast deterministic generator.\n\nIts algorithm may change between Foster releases. Use `LehmerRandom` when a serialized seed\nmust reproduce the same sequence across releases."), name: "FastRandom", public: true, intrinsic: false, parameters: [], compositions: [Named("SeedableRandom", []), Named("SplittableRandom", [])], fields: [RecordField { name: "state", public: false, ty: Named("Int", []) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 885..992, documentation: Some("Constructs the portable generator from any integer seed."), name: "LehmerRandom.from_seed", owner: Some("LehmerRandom"), receiver: false, public: true, intrinsic: None, type_parameters: [], groups: [], parameters: [Parameter { span: 904..908, name: "seed", ty: Some(Named("Int", [])), type_span: Some(910..913) }], return_type: Some(Named("LehmerRandom", [])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Record { constructor: Spanned { expression: Name("LehmerRandom"), span: 941..953 }, fields: [RecordFieldValue { name: "state", value: Spanned { expression: Call { callee: Spanned { expression: Name("normalized_seed")