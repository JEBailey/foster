Ordering"), span: 1309..1317 }, name: "Equal" }, span: 1309..1323 }), span: 1309..1323 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Ordering", "Greater"], enum_accessor: true, fields: [] }, span: 1336..1352 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Member { object: Spanned { expression: Name("Ordering"), span: 1356..1364 }, name: "Less" }, span: 1356..1369 }), span: 1356..1369 }] } }] }, span: 1219..1379 }), span: 1219..1379 }] } }], implementations: [Implementation { span: 1056..1387, owner_span: 1061..1069, owner: "Ordering", parameters: [] }], tests: [TestDecl { span: 1389..1573, description: "reversing an ordering exchanges less and greater", body: Block { items: [Spanned { value: Bind { name: "valid", value: Spanned { expression: Branch { subject: Some(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Member { object: Spanned { expression: Name("Ordering"), span: 1470..1478 }, name: "Less" }, span: 1470..1483 }, name: "reverse" }, span: 1470..1491 }, arguments: [] }, span: 1470..1493 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Ordering", "Greater"], enum_accessor: true, fields: [] }, span: 1504..1520 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(true), span: 1524..1528 }), span: 1524..1528 }] } }, BranchArm { test: Pattern(Spanned { pattern: Wildcard, span: 1537..1538 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(false), span: 1542..1547 }), span: 1542..1547 }] } }] }, span: 1463..1553 } }, span: 1451..1553 }, Spanned { value: Assert { condition: Spanned { expression: Name("valid"), span: 1565..1570 }, message: None }, span: 1558..1571 }] } }] }), source: Some("//! Three-way ordering results and ordering transformations.\n\n/// The relative order of two comparable values.\npub enum Ordering = Less\n    | Equal\n    | Greater\n\n/// A type whose values can be compared for semantic equality with `T`.\n///\n/// Implementations must be reflexive, symmetric, and transitive.\npub type Equality<T> = {\n    /// Returns whether this value and `other` are semantically equal.\n    pub func equal?(self, other: T) -> Bool\n}\n\n/// A totally ordered type whose values can be compared with `T`.\n///\n/// `compare` must agree with the composed `Equality<T>` implementation:\n/// it returns `Ordering.Equal` exactly when `equal?` returns true.\npub type Ordered<T> = & Equality<T> & {\n    /// Compares this value with `other`.\n    pub func compare(self, other: T) -> Ordering\n}\n\n/// A type that provides a stable integer hash for its semantic value.\n///\n/// Values considered equal must return the same hash. Unequal values may collide.\npub type Hashing = {\n    /// Returns this value's stable integer hash.\n    pub func hash(self) -> Int\n}\n\nimpl Ordering {\n    /// Reverses an ordering, exchanging `Less` and `Greater` while preserving `Equal`.\n    pub func reverse(self: Ordering) -> Ordering {\n        branch self {\n            Ordering.Less -> Ordering.Greater\n            Ordering.Equal -> Ordering.Equal\n            Ordering.Greater -> Ordering.Less\n        }\n    }\n}\n\ntest \"reversing an ordering exchanges less and greater\" {\n    let valid = branch Ordering.Less.reverse() {\n        Ordering.Greater -> true\n        _ -> false\n    }\n    assert(valid)\n}\n"), origin: Embedded }, "core.range": Module { name: "core.range", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/range.fos"), program: Some(Program { documentation: Some("Bounded integer ranges exposed as repeatable collections."), imports: [Import { span: 63..85, path: ["std", "collections"], alias: None }, Import { span: 86..101, path: ["std", "iter"], alias: None }], constants: [], records: [RecordDecl { span: 350..425, documentation: Some("A reusable sequence view over a bounded list of values.\n\nThis generic representation keeps range traversal independent of ar