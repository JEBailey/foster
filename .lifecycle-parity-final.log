713 }] }, span: 14698..14714 }), span: 14698..14714 }, Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("output"), span: 14719..14725 }, name: "push" }, span: 14719..14730 }, arguments: [Spanned { expression: CodePoint("λ"), span: 14731..14735 }] }, span: 14719..14736 }), span: 14719..14736 }, Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("output"), span: 14741..14747 }, name: "push" }, span: 14741..14752 }, arguments: [Spanned { expression: CodePoint("€"), span: 14753..14758 }] }, span: 14741..14759 }), span: 14741..14759 }, Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("output"), span: 14764..14770 }, name: "push" }, span: 14764..14775 }, arguments: [Spanned { expression: CodePoint("🙂"), span: 14776..14782 }] }, span: 14764..14783 }), span: 14764..14783 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Spanned { expression: MoveOut(Spanned { expression: Name("output"), span: 14801..14807 }), span: 14796..14807 }, span: 14795..14808 }, name: "finish" }, span: 14795..14815 }, arguments: [] }, span: 14795..14817 }, operator: Equal, right: Spanned { expression: String("start:aλ€🙂"), span: 14821..14839 } }, span: 14795..14839 }, message: None }, span: 14788..14840 }] } }] }), source: Some("//! Immutable UTF-8 text, byte-range scans, and amortized text construction.\n\nimport core.byte\nimport core.bytes\nimport core.bytes.buffer\nimport core.code_point\nimport core.functions\nimport core.list\nimport core.option\nimport core.result\n\n/// Immutable Unicode text stored as validated UTF-8 bytes.\n/// Private storage preserves the validity invariant across every construction path.\npub type String = {\n    value: Bytes\n}\n\nimpl String {\n    /// Returns an independent text value; immutable byte storage may be shared.\n    pub func copy(self: String) -> self [read self] { self + \"\" }\n\n    /// Validates UTF-8 in Foster and takes ownership of the immutable byte storage without decoding or copying it.\n    pub func from_utf8(value: Bytes) -> Result<String, Utf8Error> [consume value] {\n        branch {\n            value.utf8_valid?() -> Result.Ok(String { value })\n            _ -> Result.Error(Utf8Error { offset: -1, message: \"Bytes are not valid UTF-8\" })\n        }\n    }\n}\n\n/// A Foster text builder that encodes code points and appends UTF-8 without prefix concatenation.\npub type StringBuilder = {\n    value: ByteBuffer\n}\n\nimpl StringBuilder {\n    /// Creates an empty text builder.\n    pub func empty() -> StringBuilder {\n        StringBuilder { value: ByteBuffer.empty() }\n    }\n\n    /// Appends validated text to this builder.\n    pub func append(self: StringBuilder, text: String) -> () [reshape self.value.value.items] {\n        self.value.extend(text.bytes)\n    }\n\n    /// Encodes one Unicode scalar into UTF-8; encoding policy stays in Foster.\n    pub func push(self: StringBuilder, character: CodePoint) -> () [reshape self.value.value.items] {\n        let scalar = character.as_int()\n        branch {\n            scalar < 128 -> self.value.push(Byte.unchecked(scalar))\n            scalar < 2048 -> {\n                self.value.push(Byte.unchecked(192 + scalar / 64))\n                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))\n            }\n            scalar < 65536 -> {\n                self.value.push(Byte.unchecked(224 + scalar / 4096))\n                self.value.push(Byte.unchecked(128 + scalar / 64 - scalar / 4096 * 64))\n                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))\n            }\n            _ -> {\n                self.value.push(Byte.unchecked(240 + scalar / 262144))\n                self.value.push(Byte.unchecked(128 + scalar / 4096 - scalar / 262144 * 64))\n                self.value.push(Byte.unchecked(128 + scalar / 64 - scalar / 4096 * 64))\n                self.value.push(Byte.unchecked(128 + scalar - scalar / 64 * 64))\n            }\n        }\n    }\n\n    /// Consumes the builder and constructs one validated immutable String.\n    pub func finish(self: StringBuilder) -> String [consume self] {\n        decode_bytes((move self.value).freeze())\n    }\n}\n\n/// Decodes bytes produced by the text algorithms, retaining a checked construction boundary.\nfunc decode_bytes(data: Bytes) -> String {\n    branch String.from_utf8(move data) {\n        Result.Ok(text) -> text\n        Result.Error(_) -> {\n            assert(false, \"text construction must preserve valid UTF-8\")\n            \"\"\n        }\n    }\n}\n\n/// A cursor over one stable UTF-8 byte snapshot, never over copied suffix strings.\ntype TextCursor = {\n    data: Bytes\n    offset: Int\n}\n\n/// Creates a byte cursor over validated text.\nfunc cursor(text: String) -> TextCursor {\n    TextCursor { data: text.bytes, offset: 0 }\n}\n\n/// Returns the encoded width of a valid UTF-8 leading byte.\nfunc scalar_width(first: Int) -> Int {\n    branch {\n        first < 128 -> 1\n        first < 224 -> 2\n        first < 240 -> 3\n        _ -> 4\n    }\n}\n\nimpl TextCursor {\n    /// Reads one scalar and advances the byte offset; callers ensure the cursor is nonempty.\n    func next_scalar(self: TextCursor) -> CodePoint {\n        let first = self.data[self.offset].int\n        let width = scalar_width(first)\n        let scalar = branch {\n            width == 1 -> first\n            width == 2 -> first - 192\n            width == 3 -> first - 224\n            _ -> first - 240\n        }\n        let index = 1\n        loop {\n            break if index >= width\n            scalar = scalar * 64 + self.data[self.offset + index].int - 128\n            index = index + 1\n        }\n  