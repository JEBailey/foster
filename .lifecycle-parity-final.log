uction and integer conversion.\r\n\r\nimport core.result\r\n\r\nimpl Byte {\r\n    /// Explicitly copies this scalar value.\r\n    pub func copy(self: Byte) -> self [read self] { self }\r\n\r\n    /// Returns whether an integer fits in a byte.\r\n    pub func valid(value: Int) -> Bool {\r\n        value >= 0 && value <= 255\r\n    }\r\n\r\n    /// Constructs a byte without repeating range validation.\r\n    pub func unchecked(value: Int) -> Byte = intrinsic(\"byte.unchecked\")\r\n\r\n    /// Converts an integer in the inclusive range 0 through 255 to `Byte`.\r\n    pub func from(value: Int) -> Result<Byte, ByteError> {\r\n        return Result.Ok(Byte.unchecked(value)) if Byte.valid(value)\r\n        Result.Error(ByteError { value, message: \"Byte must be between 0 and 255\" })\r\n    }\r\n}\r\n\r\n/// Describes an integer that cannot be represented by `Byte`.\r\npub type ByteError = {\r\n    pub value: Int\r\n    pub message: String\r\n}\r\n\r\ntest \"byte conversion preserves values in range\" {\r\n    let valid = branch Byte.from(255) {\r\n        Result.Ok(value) -> value.int == 255\r\n        Result.Error(_) -> false\r\n    }\r\n    assert(valid)\r\n}\r\n"), origin: Embedded }, "core.bytes": Module { name: "core.bytes", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/bytes.fos"), program: Some(Program { documentation: Some("Immutable binary data, encoding conversions, and byte-oriented queries."), imports: [Import { span: 77..93, path: ["core", "byte"], alias: None }, Import { span: 94..110, path: ["core", "list"], alias: None }, Import { span: 111..129, path: ["core", "result"], alias: None }, Import { span: 130..148, path: ["core", "string"], alias: None }], constants: [], records: [RecordDecl { span: 196..219, documentation: Some("Private host-backed compact byte storage."), name: "RawBytes", public: false, intrinsic: true, parameters: [], compositions: [], fields: [], methods: [] }, RecordDecl { span: 276..295, documentation: Some("Private na