nts: [Spanned { expression: String("1invalid"), span: 4316..4326 }] }, span: 4306..4327 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Binding("error"), span: 4351..4356 }] }, span: 4338..4357 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Name("error"), span: 4382..4387 }, name: "value" }, span: 4382..4393 }, operator: Equal, right: Spanned { expression: String("1invalid"), span: 4397..4407 } }, span: 4382..4407 }, message: None }, span: 4375..4408 }, Spanned { value: Assert { condition: Spanned { expression: Unary { operator: Not, operand: Spanned { expression: Member { object: Spanned { expression: Member { object: Spanned { expression: Name("error"), span: 4432..4437 }, name: "message" }, span: 4432..4445 }, name: "empty?" }, span: 4432..4452 } }, span: 4428..4452 }, message: None }, span: 4421..4453 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4466..4468 }), span: 4466..4468 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 4497..4498 }] }, span: 4487..4499 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 4524..4529 }, message: Some(Spanned { expression: String("invalid URI was accepted"), span: 4531..4557 }) }, span: 4517..4558 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4571..4573 }), span: 4571..4573 }] } }] }, span: 4299..4589 }), span: 4299..4589 }] } }] }), source: Some("//! URI resource identities without protocol-specific network access.\n\nimport core.result\nimport std.resource\n\n/// Describes an invalid URI passed to `Uri.parse`.\npub type UriError = {\n    pub value: String\n    pub message: String\n}\n\n/// A parsed URI resource identifier.\n///\n/// `Uri` implements `ResourceIdentifier` but deliberately provides no resource or I/O capability.\n/// Protocol providers convert it into their typed locations—such as `TcpEndpoint`—before creating\n/// an appropriate resource implementation.\npub type Uri = & ResourceIdentifier & {\n    value: String\n    scheme_value: String\n    path_value: String\n}\n\nimpl Uri {\n    /// Parses an absolute URI with a non-empty RFC-style scheme.\n    pub func parse(value: String) -> Result<Uri, UriError> {\n        branch {\n            value.empty? -> invalid_uri(move value, \"URI must not be empty\")\n            not scheme_start?(value.head) -> invalid_uri(move value, \"URI scheme must begin with an ASCII letter\")\n            _ -> begin_scheme(move value)\n        }\n    }\n}\n\n/// Begins scanning after the already validated first scheme character.\nfunc begin_scheme(value: String) -> Result<Uri, UriError> [consume value] {\n    let remaining = value.rest\n    parse_scheme(move value, remaining, 1)\n}\n\nimpl Uri {\n    /// Builds a URI from an already separated scheme and resource path.\n    pub func from_parts(scheme: String, path: String) -> Result<Uri, UriError> {\n        Uri.parse(scheme + \":\" + path)\n    }\n\n    /// Returns the complete URI text.\n    pub func as_string(self: Uri) -> String { self.value.slice(0, self.value.length) }\n\n    /// Returns the stable identifier supplied to a protocol provider.\n    pub func resource_id(self: Uri) -> String { self.as_string() }\n\n    /// Returns the scheme spelling supplied to the parser.\n    pub func scheme(self: Uri) -> String { self.scheme_value.slice(0, self.scheme_value.length) }\n\n    /// Returns the resource portion following the URI scheme separator.\n    pub func path(self: Uri) -> String { self.path_value.slice(0, self.path_value.length) }\n}\n\n/// Scans the URI scheme until its separator.\nfunc parse_scheme(value: String, remaining: String, index: Int) -> Result<Uri, UriError> {\n    branch {\n        remaining.empty? -> invalid_uri(move value, \"URI must contain a scheme separator\")\n        remaining.head == ':' -> parsed_uri(move value, index)\n        scheme_character?(remaining.head) -> parse_scheme(move value, remaining.rest, index + 1)\n        _ -> invalid_uri(move value, \"URI scheme contains an invalid character\")\n    }\n}\n\n/// Separates validated URI text into its scheme and resource path.\nfunc parsed_uri(value: String, index: Int) -> Result<Uri, UriError> [consume value] {\n    let scheme_value = value.slice(0, index)\n    let path_value = value.slice(index + 1, value.length)\n    Result.Ok(Uri { value: move value, scheme_value, path_value })\n}\n\n/// Returns whether a code point may begin a URI scheme.\nfunc scheme_start?(character: CodePoint) -> Bool {\n    (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')\n}\n\n/// Returns whether a code point may follow the first URI scheme character.\nfunc scheme_character?(character: CodePoint) -> Bool {\n    scheme_start?(character) || (character >= '0' && character <= '9') || character == '+' || character == '-' || character == '.'\n}\n\n/// Constructs an invalid-URI result.\nfunc invalid_uri(value: String, message: String) -> Result<Uri, UriError> {\n    Result.Error(UriError { value, message })\n}\n\ntest \"URIs parse schemes paths and invalid inputs\" {\n    branch Uri.parse(\"https://example.com/path\") {\n        Result.Ok(uri) -> {\n            assert(uri.as_string() == \"https://example.com/path\")\n            assert(uri.scheme() == \"https\")\n            assert(uri.path() == \"//example.com/path\")\n            assert(uri.resource_id() == \"https://example.com/path\")\n            ()\n        }\n        Result.Error(_) -> {\n            assert(false, \"valid URI was rejected\")\n            ()\n        }\n    }\n    branch Uri.from_parts(\"tcp\", \"//localhost:8080\") {\n        Result.Ok(uri) -> {\n            assert(uri.as_string() == \"tcp://localhost:8080\")\n            ()\n        }\n        Result.Error(_) -> {\n            assert(false, \"URI parts were rejected\")\n            ()\n        }\n    }\n    branch Uri.parse(\"1invalid\") {\n        Result.Error(error) -> {\n            assert(error.value == \"1invalid\")\n            assert(not error.message.empty?)\n            ()\n        }\n        Result.Ok(_) -> {\n            assert(false, \"invalid URI was accepted\")\n            ()\n        }\n    }\n}\n"), origin: Embedded }} }, hir: PackageHir { modules: Arena { len: 52, data: [Module { name: "core", documentation: None, source_path: None, imports_with_spans: [], functions: {}, constants: {}, records: {}, variant_types: {}, imports: {} }, Module { name: "core.bool", documentation: Some("Boolean logic helpers."), source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/bool.fos"), imports_with_spans: [], functions: {"Bool.copy": [Idx::<Function>(0)], "Bool.then": [Idx::<Function>(2)], "Bool.xor": [Idx::<Function>(1)]}, constants: {}, records: {}, variant_types: {}, imports: {} }, Module { name: "core.byte", documentation: Some("Checked byte construction and integer conversion."), source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/byte.fos"), imports_with_spans: [ImportBinding { name: "result", target: Idx::<Module>(16), span: 57..75 }], functions: {"Byte.copy": [Idx::<Function>(4)], "Byte.from": [Idx::<Function>(7)], "Byte.unchecked": [Idx::<Function>(6)], "Byte.valid": [Idx::<Function>(5)]}, constants: {}, records: {"ByteError": Idx::<Record>(0)}, variant_types: {}, imports: {"result": Idx::<Module>(16)} }, Module { name: "core.bytes", documentation: Some("Immutable binary data, encoding conversions, and byte-oriented queries."), source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/bytes.fos"), imports_with_spans: [ImportBinding { name: "byte", target: Idx::<Module>(2), span: 77..93 }, ImportBinding { name: "list", target: Idx::<Module>(11), span: 94..110 }, ImportBinding { name: "result", targ