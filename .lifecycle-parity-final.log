e<T>, value: T) -> Queue<T> [consume self, consume value] {\n        Queue { values: self.values.append(value) }\n    }\n\n    /// Removes the front value and returns the remaining queue.\n    pub func pop<T>(self: Queue<T>) -> Option<QueueItem<T>> [consume self] {\n        branch {\n            self.values.empty? -> Option.None\n            _ -> Option.Some(QueueItem { value: self.values.head, remaining: Queue { values: self.values.rest } })\n        }\n    }\n}\n\n/// The result of removing one value from a queue.\npub type QueueItem<T> = {\n    pub value: T\n    pub remaining: Queue<T>\n}\n\ntest \"queues retain pushed values\" {\n    let queue = Queue { values: [1, 2] }\n    assert(queue.length() == 2)\n    ()\n}\n"), origin: Embedded }, "std.collections.set": Module { name: "std.collections.set", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/collections/set.fos"), program: Some(Program { documentation: Some("Persistent insertion-ordered sets with uniqueness enforced by equality."), imports: [Import { span: 77..99, path: ["std", "collections"], alias: None }, Import { span: 100..115, path: ["std", "iter"], alias: None }], constants: [], records: [RecordDecl { span: 185..244, documentation: Some("An insertion-ordered collection containing no duplicate values."), name: "Set", public: true, intrinsic: false, parameters: ["T"], compositions: [Named("Collection", [Named("T", [])])], fields: [RecordField { name: "values", public: false, ty: Named("List", [Named("T", [])]) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 291..355, documentation: Some("Creates an empty set."), name: "Set.empty", owner: Some("Set"), receiver: false, public: true, intrinsic: None, type_parameters: ["T"], groups: [], parameters: [], return_type: Some(Named("Set", [Named("T", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { exp