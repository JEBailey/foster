alue: Expr(Spanned { expression: Unit, span: 2060..2062 }), span: 2060..2062 }] } }] }), source: Some("//! Persistent double-ended queues backed by Foster lists.\n\nimport std.collections\nimport std.iter\nimport core.option\n\n/// A double-ended queue.\npub type Deque<T> = & Collection<T> & {\n    values: List<T>\n}\n\nimpl Deque {\n    /// Creates an empty deque.\n    pub func empty<T>() -> Deque<T> {\n        Deque { values: [] }\n    }\n\n    /// Returns the number of values in the deque.\n    pub func length<T>(self: Deque<T>) -> Int {\n        self.values.length\n    }\n\n    /// Returns whether the deque contains no values.\n    pub func empty?<T>(self: Deque<T>) -> Bool {\n        self.values.empty?\n    }\n\n    /// Creates an independent iterator from front to back.\n    pub func iterator<T>(self: Deque<T>) -> Iterator<T> {\n        self.values.iterator()\n    }\n\n    /// Returns a deque with `value` added at the front.\n    pub func push_front<T>(self: Deque<T>, value: T) -> Deque<T> [consume self, consume value] {\n        Deque { values: append_all(move self.values, [value]) }\n    }\n\n    /// Returns a deque with `value` added at the back.\n    pub func push_back<T>(self: Deque<T>, value: T) -> Deque<T> [consume self, consume value] {\n        Deque { values: self.values.append(value) }\n    }\n\n    /// Removes the front value and returns the remaining deque.\n    pub func pop_front<T>(self: Deque<T>) -> Option<DequeItem<T>> [consume self] {\n        branch {\n            self.values.empty? -> Option.None\n            _ -> Option.Some(DequeItem { value: self.values.head, remaining: Deque { values: self.values.rest } })\n        }\n    }\n\n    /// Removes the back value and returns the remaining deque.\n    pub func pop_back<T>(self: Deque<T>) -> Option<DequeItem<T>> [consume self] {\n        branch {\n            self.values.empty? -> Option.None\n            _ -> pop_back_values(move self.values, [])\n        }\n    }\n}\n\n/// The result of removing one value from a deque.\npub type DequeItem<T> = {\n    pub value: T\n    pub remaining: Deque<T>\n}\n\ntest \"deques accept values at both ends\" {\n    let deque = Deque { values: [1, 2] }\n    assert(deque.length() == 2)\n    ()\n}\n\n/// Walks to the final value while rebuilding the preceding values.\nfunc pop_back_values<T>(remaining: List<T>, prefix: List<T>) -> Option<DequeItem<T>> [consume remaining, consume prefix] {\n    branch {\n        remaining.rest.empty? -> Option.Some(DequeItem { value: remaining.head, remaining: Deque { values: prefix } })\n        _ -> pop_back_values(remaining.rest, prefix.append(remaining.head))\n    }\n}\n\n/// Appends all remaining values to the result accumulator.\nfunc append_all<T>(remaining: List<T>, result: List<T>) -> List<T> [consume remaining, consume result] {\n    branch {\n        remaining.empty? -> result\n        _ -> append_all(remaining.rest, result.append(remaining.head))\n    }\n}\n"), origin: Embedded }, "std.collections.map": Module { name: "std.collections.map", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/collections/map.fos"), program: Some(Program { documentation: Some("Persistent insertion-ordered maps represented by public key-value entries."), imports: [Import { span: 80..98, path: ["core", "option"], alias: None }, Import { span: 99..121, path: ["std", "collections"], alias: None }, Import { span: 122..137, path: ["std", "iter"], alias: None }], constants: [], records: [RecordDecl { span: 191..249, documentation: Some("A key-value pair yielded while iterating a map."), name: "Entry", public: true, intrinsic: false, parameters: ["K", "V"], compositions: [], fields: [RecordField { name: "key", public: true, ty: Named("K", []) }, RecordField { name: "value", public: true, ty: Named("V", []) }], methods: [] }, RecordDecl { span: 300..383, documentation: Some("An insertion-ordered associative collection."), name: "Map", public: true, intrinsic: false, parameters: ["K", "V"], composit