r\n\r\n    /// Formats a binary64 value as round-trippable decimal text.\r\n    pub func as_string(self: Float) -> String { FloatHost.format(self) }\r\n\r\n    /// Returns the absolute value of `value`.\r\n    pub func absolute(self: Float) -> Float {\r\n        branch {\r\n            self < 0.0 -> -self\r\n            _ -> self\r\n        }\r\n    }\r\n\r\n    /// Returns the smaller of `left` and `right`.\r\n    pub func minimum(self: Float, right: Float) -> Float {\r\n        branch {\r\n            self <= right -> self\r\n            _ -> right\r\n        }\r\n    }\r\n\r\n    /// Returns the larger of `left` and `right`.\r\n    pub func maximum(self: Float, right: Float) -> Float {\r\n        branch {\r\n            self >= right -> self\r\n            _ -> right\r\n        }\r\n    }\r\n\r\n    /// Restricts `value` to the inclusive range from `lower` to `upper`.\r\n    pub func clamp(self: Float, lower: Float, upper: Float) -> Float {\r\n        self.maximum(lower).minimum(upper)\r\n    }\r\n\r\n    /// Returns `-1`, `0`, or `1` according to the sign of `value`.\r\n    pub func sign(self: Float) -> Int {\r\n        branch {\r\n            self < 0.0 -> -1\r\n            self > 0.0 -> 1\r\n            _ -> 0\r\n        }\r\n    }\r\n\r\n    /// Compares two floating-point values and returns their ordering.\r\n    pub func compare(self: Float, right: Float) -> Ordering {\r\n        branch {\r\n            self < right -> Ordering.Less\r\n            self > right -> Ordering.Greater\r\n            _ -> Ordering.Equal\r\n        }\r\n    }\r\n\r\n    /// Returns whether `value` lies in the inclusive range from `lower` to `upper`.\r\n    pub func between?(self: Float, lower: Float, upper: Float) -> Bool {\r\n        branch {\r\n            self < lower -> false\r\n            _ -> self <= upper\r\n        }\r\n    }\r\n}\r\n\r\ntest \"floating-point helpers clamp and compare values\" {\r\n    assert((-2.5).absolute() == 2.5)\r\n    assert(4.0.clamp(0.0, 3.0) == 3.0)\r\n    assert(2.0.between?(1.0, 3.0))\r\n    ()\r\n}\r\n"), origin: Embedded }, "core.functions": Module { name: "core.functions", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/functions.fos"), program: Some(Program { documentation: Some("Reusable callable type aliases with explicit ownership behavior."), imports: [], constants: [], records: [], variants: [VariantDecl { span: 152..193, documentation: Some("A callable that borrows a value and decides whether it satisfies a condition."), name: "Predicate", public: true, kind: Union, parameters: ["T"], alternatives: [UnionMember { span: 176..191, ty: Function { parameters: [Named("T", [])], parameter_modes: [Borrow], result: Named("Bool", []), effects: [], suspends: false } }], compositions: [], methods: [] }, VariantDecl { span: 264..310, documentation: Some("A callable that takes ownership of a value and produces no result."), name: "Consumer", public: true, kind: Union, parameters: ["T"], alternatives: [UnionMember { span: 287..308, ty: Function { parameters: [Named("T", [])], parameter_modes: [Consume], result: Unit, effects: [], suspends: false } }], compositions: [], methods: [] }, VariantDecl { span: 385..420, documentation: Some("A callable that produces an owned value without receiving an argument."), name: "Supplier", public: true, kind: Union, parameters: ["T"], alternatives: [UnionMember { span: 408..419, ty: Function { parameters: [], parameter_modes: [], result: Named("T", []), effects: [], suspends: false } }], compositions: [], methods: [] }], functions: [], implementations: [], tests: [] }), source: Some("//! Reusable callable type aliases with explicit ownership behavior.\n\n/// A callable that borrows a value and decides whether it satisfies a condition.\npub type Predicate<T> = func(T) -> Bool\n\n/// A callable that takes ownership of a value and produces no result.\npub type Consumer<T> = func(consume T) -> ()\n\n/// A callable that produces an owned value without receiving an