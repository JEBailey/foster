n: Member { object: Spanned { expression: Name("Option"), span: 4907..4913 }, name: "None" }, span: 4907..4918 } }, span: 4890..4918 }, message: None }, span: 4883..4919 }] } }] }), source: Some("//! Stateful iterators, consumers, and lazy pipeline construction.\n\nimport core.functions\nimport core.option\n\n/// A stateful source that yields one value at a time.\n///\n/// Calling `next` mutates the iterator cursor and returns `None` after exhaustion.\npub type Iterator<T> = {\n    /// Advances this iterator and returns its next value, if one remains.\n    pub func next(self) -> Option<T> [mut self]\n}\n\n/// A value that can create an independent iterator over a read-only view of its elements.\npub type Iterable<T> = {\n    /// Creates an iterator positioned before this iterable's first element.\n    pub func iterator(self) -> Iterator<T>\n}\n\ntype SequenceIterator<T> = & Iterator<T> & {\n    remaining: Sequence<T>\n}\n\nimpl SequenceIterator {\n    /// Advances a sequence-backed iterator unless it has been exhausted.\n    func next<T>(self: SequenceIterator<T>) -> Option<T> {\n        branch {\n            self.remaining.empty?() -> Option.None\n            _ -> self.advance()\n        }\n    }\n\n    /// Removes and returns the current head of a non-empty sequence cursor.\n    func advance<T>(self: SequenceIterator<T>) -> Option<T> {\n        let value = self.remaining.head()\n        self.remaining = self.remaining.rest()\n        Option.Some(value)\n    }\n}\n\nimpl Iterator {\n    /// Consumes a sequence into an independent stateful iterator.\n    pub func from_sequence<T>(values: Sequence<T>) -> Iterator<T> [consume values] {\n        SequenceIterator { remaining: move values }\n    }\n\n    /// Calls `action` once for every remaining element without growing the call stack.\n    pub func for_each<T>(self: Iterator<T>, action: Consumer<T>) -> () [mut self] {\n        loop {\n            branch self.next() {\n                Option.Some(value) -> action(move value)\n                Option.None -> { break }\n            }\n        }\n        ()\n    }\n\n    /// Reduces every remaining element into one owned accumulator, from left to right.\n    pub func fold<T, U>(self: Iterator<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [mut self, consume initial] {\n        let accumulated = move initial\n        loop {\n            branch self.next() {\n                Option.Some(value) -> {\n                    accumulated = combine(move accumulated, move value)\n                    ()\n                }\n                Option.None -> { break }\n            }\n        }\n        accumulated\n    }\n\n    /// Returns the first match, leaving later elements unconsumed.\n    pub func find<T>(self: Iterator<T>, predicate: Predicate<T>) -> Option<T> [mut self] {\n        loop {\n            branch self.next() {\n                Option.Some(value) -> {\n                    return Option.Some(value) if predicate(value)\n                    ()\n                }\n                Option.None -> { break }\n            }\n        }\n        Option.None\n    }\n\n    /// Stops pulling as soon as an element satisfies `predicate`.\n    pub func any?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {\n        loop {\n            branch self.next() {\n                Option.Some(value) -> {\n                    return true if predicate(value)\n                    ()\n                }\n                Option.None -> { break }\n            }\n        }\n        false\n    }\n\n    /// Stops pulling as soon as an element fails `predicate`.\n    pub func all?<T>(self: Iterator<T>, predicate: Predicate<T>) -> Bool [mut self] {\n        loop {\n            branch self.next() {\n                Option.Some(value) -> {\n                    return false if !predicate(value)\n                    ()\n                }\n                Option.None -> { break }\n            }\n        }\n        true\n    }\n\n    /// Counts every remaining element and leaves the iterator exhausted.\n    pub func count<T>(self: Iterator<T>) -> Int [mut self] {\n        let total = 0\n        loop {\n            branch self.next() {\n                Option.Some(_) -> {\n                    total = total + 1\n                    ()\n                }\n                Option.None -> { break }\n            }\n        }\n        total\n    }\n\n    /// Collects the remaining elements into one growing list.\n    pub func collect<T>(self: Iterator<T>) -> List<T> [mut self] {\n        let output = []\n        loop {\n            branch self.next() {\n                Option.Some(value) -> output.push(value)\n                Option.None -> { break }\n            }\n        }\n        output\n    }\n}\n\ntest \"iterator consumers process every remaining value\" {\n    let iterator = [1, 2, 3].iterator()\n    let total = iterator.fold(0, (sum: Int, value: Int) -> sum + value)\n    assert(total == 6)\n}\n\ntest \"iterator predicates stop before pulling later values\" {\n    let source = [1, 2, 3, 4].iterator()\n    assert(source.any?((value: Int) -> value == 2))\n    assert(source.next() == Option.Some(3))\n    assert(!source.all?((value: Int) -> value < 4))\n    assert(source.next() == Option.None)\n}\n"), origin: Embedded }, "std.iter.filter": Module { name: "std.iter.filter", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/iter/filter.fos"), program: Some(Program { documentation: Some("Lazy iterator filtering."), imports: [Import { span: 30..51, path: ["core", "functions"], alias: None }, Import { span: 52..70, path: ["core", "option"], alias: None }, Import { span: 71..86, path: ["std", "iter"], alias: None }], constants: [], records: [RecordDecl { span: 88..184, documentation: None, name: "FilterIterator", public: false, intrinsic: false, parameters: ["T"], compositions: [Named("Iterator", [Named("T", [])])], fields: [RecordField { name: "source", public: false, ty: Named("Iterator", [Named("T"