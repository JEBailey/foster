526..4745, description: "typed paths preserve their resource identity", body: Block { items: [Spanned { value: Bind { name: "path", value: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Path"), span: 4595..4599 }, name: "from" }, span: 4595..4604 }, arguments: [Spanned { expression: String("relative/resource.txt"), span: 4605..4628 }] }, span: 4595..4629 } }, span: 4584..4629 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("path"), span: 4641..4645 }, name: "as_string" }, span: 4641..4655 }, arguments: [] }, span: 4641..4657 }, operator: Equal, right: Spanned { expression: String("relative/resource.txt"), span: 4661..4684 } }, span: 4641..4684 }, message: None }, span: 4634..4685 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("path"), span: 4697..4701 }, name: "resource_id" }, span: 4697..4713 }, arguments: [] }, span: 4697..4715 }, operator: Equal, right: Spanned { expression: String("relative/resource.txt"), span: 4719..4742 } }, span: 4697..4742 }, message: None }, span: 4690..4743 }] } }] }), source: Some("//! Portable path inspection, composition, and normalization.\n\nimport core.option\nimport core.result\nimport std.io\nimport std.resource\n\ntype PathHost = {}\n\nimpl PathHost {\n    /// Joins two host path components.\n    func join(left: String, right: String) -> String = intrinsic(\"io.join\")\n    /// Returns a host path's parent sentinel.\n    func parent(path: String) -> String = intrinsic(\"io.parent\")\n    /// Returns a host path's file-name sentinel.\n    func file_name(path: String) -> String = intrinsic(\"io.file_name\")\n    /// Returns a host path's extension sentinel.\n    func extension(path: String) -> String = intrinsic(\"io.extension\")\n    /// Canonicalizes a host path.\n    func canonicalize(path: String) -> Result<String, IoError> = intrinsic(\"io.canonicalize\")\n}\n\n/// A typed host-filesystem path.\n///\n/// `Path` preserves the host spelling supplied by the caller. Use `canonical` when an absolute,\n/// normalized path is required.\npub type Path = & ResourceIdentifier & {\n    value: String\n}\n\nimpl Path {\n    /// Wraps host path text in a typed path value.\n    pub func from(value: String) -> Path { Path { value } }\n\n    /// Returns the host path text.\n    pub func as_string(self: Path) -> String { self.value.slice(0, self.value.length) }\n\n    /// Returns the stable identifier supplied to the filesystem provider.\n    pub func resource_id(self: Path) -> String { self.as_string() }\n\n    /// Joins this path with another typed path.\n    pub func join(self: Path, right: Path) -> Path {\n        Path.from(PathHost.join(self.value, right.value))\n    }\n\n    /// Joins one textual path component onto this path.\n    pub func child(self: Path, component: String) -> Path {\n        Path.from(PathHost.join(self.value, component))\n    }\n\n    /// Returns this path's parent, or `None` when no parent component exists.\n    pub func parent(self: Path) -> Option<Path> {\n        path_option(PathHost.parent(self.value))\n    }\n\n    /// Returns this path's final component, or `None` when it is absent.\n    pub func file_name(self: Path) -> Option<String> {\n        optional_component(PathHost.file_name(self.value))\n    }\n\n    /// Returns this path's final extension without its separator.\n    pub func extension(self: Path) -> Option<String> {\n        optional_component(PathHost.extension(self.value))\n    }\n\n    /// Resolves this path to an absolute canonical path.\n    pub func canonical(self: Path) -> Result<Path, IoError> {\n        path_result(PathHost.canonicalize(self.value))\n    }\n}\n\n/// Joins two platform path components.\npub func join(left: String, right: String) -> String { PathHost.join(left, right) }\n\n/// Joins a list of platform path components, returning an empty string for an empty list.\npub func join_all(parts: List<String>) -> String {\n    branch {\n        parts.empty? -> \"\"\n        _ -> join_remaining(parts.rest, parts.head)\n    }\n}\n\n/// Joins remaining path components onto the accumulated path.\nfunc join_remaining(parts: List<String>, path: String) -> String {\n    branch {\n        parts.empty? -> path\n        _ -> join_remaining(parts.rest, join(path, parts.head))\n    }\n}\n\n/// Returns the parent path, or `None` when no parent component exists.\npub func parent(path: String) -> Option<String> { optional_component(PathHost.parent(path)) }\n/// Returns the final path component, or `None` when it is absent.\npub func file_name(path: String) -> Option<String> { optional_component(PathHost.file_name(path)) }\n/// Returns the final extension without its separator, or `None` when it is absent.\npub func extension(path: String) -> Option<String> { optional_component(PathHost.extension(path)) }\n\n/// Converts the host boundary's empty sentinel into an option.\nfunc optional_component(value: String) -> Option<String> {\n    branch {\n        value.empty? -> Option.None\n        _ -> Option.Some(value)\n    }\n}\n\n/// Converts the host boundary's empty sentinel into an optional typed path.\nfunc path_option(value: String) -> Option<Path> {\n    branch {\n        value.empty? -> Option.None\n        _ -> Option.Some(Path.from(move value))\n    }\n}\n\n/// Converts a successful host path result into a typed path.\nfunc path_result(outcome: Result<String, IoError>) -> Result<Path, IoError> [consume outcome] {\n    branch move outcome {\n        Result.Error(error) -> Result.Error(error)\n        Result.Ok(value) -> Result.Ok(Path.from(move value))\n    }\n}\n\n/// Resolves `path` to an absolute canonical path.\npub func canonicalize(path: String) -> Result<String, IoError> { PathHost.canonicalize(path) }\n\ntest \"typed paths preserve their resource identity\" {\n    let path = Path.from(\"relative/resource.txt\")\n    assert(path.as_string() == \"relative/resource.txt\")\n    assert(path.resource_id() == \"relative/resource.txt\")\n}\n"), origin: Embedded }, "std.process": Module { name: "std.process", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/process.fos"), program: Some(Program { documentation: Some("Process entry values supplied by a Foster command host."), imports: [Import { span: 61..77, path: ["core", "list"], alias: None }], constants: [], records: [RecordDecl { span: 287..367, documentation: Some("The command line passed to `main`.\n\n`executable` is the path or command used to invoke the program. `values` contains every\nfollowing argument in order and does not repeat the executable name."), name: "Arguments", public: true, intrinsic: false, parameters: [], compositions: [], fields: [RecordField { name: "executable", public: true, ty: Named("String", []) }, RecordField { name: "values", public: true, ty: Named("List", [Named("String", [])]) }], methods: [] }], variants: [], functions: [], implementations: [], tests: [] }), source: Some("//! Process entry values supplied by a Foster command host.\n\nimport core.list\n\n/// The command line passed to `main`.\n///\n/// `executable` is the path or command used to invoke the program. `values` contains every\n/// following argument in order and does not repeat the executable name.\npub type Arguments = {\n    pub executable: String\n    pub values: List<String>\n}\n"), origin: Embedded }, "std.random": Module { name: "std.random", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/random.fos"), program: Some(Program { documentation: Some("Random-source contracts, operating-system randomness, and unbiased uniform integer operations."), imports: [Import { span: 100..117, path: ["core", "bytes"], alias: None }, Import { span: 118..136, path: ["core", "result"], alias: None }], 