er(1), span: 5565..5566 } }, span: 5564..5566 }] }, span: 5539..5567 }, name: "error?" }, span: 5539..5574 }, arguments: [] }, span: 5539..5576 }, message: None }, span: 5532..5577 }, Spanned { value: Expr(Spanned { expression: Branch { subject: Some(Spanned { expression: Call { callee: Spanned { expression: Name("sample_with"), span: 5589..5600 }, arguments: [Spanned { expression: Name("source"), span: 5601..5607 }, Spanned { expression: List([Spanned { expression: Integer(1), span: 5610..5611 }, Spanned { expression: Integer(2), span: 5613..5614 }]), span: 5609..5615 }, Spanned { expression: Integer(0), span: 5617..5618 }] }, span: 5589..5619 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 5643..5644 }] }, span: 5630..5645 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 5670..5675 }, message: None }, span: 5663..5676 }, Spanned { value: Expr(Spanned { expression: Unit, span: 5689..5691 }), span: 5689..5691 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("values"), span: 5720..5726 }] }, span: 5710..5727 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Member { object: Spanned { expression: Name("values"), span: 5752..5758 }, name: "empty?" }, span: 5752..5765 }, message: None }, span: 5745..5766 }, Spanned { value: Expr(Spanned { expression: Unit, span: 5779..5781 }), span: 5779..5781 }] } }] }, span: 5582..5797 }), span: 5582..5797 }, Spanned { value: Expr(Spanned { expression: Unit, span: 5802..5804 }), span: 5802..5804 }] } }] }), source: Some("//! Random choice, shuffling, and sampling over owned Foster lists.\n\nimport core.list\nimport core.option\nimport core.result\nimport std.random\nimport std.random.generator\n\n/// Chooses one list element with `source`, returning `None` for an empty list.\npub func choose_with<T>(source: RandomSource, values: List<T>) -> Result<Option<T>, RandomError> [mut source] {\n    return Result.Ok(Option.None) if values.empty?\n    let index = try random::below_with(source, values.length)\n    Result.Ok(values.get(index))\n}\n\n/// Chooses one list element using operating-system randomness.\npub func choose<T>(values: List<T>) -> Result<Option<T>, RandomError> {\n    choose_with(SystemRandom.new(), values)\n}\n\n/// Returns a uniformly shuffled list using `source`.\npub func shuffle_with<T>(source: RandomSource, values: List<T>) -> Result<List<T>, RandomError> [mut source, consume values] {\n    shuffle_remaining(source, move values, [])\n}\n\n/// Returns a uniformly shuffled list using operating-system randomness.\npub func shuffle<T>(values: List<T>) -> Result<List<T>, RandomError> [consume values] {\n    shuffle_with(SystemRandom.new(), move values)\n}\n\n/// Selects `count` elements without replacement using `source`.\npub func sample_with<T>(source: RandomSource, values: List<T>, count: Int) -> Result<List<T>, RandomError> [mut source, consume values] {\n    return failure(\"sample\", count, \"sample count must not be negative\") if count < 0\n    return failure(\"sample\", count, \"sample count must not exceed the list length\") if count > values.length\n    sample_remaining(source, move values, count, [])\n}\n\n/// Selects `count` elements without replacement using operating-system randomness.\npub func sample<T>(values: List<T>, count: Int) -> Result<List<T>, RandomError> [consume values] {\n    sample_with(SystemRandom.new(), move values, count)\n}\n\n/// One extracted list value and the remaining owned values.\ntype Selection<T> = {\n    value: T\n    remaining: List<T>\n}\n\n/// Repeatedly extracts a uniformly chosen value into the shuffled result.\nfunc shuffle_remaining<T>(source: RandomSource, values: List<T>, output: List<T>) -> Result<List<T>, RandomError> [mut source, consume values, consume output] {\n    return Result.Ok(move output) if values.empty?\n    let index = try random::below_with(source, values.length)\n    let selected = select_at(move values, index, [])\n    shuffle_remaining(source, move selected.remaining, (move output).append(move selected.value))\n}\n\n/// Extracts at most the requested number of uniformly chosen values.\nfunc sample_remaining<T>(source: RandomSource, values: List<T>, count: Int, output: List<T>) -> Result<List<T>, RandomError> [mut source, consume values, consume output] {\n    return Result.Ok(move output) if count == 0\n    let index = try random::below_with(source, values.length)\n    let selected = select_at(move values, index, [])\n    sample_remaining(source, move selected.remaining, count - 1, (move output).append(move selected.value))\n}\n\n/// Removes one valid index while rebuilding the unselected list in original order.\nfunc select_at<T>(values: List<T>, index: Int, prefix: List<T>) -> Selection<T> [consume values, consume prefix] {\n    return Selection {\n        value: move values.head\n        remaining: (move prefix).concat(move values.rest)\n    } if index == 0\n    select_at(move values.rest, index - 1, (move prefix).append(move values.head))\n}\n\n/// Constructs a typed sequence-randomization error.\nfunc failure<T>(operation: String, value: Int, message: String) -> Result<T, RandomError> {\n    Result.Error(RandomError { operation, value, message })\n}\n\n/// Returns a typed empty integer list for generic choice tests.\nfunc empty_integers() -> List<Int> { [] }\n\ntest \"choice reports empty input and returns a present list member\" {\n    let source = LehmerRandom.from_seed(42)\n    branch choose_with(source, [10, 20, 30]) {\n        Result.Error(_) -> {\n            assert(false, \"choice failed\")\n            ()\n        }\n        Result.Ok(choice) -> branch choice {\n            Option.None -> {\n                assert(false, \"nonempty choice returned none\")\n                ()\n            }\n            Option.Some(value) -> {\n                assert(value == 10 || value == 20 || value == 30)\n                ()\n            }\n        }\n    }\n    branch choose_with(source, empty_integers()) {\n        Result.Error(_) -> {\n            assert(false, \"empty choice failed\")\n            ()\n        }\n        Result.Ok(choice) -> branch choice {\n            Option.None -> ()\n            Option.Some(_) -> {\n                assert(false, \"empty choice did not return none\")\n                ()\n            }\n        }\n    }\n}\n\ntest \"shuffle and sample preserve membership without replacement\" {\n    let source = LehmerRandom.from_seed(7)\n    branch shuffle_with(source, [1, 2, 3, 4]) {\n        Result.Error(_) -> {\n            assert(false, \"shuffle failed\")\n            ()\n        }\n        Result.Ok(values) -> {\n            assert(values.length == 4)\n            assert(values.contains?(1) && values.contains?(2) && values.contains?(3) && values.contains?(4))\n            ()\n        }\n    }\n    branch sample_with(source, [1, 2, 3, 4], 3) {\n        Result.Error(_) -> {\n            assert(false, \"sample failed\")\n            ()\n        }\n        Result.Ok(values) -> {\n            assert(values.length == 3)\n            assert(values[0] != values[1] && values[0] != values[2] && values[1] != values[2])\n            ()\n        }\n    }\n    assert(sample_with(source, [1], 2).error?())\n    assert(sample_with(source, [1], -1).error?())\n    branch sample_with(source, [1, 2], 0) {\n        Result.Error(_) -> {\n            assert(false)\n            ()\n        }\n        Result.Ok(values) -> {\n            assert(values.empty?)\n            ()\n        }\n    }\n    ()\n}\n"), origin: Embedded }, "std.resource": Module { name: "std.resource", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/resource.fos"), program: Some(Program { documentation: Some("Typed resource identifiers and independent compile-