not for\n/// cryptographic or adversarial use.\npub type LehmerRandom = & SeedableRandom & SplittableRandom & {\n    state: Int\n}\n\nimpl LehmerRandom {\n    /// Constructs the portable generator from any integer seed.\n    pub func from_seed(seed: Int) -> LehmerRandom {\n        LehmerRandom { state: normalized_seed(seed) }\n    }\n\n    /// Returns the next portable zero-based generator value.\n    pub func next(self: LehmerRandom) -> Result<Int, RandomError> [mut self.state] {\n        self.state = lehmer_step(self.state)\n        Result.Ok(self.state - 1)\n    }\n\n    /// Returns the inclusive maximum portable generator value.\n    pub func maximum(self: LehmerRandom) -> Int { LEHMER_MAXIMUM }\n\n    /// Resets the portable sequence from any integer seed.\n    pub func reseed(self: LehmerRandom, seed: Int) -> () [mut self.state] {\n        self.state = normalized_seed(seed)\n        ()\n    }\n\n    /// Derives another owned portable stream while advancing this generator.\n    pub func split(self: LehmerRandom) -> RandomSource [mut self.state] {\n        self.state = lehmer_step(self.state)\n        LehmerRandom.from_seed(self.state + 104729)\n    }\n}\n\n/// The standard fast deterministic generator.\n///\n/// Its algorithm may change between Foster releases. Use `LehmerRandom` when a serialized seed\n/// must reproduce the same sequence across releases.\npub type FastRandom = & SeedableRandom & SplittableRandom & {\n    state: Int\n}\n\nimpl FastRandom {\n    /// Constructs the default fast generator from a deterministic seed.\n    pub func from_seed(seed: Int) -> FastRandom {\n        FastRandom { state: normalized_seed(seed) }\n    }\n\n    /// Seeds the default fast generator from operating-system randomness.\n    pub func from_system() -> Result<FastRandom, RandomError> {\n        let seed = try SystemRandom.new().next()\n        Result.Ok(FastRandom.from_seed(seed))\n    }\n\n    /// Returns the next default-generator value.\n    pub func next(self: FastRandom) -> Result<Int, RandomError> [mut self.state] {\n        self.state = lehmer_step(self.state)\n        Result.Ok(self.state - 1)\n    }\n\n    /// Returns the inclusive maximum default-generator value.\n    pub func maximum(self: FastRandom) -> Int { LEHMER_MAXIMUM }\n\n    /// Resets the default generator from any integer seed.\n    pub func reseed(self: FastRandom, seed: Int) -> () [mut self.state] {\n        self.state = normalized_seed(seed)\n        ()\n    }\n\n    /// Derives another owned default stream while advancing this generator.\n    pub func split(self: FastRandom) -> RandomSource [mut self.state] {\n        self.state = lehmer_step(self.state)\n        FastRandom.from_seed(self.state + 104729)\n    }\n}\n\n/// Advances one Lehmer state without overflowing Foster's checked `Int` arithmetic.\nfunc lehmer_step(state: Int) -> Int {\n    (state * LEHMER_MULTIPLIER).modulo(LEHMER_MODULUS)\n}\n\n/// Maps every signed Foster integer into the valid nonzero Lehmer state range.\nfunc normalized_seed(seed: Int) -> Int {\n    let remainder = seed.modulo(LEHMER_MODULUS)\n    let normalized = branch { remainder < 0 -> remainder + LEHMER_MODULUS _ -> remainder }\n    branch { normalized == 0 -> 1 _ -> normalized }\n}\n\n/// Extracts a successful deterministic value for tests.\nfunc generated(outcome: Result<Int, RandomError>) -> Int {\n    branch outcome { Result.Ok(value) -> value Result.Error(_) -> -1 }\n}\n\n/// Exercises the seedable contract and returns its first reset value.\nfunc seeded_value(source: SeedableRandom, seed: Int) -> Int [mut source] {\n    source.reseed(seed)\n    generated(source.next())\n}\n\n/// Exercises the splittable contract and returns one value from the child stream.\nfunc split_value(source: SplittableRandom) -> Int [mut source] {\n    let child = source.split()\n    generated(child.next())\n}\n\ntest \"named portable generators reproduce their sequence and can be reseeded\" {\n    let left = LehmerRandom.from_seed(42)\n    let right = LehmerRandom.from_seed(42)\n    assert(generated(left.next()) == 2027381)\n    assert(generated(right.next()) == 2027381)\n    assert(generated(left.next()) == 1226992406)\n    assert(generated(right.next()) == 1226992406)\n    left.reseed(42)\n    right.reseed(42)\n    assert(generated(left.next()) == generated(right.next()))\n    assert(generated(left.next()) >= 0)\n    assert(generated(LehmerRandom.from_seed(0).next()) == 48270)\n    assert(generated(LehmerRandom.from_seed(-1).next()) == 2147435375)\n    assert(left.maximum() == LEHMER_MAXIMUM)\n    ()\n}\n\ntest \"fast generators satisfy seeded and splittable contracts\" {\n    let parent_value = generated(FastRandom.from_seed(7).next())\n    let child_value = split_value(FastRandom.from_seed(7))\n    assert(parent_value >= 0 && parent_value <= LEHMER_MAXIMUM)\n    assert(child_value >= 0 && child_value <= LEHMER_MAXIMUM)\n    assert(seeded_value(FastRandom.from_seed(99), 7) == parent_value)\n    branch FastRandom.from_system() {\n        Result.Error(_) -> {\n            assert(false, \"system seeding failed\")\n            ()\n        }\n        Result.Ok(source) -> {\n            let value = generated(source.next())\n            assert(value >= 0 && value <= LEHMER_MAXIMUM)\n            ()\n        }\n    }\n    ()\n}\n"), origin: Embedded }, "std.random.secure": Module { name: "std.random.secure", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/random/secure.fos"), program: Some(Program { documentation: Some("Security-oriented entropy, random bytes, and token generation."), imports: [Import { span: 68..85, path: ["core", "bytes"], alias: None }, Import { span: 86..104, path: ["core", "result"], alias: None }, Import { span: 105..123, path: ["core", "string"], alias: None }, Import { span: 124..141, path: ["std", "random"], alias: None }], constants: [], records: [RecordDecl { span: 203..375, documentation: Some("A fallible source of bytes drawn from external entropy."), name: "EntropyS