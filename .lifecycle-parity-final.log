4..1485 } }, span: 1466..1485 }, message: None }, span: 1459..1486 }, Spanned { value: Expr(Spanned { expression: Unit, span: 1491..1493 }), span: 1491..1493 }] } }] }), source: Some("//! Persistent last-in, first-out stacks backed by Foster lists.\n\nimport std.collections\nimport std.iter\nimport core.option\n\n/// A last-in, first-out collection.\npub type Stack<T> = & Collection<T> & {\n    values: List<T>\n}\n\nimpl Stack {\n    /// Creates an empty stack.\n    pub func empty<T>() -> Stack<T> {\n        Stack { values: [] }\n    }\n\n    /// Returns the number of stacked values.\n    pub func length<T>(self: Stack<T>) -> Int {\n        self.values.length\n    }\n\n    /// Returns whether the stack contains no values.\n    pub func empty?<T>(self: Stack<T>) -> Bool {\n        self.values.empty?\n    }\n\n    /// Creates an independent iterator from top to bottom.\n    pub func iterator<T>(self: Stack<T>) -> Iterator<T> {\n        reverse(self.values, []).iterator()\n    }\n\n    /// Returns a stack with `value` placed on top.\n    pub func push<T>(self: Stack<T>, value: T) -> Stack<T> [consume self, consume value] {\n        Stack { values: self.values.append(value) }\n    }\n\n    /// Removes the top value and returns the remaining stack.\n    pub func pop<T>(self: Stack<T>) -> Option<StackItem<T>> [consume self] {\n        branch {\n            self.values.empty? -> Option.None\n            _ -> pop_values(move self.values, [])\n        }\n    }\n}\n\n/// The result of removing one value from a stack.\npub type StackItem<T> = {\n    pub value: T\n    pub remaining: Stack<T>\n}\n\ntest \"stacks retain pushed values\" {\n    let stack = Stack { values: [1, 2] }\n    assert(stack.length() == 2)\n    ()\n}\n\n/// Walks to the final stored value while rebuilding the remaining prefix.\nfunc pop_values<T>(remaining: List<T>, prefix: List<T>) -> Option<StackItem<T>> [consume remaining, consume prefix] {\n    branch {\n        remaining.rest.empty? -> Option.Some(StackItem { value: remaining.head, remaining: Stack { values: prefix } })\n        _ -> pop_values(remaining.rest, prefix.append(remaining.head))\n    }\n}\n\n/// Reverses stored values into iterator order.\nfunc reverse<T>(remaining: List<T>, result: List<T>) -> List<T> [consume result] {\n    branch {\n        remaining.empty? -> result\n        _ -> reverse(remaining.rest, move result).append(remaining.head)\n    }\n}\n"), origin: Embedded }, "std.env": Module { name: "std.env", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/env.fos"), program: Some(Program { documentation: Some("Access to host environment variables through typed results."), imports: [Import { span: 65..83, path: ["core", "result"], alias: None }, Import { span: 84..97, path: ["std", "io"], alias: None }], constants: [], records: [RecordDecl { span: 99..116, documentation: None, name: "EnvHost", public: false, intrinsic: false, parameters: [], compositions: [], fields: [], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 189..276, documentation: Some("Returns the host process working directory."), name: "EnvHost.current_directory", owner: Some("EnvHost"), receiver: false, public: false, intrinsic: Some("io.current_directory"), type_parameters: [], groups: [], parameters: [], return_type: Some(Named("Result", [Named("String", []), Named("IoError", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [] } }, Function { body_is_recovery_stub: false, span: 333..420, documentation: Some("Returns the process's current working directory."), name: "current_directory", owner: None, receiver: false, public: true, intrinsic: None, type_parameters: [], groups: [], parameters: [], return_type: Some(Named("Result", [Named("String", []), Named("IoError", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("EnvHost"), span: 391..398 }, name: "current_directory" }, span: 391..416 }, arguments: [] }, span: 391..418 }), span: 391..418 }] } }], implementations: [Implementation { span: 118..278, owner_span: 123..130, owner: "EnvHost", parameters: [] }], tests: [] }), source: Some("//! Access to host environment variables through typed results.\n\nimport core.result\nimport std.io\n\ntype EnvHost = {}\n\nimpl EnvHost {\n    /// Returns the host process working directory.\n    func current_directory() -> Result<String, IoError> = intrinsic(\"io.current_directory\")\n}\n\n/// Returns the process's current working directory.\npub func current_directory() -> Result<String, IoError> { EnvHost.current_directory() }\n"), origin: Embedded }, "std.fs": Module { name: "std.fs", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/fs.fos"), program: Some(Program { documentation: Some("Typed whole-file and directory operations."), imports: [Import { span: 48..66, path: ["core", "result"], alias: None }, Import { span: 67..85, path: ["core", "string"], alias: None }, Import { span: 86..103, path: ["core", "bytes"], alias: None }, Import { span: 104..117, path: ["std", "io"], alias: None }, Import { span: 118..142, path: ["std", "path"], alias: Some("paths") }, Import { span: 143..162, path: ["std", "resource"], alias: None }], constants: [], records: [RecordDecl { span: 164..180, documentation: None, name: "FsHost", public: false, intrinsic: false, parameters: [], compositions: [], fields: [], methods: [] }, RecordDecl { span: 3574..3812, documentation: Some("A located file with whole-resource and positioned binary capabilities.\n\nConstructing a `File` does not touch the filesystem. Reads and writes can still fail if the\nlocation is unavailable, unsupported by the host provider, or its permissions change."), name: "File", public: true, intrinsic: false, parameters: [], co