ion: Closure { captures: [], parameters: [Parameter { span: 3037..3042, name: "value", ty: Some(Named("Int", [])), type_span: Some(3044..3047) }], effects: [], suspends: false, body: Expression(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 3052..3057 }, operator: Add, right: Spanned { expression: Integer(2), span: 3060..3061 } }, span: 3052..3061 }) }, span: 3036..3061 }] }, span: 3008..3062 } }, span: 2995..3062 }, Spanned { value: Bind { name: "valid", value: Spanned { expression: Branch { subject: Some(Spanned { expression: Name("mapped"), span: 3086..3092 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 3113..3118 }] }, span: 3103..3119 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 3123..3128 }, operator: Equal, right: Spanned { expression: Integer(22), span: 3132..3134 } }, span: 3123..3134 }), span: 3123..3134 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 3156..3157 }] }, span: 3143..3158 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(false), span: 3162..3167 }), span: 3162..3167 }] } }] }, span: 3079..3173 } }, span: 3067..3173 }, Spanned { value: Assert { condition: Spanned { expression: Name("valid"), span: 3185..3190 }, message: None }, span: 3178..3191 }] } }] }), source: Some("//! Explicit success and failure values with composable transformations.\n\n/// A value that is either a successful `Ok(T)` or a failed `Error(E)`.\npub enum Result<T, E> = Ok(T)\n    | Error(E)\n\nimpl Result {\n    /// Applies `transform` to a successful value and preserves an error.\n    pub func map<T, E, U>(self: Result<T, E>, transform: func(T) -> U) -> Result<U, E> {\n        branch self {\n            Result.Ok(value) -> Result.Ok(transform(value))\n            Result.Error(error) -> Result.Error(error)\n        }\n    }\n\n    /// Applies `transform` to an error and preserves a successful value.\n    pub func map_error<T, E, F>(self: Result<T, E>, transform: func(E) -> F) -> Result<T, F> {\n        branch self {\n            Result.Ok(value) -> Result.Ok(value)\n            Result.Error(error) -> Result.Error(transform(error))\n        }\n    }\n\n    /// Applies a result-producing transform to a successful value and flattens the result.\n    pub func and_then<T, E, U>(self: Result<T, E>, transform: func(T) -> Result<U, E>) -> Result<U, E> {\n        branch self {\n            Result.Ok(value) -> transform(value)\n            Result.Error(error) -> Result.Error(error)\n        }\n    }\n\n    /// Returns whether the result is successful.\n    pub func success?<T, E>(self: Result<T, E>) -> Bool {\n        branch self {\n            Result.Ok(_) -> true\n            Result.Error(_) -> false\n        }\n    }\n\n    /// Returns whether the result contains an error.\n    pub func error?<T, E>(self: Result<T, E>) -> Bool {\n        branch self {\n            Result.Ok(_) -> false\n            Result.Error(_) -> true\n        }\n    }\n\n    /// Returns the successful value, or a fallback when the result contains an error.\n    pub func unwrap_or<T, E>(self: Result<T, E>, fallback: T) -> T {\n        branch self {\n            Result.Ok(value) -> value\n            Result.Error(_) -> fallback\n        }\n    }\n\n    /// Returns the successful value, or computes a fallback from the error.\n    pub func unwrap_or_else<T, E>(self: Result<T, E>, fallback: func(E) -> T) -> T {\n        branch self {\n            Result.Ok(value) -> value\n            Result.Error(error) -> fallback(error)\n        }\n    }\n\n    /// Preserves a successful value, or recovers by transforming the error into another result.\n    pub func or_else<T, E, F>(self: Result<T, E>, recover: func(E) -> Result<T, F>) -> Result<T, F> {\n        branch self {\n            Result.Ok(value) -> Result.Ok(value)\n            Result.Error(error) -> recover(error)\n        }\n    }\n\n    /// Removes one layer from a nested successful result.\n    pub func flatten<T, E>(self: Result<Result<T, E>, E>) -> Result<T, E> {\n        branch self {\n            Result.Ok(value) -> value\n            Result.Error(error) -> Result.Error(error)\n        }\n    }\n}\n\n/// Supplies a concrete error type for the successful-result test case.\nfunc successful_test_value() -> Result<Int, String> {\n    Result.Ok(20)\n}\n\ntest \"result mapping transforms successful values\" {\n    let mapped = successful_test_value().map((value: Int) -> value + 2)\n    let valid = branch mapped {\n        Result.Ok(value) -> value == 22\n        Result.Error(_) -> false\n    }\n    assert(valid)\n}\n"), origin: Embedded }, "core.string": Module { name: "core.string", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/string.fos"), program: Some(Program { documentation: Some("Immutable UTF-8 text, byte-range scans, and amortized text construction."), imports: [Import { span: 78..94, path: ["core", "byte"], alias: None }, Import { span: 95..112, path: ["core", "bytes"], alias: None }, Import { span: 113..137, path: ["core", "bytes", "buffer"], alias: None }, Import { span: 138..160, path: ["core", "code_point"], alias: None }, Import { span: 161..182, path: ["core", "functions"], alias: None }, Import { span: 183..199, path: ["core", "list"], alias: None }, Import { span: 200..218, path: ["core", "option"], alias: None }, Import { span: 219..237, path: ["core", "result"], alias: None }], constants: [], records: [RecordDecl { span: 384..422, documentation: Some("Immutable Unicode text stored as validated UTF-8 bytes.\nPrivate storage preserves the validity invariant across every construction path."), name: "String", public: true, intrinsic: false, parameters: [], compositions: [], fields: [RecordField { n