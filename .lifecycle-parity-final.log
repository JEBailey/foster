 operator: Equal, right: Spanned { expression: Integer(7), span: 7358..7359 } }, span: 7349..7359 }, Spanned { expression: String("copy returned the wrong byte count"), span: 7361..7397 }] }, span: 7333..7398 }), span: 7333..7398 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 7420..7421 }] }, span: 7407..7422 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Name("io_test_require"), span: 7426..7441 }, arguments: [Spanned { expression: Bool(false), span: 7442..7447 }, Spanned { expression: String("copy returned an error"), span: 7449..7473 }] }, span: 7426..7474 }), span: 7426..7474 }] } }] }, span: 7257..7480 }), span: 7257..7480 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Member { object: Spanned { expression: Name("writer"), span: 7492..7498 }, name: "contents" }, span: 7492..7507 }, name: "hex" }, span: 7492..7511 }, arguments: [] }, span: 7492..7513 }, operator: Equal, right: Spanned { expression: String("00010203040506"), span: 7517..7533 } }, span: 7492..7533 }, message: None }, span: 7485..7534 }] } }] }), source: Some("//! Generic byte and text stream contracts with complete read/write helpers.\n\nimport core.bytes.buffer as byte_buffer\nimport core.bytes\nimport core.result\n\n/// Describes a failed host I/O operation.\npub type IoError = {\n    pub operation: String\n    pub path: String\n    pub message: String\n}\n\n/// A stateful source of binary data.\n///\n/// `read` returns at most `maximum` bytes. Empty bytes indicate clean end-of-stream.\n/// A successful read of a non-empty stream must return at least one byte.\npub type Reader<E> = {\n    /// Reads up to `maximum` bytes, returning empty bytes at end-of-stream.\n    pub func read(self, maximum: Int) -> Result<Bytes, E> [mut self]\n}\n\n/// A stateful destination for binary data.\n///\n/// `write` may accept fewer bytes than supplied and reports the accepted count. A successful write\n/// of non-empty bytes must accept at least one byte. `flush` makes buffered output visible to the\n/// destination.\npub type Writer<E> = {\n    /// Writes a non-empty prefix of `contents` and returns the accepted byte count.\n    pub func write(self, contents: Bytes) -> Result<Int, E> [mut self]\n    /// Makes buffered output visible to the destination.\n    pub func flush(self) -> Result<(), E> [mut self]\n}\n\n/// A stateful source which decodes text while preserving character boundaries between reads.\n/// Empty text indicates clean end-of-stream.\npub type TextReader<E> = {\n    /// Reads decoded text without splitting a character boundary.\n    pub func read_text(self, maximum: Int) -> Result<String, E> [mut self]\n}\n\n/// A stateful text destination.\n///\n/// `write_text` accepts the complete string or returns an error. `flush` makes buffered text visible\n/// to the destination.\npub type TextWriter<E> = {\n    /// Writes the complete text value or returns an error.\n    pub func write_text(self, text: String) -> Result<(), E> [mut self]\n    /// Makes buffered text visible to the destination.\n    pub func flush(self) -> Result<(), E> [mut self]\n}\n\n/// A bidirectional binary stream combining the `Reader<E>` and `Writer<E>` contracts.\npub type Duplex<E> = & Reader<E> & Writer<E> & {}\n\n/// Reads a stream through EOF into compact immutable bytes.\npub func read_all<E>(reader: Reader<E>) -> Result<Bytes, E> [mut reader] {\n    let buffer = ByteBuffer.empty()\n    read_remaining(reader, move buffer)\n}\n\n/// Writes every byte, retrying successful partial writes, and then flushes the destination.\npub func write_all<E>(writer: Writer<E>, contents: Bytes) -> Result<(), E> [mut writer] {\n    branch {\n        contents.empty? -> writer.flush()\n        _ -> continue_write(writer, contents, writer.write(contents))\n    }\n}\n\n/// Copies bytes through EOF and returns the number written.\npub func copy<E>(reader: Reader<E>, writer: Writer<E>) -> Result<Int, E> [mut reader, mut writer] {\n    copy_remaining(reader, writer, 0)\n}\n\n/// Continues accumulating chunks until the reader reports EOF.\nfunc read_remaining<E>(reader: Reader<E>, buffer: ByteBuffer) -> Result<Bytes, E> [mut reader, reshape buffer, consume buffer] {\n    let chunk = try reader.read(8192)\n    branch {\n        chunk.empty? -> Result.Ok((move buffer).freeze())\n        _ -> append_and_read(reader, move buffer, chunk)\n    }\n}\n\n/// Appends one successful read before requesting another chunk.\nfunc append_and_read<E>(reader: Reader<E>, buffer: ByteBuffer, chunk: Bytes) -> Result<Bytes, E> [mut reader, reshape buffer, consume buffer] {\n    buffer.extend(chunk)\n    read_remaining(reader, move buffer)\n}\n\n/// Handles one partial write and retries the unwritten suffix.\nfunc continue_write<E>(writer: Writer<E>, contents: Bytes, outcome: Result<Int, E>) -> Result<(), E> [mut writer, consume outcome] {\n    let written = try move outcome\n    write_all(writer, contents.slice(written, contents.length))\n}\n\n/// Continues copying after requesting one chunk.\nfunc copy_remaining<E>(reader: Reader<E>, writer: Writer<E>, total: Int) -> Result<Int, E> [mut reader, mut writer] {\n    let chunk = try reader.read(8192)\n    branch {\n        chunk.empty? -> finish_copy(total, writer.flush())\n        _ -> write_copy_chunk(reader, writer, chunk, total, writer.write(chunk))\n    }\n}\n\n/// Handles a partial chunk write without flushing between input chunks.\nfunc write_copy_chunk<E>(reader: Reader<E>, writer: Writer<E>, chunk: Bytes, total: Int, outcome: Result<Int, E>) -> Result<Int, E> [mut reader, mut writer, consume outcome] {\n    let written = try move outcome\n    branch {\n        written == chunk.length -> copy_remaining(reader, writer, total + written)\n        _ -> write_copy_chunk(reader, writer, chunk.slice(written, chunk.length), total + written, writer.write(chunk.slice(written, chunk.length)))\n    }\n}\n\n/// Converts the final flush result into the completed byte count.\nfunc finish_copy<E>(total: Int, outcome: Result<(), E>) -> Result<Int, E> [consume outcome] {\n    try move outcome\n    Result.Ok(total)\n}\n\ntype IoTestError = { message: String }\n\ntype IoTestReader = & Reader<IoTestError> & {\n    remaining: Bytes\n    chunk_size: Int\n}\n\ntype IoTestWriter = & Writer<IoTestError> & {\n    contents: Bytes\n    chunk_size: Int\n}\n\nimpl IoTestReader {\n    /// Reads a bounded chunk for the generic stream contract test.\n    func read(self: IoTestReader, maximum: Int) -> Result<Bytes, IoTestError> [mut self.remaining, read self.chunk_size] {\n        let limit = branch { maximum < self.chunk_size -> maximum _ -> self.chunk_size }\n        let amount = branch { limit < self.remaining.length -> limit _ -> self.remaining.length }\n        let chunk = self.remaining.slice(0, amount)\n        self.remaining = self.remaining.slice(amount, self.remaining.length)\n        Result.Ok(chunk)\n    }\n}\n\nimpl IoTestWriter {\n    /// Accepts a bounded chunk for the generic stream contract test.\n    func write(self: IoTestWriter, contents: Bytes) -> Result<Int, IoTestError> [mut self.contents, read self.chunk_size] {\n        let amount = branch { self.chunk_size < contents.length -> self.chunk_size _ -> contents.length }\n        self.contents = self.contents.concat(contents.slice(0, amount))\n        Result.Ok(amount)\n    }\n\n    /// Completes a test writer flush.\n    func flush(self: IoTestWriter) -> Result<(), IoTestError> {\n        Result.Ok(())\n    }\n}\n\n/// Extracts valid hexadecimal bytes for stream fixtures.\nfunc io_test_bytes(outcome: Result<Bytes, bytes::HexError>) -> Bytes {\n    branch outcome {\n        Result.Ok(contents) -> contents\n        Result.Error(_) -> Bytes.empty()\n    }\n}\n\n/// Asserts one stream-test condition while keeping branch result types uniform.\nfunc io_test_require(condition: Bool, message: String) -> () {\n    assert(condition, message)\n    ()\n}\n\ntest \"generic streams handle partial IO and EOF\" {\n    let all_reader = IoTestReader { remaining: io_test_bytes(Bytes.from_hex(\"00010203040506\")), chunk_size: 2 }\n    branch read_all(all_reader) {\n        Result.Ok(contents) -> io_test_require(contents.hex() == \"00010203040506\", \"read_all changed stream contents\")\n        Result.Error(_) -> io_test_require(false, \"read_all returned an error\")\n    }\n\n    let copy_reader = IoTestReader { remaining: io_test_bytes(Bytes.from_hex(\"00010203040506\")), chunk_size: 2 }\n    let writer = IoTestWriter { contents: Bytes.empty(), chunk_size: 3 }\n    branch copy_remaining(copy_reader, writer, 0) {\n        Result.Ok(count) -> io_test_require(count == 7, \"copy returned the wrong byte count\")\n        Result.Error(_) -> io_test_require(false, \"copy returned an error\")\n    }\n    assert(writer.contents.hex() == \"00010203040506\")\n}\n"), origin: Embedded }, "std.iter": Module { name: "std.iter", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/iter.fos"), program: Some(Program { documentation: Some("Stateful iterators, consumers, and lazy pipeline construction."), imports: [Import { span: 68..89, path: ["core", "functions"], alias: None }, Import { span: 90..108, path: ["core", "option"], alias: None }], constants: [], records: [RecordDecl { span: 253..402, documentation: Some("A stateful source that yields one value at a time.\n\nCalling `next` mutates the iterator cursor and returns `None` after exhaustion."), name: "Iterator", public: true, intrinsic: false, parameters: ["T"], compositions: [], fields: [], methods: [MethodRequirement { span: 357..400, documentation: Some("Advances this iterator and returns its next value, if one remains."), name: "next", receiver: true, public: true, type_parameters: [], groups: [], para