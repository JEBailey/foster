{ expression: Member { object: Spanned { expression: Name("value"), span: 16675..16680 }, name: "start" }, span: 16675..16686 }, arguments: [] }, span: 16675..16688 }, name: "equal?" }, span: 16675..16695 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Instant"), span: 16696..16703 }, name: "epoch" }, span: 16696..16709 }, arguments: [] }, span: 16696..16711 }] }, span: 16675..16712 }, message: None }, span: 16668..16713 }, Spanned { value: Assert { condition: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 16733..16738 }, name: "end" }, span: 16733..16742 }, arguments: [] }, span: 16733..16744 }, name: "equal?" }, span: 16733..16751 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Instant"), span: 16752..16759 }, name: "from_epoch_seconds" }, span: 16752..16778 }, arguments: [Spanned { expression: Integer(2), span: 16779..16780 }] }, span: 16752..16781 }] }, span: 16733..16782 }, message: None }, span: 16726..16783 }, Spanned { value: Assert { condition: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 16803..16808 }, name: "duration" }, span: 16803..16817 }, arguments: [] }, span: 16803..16819 }, name: "equal?" }, span: 16803..16826 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Duration"), span: 16827..16835 }, name: "from_seconds" }, span: 16827..16848 }, arguments: [Spanned { expression: Integer(2), span: 16849..16850 }] }, span: 16827..16851 }] }, span: 16803..16852 }, message: None }, span: 16796..16853 }, Spanned { value: Expr(Spanned { expression: Unit, span: 16866..16868 }), span: 16866..16868 }] } }] }, span: 16442..16884 }), span: 16442..16884 }] } }, TestDecl { span: 16888..17219, description: "wall and continuous clocks return values in their separate domains", body: Block { items: [Spanned { value: Bind { name: "wall", value: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("SystemClock"), span: 16979..16990 }, name: "new" }, span: 16979..16994 }, arguments: [] }, span: 16979..16996 }, name: "now" }, span: 16979..17000 }, arguments: [] }, span: 16979..17002 } }, span: 16968..17002 }, Spanned { value: Assert { condition: Spanned { expression: Logical { left: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("wall"), span: 17014..17018 }, name: "nanosecond" }, span: 17014..17029 }, arguments: [] }, span: 17014..17031 }, operator: GreaterEqual, right: Spanned { expression: Integer(0), span: 17035..17036 } }, span: 17014..17036 }, operator: And, right: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("wall"), span: 17040..17044 }, name: "nanosecond" }, span: 17040..17055 }, arguments: [] }, span: 17040..17057 }, operator: Less, right: Spanned { expression: Integer(1000000000), span: 17060..17070 } }, span: 17040..17070 } }, span: 17014..17070 }, message: None }, span: 17007..17071 }, Spanned { value: Bind { name: "first", value: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("ContinuousClock"), span: 17088..17103 }, name: "new" }, span: 17088..17107 }, arguments: [] }, span: 17088..17109 }, name: "now" }, span: 17088..17113 }, arguments: [] }, span: 17088..17115 } }, span: 17076..17115 }, Spanned { value: Bind { name: "second", value: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("ContinuousClock"), span: 17133..17148 }, name: "new" }, span: 17133..17152 }, arguments: [] }, span: 17133..17154 }, name: "now" }, span: 17133..17158 }, arguments: [] }, span: 17133..17160 } }, span: 17120..17160 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("first"), span: 17172..17177 }, name: "until" }, span: 17172..17183 }, arguments: [Spanned { expression: Name("second"), span: 17184..17190 }] }, span: 17172..17191 }, name: "total_nanoseconds" }, span: 17172..17209 }, arguments: [] }, span: 17172..17211 }, operator: GreaterEqual, right: Spanned { expression: Integer(0), span: 17215..17216 } }, span: 17172..17216 }, message: None }, span: 17165..17217 }] } }] }), source: Some("//! Exact instants, elapsed durations, intervals, and injectable clocks.\n\nimport core.ordering\nimport core.result\n\ntype TimeHost = {}\n\nimpl TimeHost {\n    /// Returns the wall clock as canonical Unix seconds and nanoseconds.\n    func wall_now() -> List<Int> = intrinsic(\"time.wall_now\")\n\n    /// Returns nanoseconds elapsed on this host context's monotonic clock.\n    func monotonic_now() -> Int = intrinsic(\"time.monotonic_now\")\n}\n\n/// Describes an invalid or impossible exact-time value.\npub type TimeError = {\n    pub value: Int\n    pub message: String\n}\n\n/// An exact signed elapsed duration.\n///\n/// `nanosecond` is always between zero and 999,999,999. Negative values use a\n/// floor-based representation, so minus half a second is `seconds = -1` and\n/// `nanosecond = 500,000,000`.\npub type Duration = & Ordered<Duration> & {\n    seconds_value: Int\n    nanosecond_value: Int\n}\n\nimpl Duration {\n    /// Constructs a canonical duration from seconds and a fractional nanosecond part.\n    pub func from_parts(seconds: Int, nanosecond: Int) -> Result<Duration, TimeError> {\n        branch {\n            nanosecond < 0 -> invalid_duration(nanosecond, \"duration nanosecond must not be negative\")\n            nanosecond >= 1000000000 -> invalid_duration(nanosecond, \"duration nanosecond must be below one billion\")\n            _ -> Result.Ok(Duration { seconds_value: seconds, nanosecond_value: nanosecond })\n        }\n    }\n\n    /// Constructs an exact whole-second duration.\n    pub func from_seconds(seconds: Int) -> Duration {\n        Duration { seconds_value: seconds, nanosecond_value: 0 }\n    }\n\n    /// Constructs an exact duration from signed milliseconds.\n    pub func from_milliseconds(milliseconds: Int) -> Duration {\n        let seconds = milliseconds / 1000\n        let remainder = milliseconds - seconds * 1000\n        branch {\n            remainder < 0 -> Duration { seconds_value: seconds - 1, nanosecond_value: (remainder + 1000) * 1000000 }\n            _ -> Duration { seconds_value: seconds, nanosecond_value: remainder * 1000000 }\n        }\n    }\n\n    /// Constructs an exact duration from signed nanoseconds.\n    pub func from_nanoseconds(nanoseconds: Int) -> Duration {\n        let seconds = nanoseconds / 1000000000\n        let remainder = nanoseconds - seconds * 1000000000\n        branch {\n            remainder < 0 -> Duration { seconds_value: seconds - 1, nanosecond_value: remainder + 1000000000 }\n            _ -> Duration { seconds_value: seconds, nanosecond_value: remainder }\n        }\n    }\n\n    /// Returns a zero-length duration.\n    pub func zero() -> Duration { Duration.from_seconds(0) }\n\n    /// Returns the canonical whole-second component.\n    pub func seconds(self: Duration) -> Int { self.seconds_value }\n\n    /// Returns the nonnegative fractional nanosecond component.\n    pub func nanosecond(self: Duration) -> Int { self.nanosecond_value }\n\n    /// Returns this duration as signed nanoseconds.\n    ///\n    /// This conversion fails at runtime if the represented value exceeds `Int`.\n    pub func total_nanoseconds(self: Duration) -> Int {\n        self.seconds_value * 1000000000 + self.nanosecond_value\n    }\n\n    /// Returns this duration as signed milliseconds, truncated toward negative infinity.\n    pub func total_milliseconds(self: Duration) -> Int {\n        self.seconds_value * 1000 + self.nanosecond_value / 1000000\n    }\n\n    /// Adds two exact durations and returns a canonical result.\n    pub func add(self: Duration, other: Duration) -> Duration {\n        canonical_duration(self.seconds_value + other.seconds_value, self.nanosecond_value + other.nanosecond_value)\n    }\n\n    /// Subtracts another exact duration and returns a canonical result.\n    pub func subtract(self: Duration, other: Duration) -> Duration {\n        self.add(other.negated())\n    }\n\n    /// Returns the additive inverse of this duration.\n    pub func negated(self: Duration) -> Duration {\n        branch {\n            self.nanosecond_value == 0 -> Duration { seconds_value: -self.seconds_value, nanosecond_value: 0 }\n            _ -> Duration { seconds_value: -self.seconds_value - 1, nanosecond_value: 1000000000 - self.nanosecond_value }\n        }\n    }\n\n    /// Returns whether this duration has zero length.\n    pub func zero?(self: Duration) -> Bool {\n        self.seconds_value == 0 && self.nanosecond_value == 0\n    }\n\n    /// Compares two exact durations.\n    pub func compare(self: Duration, other: Duration) -> Ordering {\n        compare_parts(self.seconds_value, self.nanosecond_value, other.seconds_value, other.nanosecond_value)\n    }\n\n    /// Returns whether two exact durations are equal.\n    pub func equal?(self: Duration, other: Duration) -> Bool {\n        self.seconds_value == other.seconds_value && self.nanosecond_value == other.nanosecond_value\n    }\n}\n\n/// A precise point on the Unix time line, independent of calendars and time zones.\npub type Instant = & Ordered<Instant> & {\n    epoch_seconds_value: Int\n    nanosecond_value: Int\n}\n\nimpl Instant {\n    /// Constructs an instant from canonical Unix seconds and nanoseconds.\n    pub func from_parts(epoch_seconds: Int, nanosecond: Int) -> Result<Instant, TimeError> {\n        branch {\n            nanosecond < 0 -> invalid_instant(nanosecond, \"instant nanosecond must not be negative\")\n            nanosecond >= 1000000000 -> invalid_instant(nanosecond, \"instant nanosecond must be below one billion\")\n            _ -> Result.Ok(Instant { epoch_seconds_value: epoch_seconds, nanosecond_value: nanosecond })\n        }\n    }\n\n    /// Constructs an instant at a whole Unix second.\n    pub func from_epoch_seconds(epoch_seconds: Int) -> Instant {\n        Instant { epoch_seconds_value: epoch_seconds, nanosecond_value: 0 }\n    }\n\n    /// Constructs an instant from signed Unix milliseconds.\n    pub func from_epoch_milliseconds(milliseconds: Int) -> Instant {\n        let seconds = milliseconds / 1000\n        let remainder = milliseconds - seconds * 1000\n        branch {\n            remainder < 0 -> Instant { epoch_seconds_value: seconds - 1, nanosecond_value: (remainder + 1000) * 1000000 }\n            _ -> Instant { epoch_seconds_value: seconds, nanosecond_value: remainder * 1000000 }\n        }\n    }\n\n    /// Returns the Unix epoch.\n    pub func epoch() -> Instant { Instant.from_epoch_seconds(0) }\n\n    /// Returns the canonical Unix-second component.\n    pub func epoch_seconds(self: Instant) -> Int { self.epoch_seconds_value }\n\n    /// Returns the nonnegative fractional nanosecond component.\n    pub func nanosecond(self: Instant) -> Int { self.nanosecond_value }\n\n    /// Returns signed Unix milliseconds, truncated toward negative infinity.\n    pub func epoch_milliseconds(self: Instant) -> Int {\n        self.epoch_seconds_value * 1000 + self.nanosecond_value / 1000000\n    }\n\n    /// Advances this instant by an exact duration.\n    pub func add(self: Instant, duration: Duration) -> Instant {\n        canonical_instant(self.epoch_seconds_value + duration.seconds(), self.nanosecond_value + duration.nanosecond())\n    }\n\n    /// Moves this instant backward by an exact duration.\n    pub func subtract(self: Instant, duration: Duration) -> Instant {\n        self.add(duration.negated())\n    }\n\n    /// Returns the exact elapsed duration from this instant until `other`.\n    pub func until(self: Instant, other: Instant) -> Duration {\n        canonical_duration(other.epoch_seconds_value - self.epoch_seconds_value, other.nanosecond_value - self.nanosecond_value)\n    }\n\n    /// Compares two instants on the time line.\n    pub func compare(self: Instant, other: Instant) -> Ordering {\n        compare_parts(self.epoch_seconds_value, self.nanosecond_value, other.epoch_seconds_value, other.nanosecond_value)\n    }\n\n    /// Returns whether two instants identify the same point on the time line.\n    pub func equal?(self: Instant, other: Instant) -> Bool {\n        self.epoch_seconds_value == other.epoch_seconds_value && self.nanosecond_value == other.nanosecond_value\n    }\n}\n\n/// A half-open interval between two exact instants.\npub type Interval = {\n    start_value: Instant\n    end_value: Instant\n}\n\nimpl Interval {\n    /// Constructs `[start, end)`, rejecting an end before the start.\n    pub func from(start: Instant, end: Instant) -> Result<Interval, TimeError> {\n        branch end.compare(start) {\n            Ordering.Less -> Result.Error(TimeError { value: end.epoch_seconds(), message: \"interval end must not precede its start\" })\n            _ -> Result.Ok(Interval { start_value: start, end_value: end })\n        }\n    }\n\n    /// Returns the inclusive interval start.\n    pub func start(self: Interval) -> Instant { clone_instant(self.start_value) }\n\n    /// Returns the exclusive interval end.\n    pub func end(self: Interval) -> Instant { clone_instant(self.end_value) }\n\n    /// Returns the exact interval length.\n    pub func duration(self: Interval) -> Duration { self.start_value.until(self.end_value) }\n\n    /// Returns whether this interval contains `instant`.\n    pub func contains?(self: Interval, instant: Instant) -> Bool {\n        not matches_ordering(instant.compare(self.start_value), Ordering.Less) && matches_ordering(instant.compare(self.end_value), Ordering.Less)\n    }\n}\n\n/// A source of values on one particular time line.\npub type Clock<T> = {\n    /// Returns the clock's current reading.\n    pub func now(self) -> T\n}\n\n/// The host wall clock, producing serializable Unix instants.\npub type SystemClock = & Clock<Instant> & {\n    marker: Symbol\n}\n\nimpl SystemClock {\n    /// Constructs the host wall clock capability.\n    pub func new() -> SystemClock { SystemClock { marker: :system_clock } }\n\n    /// Reads the host wall clock.\n    pub func now(self: SystemClock) -> Instant {\n        let parts = TimeHost.wall_now()\n        Instant { epoch_seconds_value: parts[0], nanosecond_value: parts[1] }\n    }\n}\n\n/// Returns the current host wall-clock instant.\npub func now() -> Instant { SystemClock.new().now() }\n\n/// An opaque reading from one monotonic-clock domain.\npub type MonotonicInstant = & Ordered<MonotonicInstant> & {\n    ticks_value: Int\n}\n\nimpl MonotonicInstant {\n    /// Returns the host-context-relative nanosecond reading.\n    pub func ticks(self: MonotonicInstant) -> Int { self.ticks_value }\n\n    /// Returns the elapsed duration from this reading until `other`.\n    pub func until(self: MonotonicInstant, other: MonotonicInstant) -> Duration {\n        Duration.from_nanoseconds(other.ticks_value - self.ticks_value)\n    }\n\n    /// Advances a monotonic reading for deterministic clock implementations.\n    pub func add(self: MonotonicInstant, duration: Duration) -> MonotonicInstant {\n        MonotonicInstant { ticks_value: self.ticks_value + duration.total_nanoseconds() }\n    }\n\n    /// Compares two readings from the same monotonic-clock domain.\n    pub func compare(self: MonotonicInstant, other: MonotonicInstant) -> Ordering {\n        compare_int(self.ticks_value, other.ticks_value)\n    }\n\n    /// Returns whether two monotonic readings are equal.\n    pub func equal?(self: MonotonicInstant, other: MonotonicInstant) -> Bool {\n        self.ticks_value == other.ticks_value\n    }\n}\n\n/// The host monotonic clock, suitable for deadlines and elapsed measurements.\npub type ContinuousClock = & Clock<MonotonicInstant> & {\n    marker: Symbol\n}\n\nimpl ContinuousClock {\n    /// Constructs the host monotonic clock capability.\n    pub func new() -> ContinuousClock { ContinuousClock { marker: :continuous_clock } }\n\n    /// Reads the host monotonic clock.\n    pub func now(self: ContinuousClock) -> MonotonicInstant {\n        MonotonicInstant { ticks_value: TimeHost.monotonic_now() }\n    }\n}\n\n/// Canonicalizes a duration whose nanosecond part may be outside its public range.\nfunc canonical_duration(seconds: Int, nanosecond: Int) -> Duration {\n    let carry = floor_div(nanosecond, 1000000000)\n    Duration { seconds_value: seconds + carry, nanosecond_value: nanosecond - carry * 1000000000 }\n}\n\n/// Canonicalizes an instant whose nanosecond part may be outside its public range.\nfunc canonical_instant(seconds: Int, nanosecond: Int) -> Instant {\n    let carry = floor_div(nanosecond, 1000000000)\n    Instant { epoch_seconds_value: seconds + carry, nanosecond_value: nanosecond - carry * 1000000000 }\n}\n\n/// Reconstructs an instant from its scalar representation.\nfunc clone_instant(value: Instant) -> Instant {\n    canonical_instant(value.epoch_seconds(), value.nanosecond())\n}\n\n/// Divides integers with a result rounded toward negative infinity.\nfunc floor_div(value: Int