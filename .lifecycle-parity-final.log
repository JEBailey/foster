MoveOut(Spanned { expression: Name("buffer"), span: 2394..2400 }), span: 2389..2400 }, span: 2388..2401 }, name: "freeze" }, span: 2388..2408 }, arguments: [] }, span: 2388..2410 }, name: "hex" }, span: 2388..2414 }, arguments: [] }, span: 2388..2416 }, operator: Equal, right: Spanned { expression: String("6f6b"), span: 2420..2426 } }, span: 2388..2426 }, message: None }, span: 2381..2427 }, Spanned { value: Expr(Spanned { expression: Unit, span: 2432..2434 }), span: 2432..2434 }] } }] }), source: Some("//! Mutable byte accumulation implemented over Foster's lower-level list storage.\n\nimport core.bytes\nimport core.list\n\n/// Mutable byte construction storage.\n///\n/// Capacity is an implementation hint: the Foster implementation reports its current length and\n/// accepts reservations without making allocation strategy observable.\npub type ByteBuffer = {\n    value: List<Byte>\n}\n\nimpl ByteBuffer {\n    /// Creates an empty mutable byte buffer.\n    pub func empty() -> ByteBuffer {\n        ByteBuffer { value: [] }\n    }\n\n    /// Creates an empty buffer with an allocation hint.\n    pub func with_capacity(capacity: Int) -> ByteBuffer {\n        assert(capacity >= 0, \"ByteBuffer capacity cannot be negative\")\n        ByteBuffer.empty()\n    }\n\n    /// Appends one byte.\n    pub func push(self: ByteBuffer, value: Byte) -> () [reshape self.value.items] {\n        self.value.push(value)\n        ()\n    }\n\n    /// Appends an immutable byte sequence.\n    pub func extend(self: ByteBuffer, values: Bytes) -> () [reshape self.value.items] {\n        let index = 0\n        loop {\n            break if index >= values.length\n            self.value.push(values[index])\n            index = index + 1\n        }\n        ()\n    }\n\n    /// Removes every buffered byte.\n    pub func clear(self: ByteBuffer) -> () [mut self.value] {\n        self.value = []\n        ()\n    }\n\n    /// Keeps at most the first `length` buffered bytes.\n    pub func truncate(self: ByteBuffer, length: Int) -> () [mut self.value] {\n        assert(length >= 0, \"truncate length cannot be negative\")\n        self.value = self.value.take(length)\n        ()\n    }\n\n    /// Accepts an allocation hint without exposing storage capacity as semantics.\n    pub func reserve(self: ByteBuffer, additional: Int) -> () {\n        assert(additional >= 0, \"reserve amount cannot be negative\")\n        ()\n    }\n\n    /// Consumes the buffer and packs its values into immutable bytes.\n    pub func freeze(self: ByteBuffer) -> Bytes [consume self] {\n        Bytes.from(move self.value)\n    }\n\n    /// Copies the current values into immutable bytes.\n    pub func snapshot(self: ByteBuffer) -> Bytes {\n        Bytes.from(self.value.map((value: Byte) -> value))\n    }\n}\n\ntest \"byte buffers append snapshot and freeze contents\" {\n    let buffer = ByteBuffer.empty()\n    buffer.extend(\"ok\".bytes)\n    assert(buffer.snapshot().hex() == \"6f6b\")\n    assert((move buffer).freeze().hex() == \"6f6b\")\n    ()\n}\n"), origin: Embedded }, "core.code_point": Module { name: "core.code_point", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/code_point.fos"), program: Some(Program { documentation: Some("Unicode scalar construction, classification, and UTF-8 encoding."), imports: [Import { span: 72..90, path: ["core", "option"], alias: None }], constants: [], records: [], variants: [], functions: [Function { body_is_recovery_stub: false, span: 162..221, documentation: Some("Explicitly copies this scalar value."), name: "CodePoint.copy", owner: Some("CodePoint"), receiver: true, public: true, intrinsic: None, type_parameters: [], groups: [], parameters: [Parameter { span: 176..180, name: "self", ty: Some(Named("CodePoint", [])), type_span: Some(182..191) }], return_type: Some(Named("self", [])), effects_explicit: true, effects: [Effect { kind: Read, target: GroupPath { root: "self", children: [] } }], effect_spans: [202..211], suspends: false, suspe