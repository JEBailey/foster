rue, intrinsic: false, parameters: ["E"], compositions: [], fields: [], methods: [MethodRequirement { span: 2275..2327, documentation: Some("Releases the value and consumes its live identity."), name: "close", receiver: true, public: true, type_parameters: [], groups: [], parameters: [Parameter { span: 2290..2294, name: "self", ty: None, type_span: None }], return_type: Some(Named("Result", [Unit, Named("E", [])])), effects: [Effect { kind: Consume, target: GroupPath { root: "self", children: [] } }], suspends: false }] }, RecordDecl { span: 2382..2526, documentation: Some("A value that accepts child values of type `C`."), name: "Accepting", public: true, intrinsic: false, parameters: ["C", "E"], compositions: [], fields: [], methods: [MethodRequirement { span: 2476..2524, documentation: Some("Waits for and returns the next accepted child value."), name: "accept", receiver: true, public: true, type_parameters: [], groups: [], parameters: [Parameter { span: 2492..2496, name: "self", ty: None, type_span: None }], return_type: Some(Named("Result", [Named("C", []), Named("E", [])])), effects: [Effect { kind: Mut, target: GroupPath { root: "self", children: [] } }], suspends: false }] }, RecordDecl { span: 2590..2646, documentation: Some("A value supporting both complete binary reads and writes."), name: "ReadWrite", public: true, intrinsic: false, parameters: ["E"], compositions: [Named("Readable", [Named("E", [])]), Named("Writable", [Named("E", [])])], fields: [], methods: [] }], variants: [], functions: [], implementations: [], tests: [] }), source: Some("//! Typed resource identifiers and independent compile-time capability contracts.\n\nimport core.bytes\nimport core.result\n\n/// An explicit identifier for a resource provider or target.\n///\n/// The uncommon `resource_id` member prevents displayable values such as integers from satisfying\n/// this contract accidentally merely because they implement `as_string`.\npub type ResourceIdentifier = {\n    /// Returns the stable textual identifier supplied to the resource provider.\n    pub func resource_id(self) -> String [read self]\n}\n\n/// A resource associated with an identifier of the concrete type `L`.\n///\n/// Keeping `L` in the contract prevents a file, socket, or future URI-backed provider from losing\n/// the kind of identifier with which it was created.\npub type Resource<L> = {\n    pub location: L\n}\n\n/// A value whose complete binary contents can be read.\npub type Readable<E> = {\n    /// Reads the complete contents.\n    pub func read(self) -> Result<Bytes, E> [mut self]\n}\n\n/// A value whose binary contents can be replaced.\npub type Writable<E> = {\n    /// Writes bytes and returns the number accepted.\n    pub func write(self, contents: Bytes) -> Result<Int, E> [mut self]\n\n    /// Makes buffered output visible to the destination.\n    pub func flush(self) -> Result<(), E> [mut self]\n}\n\n/// A value supporting bounded binary reads at explicit offsets.\n///\n/// Position belongs to the operation rather than the resource, so callers can share one stable\n/// identifier without manufacturing separate reader objects.\npub type PositionedReadable<E> = {\n    /// Reads at most `maximum` bytes beginning at `offset`.\n    pub func read_at(self, offset: Int, maximum: Int) -> Result<Bytes, E> [mut self]\n}\n\n/// A value that accepts bytes at its current logical end.\npub type Appendable<E> = {\n    /// Appends bytes and returns the number accepted.\n    pub func append(self, contents: Bytes) -> Result<Int, E> [mut self]\n}\n\n/// A value whose current binary length can be queried.\npub type Sized<E> = {\n    /// Returns the current length in bytes.\n    pub func length(self) -> Result<Int, E> [mut self]\n}\n\n/// An owned value that can release its host or provider state deterministically.\npub type Closable<E> = {\n    /// Releases the value and consumes its live identity.\n    pub func close(self) -> Result<(), E> [consume self]\n}\n\n/// A value that accepts child values of type `C`.\npub type Accepting<C, E> = {\n    /// Waits for and returns the next accepted child value.\n    pub func accept(self) -> Result<C, E> [mut self]\n}\n\n/// A value supporting both complete binary reads and writes.\npub type ReadWrite<E> = & Readable<E> & Writable<E> & {}\n"), origin: Embedded }, "std.sequence": Module { name: "std.sequence", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/sequence.fos"), program: Some(Program { documentation: Some("Generic algorithms over immutable indexed sequences."), imports: [Import { span: 58..79, path: ["core", "functions"], alias: None }, Import { span: 80..98, path: ["core", "option"], alias: None }], constants: [], records: [], variants: [], functions: [Function { body_is_recovery_stub: false, span: 196..311, documentation: Some("Applies `transform` to every element of a string or list and returns the results as a list."), name: "map", owner: None, receiver: false, public: true, intrinsic: None, type_parameters: ["T", "U"], groups: [], parameters: [Parameter { span: 215..221, name: "values", ty: Some(Named("Sequence", [Named("T", [])])), type_span: Some(223..234) }, Parameter { span: 236..245, name: "transform", ty: Some(Function { parameters: [Named("T", [])], parameter_modes: [Borrow], result: Named("U", []), effects: [], suspends: false }), type_span: Some(247..259) }], return_type: Some(Named("List", [Named("U", [])])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Call { callee: Spanned { expression: Name("map_into"), span: 278..286 }, arguments: [Spanned { expression: Name("values"), span: 287..293 }, Spanned { expression: Name("transform"), span: 295..304 }, Spanned { expression: List([]), span: 306..308 }] }, span: 278..309 }), span: 278..309 }] } }, Function { body_is_recovery_stub: false, span: 383..604, documentation: Some("Maps the remaining sequence elements i