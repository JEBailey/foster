r: Equal, right: Spanned { expression: Integer(4), span: 3327..3328 } }, span: 3308..3328 }, message: None }, span: 3301..3329 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Integer(12), span: 3342..3344 }, name: "clamp" }, span: 3342..3350 }, arguments: [Spanned { expression: Integer(0), span: 3351..3352 }, Spanned { expression: Integer(10), span: 3354..3356 }] }, span: 3342..3357 }, operator: Equal, right: Spanned { expression: Integer(10), span: 3361..3363 } }, span: 3342..3363 }, message: None }, span: 3335..3364 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Integer(2), span: 3377..3378 }, name: "power" }, span: 3377..3384 }, arguments: [Spanned { expression: Integer(5), span: 3385..3386 }] }, span: 3377..3387 }, operator: Equal, right: Spanned { expression: Integer(32), span: 3391..3393 } }, span: 3377..3393 }, message: None }, span: 3370..3394 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Integer(2), span: 3407..3408 }, name: "range" }, span: 3407..3414 }, arguments: [Spanned { expression: Integer(5), span: 3415..3416 }] }, span: 3407..3417 }, name: "length" }, span: 3407..3424 }, operator: Equal, right: Spanned { expression: Integer(3), span: 3428..3429 } }, span: 3407..3429 }, message: None }, span: 3400..3430 }, Spanned { value: Expr(Spanned { expression: Unit, span: 3436..3438 }), span: 3436..3438 }] } }] }), source: Some("//! Integer arithmetic helpers, ordering, and range generation.\r\n\r\nimport core.ordering\r\n\r\nimpl Int {\r\n    /// Explicitly copies this scalar value.\r\n    pub func copy(self: Int) -> self [read self] { self }\r\n\r\n    /// Returns the absolute value of this integer.\r\n    pub func absolute(self: Int) -> Int {\r\n        branch {\r\n            self < 0 -> -self\r\n            _ -> self\r\n        }\r\n    }\r\n\r\n    /// Returns the smaller of `left` and `right`.\r\n    pub func minimum(self: Int, right: Int) -> Int {\r\n        branch {\r\n            self <= right -> self\r\n            _ -> right\r\n        }\r\n    }\r\n\r\n    /// Returns the larger of `left` and `right`.\r\n    pub func maximum(self: Int, right: Int) -> Int {\r\n        branch {\r\n            self >= right -> self\r\n            _ -> right\r\n        }\r\n    }\r\n\r\n    /// Restricts `value` to the inclusive range from `lower` to `upper`.\r\n    pub func clamp(self: Int, lower: Int, upper: Int) -> Int {\r\n        self.maximum(lower).minimum(upper)\r\n    }\r\n\r\n    /// Returns `-1`, `0`, or `1` according to the sign of `value`.\r\n    pub func sign(self: Int) -> Int {\r\n        branch {\r\n            self < 0 -> -1\r\n            self > 0 -> 1\r\n            _ -> 0\r\n        }\r\n    }\r\n\r\n    /// Compares two integers and returns their ordering.\r\n    pub func compare(self: Int, right: Int) -> Ordering {\r\n        branch {\r\n            self < right -> Ordering.Less\r\n            self > right -> Ordering.Greater\r\n            _ -> Ordering.Equal\r\n        }\r\n    }\r\n\r\n    /// Returns whether `value` lies in the inclusive range from `lower` to `upper`.\r\n    pub func between?(self: Int, lower: Int, upper: Int) -> Bool {\r\n        branch {\r\n            self < lower -> false\r\n            _ -> self <= upper\r\n        }\r\n    }\r\n\r\n    /// Returns whether `value` is evenly divisible by two.\r\n    pub func even?(self: Int) -> Bool {\r\n        self / 2 * 2 == self\r\n    }\r\n\r\n    /// Returns whether `value` is not evenly divisible by two.\r\n    pub func odd?(self: Int) -> Bool {\r\n        self / 2 * 2 != self\r\n    }\r\n\r\n    /// Raises `base` to a nonnegative integer `exponent`.\r\n    pub func power(self: Int, exponent: Int) -> Int {\r\n        power_of(self, exponent)\r\n    }\r\n\r\n    /// Returns the remainder after integer division by `divisor`.\r\n    pub func modulo(self: Int, divisor: Int) -> Int {\r\n        self - self / divisor * divisor\r\n    }\r\n\r\n    /// Builds the half-open integer range `[start, end)`.\r\n    pub func range(self: Int, end: Int) -> List<Int> {\r\n        range_into(self, end, [])\r\n    }\r\n\r\n    /// Formats an integer as decimal text.\r\n    pub func as_string(self: Int) -> String {\r\n        branch {\r\n            self < 0 -> \"-\" + negative_string(self)\r\n            _ -> unsigned_string(self)\r\n        }\r\n    }\r\n\r\n}\r\n\r\n/// Multiplies the base for each remaining exponent step.\r\nfunc power_of(base: Int, exponent: Int) -> Int {\r\n    branch {\r\n        exponent <= 0 -> 1\r\n        _ -> base * power_of(base, exponent - 1)\r\n    }\r\n}\r\n\r\n/// Appends consecutive integers to the range accumulator.\r\nfunc range_into(value: Int, end: Int, result: List<Int>) -> List<Int> [consume result] {\r\n    branch {\r\n        value >= end -> result\r\n        _ -> range_into(value + 1, end, result.append(value))\r\n    }\r\n}\r\n\r\ntest \"integer helpers cover signs ranges and powers\" {\r\n    assert((-4).absolute() == 4)\r\n    assert(12.clamp(0, 10) == 10)\r\n    assert(2.power(5) == 32)\r\n    assert(2.range(5).length == 3)\r\n    ()\r\n}\r\n\r\n/// Formats a known nonnegative integer as decimal text.\r\nfunc unsigned_string(value: Int) -> String {\r\n    let quotient = value / 10\r\n    let digit = value - quotient * 10\r\n    branch {\r\n        quotient == 0 -> from_code_point(48 + digit).string\r\n        _ -> unsigned_string(quotient) + from_code_point(48 + digit).string\r\n    }\r\n}\r\n\r\n/// Formats a known negative integer without negating the signed minimum.\r\nfunc negative_string(value: Int) -> String {\r\n    let quotient = value / 10\r\n    let remainder = value - quotient * 10\r\n    let digit = -remainder\r\n    branch {\r\n        quotient == 0 -> from_code_point(48 + digit).string\r\n        _ -> negative_string(quotient) + from_code_point(48 + digit).string\r\n    }\r\n}\r\n"), origin: Embedded }, "core.list": Module { name: "core.list", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/list.fos"), program: Some(Program { documentation: Some("Owned homogeneous lists and indexed, stack-safe collection algorithms."), imports: [Import { span: 78..99, path: ["core", "functions"], alias: None }, Import { span: 101..119, path: ["core", "option"], alias: None }, Import { span: 121..151, path: ["core", "result"], alias: Some("outcomes") }, Import { span: 153..171, path: ["core", "string"], alias: None }], constants: [], records: [RecordDecl { span: 261..286, documentation: Some("Private descriptor-backed contiguous list storage shared by executable backends."), name: "RawList", public: false, intrinsic: true, parameters: ["T"], compositions: [], fields: [], methods: [] }, RecordDecl { span: 375..421, documentation: Some("An ordered value collection backed by private copy-on-write contiguous storage."), name: "List", public: true, intrinsic: false, parameters: ["T"], compositions: [], fields: [RecordField { name: "value", public: false, ty: Named("RawList", [Named("T", [])]) }], methods: [] }], variants: [VariantDecl { span: 488..547, documentation: Some("Why an independently owned element could not be obtained."), name: "ListReadError", public: true, kind: Enum, parameters: [], alternatives: [EnumCase { span: 513..524, name: "OutOfBounds", payload: None }, EnumCase { span: 532..543, name: "NotCopyable", payload: None }], compositions: [], methods: [] }], functions: [Function { body_is_recovery_stub: false, span: 612..705, documentation: Some("Appends `value` to this list in place."), name: "List.push", owner: Some("List"), receiver: true, public: true, intrinsic: Some("list.push"), type_parameters: 