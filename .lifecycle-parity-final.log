 }, span: 10450..10461 } }, span: 10433..10461 }, message: None }, span: 10426..10462 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("values"), span: 10475..10481 }, name: "last" }, span: 10475..10486 }, arguments: [] }, span: 10475..10488 }, operator: Equal, right: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Option"), span: 10492..10498 }, name: "Some" }, span: 10492..10503 }, arguments: [Spanned { expression: Integer(6), span: 10504..10505 }] }, span: 10492..10506 } }, span: 10475..10506 }, message: None }, span: 10468..10507 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: List([Spanned { expression: List([Spanned { expression: Integer(1), span: 10522..10523 }, Spanned { expression: Integer(2), span: 10525..10526 }]), span: 10521..10527 }, Spanned { expression: List([]), span: 10529..10531 }, Spanned { expression: List([Spanned { expression: Integer(3), span: 10534..10535 }]), span: 10533..10536 }]), span: 10520..10537 }, name: "flatten" }, span: 10520..10545 }, arguments: [] }, span: 10520..10547 }, operator: Equal, right: Spanned { expression: List([Spanned { expression: Integer(1), span: 10552..10553 }, Spanned { expression: Integer(2), span: 10555..10556 }, Spanned { expression: Integer(3), span: 10558..10559 }]), span: 10551..10560 } }, span: 10520..10560 }, message: None }, span: 10513..10561 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: List([Spanned { expression: String("λ"), span: 10575..10579 }, Spanned { expression: String(""), span: 10581..10583 }, Spanned { expression: String("🙂"), span: 10585..10591 }]), span: 10574..10592 }, name: "join" }, span: 10574..10597 }, arguments: [Spanned { expression: String("|"), span: 10598..10601 }] }, span: 10574..10602 }, operator: Equal, right: Spanned { expression: String("λ||🙂"), span: 10606..10616 } }, span: 10574..10616 }, message: None }, span: 10567..10617 }, Spanned { value: Expr(Spanned { expression: Unit, span: 10623..10625 }), span: 10623..10625 }] } }] }), source: Some("//! Owned homogeneous lists and indexed, stack-safe collection algorithms.\r\n\r\nimport core.functions\r\nimport core.option\r\nimport core.result as outcomes\r\nimport core.string\r\n\r\n/// Private descriptor-backed contiguous list storage shared by executable backends.\r\nintrinsic type RawList<T>\r\n\r\n/// An ordered value collection backed by private copy-on-write contiguous storage.\r\npub type List<T> = {\r\n    value: RawList<T>\r\n}\r\n\r\n/// Why an independently owned element could not be obtained.\r\npub enum ListReadError = OutOfBounds\r\n    | NotCopyable\r\n\r\nimpl List {\r\n    /// Appends `value` to this list in place.\r\n    pub func push<T>(self: List<T>, value: T) -> () [reshape self.items] = intrinsic(\"list.push\")\r\n\r\n    /// Returns this list with `value` appended.\r\n    pub func append<T>(self: List<T>, value: T) -> List<T> [consume self] = intrinsic(\"list.append\")\r\n\r\n    /// Copies an element without removing it. Bounds are checked before its Copy capability.\r\n    pub func at<T>(self: List<T>, index: Int) -> Result<T, ListReadError> [read self] {\r\n        branch {\r\n            index < 0 || index >= self.length -> Result.Error(ListReadError.OutOfBounds)\r\n            !self.can_copy_at(index) -> Result.Error(ListReadError.NotCopyable)\r\n            _ -> Result.Ok(self.copy_at(index))\r\n        }\r\n    }\r\n\r\n    /// Tests the runtime Copy capability of an in-bounds element.\r\n    func can_copy_at<T>(self: List<T>, index: Int) -> Bool [read self] = intrinsic(\"list.can_copy_at\")\r\n    /// Invokes Copy after the caller checks bounds and capability.\r\n    func copy_at<T>(self: List<T>, index: Int) -> T [read self] = intrinsic(\"list.copy_at\")\r\n\r\n    /// Collection algorithms that produce owned elements require Copy.\r\n    func read_at<T>(self: List<T>, index: Int) -> T [read self] {\r\n        assert(index >= 0 && index < self.length, \"list index is out of bounds\")\r\n        assert(self.can_copy_at(index), \"list element does not implement Copy\")\r\n        self.copy_at(index)\r\n    }\r\n\r\n    /// Returns whether this list contains `expected`.\r\n    pub func contains?<T>(self: List<T>, expected: T) -> Bool {\r\n        let index = 0\r\n        loop {\r\n            return false if index >= self.length\r\n            return true if self[index] == expected\r\n            index = index + 1\r\n        }\r\n        false\r\n    }\r\n\r\n    /// Copies the first element, or returns `None` when it is absent or not copyable.\r\n    pub func first<T>(self: List<T>) -> Option<T> {\r\n        self.get(0)\r\n    }\r\n\r\n    /// Copies the final element, or returns `None` when it is absent or not copyable.\r\n    pub func last<T>(self: List<T>) -> Option<T> {\r\n        self.get(self.length - 1)\r\n    }\r\n\r\n    /// Applies `transform` to every element, from left to right.\r\n    pub func map<T, U>(self: List<T>, transform: func(T) -> U) -> List<U> {\r\n        let result = []\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            result.push(transform(self[index]))\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Returns the elements for which `include` evaluates to true.\r\n    pub func filter<T>(self: List<T>, include: Predicate<T>) -> List<T> {\r\n        let result = []\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            let value = self.read_at(index)\r\n            branch {\r\n                include(value) -> result.push(value)\r\n                _ -> ()\r\n            }\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Reduces the list from left to right, beginning with `initial`.\r\n    pub func fold<T, U>(self: List<T>, initial: U, combine: func(consume U, consume T) -> U) -> U [read self, consume initial] {\r\n        let result = move initial\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            result = combine(move result, self.read_at(index))\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Returns the first matching element; stops evaluating the predicate at that element.\r\n    pub func find<T>(self: List<T>, predicate: Predicate<T>) -> Option<T> {\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            let value = self.read_at(index)\r\n            return Option.Some(value) if predicate(value)\r\n            index = index + 1\r\n        }\r\n        Option.None\r\n    }\r\n\r\n    /// Returns whether at least one element satisfies `predicate`.\r\n    pub func any?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {\r\n        let index = 0\r\n        loop {\r\n            return false if index >= self.length\r\n            return true if predicate(self[index])\r\n            index = index + 1\r\n        }\r\n        false\r\n    }\r\n\r\n    /// Returns whether every element satisfies `predicate`.\r\n    pub func all?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {\r\n        let index = 0\r\n        loop {\r\n            return true if index >= self.length\r\n            return false if !predicate(self[index])\r\n            index = index + 1\r\n        }\r\n        true\r\n    }\r\n\r\n    /// Builds a reversed list without materializing intermediate tails.\r\n    pub func reverse<T>(self: List<T>) -> List<T> {\r\n        let result = []\r\n        let index = self.length\r\n        loop {\r\n            break if index <= 0\r\n            index = index - 1\r\n            result.push(self.read_at(index))\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Appends every element of `right`, consuming the left list.\r\n    pub func concat<T>(self: List<T>, right: List<T>) -> List<T> [consume self, read right] {\r\n        let result = move self\r\n        let index = 0\r\n        loop {\r\n            break if index >= right.length\r\n            result.push(right.read_at(index))\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Returns a copy of the element, or None when it is unavailable or not copyable.\r\n    pub func get<T>(self: List<T>, index: Int) -> Option<T> [read self] {\r\n        branch self.at(index) {\r\n            Result.Ok(value) -> Option.Some(value)\r\n            Result.Error(_) -> Option.None\r\n        }\r\n    }\r\n\r\n    /// Copies only the elements in the checked half-open range `start..end`.\r\n    pub func slice<T>(self: List<T>, start: Int, end: Int) -> List<T> {\r\n        assert(start >= 0 && end >= start && end <= self.length, \"list slice is out of bounds\")\r\n        let result = []\r\n        let index = start\r\n        loop {\r\n            break if index >= end\r\n            result.push(self.read_at(index))\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Returns at most the first `count` elements; a nonpositive count returns an empty list.\r\n    pub func take<T>(self: List<T>, count: Int) -> List<T> {\r\n        let end = branch {\r\n            count < 0 -> 0\r\n            count > self.length -> self.length\r\n            _ -> count\r\n        }\r\n        self.slice(0, end)\r\n    }\r\n\r\n    /// Consumes the list and returns the elements after the first `count` entries.\r\n    pub func drop<T>(self: List<T>, count: Int) -> List<T> [consume self] {\r\n        return self if count <= 0\r\n        return [] if count >= self.length\r\n        self.slice(count, self.length)\r\n    }\r\n\r\n    /// Maps each element to a list and appends its elements to one output buffer.\r\n    pub func flat_map<T, U>(self: List<T>, transform: func(T) -> List<U>) -> List<U> {\r\n        let result = []\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            let mapped = transform(self[index])\r\n            let item = 0\r\n            loop {\r\n                break if item >= mapped.length\r\n                result.push(mapped.read_at(item))\r\n                item = item + 1\r\n            }\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Concatenates nested lists in source order without constructing intermediate tails.\r\n    pub func flatten<T>(self: List<List<T>>) -> List<T> {\r\n        let result = []\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            let item = 0\r\n            loop {\r\n                break if item >= self[index].length\r\n                result.push(self[index].read_at(item))\r\n                item = item + 1\r\n            }\r\n            index = index + 1\r\n        }\r\n        result\r\n    }\r\n\r\n    /// Counts the elements satisfying `predicate`.\r\n    pub func count<T>(self: List<T>, predicate: Predicate<T>) -> Int {\r\n        let count = 0\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            branch {\r\n                predicate(self[index]) -> {\r\n                    count = count + 1\r\n                    ()\r\n                }\r\n                _ -> ()\r\n            }\r\n            index = index + 1\r\n        }\r\n        count\r\n    }\r\n\r\n    /// Returns whether no element satisfies `predicate`.\r\n    pub func none?<T>(self: List<T>, predicate: Predicate<T>) -> Bool {\r\n        !self.any?(predicate)\r\n    }\r\n\r\n    /// Combines a nonempty list into one value, or returns `None` for an empty list.\r\n    pub func reduce<T>(self: List<T>, combine: func(T, T) -> T) -> Option<T> {\r\n        return Option.None if self.empty?\r\n        let result = self.read_at(0)\r\n        let index = 1\r\n        loop {\r\n            break if index >= self.length\r\n            result = combine(result, self.read_at(index))\r\n            index = index + 1\r\n        }\r\n        Option.Some(result)\r\n    }\r\n\r\n    /// Joins strings into one byte builder, inserting separators only between elements.\r\n    pub func join(self: List<String>, separator: String) -> String {\r\n        let output = StringBuilder.empty()\r\n        let index = 0\r\n        loop {\r\n            break if index >= self.length\r\n            branch {\r\n                index > 0 -> output.append(separator)\r\n                _ -> ()\r\n            }\r\n            output.append(self.read_at(index))\r\n            index = index + 1\r\n        }\r\n        (move output).finish()\r\n    }\r\n}\r\n\r\ntest \"list algorithms transform and aggregate values\" {\r\n    let values = [1, 2, 3].map((value: Int) -> value * 2)\r\n    assert(values == [2, 4, 6])\r\n    assert(values.fold(0, (total: Int, value: Int) -> total + value) == 12)\r\n    assert(values.reverse() == [6, 4, 2])\r\n    assert(values.slice(1, 3) == [4, 6])\r\n    assert(values.take(-1) == [])\r\n    assert(values.take(99) == values)\r\n    assert(values.get(-1) == Option.None)\r\n    assert(values.get(3) == Option.None)\r\n    assert(values.last() == Option.Some(6))\r\n    assert([[1, 2], [], [3]].flatten() == [1, 2, 3])\r\n    assert([\"λ\", \"\", \"🙂\"].join(\"|\") == \"λ||🙂\")\r\n    ()\r\n}\r\n"), origin: Embedded }, "core.option": Module { name: "core.option", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/option.fos"), program: Some(Program { documentation: Some("Optional values and transformations that preserve absence."), imports: [Import { span: 64..85, path: ["core", "functions"], alias: No