ime(value.time()) }\n\n/// Formats an ISO UTC offset, using `Z` for zero.\npub func offset(value: Offset) -> String {\n    let seconds = value.seconds()\n    return \"Z\" if seconds == 0\n    let sign = branch { seconds < 0 -> \"-\" _ -> \"+\" }\n    let absolute = seconds.absolute()\n    let hour = absolute / 3600\n    let after_hour = absolute - hour * 3600\n    let minute = after_hour / 60\n    let second = after_hour - minute * 60\n    branch {\n        second == 0 -> sign + pad(hour, 2) + \":\" + pad(minute, 2)\n        _ -> sign + pad(hour, 2) + \":\" + pad(minute, 2) + \":\" + pad(second, 2)\n    }\n}\n\n/// Formats an exact instant as an RFC-3339 UTC timestamp.\npub func instant(value: Instant) -> String {\n    date_time(DateTime.from_epoch_parts(value.epoch_seconds(), value.nanosecond())) + \"Z\"\n}\n\n/// Formats a fixed-offset date-time with its numeric offset.\npub func offset_date_time(value: OffsetDateTime) -> String {\n    date_time(value.local()) + offset(value.offset())\n}\n\n/// Formats a zoned date-time losslessly with its numeric offset and zone identifier.\npub func zoned_date_time(value: ZonedDateTime) -> String {\n    date_time(value.local()) + offset(value.offset()) + \"[\" + value.zone_id() + \"]\"\n}\n\n/// Parses an ISO date in `YYYY-MM-DD` form.\npub func parse_date(source: String) -> Result<Date, FormatError> {\n    let year = parse_digits(source, 0, 4)\n    let month = parse_digits(source, 5, 7)\n    let day = parse_digits(source, 8, 10)\n    branch {\n        source.length != 10 -> invalid_date(move source, \"date must use YYYY-MM-DD\")\n        source.slice(4, 5) != \"-\" || source.slice(7, 8) != \"-\" -> invalid_date(move source, \"date separators must use YYYY-MM-DD\")\n        _ -> parsed_date(move source, year, month, day)\n    }\n}\n\n/// Parses an ISO clock time in `HH:MM:SS` form with an optional fractional second.\npub func parse_time(source: String) -> Result<TimeOfDay, FormatError> {\n    let hour = parse_digits(source, 0, 2)\n    let minute = parse_digits(source, 3, 5)\n    let second = parse_digits(source, 6, 8)\n    let fraction = fractional_nanoseconds(source, 9, source.length)\n    branch {\n        source.length < 8 -> invalid_time(move source, \"time must include HH:MM:SS\")\n        source.slice(2, 3) != \":\" || source.slice(5, 6) != \":\" -> invalid_time(move source, \"time separators must use HH:MM:SS\")\n        source.length == 8 -> parsed_time(move source, hour, minute, second, 0)\n        source.slice(8, 9) != \".\" -> invalid_time(move source, \"fractional seconds must follow a decimal point\")\n        source.length > 18 -> invalid_time(move source, \"fractional seconds support at most nine digits\")\n        _ -> parsed_time(move source, hour, minute, second, fraction)\n    }\n}\n\n/// Parses an ISO civil date-time separated by `T`.\npub func parse_date_time(source: String) -> Result<DateTime, FormatError> {\n    let parsed_date_value = parse_date(source.slice(0, 10))\n    let parsed_time_value = parse_time(source.slice(11, source.length))\n    branch {\n        source.length < 19 -> invalid_date_time(move source, \"date-time must include a date, T, and clock time\")\n        source.slice(10, 11) != \"T\" -> invalid_date_time(move source, \"date and time must be separated by T\")\n        _ -> combine_date_time(move source, move parsed_date_value, move parsed_time_value)\n    }\n}\n\n/// Parses `Z` or a signed `HH:MM[:SS]` UTC offset.\npub func parse_offset(source: String) -> Result<Offset, FormatError> {\n    return Result.Ok(Offset.utc()) if source == \"Z\"\n    let hour = parse_digits(source, 1, 3)\n    let minute = parse_digits(source, 4, 6)\n    let second = branch { source.length == 9 -> parse_digits(source, 7, 9) _ -> 0 }\n    branch {\n        source.length != 6 && source.length != 9 -> invalid_offset(move source, \"offset must use Z or signed HH:MM[:SS]\")\n        source.slice(0, 1) != \"+\" && source.slice(0, 1) != \"-\" -> invalid_offset(move source, \"offset must begin with + or -\")\n        source.slice(3, 4) != \":\" -> invalid_offset(move source, \"offset must separate hours and minutes with a colon\")\n        source.length == 9 && source.slice(6, 7) != \":\" -> invalid_offset(move source, \"offset seconds must follow a colon\")\n        _ -> parsed_offset(move source, hour, minute, second)\n    }\n}\n\n/// Parses an RFC-3339 instant with `Z` or a numeric UTC offset.\npub func parse_instant(source: String) -> Result<Instant, FormatError> {\n    branch {\n        source.length < 20 -> invalid_instant(move source, \"instant must include a date, time, and UTC offset\")\n        source.slice(source.length - 1, source.length) == \"Z\" -> instant_from_parts(source.slice(0, source.length - 1), \"Z\", move source)\n        source.length >= 25 && offset_sign_at?(source, source.length - 6) -> instant_from_parts(source.slice(0, source.length - 6), source.slice(source.length - 6, source.length), move source)\n        source.length >= 28 && offset_sign_at?(source, source.length - 9) -> instant_from_parts(source.slice(0, source.length - 9), source.slice(source.length - 9, source.length), move source)\n        _ -> invalid_instant(move source, \"instant must end in Z or a numeric UTC offset\")\n    }\n}\n\n/// Returns whether the indexed character begins a numeric UTC offset.\nfunc offset_sign_at?(source: String, index: Int) -> Bool {\n    source.slice(index, index + 1) == \"+\" || source.slice(index, index + 1) == \"-\"\n}\n\n/// Converts validated date fields into a typed date result.\nfunc parsed_date(source: String, year: Int, month: Int, day: Int) -> Result<Date, FormatError> {\n    return invalid_date(move source, \"date contains a non-decimal field\") if year < 0 || month < 0 || day < 0\n    branch Date.from(year, month, day) {\n        Result.Ok(value) -> Result.Ok(value)\n        Result.Error(error) -> invalid_date(move source, move error.message)\n    }\n}\n\n/// Converts validated time fields into a typed clock result.\nfunc parsed_time(source: String, hour: Int, minute: Int, second: Int, nanosecond: Int) -> Result<TimeOfDay, FormatError> {\n    return invalid_time(move source, \"time contains a non-decimal field\") if hour < 0 || minute < 0 || second < 0 || nanosecond < 0\n    branch TimeOfDay.from(hour, minute, second, nanosecond) {\n        Result.Ok(value) -> Result.Ok(value)\n        Result.Error(error) -> invalid_time(move source, move error.message)\n    }\n}\n\n/// Combines independently parsed date and time results.\nfunc combine_date_time(source: String, parsed_date: Result<Date, FormatError>, parsed_time: Result<TimeOfDay, FormatError>) -> Result<DateTime, FormatError> [consume parsed_date, consume parsed_time] {\n    let date = try move parsed_date\n    let time = try move parsed_time\n    Result.Ok(DateTime.from(move date, move time))\n}\n\n/// Converts validated offset fields into a typed offset result.\nfunc parsed_offset(source: String, hour: Int, minute: Int, second: Int) -> Result<Offset, FormatError> {\n    return invalid_offset(move source, \"offset contains a non-decimal field\") if hour < 0 || minute < 0 || second < 0\n    return invalid_offset(move source, \"offset minute and second fields must be below 60\") if minute > 59 || second > 59\n    let magnitude = hour * 3600 + minute * 60 + second\n    let signed = branch { source.slice(0, 1) == \"-\" -> -magnitude _ -> magnitude }\n    branch Offset.from_seconds(signed) {\n        Result.Ok(value) -> Result.Ok(value)\n        Result.Error(error) -> invalid_offset(move source, move error.message)\n    }\n}\n\n/// Combines a parsed civil value and offset into an exact instant.\nfunc instant_from_parts(local_source: String, offset_source: String, source: String) -> Result<Instant, FormatError> {\n    let local = try parse_date_time(move local_source)\n    let offset = try parse_offset(move offset_source)\n    Result.Ok(OffsetDateTime.from_local(local, move offset).instant())\n}\n\n/// Parses decimal digits in one half-open source range, returning -1 on failure.\nfunc parse_digits(source: String, start: Int, end: Int) -> Int {\n    parse_digits_into(source, start, end, 0)\n}\n\n/// Accumulates decimal digits in one source range.\nfunc parse_digits_into(source: String, index: Int, end: Int, value: Int) -> Int {\n    return value if index >= end\n    let character = source.slice(index, index + 1)\n    return -1 if character.empty?\n    let digit = character.head.as_int() - 48\n    return -1 if digit < 0 || digit > 9\n    parse_digits_into(source, index + 1, end, value * 10 + digit)\n}\n\n/// Scales one to nine decimal fraction digits to nanoseconds.\nfunc fractional_nanoseconds(source: String, start: Int, end: Int) -> Int {\n    let parsed = parse_digits(source, start, end)\n    branch {\n        parsed < 0 -> -1\n        _ -> parsed * 10.power(9 - (end - start))\n    }\n}\n\n/// Pads a nonnegative number to a minimum decimal width.\nfunc pad(value: Int, width: Int) -> String { pad_text(value.as_string(), width) }\n\n/// Prepends zeroes until text reaches a minimum width.\nfunc pad_text(value: String, width: Int) -> String {\n    branch { value.length >= width -> value _ -> pad_text(\"0\" + value, width) }\n}\n\n/// Formats an ISO year with at least four digits.\nfunc format_year(year: Int) -> String {\n    branch { year < 0 -> \"-\" + pad((-year), 4) _ -> pad(year, 4) }\n}\n\n/// Removes insignificant zeroes from a nine-digit fractional second.\nfunc trim_fraction(value: String) -> String {\n    branch {\n        value.empty? -> value\n        value.ends_with?(\"0\") -> trim_fraction(value.slice(0, value.length - 1))\n        _ -> value\n    }\n}\n\n/// Constructs a date parse error.\nfunc invalid_date(value: String, message: String) -> Result<Date, FormatError> {\n    Result.Error(FormatError { value, message })\n}\n\n/// Constructs a time parse error.\nfunc invalid_time(value: String, message: String) -> Result<TimeOfDay, FormatError> {\n    Result.Error(FormatError { value, message })\n}\n\n/// Constructs a date-time parse error.\nfunc invalid_date_time(value: String, message: String) -> Result<DateTime, FormatError> {\n    Result.Error(FormatError { value, message })\n}\n\n/// Constructs an offset parse error.\nfunc invalid_offset(value: String, message: String) -> Result<Offset, FormatError> {\n    Result.Error(FormatError { value, message })\n}\n\n/// Constructs an instant parse error.\nfunc invalid_instant(value: String, message: String) -> Result<Instant, FormatError> {\n    Result.Error(FormatError { value, message })\n}\n\ntest \"ISO civil values parse and format without losing precision\" {\n    branch parse_date_time(\"2024-02-29T23:59:58.123400\") {\n        Result.Error(_) -> {\n            assert(false, \"valid ISO date-time was rejected\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(date_time(move value) == \"2024-02-29T23:59:58.1234\")\n            ()\n        }\n    }\n}\n\ntest \"RFC-3339 instants normalize numeric offsets\" {\n    branch parse_instant(\"1970-01-01T02:00:00+02:00\") {\n        Result.Error(_) -> {\n            assert(false, \"valid offset instant was rejected\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.equal?(Instant.epoch()))\n            assert(instant(move value) == \"1970-01-01T00:00:00Z\")\n            ()\n        }\n    }\n}\n\ntest \"portable parsers reject invalid calendar and offset fields\" {\n    assert(parse_date(\"2023-02-29\").error?())\n    assert(parse_time(\"24:00:00\").error?())\n    assert(parse_offset(\"+25:00\").error?())\n}\n\ntest \"ISO formatters cover partial offsets and zoned annotations\" {\n    assert(date(Date.from_epoch_day(0)) == \"1970-01-01\")\n    assert(time(TimeOfDay.midnight()) == \"00:00:00\")\n    let offset_value = branch parse_offset(\"-05:30:15\") { Result.Ok(value) -> value Result.Error(_) -> Offset.utc() }\n    assert(offset(offset_value) == \"-05:30:15\")\n    let local = DateT