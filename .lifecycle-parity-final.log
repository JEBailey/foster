: Spanned { expression: Integer(1), span: 8602..8603 } }, span: 8601..8603 }] }, span: 8588..8604 }, name: "error?" }, span: 8588..8611 }, arguments: [] }, span: 8588..8613 }, message: None }, span: 8581..8614 }, Spanned { value: Assert { condition: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("source"), span: 8626..8632 }, name: "bytes" }, span: 8626..8638 }, arguments: [Spanned { expression: Integer(1048577), span: 8639..8646 }] }, span: 8626..8647 }, name: "error?" }, span: 8626..8654 }, arguments: [] }, span: 8626..8656 }, message: None }, span: 8619..8657 }, Spanned { value: Expr(Spanned { expression: Unit, span: 8662..8664 }), span: 8662..8664 }] } }] }), source: Some("//! Random-source contracts, operating-system randomness, and unbiased uniform integer operations.\n\nimport core.bytes\nimport core.result\n\n/// Describes invalid random requests or unavailable host entropy.\npub type RandomError = {\n    pub operation: String\n    pub value: Int\n    pub message: String\n}\n\n/// A stateful source of uniformly distributed nonnegative integers.\n///\n/// `next` must return a value in the inclusive range from zero through `maximum`. Every value in\n/// that range must be equally likely. Source failure is explicit so host entropy and deterministic\n/// generators share one contract without hiding environmental errors.\npub type RandomSource = {\n    /// Returns the next uniformly distributed source value.\n    pub func next(self) -> Result<Int, RandomError> [mut self]\n    /// Returns the inclusive maximum value produced by `next`.\n    pub func maximum(self) -> Int\n}\n\n/// A random source whose deterministic state can be reset from an integer seed.\npub type SeedableRandom = & RandomSource & {\n    /// Resets this source to the sequence selected by `seed`.\n    pub func reseed(self, seed: Int) -> () [mut self]\n}\n\n/// A random source which can derive another deterministic stream.\npub type SplittableRandom = & RandomSource & {\n    /// Advances this source and returns a separately owned derived stream.\n    pub func split(self) -> RandomSource [mut self]\n}\n\n/// Private namespace for operating-system entropy.\ntype RandomHost = {}\n\nimpl RandomHost {\n    /// Reads bytes from the operating system's secure entropy source.\n    func bytes(count: Int) -> Result<Bytes, RandomError> = intrinsic(\"random.bytes\")\n}\n\n/// A stateless view of the operating system's secure random source.\npub type SystemRandom = & RandomSource & {\n    marker: Symbol\n}\n\nimpl SystemRandom {\n    /// Constructs an operating-system-backed random source.\n    pub func new() -> SystemRandom {\n        SystemRandom { marker: :system_random }\n    }\n\n    /// Returns up to 1,048,576 bytes from the operating system's secure entropy source.\n    pub func bytes(self: SystemRandom, count: Int) -> Result<Bytes, RandomError> [mut self] {\n        return failure(\"bytes\", count, \"random byte count must not be negative\") if count < 0\n        return failure(\"bytes\", count, \"random byte count must not exceed 1048576\") if count > 1048576\n        RandomHost.bytes(count)\n    }\n\n    /// Returns a uniformly distributed 31-bit nonnegative integer from operating-system entropy.\n    pub func next(self: SystemRandom) -> Result<Int, RandomError> [mut self] {\n        let entropy = try self.bytes(4)\n        let first = entropy[0].int.modulo(128)\n        Result.Ok(((first * 256 + entropy[1].int) * 256 + entropy[2].int) * 256 + entropy[3].int)\n    }\n\n    /// Returns the largest value produced by `SystemRandom.next`.\n    pub func maximum(self: SystemRandom) -> Int { 2147483647 }\n}\n\n/// Returns an unbiased value from `source` in the half-open range `[0, count)`.\npub func below_with(source: RandomSource, count: Int) -> Result<Int, RandomError> [mut source] {\n    return failure(\"below\", count, \"random count must be positive\") if count <= 0\n    let maximum = source.maximum()\n    return failure(\"below\", maximum, \"random source maximum must be between zero and 9223372036854775806\") if maximum < 0 || maximum == 9223372036854775807\n    let capacity = maximum + 1\n    return failure(\"below\", count, \"random count exceeds the source range\") if count > capacity\n    sample_below(source, count, capacity - capacity.modulo(count), maximum)\n}\n\n/// Returns an unbiased value from `source` in the half-open range `[start, end)`.\npub func between_with(source: RandomSource, start: Int, end: Int) -> Result<Int, RandomError> [mut source] {\n    let width = range_width(start, end, source.maximum() + 1)\n    return failure(\"between\", end, \"random range must be nonempty and fit the source\") if width <= 0\n    Result.Ok(start + try below_with(source, width))\n}\n\n/// Returns an unbiased operating-system-backed value in `[0, count)`.\npub func below(count: Int) -> Result<Int, RandomError> {\n    below_with(SystemRandom.new(), count)\n}\n\n/// Returns an unbiased operating-system-backed value in `[start, end)`.\npub func between(start: Int, end: Int) -> Result<Int, RandomError> {\n    between_with(SystemRandom.new(), start, end)\n}\n\n/// Repeats a source draw when reducing it modulo `count` would introduce bias.\nfunc sample_below(source: RandomSource, count: Int, limit: Int, maximum: Int) -> Result<Int, RandomError> [mut source] {\n    let value = try source.next()\n    return failure(\"next\", value, \"random source returned a value outside its advertised range\") if value < 0 || value > maximum\n    return sample_below(source, count, limit, maximum) if value >= limit\n    Result.Ok(value.modulo(count))\n}\n\n/// Computes a safe positive range width, or minus one when the range is invalid or too wide.\nfunc range_width(start: Int, end: Int, capacity: Int) -> Int {\n    return -1 if start >= end\n    branch {\n        start >= 0 -> bounded_width(end - start, capacity)\n        end <= 0 -> branch {\n            start == (-9223372036854775807 - 1) && end == 0 -> -1\n            _ -> bounded_width(end - start, capacity)\n        }\n        start < -capacity -> -1\n        end > capacity -> -1\n        (-start) > capacity - end -> -1\n        _ -> (-start) + end\n    }\n}\n\n/// Returns `width` when it fits the source capacity, or minus one otherwise.\nfunc bounded_width(width: Int, capacity: Int) -> Int {\n    branch { width <= capacity -> width _ -> -1 }\n}\n\n/// Constructs a typed random error for any failed result shape.\nfunc failure<T>(operation: String, value: Int, message: String) -> Result<T, RandomError> {\n    Result.Error(RandomError { operation, value, message })\n}\n\n/// Deterministic source used to exercise generic random operations.\ntype RandomTestSource = & RandomSource & {\n    value: Int\n    maximum_value: Int\n}\n\nimpl RandomTestSource {\n    /// Returns the current test value and advances cyclically.\n    func next(self: RandomTestSource) -> Result<Int, RandomError> [mut self.value, read self.maximum_value] {\n        let value = self.value\n        self.value = branch { value >= self.maximum_value -> 0 _ -> value + 1 }\n        Result.Ok(value)\n    }\n\n    /// Returns the configured test-source maximum.\n    func maximum(self: RandomTestSource) -> Int { self.maximum_value }\n}\n\ntest \"uniform integer operations use half-open bounds and validate requests\" {\n    // Six and seven are rejected for a count of three, proving modulo bias is avoided.\n    let source = RandomTestSource { value: 6, maximum_value: 7 }\n    branch below_with(source, 3) {\n        Result.Error(_) -> {\n            assert(false, \"valid bounded draw failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value == 0)\n            ()\n        }\n    }\n    branch between_with(source, -2, 2) {\n        Result.Error(_) -> {\n            assert(false, \"valid signed range failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value >= -2 && value < 2)\n            ()\n        }\n    }\n    assert(below_with(source, 0).error?())\n    assert(between_with(source, 3, 3).error?())\n    assert(between_with(source, -10, 10).error?())\n    assert(below_with(RandomTestSource { value: 0, maximum_value: -1 }, 1).error?())\n    assert(below_with(RandomTestSource { value: 0, maximum_value: 9223372036854775807 }, 1).error?())\n    assert(below_with(RandomTestSource { value: 8, maximum_value: 7 }, 3).error?())\n    ()\n}\n\ntest \"system randomness returns bounded values and requested bytes\" {\n    let source = SystemRandom.new()\n    branch source.bytes(16) {\n        Result.Error(_) -> {\n            assert(false, \"system entropy was unavailable\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.length == 16)\n            ()\n        }\n    }\n    branch below_with(source, 20) {\n        Result.Error(_) -> {\n            assert(false, \"system bounded draw failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value >= 0 && value < 20)\n            ()\n        }\n    }\n    branch below(1) {\n        Result.Error(_) -> {\n            assert(false, \"system convenience draw failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value == 0)\n            ()\n        }\n    }\n    branch between(-3, -2) {\n        Result.Error(_) -> {\n            assert(false, \"system signed convenience draw failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value == -3)\n            ()\n        }\n    }\n    assert(source.bytes(-1).error?())\n    assert(source.bytes(1048577).error?())\n    ()\n}\n"), origin: Embedded }, "std.random.distribution": Module { name: "std.random.distribution", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/random/distribution.fos"), program: Some(Program { documentation: Some("Typed probab