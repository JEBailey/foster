T>\n}\n\nimpl Set {\n    /// Creates an empty set.\n    pub func empty<T>() -> Set<T> {\n        Set { values: [] }\n    }\n\n    /// Creates a set containing each input value once.\n    pub func from<T>(values: List<T>) -> Set<T> [consume values] {\n        Set { values: unique(move values, []) }\n    }\n\n    /// Returns the number of values in the set.\n    pub func length<T>(self: Set<T>) -> Int {\n        self.values.length\n    }\n\n    /// Returns whether the set contains no values.\n    pub func empty?<T>(self: Set<T>) -> Bool {\n        self.values.empty?\n    }\n\n    /// Creates an independent iterator in insertion order.\n    pub func iterator<T>(self: Set<T>) -> Iterator<T> {\n        self.values.iterator()\n    }\n\n    /// Returns whether `value` is present.\n    pub func contains?<T>(self: Set<T>, value: T) -> Bool {\n        contains_value?(self.values, value)\n    }\n\n    /// Returns a set containing `value`.\n    pub func insert<T>(self: Set<T>, value: T) -> Set<T> [consume self, consume value] {\n        branch {\n            self.contains?(value) -> self\n            _ -> Set { values: self.values.append(value) }\n        }\n    }\n\n    /// Returns a set without `value`.\n    pub func remove<T>(self: Set<T>, value: T) -> Set<T> [consume self] {\n        Set { values: without(move self.values, value, []) }\n    }\n}\n\ntest \"sets preserve insertion order while removing duplicates\" {\n    let values = Set.from([1, 2, 1])\n    assert(values.length() == 2)\n    assert(values.contains?(1))\n    assert(values.contains?(2))\n    ()\n}\n\n/// Searches the remaining backing values for `expected`.\nfunc contains_value?<T>(values: List<T>, expected: T) -> Bool {\n    branch {\n        values.empty? -> false\n        values.head == expected -> true\n        _ -> contains_value?(values.rest, expected)\n    }\n}\n\n/// Appends values not already present in the result accumulator.\nfunc unique<T>(remaining: List<T>, result: List<T>) -> List<T> [consume remaining, consume result] {\n    branch {\n        remaining.empty? -> result\n        contains_value?(result, remaining.head) -> unique(remaining.rest, move result)\n        _ -> unique(remaining.rest, result.append(remaining.head))\n    }\n}\n\n/// Copies values other than `expected` into the result accumulator.\nfunc without<T>(remaining: List<T>, expected: T, result: List<T>) -> List<T> [consume remaining, consume result] {\n    branch {\n        remaining.empty? -> result\n        remaining.head == expected -> without(remaining.rest, expected, move result)\n        _ -> without(remaining.rest, expected, result.append(remaining.head))\n    }\n}\n"), origin: Embedded }, "std.collections.stack": Module { name: "std.collections.stack", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/collections/stack.fos"), program: Some(Program { documentation: Some("Persistent last-in, first-out stacks backed by Foster lists."), imports: [Import { span: 66..88, path: ["std", "collections"], alias: None }, Import { span: 89..104, path: ["std", "iter"], alias: None }, Import { span: 105..123, path: ["core", "option"], alias: None }], constants: [], records: [RecordDecl { span: 162..223, documentation: Some("A last-in, first-out collection."), name: "Stack", public: true, intrinsic: false, parameters: ["T"], compositions: [Named("Collection", [Named("T", [])])], fields: [RecordField { name: "values", public: false, ty: Named("List", [Named("T", [])]) }], methods: [] }, RecordDecl { span: 1303..1375, documentation: Some("The result of removing one value from a stack."), name: "StackItem", public: true, intrinsic: false, parameters: ["T"], compositions: [], fields: [RecordField { name: "value", public: true, ty: Named("T", []) }, RecordField { name: "remaining", public: true, ty: Named("Stack", [Named("T", [])]) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 274..342, documentation: Some("Creates an empty stack."), name: "Stack