xpression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Bytes"), span: 7776..7781 }, name: "from" }, span: 7776..7786 }, arguments: [Spanned { expression: List([Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Byte"), span: 7788..7792 }, name: "unchecked" }, span: 7788..7802 }, arguments: [Spanned { expression: Integer(240), span: 7803..7806 }] }, span: 7788..7807 }, Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Byte"), span: 7809..7813 }, name: "unchecked" }, span: 7809..7823 }, arguments: [Spanned { expression: Integer(159), span: 7824..7827 }] }, span: 7809..7828 }]), span: 7787..7829 }] }, span: 7776..7830 }, name: "utf8_valid?" }, span: 7776..7842 }, arguments: [] }, span: 7776..7844 } }, span: 7775..7844 }, message: None }, span: 7768..7845 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Member { object: Spanned { expression: String("abcdef"), span: 7857..7865 }, name: "bytes" }, span: 7857..7871 }, name: "slice" }, span: 7857..7877 }, arguments: [Spanned { expression: Integer(2), span: 7878..7879 }, Spanned { expression: Integer(4), span: 7881..7882 }] }, span: 7857..7883 }, name: "hex" }, span: 7857..7887 }, arguments: [] }, span: 7857..7889 }, operator: Equal, right: Spanned { expression: String("6364"), span: 7893..7899 } }, span: 7857..7899 }, message: None }, span: 7850..7900 }, Spanned { value: Expr(Spanned { expression: Unit, span: 7905..7907 }), span: 7905..7907 }] } }] }), source: Some("//! Immutable binary data, encoding conversions, and byte-oriented queries.\n\nimport core.byte\nimport core.list\nimport core.result\nimport core.string\n\n/// Private host-backed compact byte storage.\nintrinsic type RawBytes\n\n/// Private namespace for host-backed byte operations.\ntype BytesHost = {}\n\nimpl BytesHost {\n    /// Packs a Foster byte list into compact storage.\n    func from_list(values: List<Byte>) -> Bytes [consume values] = intrinsic(\"bytes.from_list\")\n    /// Expands compact storage into a Foster list.\n    func to_list(values: Bytes) -> List<Byte> = intrinsic(\"bytes.to_list\")\n}\n\n/// Immutable binary data backed by compact private host storage.\npub type Bytes = {\n    value: RawBytes\n}\n\n/// Describes a failed UTF-8 decoding operation.\npub type Utf8Error = {\n    pub offset: Int\n    pub message: String\n}\n\n/// Describes malformed hexadecimal byte text.\npub type HexError = {\n    pub offset: Int\n    pub message: String\n}\n\nimpl Bytes {\n    /// Returns an independent immutable byte value.\n    pub func copy(self: Bytes) -> self [read self] { BytesHost.from_list(BytesHost.to_list(self)) }\n\n    /// Creates an empty immutable byte sequence.\n    pub func empty() -> Bytes {\n        BytesHost.from_list([])\n    }\n\n    /// Packs a list of bytes into compact immutable storage.\n    pub func from(values: List<Byte>) -> Bytes [consume values] {\n        BytesHost.from_list(move values)\n    }\n\n    /// Decodes an even-length hexadecimal string.\n    pub func from_hex(value: String) -> Result<Bytes, HexError> {\n        let characters = value.code_points()\n        let output = []\n        let offset = 0\n        loop {\n            break if offset >= characters.length\n            return Result.Error(HexError {\n                offset: offset + 1\n                message: \"hexadecimal byte text must have even length\"\n            }) if offset + 1 == characters.length\n            let high = hex_nibble(characters[offset])\n            return invalid_hex(offset, characters[offset]) if high < 0\n            let low = hex_nibble(characters[offset + 1])\n            return invalid_hex(offset + 1, characters[offset + 1]) if low < 0\n            output.push(Byte.unchecked(high * 16 + low))\n            offset = offset + 2\n        }\n        Result.Ok(Bytes.from(move output))\n    }\n\n    /// Concatenates two immutable byte sequences.\n    pub func concat(self: Bytes, other: Bytes) -> Bytes {\n        let output = self.list()\n        let index = 0\n        loop {\n            break if index >= other.length\n            output.push(other[index])\n            index = index + 1\n        }\n        Bytes.from(move output)\n    }\n\n    /// Returns bytes in the half-open range `start..end`.\n    pub func slice(self: Bytes, start: Int, end: Int) -> Bytes {\n        assert(start >= 0 && end >= start && end <= self.length, \"byte slice is out of bounds\")\n        let output = []\n        let index = start\n        loop {\n            break if index >= end\n            output.push(self[index])\n            index = index + 1\n        }\n        Bytes.from(move output)\n    }\n\n    /// Expands compact bytes into a Foster list.\n    pub func list(self: Bytes) -> List<Byte> {\n        BytesHost.to_list(self)\n    }\n\n    /// Encodes bytes as lowercase hexadecimal text.\n    pub func hex(self: Bytes) -> String {\n        let output = []\n        let index = 0\n        loop {\n            break if index >= self.length\n            let value = self[index].int\n            output.push(hex_digit(value / 16))\n            output.push(hex_digit(value - value / 16 * 16))\n            index = index + 1\n        }\n        branch String.from_utf8(Bytes.from(move output)) {\n            Result.Ok(text) -> text\n            Result.Error(_) -> {\n                assert(false, \"hexadecimal output must be valid UTF-8\")\n                \"\"\n            }\n        }\n    }\n\n    /// Returns whether two byte sequences contain identical values.\n    pub func equal?(self: Bytes, other: Bytes) -> Bool {\n        return false if self.length != other.length\n        let index = 0\n        loop {\n            break if index >= self.length\n            return false if self[index] != other[index]\n            index = index + 1\n        }\n        true\n    }\n\n    /// Computes a deterministic hash over the byte sequence.\n    pub func hash(self: Bytes) -> Int {\n        let state = 17\n        let index = 0\n        loop {\n            break if index >= self.length\n            state = state + self[index]\n            index = index + 1\n        }\n        state\n    }\n\n    /// Checks UTF-8 scalar boundaries without allocating decoded text or copied suffixes.\n    pub func utf8_valid?(self: Bytes) -> Bool {\n        let index = 0\n        loop {\n            break if index >= self.length\n            let first = self[index].int\n            let width = branch {\n                first <= 127 -> 1\n                first >= 194 && first <= 223 -> 2\n                first >= 224 && first <= 239 -> 3\n                first >= 240 && first <= 244 -> 4\n                _ -> 0\n            }\n            return false if width == 0 || width > self.length - index\n            branch {\n                width > 1 -> {\n                    let second = self[index + 1].int\n                    return false if second < 128 || second > 191\n                    return false if first == 224 && second < 160\n                    return false if first == 237 && second > 159\n                    return false if first == 240 && second < 144\n                    return false if first == 244 && second > 143\n                    let tail = 2\n                    loop {\n                        break if tail >= width\n                        let continuation = self[index + tail].int\n                        return false if continuation < 128 || continuation > 191\n                        tail = tail + 1\n                    }\n                    ()\n                }\n                _ -> ()\n            }\n            index = index + width\n        }\n        true\n    }\n}\n\ntest \"bytes round-trip UTF-8 and hexadecimal text\" {\n    let encoded = \"Foster λ\".bytes\n    assert(encoded.hex() == \"466f7374657220cebb\")\n    let valid = branch String.from_utf8(move encoded) {\n        Result.Ok(value) -> value == \"Foster λ\"\n        Result.Error(_) -> false\n    }\n    assert(valid)\n}\n\n/// Converts one hexadecimal digit to its integer nibble, or `-1` when invalid.\nfunc hex_nibble(character: CodePoint) -> Int {\n    let value = character.as_int()\n    branch {\n        value >= 48 && value <= 57 -> value - 48\n        value >= 97 && value <= 102 -> value - 87\n        value >= 65 && value <= 70 -> value - 55\n        _ -> -1\n    }\n}\n\n/// Constructs a hexadecimal decoding error at the supplied character offset.\nfunc invalid_hex(offset: Int, character: CodePoint) -> Result<Bytes, HexError> {\n    Result.Error(HexError {\n        offset\n        message: \"invalid hexadecimal digit `\" + character.string + \"`\"\n    })\n}\n\n/// Encodes one integer nibble as an ASCII byte.\nfunc hex_digit(value: Int) -> Byte {\n    branch {\n        value < 10 -> Byte.unchecked(48 + value)\n        _ -> Byte.unchecked(87 + value)\n    }\n}\n\ntest \"UTF-8 validation rejects invalid boundaries and truncated sequences\" {\n    assert(Bytes.from([Byte.unchecked(0)]).utf8_valid?())\n    assert(\"λ€🙂\".bytes.utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(128)]).utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(192), Byte.unchecked(128)]).utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(224), Byte.unchecked(159), Byte.unchecked(191)]).utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(237), Byte.unchecked(160), Byte.unchecked(128)]).utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(244), Byte.unchecked(144), Byte.unchecked(128), Byte.unchecked(128)]).utf8_valid?())\n    assert(!Bytes.from([Byte.unchecked(240), Byte.unchecked(159)]).utf8_valid?())\n    assert(\"abcdef\".bytes.slice(2, 4).hex() == \"6364\")\n    ()\n}\n"), origin: Embedded }, "core.bytes.buffer": Module { name: "core.bytes.buffer", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/bytes/buffer.fos"), program: Some(Program { documentation: Some("Mutable byte accumulation implemented over Foster's lower-level list storage."), imports: [Import { span: 83..100, path: ["core", "bytes"], alias: None }, Import { span: 101..117, path: ["core", "list"], alias: None }], constants: [], records: [RecordDecl { span: 331..378, documentation: Some("Mutable byte construction storage.\n\nCapacity is an implementation hint: the Foster implementation reports its current length and\naccepts reservations without making allocation strategy observable."), name: "ByteBuffer", public: true, intrinsic: false, parameters: [], compositions: [], fields: [RecordField { name: "value", public: false, ty: Named("List", [Named("Byte", [])]) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 448..519, documentation: Some("Creates an empty mutable byte buffer."), name: "ByteBuffer.empty", owner: Some("ByteBuffer"), receiver: false, public: true, intrinsic: None, type_parameters: [], groups: [], parameters: [], return_type: Some(Named("ByteBuffer", [])), effects_explicit: false, effects: [], effect_spans: [], suspends: false, suspend_span: None, body: Block { items: [Spanned { value: Expr(Spanned { expression: Record { constructor: Spanned { expression: Name("ByteBuffer"), span: 489..499 }, fields: [RecordFieldValue { name: "value", value: Spanned { expression: List([]), span: 509..511 } }] }, span: 489..513 }), span: 489..513 }] } }, Function { body_is_recovery_stub: false, span: 582..740, documentation: Some("Creates an empty buffer with an allocation hint."), name: "ByteBuffer.with_capacity", owner: Some("ByteBuffer"), receiver: false, public: true, intrinsic: None, type_parameters: [], groups: [], parameters: [Parameter { span: 605..613, name: "capacity", ty: Some(Named("Int", [])), type_span: Some(615..61