ues identify the same exact instant.\n    pub func equal?(self: ZonedDateTime, other: ZonedDateTime) -> Bool {\n        self.instant_value.equal?(other.instant_value)\n    }\n}\n\n/// Selects one instant from an explicit local-time resolution.\nfunc select_resolution(resolution: LocalResolution, zone: TimeZone, disambiguation: Disambiguation) -> Result<ZonedDateTime, ZoneError> {\n    branch resolution {\n        LocalResolution.Unique(instant) -> Result.Ok(ZonedDateTime { instant_value: instant, zone_value: zone })\n        LocalResolution.Ambiguous(options) -> branch disambiguation {\n            Disambiguation.Compatible -> Result.Ok(ZonedDateTime { instant_value: options.earlier(), zone_value: zone })\n            Disambiguation.Earlier -> Result.Ok(ZonedDateTime { instant_value: options.earlier(), zone_value: zone })\n            Disambiguation.Later -> Result.Ok(ZonedDateTime { instant_value: options.later(), zone_value: zone })\n            Disambiguation.Reject -> Result.Error(ZoneError { zone: zone.id(), message: \"local time is ambiguous in this zone\" })\n        }\n        LocalResolution.Skipped(options) -> branch disambiguation {\n            Disambiguation.Compatible -> Result.Ok(ZonedDateTime { instant_value: options.after(), zone_value: zone })\n            Disambiguation.Earlier -> Result.Ok(ZonedDateTime { instant_value: options.before(), zone_value: zone })\n            Disambiguation.Later -> Result.Ok(ZonedDateTime { instant_value: options.after(), zone_value: zone })\n            Disambiguation.Reject -> Result.Error(ZoneError { zone: zone.id(), message: \"local time does not exist in this zone\" })\n        }\n    }\n}\n\n/// Converts a civil date-time under a fixed offset into an exact instant.\nfunc instant_from_local(local: DateTime, offset: Offset) -> Instant {\n    instant_from_parts(local.epoch_seconds() - offset.seconds(), local.nanosecond())\n}\n\n/// Extracts an instant from already validated canonical parts.\nfunc instant_from_parts