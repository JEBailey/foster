.2442 } }, span: 2383..2442 }, Spanned { value: Bind { name: "valid", value: Spanned { expression: Branch { subject: Some(Spanned { expression: Name("mapped"), span: 2466..2472 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Option", "Some"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 2495..2500 }] }, span: 2483..2501 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Binary { left: Spanned { expression: Name("value"), span: 2505..2510 }, operator: Equal, right: Spanned { expression: Integer(21), span: 2514..2516 } }, span: 2505..2516 }), span: 2505..2516 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Option", "None"], enum_accessor: true, fields: [] }, span: 2525..2536 }), body: Block { items: [Spanned { value: Expr(Spanned { expression: Bool(false), span: 2540..2545 }), span: 2540..2545 }] } }] }, span: 2459..2551 } }, span: 2447..2551 }, Spanned { value: Assert { condition: Spanned { expression: Name("valid"), span: 2563..2568 }, message: None }, span: 2556..2569 }] } }] }), source: Some("//! Optional values and transformations that preserve absence.\n\nimport core.functions\n\n/// A value that is either present as `Some(T)` or absent as `None`.\npub enum Option<T> = Some(T)\n    | None\n\nimpl Option {\n    /// Applies `transform` to a present value and preserves `None`.\n    pub func map<T, U>(self: Option<T>, transform: func(T) -> U) -> Option<U> {\n        branch self {\n            Option.Some(value) -> Option.Some(transform(value))\n            Option.None -> Option.None\n        }\n    }\n\n    /// Applies an optional-producing transform to a present value and flattens the result.\n    pub func and_then<T, U>(self: Option<T>, transform: func(T) -> Option<U>) -> Option<U> {\n        branch self {\n            Option.Some(value) -> transform(value)\n            Option.None -> Option.None\n        }\n    }\n\n    /// Returns the contained value, or `fallback` when the option is `None`.\n    pub func unwrap_or<T>(self: Option<T>, fallback: T) -> T {\n        branch self {\n            Option.Some(value) -> value\n            Option.None -> fallback\n        }\n    }\n\n    /// Returns whether the option contains a value.\n    pub func present?<T>(self: Option<T>) -> Bool {\n        branch self {\n            Option.Some(_) -> true\n            Option.None -> false\n        }\n    }\n\n    /// Returns whether the option contains no value.\n    pub func absent?<T>(self: Option<T>) -> Bool {\n        branch self {\n            Option.Some(_) -> false\n            Option.None -> true\n        }\n    }\n\n    /// Returns the contained value, or computes a fallback when the option is `None`.\n    pub func unwrap_or_else<T>(self: Option<T>, fallback: Supplier<T>) -> T {\n        branch self {\n            Option.Some(value) -> value\n            Option.None -> fallback()\n        }\n    }\n\n    /// Preserves a present value, or computes another option when this option is `None`.\n    pub func or_else<T>(self: Option<T>, fallback: Supplier<Option<T>>) -> Option<T> {\n        branch self {\n            Option.Some(value) -> Option.Some(value)\n            Option.None -> fallback()\n        }\n    }\n\n    /// Removes one layer from a nested option.\n    pub func flatten<T>(self: Option<Option<T>>) -> Option<T> {\n        branch self {\n            Option.Some(value) -> value\n            Option.None -> Option.None\n        }\n    }\n}\n\ntest \"option transformations preserve presence and absence\" {\n    let mapped = Option.Some(20).map((value: Int) -> value + 1)\n    let valid = branch mapped {\n        Option.Some(value) -> value == 21\n        Option.None -> false\n    }\n    assert(valid)\n}\n"), origin: Embedded }, "core.ordering": Module { name: "core.ordering", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/ordering.fos"), program: Some(Program { documentation: Some("Three-way ordering results and ordering t