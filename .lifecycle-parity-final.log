ve.\n    func next<T>(self: TakeIterator<T>) -> Option<T> {\n        branch {\n            self.remaining <= 0 -> Option.None\n            _ -> self.take_next()\n        }\n    }\n\n    /// Decrements a positive take limit before pulling from the source iterator.\n    func take_next<T>(self: TakeIterator<T>) -> Option<T> {\n        self.remaining = self.remaining - 1\n        self.source.next()\n    }\n}\n\nimpl Iterator {\n    /// Lazily yields at most `amount` remaining elements.\n    pub func take<T>(self: Iterator<T>, amount: Int) -> Iterator<T> [consume self] {\n        TakeIterator { source: move self, remaining: amount }\n    }\n}\n\ntest \"taking limits iterator output\" {\n    let values = [1, 2, 3].iterator().take(2).collect()\n    assert(values.length == 2)\n    assert(values[1] == 2)\n    ()\n}\n"), origin: Embedded }, "std.net": Module { name: "std.net", source_path: None, program: None, source: None, origin: Embedded }, "std.net.tcp": Module { name: "std.net.tcp", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/net/tcp.fos"), program: Some(Program { documentation: Some("Endpoint-identified TCP listeners, connections, and network errors."), imports: [Import { span: 73..90, path: ["core", "bytes"], alias: None }, Import { span: 91..113, path: ["core", "code_point"], alias: None }, Import { span: 114..129, path: ["core", "int"], alias: None }, Import { span: 130..146, path: ["core", "list"], alias: None }, Import { span: 147..165, path: ["core", "option"], alias: None }, Import { span: 166..184, path: ["core", "result"], alias: None }, Import { span: 185..203, path: ["core", "string"], alias: None }, Import { span: 204..217, path: ["std", "io"], alias: None }, Import { span: 218..237, path: ["std", "resource"], alias: None }, Import { span: 238..252, path: ["std", "uri"], alias: None }], constants: [], records: [RecordDecl { span: 301..318, documentation: Some("Private namespace for TCP host operations."), name: "TcpHost", public: false, int