\nimpl SkipIterator {\n    /// Discards the configured prefix before yielding source values.\n    func next<T>(self: SkipIterator<T>) -> Option<T> {\n        loop {\n            break if self.remaining <= 0\n            branch self.source.next() {\n                Option.Some(_) -> {\n                    self.remaining = self.remaining - 1\n                    ()\n                }\n                Option.None -> { return Option.None }\n            }\n        }\n        self.source.next()\n    }\n}\n\nimpl Iterator {\n    /// Lazily discards the first `amount` remaining elements.\n    pub func skip<T>(self: Iterator<T>, amount: Int) -> Iterator<T> [consume self] {\n        SkipIterator { source: move self, remaining: amount }\n    }\n}\n\ntest \"skipping removes an iterator prefix\" {\n    let values = [1, 2, 3].iterator().skip(2).collect()\n    assert(values.length == 1)\n    assert(values[0] == 3)\n    ()\n}\n"), origin: Embedded }, "std.iter.take": Module { name: "std.iter.take", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/iter/take.fos"), program: Some(Program { documentation: Some("Lazy limitation of an iterator to a maximum number of values."), imports: [Import { span: 67..85, path: ["core", "option"], alias: None }, Import { span: 86..101, path: ["std", "iter"], alias: None }], constants: [], records: [RecordDecl { span: 103..188, documentation: None, name: "TakeIterator", public: false, intrinsic: false, parameters: ["T"], compositions: [Named("Iterator", [Named("T", [])])], fields: [RecordField { name: "source", public: false, ty: Named("Iterator", [Named("T", [])]) }, RecordField { name: "remaining", public: false, ty: Named("Int", []) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 277..441, documentation: Some("Pulls one value while the take limit remains positive."), name: "TakeIterator.next", owner: Some("TakeIterator"), receiver: true, public: false, intrinsic: None, type_parameters: ["T"]