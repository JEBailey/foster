BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 24877..24878 }] }, span: 24864..24879 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 24904..24909 }, message: Some(Spanned { expression: String("ordered civil interval was rejected"), span: 24911..24948 }) }, span: 24897..24949 }, Spanned { value: Expr(Spanned { expression: Unit, span: 24962..24964 }), span: 24962..24964 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 24993..24998 }] }, span: 24983..24999 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 25024..25029 }, name: "days" }, span: 25024..25034 }, arguments: [] }, span: 25024..25036 }, operator: Equal, right: Spanned { expression: Integer(3), span: 25040..25041 } }, span: 25024..25041 }, message: None }, span: 25017..25042 }, Spanned { value: Assert { condition: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 25062..25067 }, name: "contains?" }, span: 25062..25077 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Date"), span: 25078..25082 }, name: "from_epoch_day" }, span: 25078..25097 }, arguments: [Spanned { expression: Integer(0), span: 25098..25099 }] }, span: 25078..25100 }] }, span: 25062..25101 }, message: None }, span: 25055..25102 }, Spanned { value: Assert { condition: Spanned { expression: Unary { operator: Not, operand: Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 25126..25131 }, name: "contains?" }, span: 25126..25141 }, arguments: [Spanned { expression: Call { callee: Spanned { expression: Member { object: Spanned { expression: Name("Date"), span: 25142..25146 }, name: "from_epoch_day" }, span: 25142..25161 }, arguments: [Spanned { expression: Integer(2), span: 25162..25163 }] }, span: 25142..25164 }] }, span: 25126..25165 } }, span: 25122..25165 }, message: None }, span: 25115..25166 }, Spanned { value: Expr(Spanned { expression: Unit, span: 25179..25181 }), span: 25179..25181 }] } }] }, span: 24780..25197 }), span: 24780..25197 }] } }] }), source: Some("//! ISO civil dates and times without an implied time zone or exact instant.\n\nimport core.ordering\nimport core.result\n\n/// Describes an invalid civil date, time, or calendar operation.\npub type CivilError = {\n    pub field: String\n    pub value: Int\n    pub message: String\n}\n\n/// Controls how calendar arithmetic handles an invalid resulting day.\npub enum Overflow = Constrain\n    | Reject\n\n/// A day of the ISO week, numbered Monday through Sunday.\npub enum Weekday = Monday\n    | Tuesday\n    | Wednesday\n    | Thursday\n    | Friday\n    | Saturday\n    | Sunday\n\n/// Calendar operations required by civil date construction and arithmetic.\npub type Calendar = {\n    /// Returns the stable calendar identifier.\n    pub func id(self) -> String\n    /// Returns whether `year` contains a leap day.\n    pub func leap_year?(self, year: Int) -> Bool\n    /// Returns the number of days in one validated month.\n    pub func days_in_month(self, year: Int, month: Int) -> Int\n}\n\n/// The proleptic ISO-8601 Gregorian calendar.\npub type IsoCalendar = & Calendar & {\n    marker: Symbol\n}\n\nimpl IsoCalendar {\n    /// Constructs the ISO calendar capability.\n    pub func new() -> IsoCalendar { IsoCalendar { marker: :iso8601 } }\n\n    /// Returns the ISO calendar identifier.\n    pub func id(self: IsoCalendar) -> String { \"iso8601\" }\n\n    /// Returns whether an ISO year contains February 29.\n    pub func leap_year?(self: IsoCalendar, year: Int) -> Bool {\n        leap_year?(year)\n    }\n\n    /// Returns the number of days in an ISO month, or zero for an invalid month.\n    pub func days_in_month(self: IsoCalendar, year: Int, month: Int) -> Int {\n        days_in_month(year, month)\n    }\n}\n\n/// A calendar-aware amount. Unlike an exact duration, days and larger units\n/// require a civil date or zoned date-time before they have an elapsed length.\npub type Span = {\n    years_value: Int\n    months_value: Int\n    weeks_value: Int\n    days_value: Int\n    hours_value: Int\n    minutes_value: Int\n    seconds_value: Int\n    nanoseconds_value: Int\n}\n\n/// Noda-style spelling for a calendar-aware span.\npub type Period = Span\n\nimpl Span {\n    /// Constructs a calendar-aware span.\n    pub func from(years: Int, months: Int, weeks: Int, days: Int, hours: Int, minutes: Int, seconds: Int, nanoseconds: Int) -> Span {\n        Span { years_value: years, months_value: months, weeks_value: weeks, days_value: days, hours_value: hours, minutes_value: minutes, seconds_value: seconds, nanoseconds_value: nanoseconds }\n    }\n\n    /// Returns a zero calendar span.\n    pub func zero() -> Span { Span.from(0, 0, 0, 0, 0, 0, 0, 0) }\n\n    /// Constructs a whole-day span.\n    pub func from_days(days: Int) -> Span { Span.from(0, 0, 0, days, 0, 0, 0, 0) }\n\n    /// Constructs a whole-month span.\n    pub func from_months(months: Int) -> Span { Span.from(0, months, 0, 0, 0, 0, 0, 0) }\n\n    /// Returns the year component.\n    pub func years(self: Span) -> Int { self.years_value }\n    /// Returns the month component.\n    pub func months(self: Span) -> Int { self.months_value }\n    /// Returns the week component.\n    pub func weeks(self: Span) -> Int { self.weeks_value }\n    /// Returns the day component.\n    pub func days(self: Span) -> Int { self.days_value }\n    /// Returns the hour component.\n    pub func hours(self: Span) -> Int { self.hours_value }\n    /// Returns the minute component.\n    pub func minutes(self: Span) -> Int { self.minutes_value }\n    /// Returns the second component.\n    pub func seconds(self: Span) -> Int { self.seconds_value }\n    /// Returns the nanosecond component.\n    pub func nanoseconds(self: Span) -> Int { self.nanoseconds_value }\n\n    /// Adds two calendar-aware spans component by component.\n    pub func add(self: Span, other: Span) -> Span {\n        Span.from(self.years_value + other.years_value, self.months_value + other.months_value, self.weeks_value + other.weeks_value, self.days_value + other.days_value, self.hours_value + other.hours_value, self.minutes_value + other.minutes_value, self.seconds_value + other.seconds_value, self.nanoseconds_value + other.nanoseconds_value)\n    }\n\n    /// Returns the component-wise inverse of this span.\n    pub func negated(self: Span) -> Span {\n        Span.from(-self.years_value, -self.months_value, -self.weeks_value, -self.days_value, -self.hours_value, -self.minutes_value, -self.seconds_value, -self.nanoseconds_value)\n    }\n}\n\n/// An ISO calendar date without a time or time zone.\npub type Date = & Ordered<Date> & {\n    year_value: Int\n    month_value: Int\n    day_value: Int\n}\n\nimpl Date {\n    /// Validates and constructs an ISO civil date.\n    pub func from(year: Int, month: Int, day: Int) -> Result<Date, CivilError> {\n        branch {\n            month < 1 -> invalid_date(\"month\", month, \"month must be between 1 and 12\")\n            month > 12 -> invalid_date(\"month\", month, \"month must be between 1 and 12\")\n            day < 1 -> invalid_date(\"day\", day, \"day must be positive\")\n            day > days_in_month(year, month) -> invalid_date(\"day\", day, \"day exceeds the selected month\")\n            _ -> Result.Ok(Date { year_value: year, month_value: month, day_value: day })\n        }\n    }\n\n    /// Constructs the date corresponding to a signed day count from 1970-01-01.\n    pub func from_epoch_day(