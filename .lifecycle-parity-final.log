sHost.read_bytes(path) {\n            Result.Error(error) -> Result.Error(error)\n            Result.Ok(contents) -> decode_text(path, move contents)\n        }\n    }\n    /// Writes UTF-8 text to the host filesystem.\n    func write_text(path: String, text: String) -> Result<(), IoError> {\n        FsHost.write_bytes(path, text.bytes)\n    }\n    /// Reads binary data from the host filesystem.\n    func read_bytes(path: String) -> Result<Bytes, IoError> = intrinsic(\"io.read_bytes\")\n    /// Writes binary data to the host filesystem.\n    func write_bytes(path: String, contents: Bytes) -> Result<(), IoError> = intrinsic(\"io.write_bytes\")\n    /// Reads one bounded byte range without loading the complete file.\n    func read_range(path: String, offset: Int, maximum: Int) -> Result<Bytes, IoError> = intrinsic(\"io.read_range\")\n    /// Appends bytes to a file, creating it when necessary, and returns the accepted count.\n    func append_bytes(path: String, contents: Bytes) -> Result<Int, IoError> = intrinsic(\"io.append_bytes\")\n    /// Returns the current byte length of a regular file.\n    func file_length(path: String) -> Result<Int, IoError> = intrinsic(\"io.file_length\")\n    /// Lists direct children of a host directory.\n    func list_directory(path: String) -> Result<List<String>, IoError> = intrinsic(\"io.list_directory\")\n    /// Tests whether a host path exists.\n    func exists(path: String) -> Bool = intrinsic(\"io.exists\")\n    /// Tests whether a host path is a file.\n    func is_file(path: String) -> Bool = intrinsic(\"io.is_file\")\n    /// Tests whether a host path is a directory.\n    func is_directory(path: String) -> Bool = intrinsic(\"io.is_directory\")\n    /// Creates one directory in an existing parent directory.\n    func create_directory(path: String) -> Result<(), IoError> = intrinsic(\"io.create_directory\")\n    /// Creates a directory and every missing parent directory.\n    func create_directory_all(path: String) -> Result<(), IoError> = intrinsic(\"io.create_directory_all\")\n    /// Removes one file.\n    func remove_file(path: String) -> Result<(), IoError> = intrinsic(\"io.remove_file\")\n    /// Removes one empty directory.\n    func remove_directory(path: String) -> Result<(), IoError> = intrinsic(\"io.remove_directory\")\n    /// Renames or moves a filesystem entry.\n    func rename(from: String, to: String) -> Result<(), IoError> = intrinsic(\"io.rename\")\n    /// Copies one file and returns the number of bytes copied.\n    func copy_file(from: String, to: String) -> Result<Int, IoError> = intrinsic(\"io.copy_file\")\n}\n\n/// Validates binary file contents before exposing them as text.\nfunc decode_text(path: String, contents: Bytes) -> Result<String, IoError> [consume contents] {\n    branch String.from_utf8(move contents) {\n        Result.Ok(text) -> Result.Ok(text)\n        Result.Error(error) -> Result.Error(IoError {\n            operation: \"read_text\"\n            path: path.slice(0, path.length)\n            message: error.message\n        })\n    }\n}\n\n/// A located file with whole-resource and positioned binary capabilities.\n///\n/// Constructing a `File` does not touch the filesystem. Reads and writes can still fail if the\n/// location is unavailable, unsupported by the host provider, or its permissions change.\npub type File = & Resource<paths::Path>\n    & Readable<IoError>\n    & Writable<IoError>\n    & PositionedReadable<IoError>\n    & Appendable<IoError>\n    & Sized<IoError>\n    & {\n        pub location: paths::Path\n        host_file: ()\n    }\n\nimpl File {\n    /// Creates a host-file resource at a typed filesystem path without touching the filesystem.\n    pub func at(location: paths::Path) -> File [consume location] {\n        File { location: move location, host_file: () }\n    }\n\n    /// Creates a file resource from host path text.\n    pub func from(path: String) -> File {\n        File { location: paths::Path.from(move path), host_file: () }\n    }\n\n    /// Reads the complete file as immutable bytes.\n    pub func read(self: File) -> Result<Bytes, IoError> {\n        FsHost.read_bytes(self.location.as_string())\n    }\n\n    /// Replaces the complete file and returns the number of bytes written.\n    pub func write(self: File, contents: Bytes) -> Result<Int, IoError> {\n        written_bytes(contents.length, FsHost.write_bytes(self.location.as_string(), contents))\n    }\n\n    /// Reads at most `maximum` bytes beginning at `offset`.\n    pub func read_at(self: File, offset: Int, maximum: Int) -> Result<Bytes, IoError> {\n        FsHost.read_range(self.location.as_string(), offset, maximum)\n    }\n\n    /// Compatibility spelling for positioned reads.\n    pub func read_range(self: File, offset: Int, maximum: Int) -> Result<Bytes, IoError> {\n        self.read_at(offset, maximum)\n    }\n\n    /// Appends a binary chunk and returns the number of bytes written.\n    pub func append(self: File, contents: Bytes) -> Result<Int, IoError> {\n        FsHost.append_bytes(self.location.as_string(), contents)\n    }\n\n    /// Returns the file's current byte length.\n    pub func length(self: File) -> Result<Int, IoError> {\n        FsHost.file_length(self.location.as_string())\n    }\n\n    /// Files written through whole-file operations have no pending userspace buffer.\n    pub func flush(self: File) -> Result<(), IoError> { Result.Ok(()) }\n\n    /// Reads the complete file as UTF-8 text.\n    pub func read_text(self: File) -> Result<String, IoError> {\n        FsHost.read_text(self.location.as_string())\n    }\n\n    /// Replaces the complete file with UTF-8 text.\n    pub func write_text(self: File, text: String) -> Result<(), IoError> {\n        FsHost.write_text(self.location.as_string(), text)\n    }\n}\n\n/// Converts a successful whole-file write into its byte count.\nfunc written_bytes(length: Int, outcome: Result<(), IoError>) -> Result<Int, IoError> [consume outcome] {\n    branch move outcome {\n        Result.Error(error) -> Result.Error(error)\n        Result.Ok(_) -> Result.Ok(length)\n    }\n}\n\n/// Reads an entire UTF-8 text file.\npub func read_text(path: String) -> Result<String, IoError> { FsHost.read_text(path) }\n/// Replaces a file with UTF-8 text, creating it when necessary.\npub func write_text(path: String, text: String) -> Result<(), IoError> { FsHost.write_text(path, text) }\n/// Reads an entire file without applying text decoding.\npub func read_bytes(path: String) -> Result<Bytes, IoError> { FsHost.read_bytes(path) }\n/// Replaces a file with raw bytes, creating it when necessary.\npub func write_bytes(path: String, contents: Bytes) -> Result<(), IoError> { FsHost.write_bytes(path, contents) }\n/// Reads at most `maximum` bytes beginning at `offset` without loading the complete file.\npub func read_range(path: String, offset: Int, maximum: Int) -> Result<Bytes, IoError> { FsHost.read_range(path, offset, maximum) }\n/// Appends bytes to a file and returns the number written.\npub func append_bytes(path: String, contents: Bytes) -> Result<Int, IoError> { FsHost.append_bytes(path, contents) }\n/// Returns a file's current byte length.\npub func file_length(path: String) -> Result<Int, IoError> { FsHost.file_length(path) }\n/// Returns the names directly inside a directory in deterministic order.\npub func list_directory(path: String) -> Result<List<String>, IoError> { FsHost.list_directory(path) }\n/// Returns whether a filesystem entry exists at `path`.\npub func exists?(path: String) -> Bool { FsHost.exists(path) }\n/// Returns whether `path` identifies a regular file.\npub func file?(path: String) -> Bool { FsHost.is_file(path) }\n/// Returns whether `path` identifies a directory.\npub func directory?(path: String) -> Bool { FsHost.is_directory(path) }\n/// Creates one directory; its parent must already exist.\npub func create_directory(path: String) -> Result<(), IoError> { FsHost.create_directory(path) }\n/// Creates a directory and all missing parent directories.\npub func create_directory_all(path: String) -> Result<(), IoError> { FsHost.create_directory_all(path) }\n/// Removes a file without removing directories.\npub func remove_file(path: String) -> Result<(), IoError> { FsHost.remove_file(path) }\n/// Removes an empty directory without recursively deleting its contents.\npub func remove_directory(path: String) -> Result<(), IoError> { FsHost.remove_directory(path) }\n/// Renames or moves `from` to `to` according to host filesystem rules.\npub func rename(from: String, to: String) -> Result<(), IoError> { FsHost.rename(from, to) }\n/// Copies a file from `from` to `to` and returns the number of bytes copied.\npub func copy_file(from: String, to: String) -> Result<Int, IoError> { FsHost.copy_file(from, to) }\n"), origin: Embedded }, "std.io": Module { name: "std.io", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/io.fos"), program: Some(Program { documentation: Some("Generic byte and text stream contracts with complete read/write helpers."), imports: [Import { span: 78..117, path: ["core", "bytes", "buffer"], alias: Some("byte_buffer") }, Import { span: 118..135, path: ["core", "bytes"], alias: None }, Import { span: 136..154, path: ["core", "result"], alias: None }], constants: [], records: [RecordDecl { span: 199..292, documentation: Some("Describes a failed host I/O operation."), name: "IoError", public: true, intrinsic: false, parameters: [], compositions: [], fields: [RecordField { name: "operation", public: true, ty: Named("String", []) }, RecordField { name: "path", public: true, ty: Named("String", []) }, RecordField { name: "message", public: true, ty: Named("String", []) }], methods: [] }, RecordDecl { span: 497..667, documentation: Some("A stateful source of binary data.\n\n`read` returns at most `maximum` bytes. Empty bytes indicate clean end-of-stream.\nA successful read of a non-empty stream must return at least one byte."), name: "Reader", public: true, intrin