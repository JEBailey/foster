5 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 4100..4105 }, message: None }, span: 4093..4106 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4119..4121 }), span: 4119..4121 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 4150..4155 }] }, span: 4140..4156 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 4181..4186 }, name: "empty?" }, span: 4181..4193 }, message: None }, span: 4174..4194 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4207..4209 }), span: 4207..4209 }] } }] }, span: 4034..4225 }), span: 4034..4225 }, Spanned { value: Expr(Spanned { expression: Branch { subject: Some(Spanned { expression: Call { callee: Spanned { expression: Name("token_hex"), span: 4237..4246 }, arguments: [Spanned { expression: Integer(0), span: 4247..4248 }] }, span: 4237..4249 }), arms: [BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Error"], enum_accessor: true, fields: [Spanned { pattern: Wildcard, span: 4273..4274 }] }, span: 4260..4275 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Bool(false), span: 4300..4305 }, message: None }, span: 4293..4306 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4319..4321 }), span: 4319..4321 }] } }, BranchArm { test: Pattern(Spanned { pattern: Variant { path: ["Result", "Ok"], enum_accessor: true, fields: [Spanned { pattern: Binding("value"), span: 4350..4355 }] }, span: 4340..4356 }), body: Block { items: [Spanned { value: Assert { condition: Spanned { expression: Member { object: Spanned { expression: Name("value"), span: 4381..4386 }, name: "empty?" }, span: 4381..4393 }, message: None }, span: 4374..4394 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4407..4409 }), span: 4407..4409 }] } }] }, span: 4230..4425 }), span: 4230..4425 }, Spanned { value: Expr(Spanned { expression: Unit, span: 4430..4432 }), span: 4430..4432 }] } }] }), source: Some("//! Security-oriented entropy, random bytes, and token generation.\n\nimport core.bytes\nimport core.result\nimport core.string\nimport std.random\n\n/// A fallible source of bytes drawn from external entropy.\npub type EntropySource = {\n    /// Returns exactly `count` entropy bytes or a typed failure.\n    pub func bytes(self, count: Int) -> Result<Bytes, RandomError> [mut self]\n}\n\n/// An operating-system-backed source implementing both integer and entropy contracts.\npub type SecureRandom = & RandomSource & EntropySource & {\n    source_value: SystemRandom\n}\n\nimpl SecureRandom {\n    /// Constructs a secure source backed by the operating system.\n    pub func new() -> SecureRandom {\n        SecureRandom { source_value: SystemRandom.new() }\n    }\n\n    /// Returns the next uniformly distributed secure 31-bit integer.\n    pub func next(self: SecureRandom) -> Result<Int, RandomError> [mut self.source_value] {\n        self.source_value.next()\n    }\n\n    /// Returns the inclusive maximum secure integer value.\n    pub func maximum(self: SecureRandom) -> Int { self.source_value.maximum() }\n\n    /// Returns exactly `count` operating-system entropy bytes.\n    pub func bytes(self: SecureRandom, count: Int) -> Result<Bytes, RandomError> [mut self.source_value] {\n        self.source_value.bytes(count)\n    }\n}\n\n/// Returns exactly `count` operating-system entropy bytes.\npub func random_bytes(count: Int) -> Result<Bytes, RandomError> {\n    SecureRandom.new().bytes(count)\n}\n\n/// Returns a lowercase hexadecimal security token containing `byte_count` random bytes.\npub func token_hex(byte_count: Int) -> Result<String, RandomError> {\n    let entropy = try random_bytes(byte_count)\n    Result.Ok(entropy.hex())\n}\n\n/// Returns a URL-safe token with exactly `length` uniformly selected ASCII characters.\npub func token(length: Int) -> Result<String, RandomError> {\n    return failure(\"token\", length, \"token length must not be negative\") if length < 0\n    return failure(\"token\", length, \"token length must not exceed 4096\") if length > 4096\n    token_remaining(SecureRandom.new(), length, \"\")\n}\n\n/// Appends URL-safe alphabet characters until the requested token length is reached.\nfunc token_remaining(source: SecureRandom, remaining: Int, output: String) -> Result<String, RandomError> [mut source, consume output] {\n    return Result.Ok(move output) if remaining == 0\n    let index = try random::below_with(source, 64)\n    let alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\"\n    token_remaining(source, remaining - 1, move output + alphabet.slice(index, index + 1))\n}\n\n/// Constructs a typed secure-randomness error.\nfunc failure<T>(operation: String, value: Int, message: String) -> Result<T, RandomError> {\n    Result.Error(RandomError { operation, value, message })\n}\n\n/// Exercises the byte-oriented entropy contract for tests.\nfunc entropy_length(source: EntropySource, count: Int) -> Int [mut source] {\n    branch source.bytes(count) {\n        Result.Error(_) -> -1\n        Result.Ok(value) -> value.length\n    }\n}\n\ntest \"secure entropy produces exact byte and token lengths\" {\n    assert(entropy_length(SecureRandom.new(), 8) == 8)\n    branch random_bytes(24) {\n        Result.Error(_) -> {\n            assert(false, \"secure bytes were unavailable\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.length == 24)\n            ()\n        }\n    }\n    branch token(32) {\n        Result.Error(_) -> {\n            assert(false, \"secure token generation failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.length == 32)\n            ()\n        }\n    }\n    branch token_hex(12) {\n        Result.Error(_) -> {\n            assert(false, \"hex token generation failed\")\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.length == 24)\n            ()\n        }\n    }\n    assert(token(-1).error?())\n    assert(token(4097).error?())\n    assert(random_bytes(-1).error?())\n    assert(random_bytes(1048577).error?())\n    branch token(0) {\n        Result.Error(_) -> {\n            assert(false)\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.empty?)\n            ()\n        }\n    }\n    branch token_hex(0) {\n        Result.Error(_) -> {\n            assert(false)\n            ()\n        }\n        Result.Ok(value) -> {\n            assert(value.empty?)\n            ()\n        }\n    }\n    ()\n}\n"), origin: Embedded }, "std.random.sequence": Module { name: "std.random.sequence", source_path: Some("C:\\Users\\jason\\git\\foster\\library/std/random/sequence.fos"), program: Some(Program { documentation: Some("Random choice, shuffling, and sampling over owned Foster lists."), imports: [Import { span: 69..85, path: ["core", "list"], alias: None }, Import { span: 86..104, path: ["core", "option"], alias: None }, Import { span: 105..123, path: ["core", "result"], alias: None }, Import { span: 124..141, path: ["std", "random"], alias: None }, Import { span: 142..169, path: ["std", "random", "generator"], alias: None }], constants: [], records: [RecordDecl { span: 1897..1956, documentation: Some("One extracted list value and the remaining owned values."), name: "Selection", public: false, intrinsic: false, parameters: ["T"], compositions: [], fields: [RecordField { name: "value", public: false, ty: Named("T", []) }, RecordField { name: "remaining", public: false, ty: Named("List", [Named("T", [])]) }], methods: [] }], variants: [], functions: [Function { body_is_recovery_stub: false, span: 251..510, documentation: Some("Chooses one list element with `source`, returning `None` for an empty list."), name: "choos