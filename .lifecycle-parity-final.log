, Spanned { expression: Integer(2), span: 3826..3827 }] }, span: 3805..3828 }, name: "put" }, span: 3805..3832 }, arguments: [Spanned { expression: String("b"), span: 3833..3836 }, Spanned { expression: Integer(3), span: 3838..3839 }] }, span: 3805..3840 }, name: "values" }, span: 3805..3847 }, arguments: [] }, span: 3805..3849 } }, span: 3792..3849 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Member { object: Spanned { expression: Name("stored"), span: 3861..3867 }, name: "length" }, span: 3861..3874 }, operator: Equal, right: Spanned { expression: Integer(2), span: 3878..3879 } }, span: 3861..3879 }, message: None }, span: 3854..3880 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Index { object: Spanned { expression: Name("stored"), span: 3892..3898 }, index: Spanned { expression: Integer(0), span: 3899..3900 } }, span: 3892..3901 }, operator: Equal, right: Spanned { expression: Integer(2), span: 3905..3906 } }, span: 3892..3906 }, message: None }, span: 3885..3907 }, Spanned { value: Assert { condition: Spanned { expression: Binary { left: Spanned { expression: Index { object: Spanned { expression: Name("stored"), span: 3919..3925 }, index: Spanned { expression: Integer(1), span: 3926..3927 } }, span: 3919..3928 }, operator: Equal, right: Spanned { expression: Integer(3), span: 3932..3933 } }, span: 3919..3933 }, message: None }, span: 3912..3934 }] } }] }), source: Some("//! Persistent insertion-ordered maps represented by public key-value entries.\n\nimport core.option\nimport std.collections\nimport std.iter\n\n/// A key-value pair yielded while iterating a map.\npub type Entry<K, V> = {\n    pub key: K\n    pub value: V\n}\n\n/// An insertion-ordered associative collection.\npub type Map<K, V> = & Collection<Entry<K, V>> & {\n    entries: List<Entry<K, V>>\n}\n\nimpl Map {\n    /// Creates an empty map.\n    pub func empty<K, V>() -> Map<K, V> {\n        Map { entries: [] }\n    }\n\n    /// Consumes the map and returns the value associated with `key`, if present.\n    pub func get<K, V>(self: Map<K, V>, key: K) -> Option<V> {\n        get_entries(move self.entries, key)\n    }\n}\n\n/// Searches owned entries for a matching key and returns its value.\nfunc get_entries<K, V>(entries: List<Entry<K, V>>, key: K) -> Option<V> {\n    branch {\n        entries.empty? -> Option.None\n        entries.head.key == key -> Option.Some(entries.head.value)\n        _ -> get_entries(entries.rest, key)\n    }\n}\n\nimpl Map {\n    /// Returns whether the map contains `key` without consuming the map.\n    pub func contains_key?<K, V>(self: Map<K, V>, key: K) -> Bool {\n        contains_entries?(self.entries, key)\n    }\n}\n\n/// Searches entries for a key without extracting its value.\nfunc contains_entries?<K, V>(entries: List<Entry<K, V>>, key: K) -> Bool {\n    branch {\n        entries.empty? -> false\n        entries.head.key == key -> true\n        _ -> contains_entries?(entries.rest, key)\n    }\n}\n\nimpl Map {\n    /// Returns a map with `key` associated with `value`, replacing an existing entry when present.\n    pub func put<K, V>(self: Map<K, V>, key: K, value: V) -> Map<K, V> {\n        Map { entries: put_entries(move self.entries, move key, move value) }\n    }\n}\n\n/// Rebuilds the entry list with the supplied key and value.\nfunc put_entries<K, V>(entries: List<Entry<K, V>>, key: K, value: V) -> List<Entry<K, V>> {\n    branch {\n        entries.empty? -> [Entry { key, value }]\n        entries.head.key == key -> [Entry { key, value }].concat(entries.rest)\n        _ -> [entries.head].concat(put_entries(entries.rest, move key, move value))\n    }\n}\n\nimpl Map {\n    /// Returns the number of entries in the map.\n    pub func length<K, V>(self: Map<K, V>) -> Int {\n        self.entries.length\n    }\n\n    /// Returns whether the map contains no entries.\n    pub func empty?<K, V>(self: Map<K, V>) -> Bool {\n        self.entries.empty?\n    }\n\n    /// Creates an independent iterator over entries in storage order.\n    pub func iterator<K, V>(self: Map<K, V>) -> Iterator<Entry<K, V>> {\n        self.entries.iterator()\n    }\n\n    /// Consumes the map and returns its keys in storage order.\n    pub func keys<K, V>(self: Map<K, V>) -> List<K> {\n        keys_into(move self.entries, [])\n    }\n}\n\n/// Extracts keys from owned entries into the result accumulator.\nfunc keys_into<K, V>(entries: List<Entry<K, V>>, result: List<K>) -> List<K> {\n    branch {\n        entries.empty? -> result\n        _ -> keys_into(entries.rest, result.append(entries.head.key))\n    }\n}\n\nimpl Map {\n    /// Consumes the map and returns its values in storage order.\n    pub func values<K, V>(self: Map<K, V>) -> List<V> {\n        values_into(move self.entries, [])\n    }\n}\n\ntest \"maps replace values without duplicating keys\" {\n    let values = Map.empty().put(\"a\", 1).put(\"a\", 2)\n    let found = branch values.get(\"a\") {\n        Option.Some(value) -> value == 2\n        Option.None -> false\n    }\n    assert(found)\n    assert(values.length() == 1)\n    assert(not values.empty?())\n    assert(values.contains_key?(\"a\"))\n    assert(not values.contains_key?(\"missing\"))\n    let keys = Map.empty().put(\"a\", 2).put(\"b\", 3).keys()\n    assert(keys.length == 2)\n    assert(keys[0] == \"a\")\n    assert(keys[1] == \"b\")\n    let stored = Map.empty().put(\"a\", 2).put(\"b\", 3).values()\n    assert(stored.length == 2)\n    assert(stored[0] == 2)\n    assert(stored[1] == 3)\n}\n\n/// Extracts values from owned entries into the result accumulator.\nfunc values_into<K, V>(entries: List<Entry<K, V>>, result: List<V>) -> List<V> {\n    branch {\n        entries.empty? -> result\n        _ -> values_into(entries.rest, result.append(entries.head.value))\n    }\n}\n"), origin: Embedded }, "std.collections.queue": Module { name: "std.collections.queue", source_path: Some("C:\\Users\\jas