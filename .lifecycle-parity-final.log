ange {\n    /// Creates a range view over `values`.\n    pub func from<T>(values: List<T>) -> Range<T> [consume values] {\n        Range { values: move values }\n    }\n\n    /// Returns whether the range is empty.\n    pub func empty?<T>(self: Range<T>) -> Bool {\n        self.values.empty?\n    }\n\n    /// Returns the number of values remaining in the range.\n    pub func length<T>(self: Range<T>) -> Int {\n        self.values.length\n    }\n\n    /// Returns the first range value.\n    pub func head<T>(self: Range<T>) -> T {\n        self.values.head\n    }\n\n    /// Returns a sequence containing all values after the head.\n    pub func rest<T>(self: Range<T>) -> Sequence<T> {\n        self.values.rest\n    }\n\n    /// Creates an independent iterator over the range values.\n    pub func iterator<T>(self: Range<T>) -> Iterator<T> {\n        self.values.iterator()\n    }\n}\n"), origin: Embedded }, "core.remote_error": Module { name: "core.remote_error", source_path: Some("C:\\Users\\jason\\git\\foster\\library/core/remote_error.fos"), program: Some(Program { documentation: Some("Outcomes of remote execution, distinct from method domain errors."), imports: [], constants: [], records: [], variants: [VariantDecl { span: 158..211, documentation: Some("A worker execution failure, or the reserved outcome for owner-driven cancellation."), name: "RemoteError", public: true, kind: Enum, parameters: [], alternatives: [EnumCase { span: 181..195, name: "Failed", payload: Some(Named("String", [])) }, EnumCase { span: 202..210, name: "Shutdown", payload: None }], compositions: [], methods: [] }], functions: [], implementations: [], tests: [] }), source: Some("//! Outcomes of remote execution, distinct from method domain errors.\n\n/// A worker execution failure, or the reserved outcome for owner-driven cancellation.\npub enum RemoteError = Failed(String)\n    | Shutdown\n"), origin: Embedded }, "core.result": Module { name: "core.result", source_path: Some("C:\\Users\\jason\