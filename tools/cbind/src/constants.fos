//! Discovers selected-header macros and evaluates constant expressions with Clang.
//! Static initializers exclude runtime calls. No C expression is translated into Foster.
import core.list
import core.string
import core.int
import core.result
import core.future
import std.process
import bridge
import bindings

pub type Extracted = {
    pub values: String, pub report: String
}
type Context = {
    shim: String, output: String, compiler: String, includes: List<String>, rows: List<String>, records: Contract, accepted: List<String>, documentation: List<Documentation>
}

type Constant = {
    name: String, kind: String
}

type Documentation = {
    name: String, text: String
}

type Macro = {
    name: String, definition: String
}

func text(tree: Contract, node: Int, key: String) -> String {
    let field = tree.member(node, key)
    branch {
        field < 0 -> "" _ -> tree.nodes[field].text.copy()
    }
}
func arguments(context: Context) -> List<String> {
    let args = ["--target=x86_64-pc-windows-msvc", "-x", "c", "-std=c11"]
    for include in context.includes {
        args.push("-I")
        args.push(include.copy())
    }
    move args
}
func attempt(context: Context, args: List<String>) -> ProcessOutput {
    let child = branch process::spawn_with(context.compiler, args, SpawnOptions {
        directory: "", output_limit: 67108864
    }) {
        Result.Ok(child) -> move child
        Result.Error(error) -> panic(error.message)
    }
    branch await child {
        Result.Ok(output) -> move output
        Result.Error(error) -> panic(error.message)
    }
}
// Only literal string decay/parentheses are safe to copy without pointer contracts.
func literal_string(tree: Contract, node: Int) -> Bool {
    let kind = text(tree, node, "kind")
    return text(tree, tree.member(node, "type"), "qualType").starts_with?("char[") if kind == "StringLiteral"
    return false if !["VarDecl", "ImplicitCastExpr", "ParenExpr"].contains?(kind)
    let children = tree.array(node, "inner", false)
    children.length == 1 && literal_string(tree, children[0])
}
func type_json(tree: Contract, node: Int) -> String {
    return bindings::quoted(tree.nodes[node].text) if tree.nodes[node].kind == "string"
    if tree.member(node, "array") >= 0 {
        return "{\"array\":" + type_json(tree, tree.member(node, "array")) + ",\"length\":" + tree.nodes[tree.member(node, "length")].text + "}"
    }
    let key = branch {
        tree.member(node, "enum") >= 0 -> "enum"
        _ -> "record"
    }
    "{" + bindings::quoted(key) + ":" + bindings::quoted(tree.string(node, key, true)) + "}"
}
func print_value(context: Context, ty: String, place: String) -> String {
    branch {
        ty.starts_with?("{") -> {
            let record_type = bridge::decode_json(ty)
            branch {
                record_type.member(0, "enum") >= 0 -> {
                    return "printf(\"%lld\", (long long)(" + place + "));\n"
                }
                record_type.member(0, "array") >= 0 -> {
                    let element = type_json(record_type, record_type.member(0, "array"))
                    let length = 0
                    for character in record_type.nodes[record_type.member(0, "length")].text {
                        length = length * 10 + character.bytes[0].int - 48
                    }
                    let output = "putchar('[');\n"
                    for index in 0.range(length) {
                        if index > 0 output = output + "putchar(',');\n"
                        output = output + print_value(context, element, place + "[" + index.as_string() + "]")
                    }
                    return output + "putchar(']');\n"
                }
            }
            let name = record_type.string(0, "record", true)
            let output = "putchar('{');\n"
            for record in context.records.array(0, "records", false) {
                continue if context.records.string(record, "name", true) != name
                let separator = ""
                for field in context.records.array(record, "fields", true) {
                    let field_name = context.records.string(field, "name", true)
                    let field_type = context.records.member(field, "type")
                    let kind = type_json(context.records, field_type)
                    output = output + "fputs(" + bindings::quoted(separator + bindings::quoted(field_name) + ":") + ", stdout);\n"
                    output = output + print_value(context, kind, place + "." + field_name)
                    separator = ","
                }
            }
            output + "putchar('}');\n"
        }
        ty == "\"string\"" -> "json_string((const unsigned char*)" + place + ", sizeof(" + place + ") - 1);\n"
        ty == "\"f32\"" || ty == "\"f64\"" -> "if (isfinite((double)(" + place + "))) printf(\"%.17g\", (double)(" + place + ")); else fputs(\"null\", stdout);\n"
        ty == "\"bool\"" -> "fputs((" + place + ") ? \"true\" : \"false\", stdout);\n"
        ty == "\"char\"" -> "printf(\"%u\", (unsigned int)(unsigned char)(" + place + "));\n"
        _ -> "printf(\"%lld\", (long long)(" + place + "));\n"
    }
}
// A failed batch is bisected so one declaration-shaped macro cannot hide valid constants.
func probe(context: Context, names: List<String>, values: List<String>, reports: List<String>) {
    return () if names.empty?
    let file = bridge::artifact(context.output, ".constants.c")
    let prefix = "#include " + bindings::quoted(context.shim) + "\n"
    let source = prefix + "void foster_cbind_constants(void) {\n"
    for name in names {
        source = source + "static const __auto_type foster_cbind_" + name + " = " + name + ";\n"
    }
    source = source + "}\n"
    bridge::write_file(file, source)
    let args = arguments(context)
    for arg in ["-fsyntax-only", "-Werror", "-Xclang", "-ast-dump=json", "-Xclang", "-ast-dump-filter=foster_cbind_constants", file.copy()] {
        args.push(arg.copy())
    }
    let completed = attempt(context, args)
    if !completed.status.success {
        branch {
            names.length == 1 -> reports.push(names[0] + ": macro is not a supported C static constant expression\n")
            _ -> {
                let middle = names.length / 2
                probe(context, names.slice(0, middle), values, reports)
                probe(context, names.slice(middle, names.length), values, reports)
            }
        }
        return ()
    }
    let tree = bridge::decode_json(String.from_utf8(move completed.stdout).unwrap_or(""))
    let constants = []
    for body in tree.array(0, "inner", false) {
        for statement in tree.array(body, "inner", false) {
            for variable in tree.array(statement, "inner", false) {
                continue if text(tree, variable, "kind") != "VarDecl"
                let name = text(tree, variable, "name").strip_prefix("foster_cbind_")
                let node = tree.member(variable, "type")
                let spelling = text(tree, node, "desugaredQualType")
                .if_empty([ref tree] () -> text(tree, node, "qualType"))
                spelling = spelling.strip_prefix("const ")
                let kind = bindings::binding_type(spelling, context.rows, context.accepted)
                kind = branch {
                    literal_string(tree, variable) -> "\"string\""
                    spelling.starts_with?("enum ") -> "\"i64\""
                    kind.empty? || kind == "\"void\"" -> {
                        reports.push("""%name%: unsupported constant type %spelling%\n""")
                        continue
                    }
                    _ -> move kind
                }
                constants.push(Constant {
                    name: move name, kind: move kind
                })
            }
        }
    }
    return () if constants.empty?
    source = prefix + PRINTER + "\nint main(void) {\n"
    for constant in constants {
        source = source + print_value(context, constant.kind, "(" + constant.name + ")") + "putchar('\\n');\n"
    }
    source = source + "return 0; }\n"
    bridge::write_file(file, source)
    let executable = bridge::artifact(context.output, ".constants.exe")
    args = arguments(context)
    for arg in [file.copy(), "-o", executable.copy()] {
        args.push(arg.copy())
    }
    bridge::execute(context.compiler, args, "")
    let output = bridge::execute(executable, [], "")
    let lines = output.copy().split("\n")
    let index = 0
    for constant in constants {
        let value = lines[index].copy().trim()
        let decoded = bridge::decode_json(value)
        let finite = true
        for node in decoded.nodes {
            if node.kind == "null" finite = false
        }
        branch {
            !finite -> reports.push(constant.name + ": non-finite constant is not representable\n")
            _ -> {
                let docs = ""
                for entry in context.documentation {
                    if entry.name == constant.name {
                        docs = ",\"documentation\":" + entry.text
                    }
                }
                values.push("{\"name\":" + bindings::quoted(constant.name) + ",\"type\":" + constant.kind + ",\"value\":" + value + docs + "}")
            }
        }
        index = index + 1
    }
}

/// Extracts active object macros and enum values from selected headers. Unsupported
/// macros are reported; empty preprocessing markers do not declare values.
pub func discover(rows: String, manifest: String, shim: String, output: String, compiler: String, headers: List<String>, includes: List<String>) -> Extracted {
    let records = bridge::decode_json(manifest)
    let accepted = []
    for node in records.array(0, "records", false) {
        accepted.push(records.string(node, "name", true))
    }
    let types = []
    let enumerators = []
    let documentation = []
    for row in rows.copy().split("\n") {
        let fields = row.copy().split("\t")
        continue if fields.length < 2
        branch {
            fields[0] == "T" || fields[0] == "S" || fields[0] == "N" -> types.push(row.copy())
            fields[0] == "E" -> enumerators.push(fields[1].copy())
            fields[0] == "D" && fields.length == 3 && fields[1].starts_with?("K.") -> {
                documentation.push(Documentation {
                    name: fields[1].strip_prefix("K."), text: fields[2].copy()
                })
            }
        }
    }
    let context = Context {
        shim: shim.copy(), output: output.copy(), compiler: compiler.copy(), includes: includes.slice(0, includes.length), rows: move types, records: move records, accepted: move accepted, documentation: move documentation
    }
    let args = arguments(context)
    for arg in ["-E", "-dD", shim.copy()] {
        args.push(arg.copy())
    }
    let preprocessed = bridge::execute(compiler, args, "")
    bridge::write_file(bridge::artifact(output, ".preprocessed.h"), preprocessed)
    let names = []
    let reports = []
    let macros = []
    let selected = false
    for line in preprocessed.copy().split("\n") {
        let parts = line.copy().split("\"")
        if line.starts_with?("# ") && parts.length >= 3 {
            selected = false
            let file = parts[1].copy().split("\\\\").join("\\")
            if !file.starts_with?("<") selected = headers.contains?(bridge::canonical(file))
            continue
        }
        continue if !line.starts_with?("#define ") && !line.starts_with?("#undef ")
        let define = line.starts_with?("#define ")
        let rest = line.slice(branch {
            define -> 8 _ -> 7
        }, line.length).trim()
        let pieces = rest.copy().split(" ")
        let token = pieces[0].copy()
        let name = token.copy().split("(")[0].copy()
        for index in 0.range(macros.length) {
            if macros[index].name == name {
                macros[index] = Macro {
                    name: name.copy(), definition: ""
                }
            }
        }
        continue if !define || !selected
        macros.push(Macro {
            name: move name, definition: branch {
                rest == token -> "" _ -> rest.copy()
            }
        })
    }
    for macro in macros {
        continue if macro.definition.empty?
        branch {
            macro.definition.starts_with?(macro.name + "(") -> reports.push(macro.name + ": function-like macro requires a C adapter\n")
            _ -> names.push(macro.name.copy())
        }
    }
    for name in enumerators {
        if !names.contains?(name) {
            names.push(name.copy())
        }
    }
    let values = []
    probe(context, names, values, reports)
    Extracted {
        values: "[" + values.join(",\n") + "]", report: reports.join("")
    }
}

const PRINTER = "#include <stdio.h>\n#include <math.h>\nstatic void json_string(const unsigned char *s, size_t n) { putchar('\"'); for(size_t i=0;i<n;i++) { unsigned c=s[i]; if(c=='\"'||c=='\\\\') { putchar('\\\\'); putchar(c); } else if(c<32) printf(\"\\\\u%04x\",c); else putchar(c); } putchar('\"'); }\n"
