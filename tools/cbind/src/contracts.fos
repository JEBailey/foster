//! Explicit ownership and pointer contracts layered over discovered declarations.
import core.list.List

import core.string.String
import core.string.StringBuilder

import std.iter.map

import bridge
import bridge.*
import static bridge.*
import bindings
import bindings.*
import static bindings.*

func mentions(tree: Contract, node: Int, names: List<String>) -> Bool {
    return false if node < 0
    let record = tree.member(node, "record")
    return true if record >= 0 && names.contains?(tree.nodes[record].text)
    for child in tree.children(node) {
        return true if mentions(tree, child, names)
    }
    false
}

/// Merges reviewed operations and owners; unreviewed operations involving owned
/// value types are removed instead of exposing a second, copyable ownership API.
pub func apply(manifest: String, report: String, declarations: String, source: String) -> Generated {
    let base = bridge::decode_json(manifest)
    let contracts = bridge::decode_json(source)
    assert(contracts.nodes[0].kind == "object", "contracts must be an object")
    for member in contracts.children(0) {
        assert(["operations", "resources", "exclude", "callbacks"].contains?(contracts.nodes[member].key), "unknown contracts field " + contracts.nodes[member].key)
    }
    let declared = []
    let declared_types = []
    for row in declarations.copy().split("\n") {
        let fields = row.copy().split("\t")
        if fields.length >= 3 && ["F", "R"].contains?(fields[0]) declared.push(fields[1].copy())
        if fields.length >= 3 && fields[0] == "T"declared_types.push(fields[1].copy())
    }
    let replaced = []
    let reviewed = contracts.array(0, "operations", false).iterator().map([ref contracts, ref declared, ref replaced] (operation: Int) -> {
        let name = contracts.string(operation, "name", true)
        let symbol = contracts.string(operation, "symbol", true)
        assert(declared.contains?(symbol), """contract symbol was not discovered in the selected header: %symbol%""")
        assert(!replaced.contains?(name), """duplicate reviewed operation %name%""")
        replaced.push(name.copy())
        replaced.push(symbol.copy())
        contracts.json(operation)
    }).collect()

    let excluded = []
    for name in contracts.array(0, "exclude", false) {
        assert(contracts.nodes[name].kind == "string" && declared.contains?(contracts.nodes[name].text), "excluded function was not discovered")
        excluded.push(contracts.nodes[name].text.copy())
    }
    let blocked = []
    let resources = []
    for resource in contracts.array(0, "resources", false) {
        resources.push(contracts.json(resource))
        let native = contracts.string(resource, "c_type", true)
        blocked.push(native.copy())

        // A resource may use a typedef such as Texture2D while discovery names
        // its value record Texture. Suppress that underlying record as well.
        for pass in 0.range(32) {
            let previous = native.copy()
            for row in declarations.copy().split("\n") {
                let fields = row.copy().split("\t")
                if fields.length >= 3 && fields[0] == "T" && fields[1] == native {
                    native = fields[2].copy()
                    break
                }
            }
            break if native == previous
        }

        native = native.strip_prefix("struct ")

        blocked.push(native.copy())
        for key in ["destroy", "close", "valid"] {
            let symbol = contracts.string(resource, key, key == "destroy")
            if !symbol.empty? {
                assert(declared.contains?(symbol), "resource function was not discovered: " + symbol)
                excluded.push(symbol.copy())
            }
        }
    }
    let changed = true
    while changed {
        changed = false
        for record in base.array(0, "records", false) {
            let name = base.string(record, "name", true)
            continue if blocked.contains?(name)
            if mentions(base, base.member(record, "fields"), blocked) {
                blocked.push(name.copy())
                changed = true
            }
        }
    }

    let records = []
    for record in base.array(0, "records", false) {
        if !blocked.contains?(base.string(record, "name", true)){
            records.push(base.json(record))
        }
    }

    let operations = []
    let extra_report = StringBuilder.empty()
    for operation in base.array(0, "operations", true) {
        let name = base.string(operation, "name", true)
        continue if replaced.contains?(name) || excluded.contains?(name)
        branch {
            mentions(base, operation, blocked) -> {
                extra_report.append("""%name%: native resource use requires a reviewed operation contract\n""")
            }
            _ -> operations.push(base.json(operation))
        }
    }

    for operation in reviewed {
        operations.push(operation.copy())
    }

    let members = []
    for member in base.children(0) {
        let key = base.nodes[member].key.copy()
        continue if ["operations", "records", "resources", "callbacks"].contains?(key)
        members.push("""%{bindings::quoted(key)}%:%{base.json(member)}%""")
    }

    members.push(""""operations":[%{operations.join(",")}%]""")
    members.push(""""records":[%{records.join(",")}%]""")
    members.push(""""resources":[%{resources.join(",")}%]""")

    let callbacks = []
    let callback_types = []
    for callback in base.array(0, "callbacks", false) {
        callbacks.push(base.json(callback))
    }
    for callback in contracts.array(0, "callbacks", false) {
        callbacks.push(contracts.json(callback))
        let native = contracts.string(callback, "c_type", false)
        if !native.empty? {
            assert(declared_types.contains?(native), "callback typedef was not discovered: " + native)
            callback_types.push(native.copy())
        }
    }
    members.push(""""callbacks":[%{callbacks.join(",")}%]""")
    let remaining = StringBuilder.empty()
    for line in report.copy().split("\n") {
        continue if line.empty?
        let name = line.copy().split(":")[0]
        continue if replaced.contains?(name) || excluded.contains?(name) || blocked.contains?(name) || callback_types.contains?(name)
        remaining.append("""%line%\n""")
    }
    Generated {
        manifest: """{%{members.join(",")}%}""", report: (move remaining).finish() + (move extra_report).finish()
    }
}

test "reviewed owners suppress copyable records and raw cleanup paths" {
    let base = "{\"abi\":1,\"headers\":[],\"records\":[{\"name\":\"Handle\",\"c_type\":\"Handle\",\"fields\":[]},{\"name\":\"Container\",\"c_type\":\"Container\",\"fields\":[{\"name\":\"item\",\"type\":{\"record\":\"Handle\"}}]}],\"operations\":[{\"name\":\"open\",\"symbol\":\"open\",\"result\":{\"record\":\"Handle\"}},{\"name\":\"read\",\"symbol\":\"read\",\"parameters\":[{\"record\":\"Container\"}],\"result\":\"i32\"},{\"name\":\"destroy\",\"symbol\":\"destroy\",\"result\":\"void\"}]}"
    let reviewed = "{\"resources\":[{\"name\":\"Handle\",\"c_type\":\"HandleAlias\",\"destroy\":\"destroy\",\"by_value\":true}],\"operations\":[{\"name\":\"open\",\"symbol\":\"open\",\"result\":\"void\",\"creates\":\"Handle\"}]}"
    let result = apply(base, "open: unsupported\nother: unsupported\n", "T\tHandleAlias\tstruct Handle\nF\topen\tx\nF\tdestroy\tx\nF\tread\tx\n", reviewed)
    let tree = bridge::decode_json(result.manifest)
    assert(tree.array(0, "records", true).length == 0)
    assert(tree.array(0, "resources", true).length == 1)
    assert(tree.array(0, "operations", true).length == 1)
    assert(result.report.contains?("other: unsupported") && result.report.contains?("read: native resource"))
    assert(!result.report.contains?("open: unsupported"))
}
