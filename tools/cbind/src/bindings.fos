//! Windows x64 scalar and value-record bindings. Ownership is an explicit contract.
import core.list
import core.string
import core.int

pub type Generated = { pub manifest: String, pub report: String }
type Metadata = { names: List<String>, parts: List<String> }

// The adapter supplies tab-separated T(alias, type), F(name, result, parameters),
// S(name, C type, field/type pairs), and R(name, reason) records. Clang parses C.
func scalar(spelling: String, declarations: List<String>) -> String {
    let name = spelling.copy().trim()
    let depth = 0
    while depth < 32 {
        let mapped = branch name {
            "void" -> "void"
            "@cstring" -> "c_string"
            "_Bool" -> "bool"
            "bool" -> "bool"
            "signed char" -> "i8"
            "unsigned char" -> "u8"
            "short" -> "i16"
            "short int" -> "i16"
            "unsigned short" -> "u16"
            "unsigned short int" -> "u16"
            "int" -> "i32"
            "unsigned int" -> "u32"
            "long long" -> "i64"
            "long long int" -> "i64"
            "unsigned long long" -> "u64"
            "unsigned long long int" -> "u64"
            "float" -> "f32"
            "double" -> "f64"
            _ -> ""
        }
        return mapped if !mapped.empty?
        let alias = ""
        for row in declarations {
            let fields = row.copy().split("\t")
            branch {
                fields.length == 3 && fields[0] == "T" && fields[1] == name -> { alias = fields[2].copy() }
                _ -> ()
            }
        }
        return "" if alias.empty? || alias == name
        name = move alias
        depth = depth + 1
    }
    ""
}

// Returns a complete JSON type, resolving aliases before matching record tags.
pub func binding_type(spelling: String, declarations: List<String>, accepted: List<String>) -> String {
    let primitive = scalar(spelling, declarations)
    return quoted(primitive) if !primitive.empty?
    let name = spelling.copy()
    let depth = 0
    while depth < 32 {
        branch { name.contains?("[") -> {
            let parts = name.copy().split("[")
            let dimension = parts[1].copy().split("]")
            let length = 0
            for character in dimension[0] {
                let digit = character.bytes[0].int - 48
                return "" if digit < 0 || digit > 9 || length > 8191
                length = length * 10 + digit
            }
            return "" if length < 1 || length > 8191 || dimension.length != 2 || !dimension[1].empty?
            let element = parts[0].copy().trim()
            let index = 2
            while index < parts.length { element = element + "[" + parts[index]
                index = index + 1 }
            let kind = branch { element == "char" -> "\"char\"" _ -> binding_type(element, declarations, accepted) }
            return "" if kind.empty? || kind == "\"void\"" || kind == "\"c_string\""
            return "{\"array\": " + kind + ", \"length\": " + length.as_string() + "}"
        } _ -> () }
        let alias = ""
        for row in declarations {
            let fields = row.copy().split("\t")
            continue if fields.length < 3
            return "{\"record\": " + quoted(fields[1]) + "}" if fields[0] == "S" && (fields[2] == name || fields[1] == name) && accepted.contains?(fields[1])
            return "{\"enum\": " + quoted(fields[1]) + "}" if fields[0] == "N" && (fields[2] == name || fields[1] == name)
            branch {
                fields[0] == "T" && fields[1] == name -> { alias = fields[2].copy() }
                _ -> ()
            }
        }
        return "" if alias.empty? || alias == name
        name = move alias
        depth = depth + 1
    }
    ""
}

// Preserve paths and diagnostic characters as JSON text, never source fragments.
pub func quoted(text: String) -> String {
    let output = "\""
    for character in text {
        output = output + branch character {
            "\"" -> "\\\""
            "\\" -> "\\\\"
            "\n" -> "\\n"
            "\r" -> "\\r"
            "\t" -> "\\t"
            _ -> character.copy()
        }
    }
    output + "\""
}

func metadata(data: Metadata, name: String) -> String {
    let output = ""
    let index = 0
    while index < data.names.length {
        branch { data.names[index] == name -> { output = output + data.parts[index] } _ -> () }
        index = index + 1
    }
    move output
}

/// Produces a manifest and diagnostics for rejected functions. Value records are
/// accepted only when every field resolves to a scalar or an accepted value record.
pub func generate(input: String, header: String) -> Generated {
    let declarations = input.copy().split("\n")
    let types = []
    let annotations = Metadata { names: [], parts: [] }
    let annotation_keys = []
    for row in declarations {
        let fields = row.copy().split("\t")
        continue if fields.length < 3
        branch {
            fields[0] == "T" || fields[0] == "S" || fields[0] == "N" -> types.push(row.copy())
            fields[0] == "D" || fields[0] == "P" -> {
                let key = fields[0] + "." + fields[1]
                continue if annotation_keys.contains?(key)
                annotation_keys.push(move key)
                annotations.names.push(fields[1].copy())
                let field = branch { fields[0] == "D" -> "documentation" _ -> "parameter_names" }
                annotations.parts.push(", " + quoted(field) + ": " + fields[2])
            }
            _ -> ()
        }
    }
    let operations = ""
    let report = ""
    let names = []
    let reported_types = []
    let accepted = []
    let records = ""
    // Preserve typedef names even when Clang desugars an anonymous enum alias
    // to another typedef name instead of an `enum Tag` spelling.
    let enum_aliases = []
    for row in types {
        let fields = row.copy().split("\t")
        continue if fields[0] != "T"
        branch { binding_type(fields[1], types, []).starts_with?("{\"enum\":") -> {
            enum_aliases.push("N\t" + fields[1] + "\t" + fields[1])
        } _ -> () }
    }
    for row in enum_aliases { types.push(row.copy()) }
    let enums = []
    let enum_names = []
    for row in types {
        let fields = row.copy().split("\t")
        continue if fields[0] != "N" || enum_names.contains?(fields[1])
        enum_names.push(fields[1].copy())
        enums.push("{\"name\": " + quoted(fields[1]) + ", \"c_type\": " + quoted(fields[2]) + metadata(annotations, "S." + fields[1]) + "}")
    }
    let pass = 0
    while pass < 32 {
        let previous = accepted.length
        for row in types {
            let fields = row.copy().split("\t")
            continue if fields.length < 5 || fields[0] != "S" || accepted.contains?(fields[1])
            let members = ""
            let valid = true
            let index = 3
            while index + 1 < fields.length {
                let kind = binding_type(fields[index + 1], types, accepted)
                branch {
                    kind.empty? || kind == "\"void\"" || kind == "\"c_string\"" -> { valid = false }
                    _ -> ()
                }
                members = members + branch { index == 3 -> "" _ -> ", " } + "{\"name\": " + quoted(fields[index]) + ", \"type\": " + kind + metadata(annotations, "S." + fields[1] + "." + fields[index]) + "}"
                index = index + 2
            }
            branch {
                valid -> {
                    records = records + branch { records.empty? -> "" _ -> ",\n" } + "    {\"name\": " + quoted(fields[1]) + ", \"c_type\": " + quoted(fields[2]) + ", \"fields\": [" + members + "]" + metadata(annotations, "S." + fields[1]) + "}"
                    accepted.push(fields[1].copy())
                }
                _ -> ()
            }
        }
        break if previous == accepted.length
        pass = pass + 1
    }
    for row in declarations {
        let fields = row.copy().trim().split("\t")
        continue if fields.length < 3 || ["T", "S", "N", "D", "P", "E", "K"].contains?(fields[0])
        branch {
            fields[0] == "Q" -> {
                continue if reported_types.contains?(fields[1])
                reported_types.push(fields[1].copy())
                branch { binding_type(fields[2], types, accepted).empty? -> { report = report + fields[1] + ": unsupported type declaration: " + fields[2] + "\n" } _ -> () }
            }
            fields[0] == "R" -> { report = report + fields[1] + ": " + fields[2] + "\n" }
            fields[0] == "F" -> {
                let name = fields[1].copy()
                continue if names.contains?(name)
                let returns = binding_type(fields[2], types, accepted)
                let reason = ""
                branch {
                    returns.empty? -> { reason = "unsupported result type: " + fields[2] }
                    _ -> ()
                }
                let parameters = ""
                let index = 3
                while index < fields.length {
                    let kind = binding_type(fields[index], types, accepted)
                    branch {
                        kind.empty? || kind == "\"void\"" -> { reason = "unsupported parameter type: " + fields[index] }
                        _ -> ()
                    }
                    parameters = parameters + branch { index == 3 -> "" _ -> ", " } + kind
                    index = index + 1
                }
                branch {
                    reason.empty? -> {
                        operations = operations + branch { operations.empty? -> "" _ -> ",\n" }
                        operations = operations + "    {\"name\": " + quoted(name) + ", \"symbol\": " + quoted(name) + ", \"parameters\": [" + parameters + "], \"result\": " + returns + metadata(annotations, "F." + name) + "}"
                        names.push(name)
                    }
                    _ -> { report = report + name + ": " + reason + "; provide a reviewed binding contract\n" }
                }
            }
            _ -> panic("invalid declaration record")
        }
    }
    Generated {
        manifest: "{\n  \"abi\": 1,\n  \"headers\": [" + quoted(header) + "],\n  \"enums\": [" + enums.join(", ") + "],\n  \"records\": [\n" + records + "\n  ],\n  \"operations\": [\n" + operations + "\n  ]\n}\n"
        report
    }
}

test "nested records and aliases resolve independent of declaration order" {
    let generated = generate("S\tBox\tstruct Box\tpoint\tPoint\nS\tPoint\tstruct Point\tx\tfloat\ty\tfloat\nT\tPoint\tstruct Point\nT\tBox\tstruct Box\nF\tshift\tBox\tBox\n", "sample.h")
    assert(generated.report.empty?)
    assert(generated.manifest.contains?("\"record\": \"Point\""))
    assert(generated.manifest.contains?("\"result\": {\"record\": \"Box\"}"))
}

test "pointer and cyclic fields reject dependent functions but fixed arrays resolve" {
    let generated = generate("S\tOwner\tstruct Owner\tdata\tvoid *\nS\tArray\tstruct Array\tdata\tint[4]\nS\tCycle\tstruct Cycle\tself\tstruct Cycle\nF\ta\tOwner\nF\tb\tArray\nF\tc\tCycle\n", "sample.h")
    assert(generated.report.contains?("a: unsupported result"))
    assert(!generated.report.contains?("b: unsupported result"))
    assert(generated.manifest.contains?("\"array\": \"i32\", \"length\": 4"))
    assert(generated.report.contains?("c: unsupported result"))
}

test "scalar declarations resolve typedef chains and preserve operation order" {
    let generated = generate("T\tint32_t\tint\nT\tCount\tint32_t\nF\tadd\tCount\tCount\tint\nF\treset\tvoid\nF\tadd\tCount\tCount\tint\n", "sample.h")
    assert(generated.report.empty?)
    assert(generated.manifest.contains?("\"parameters\": [\"i32\", \"i32\"], \"result\": \"i32\""))
    assert(generated.manifest.contains?("\"parameters\": [], \"result\": \"void\""))
    assert(generated.manifest.copy().split("\"name\": \"add\"").length == 2)
}

test "pointer ownership and ABI-incompatible scalar types are never guessed" {
    let generated = generate("F\topen\tHandle *\nF\ttext\tint\tconst char *\nF\twide\tlong\nF\tcharacter\tchar\nR\tprintf\tvariadic function\n", "sample.h")
    assert(!generated.manifest.contains?("\"name\""))
    assert(generated.report.contains?("open: unsupported result"))
    assert(generated.report.contains?("text: unsupported parameter"))
    assert(generated.report.contains?("wide: unsupported result"))
    assert(generated.report.contains?("printf: variadic function"))
}

test "alias cycles terminate and JSON paths are escaped" {
    let generated = generate("T\tA\tB\nT\tB\tA\nF\tcycle\tA\n", "C:\\a\"b.h")
    assert(generated.report.contains?("cycle:"))
    assert(generated.manifest.contains?("C:\\\\a\\\"b.h"))
}

test "fixed arrays resolve dimensions typedefs records and enums" {
    let generated = generate("N\tMode\tenum Mode\nT\tModeAlias\tenum Mode\nT\tRow\tfloat[2]\nS\tPoint\tstruct Point\tx\tfloat\nS\tArrays\tstruct Arrays\tgrid\tfloat[2][3]\trow\tRow\tpoints\tPoint[2]\tname\tchar[4]\tmode\tModeAlias\nF\troundtrip\tArrays\tArrays\nF\tmode\tModeAlias\tModeAlias\n", "sample.h")
    assert(generated.report.empty?)
    assert(generated.manifest.contains?("\"array\": {\"array\": \"f32\", \"length\": 3}, \"length\": 2"))
    assert(generated.manifest.contains?("\"enum\": \"ModeAlias\""))
    let aliases = generate("N\tFlags\tFlags\nT\tFlags\tFlags\nT\tOtherFlags\tFlags\nT\tMoreFlags\tOtherFlags\n", "sample.h")
    assert(aliases.manifest.contains?("\"name\": \"OtherFlags\", \"c_type\": \"OtherFlags\""))
    assert(aliases.manifest.contains?("\"name\": \"MoreFlags\", \"c_type\": \"MoreFlags\""))
    for spelling in ["int[]", "int[0]", "int[-1]", "int[9000]", "int *[2]", "int (*)[2]"] {
        assert(binding_type(spelling, [], []).empty?)
    }
}
