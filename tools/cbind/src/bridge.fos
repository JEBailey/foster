//! Reviewed C contracts, validation, schema identity, and source generation.
//! JSON decoding, filesystem access, and Clang orchestration run in Foster.
import core.bytes.Bytes

import core.code_point

import core.byte as octets

import core.int.Int

import core.list.List

import core.option.Option

import core.result.Result

import core.string.String
import core.string.StringBuilder

import std.process
import std.process.SpawnOptions
import std.process.Arguments

import core.future

import std.json
import std.json.JsonParseOptions
import std.json.JsonNumber
import std.json.JsonMember
import std.json.JsonValue
import static std.json.*
import std.fs

import static std.fs.*
import std.path as paths

import static std.path.*
import std.env

pub type Node = {
    pub parent: Int, pub key: String, pub kind: String, pub text: String
}

impl Node {
    func copy(self) -> self {
        Node {
            parent: self.parent, key: self.key.copy(), kind: self.kind.copy(), text: self.text.copy()
        }
    }
}

pub type Contract = {
    pub nodes: List<Node>,
    links: List<List<Int>>
}

func empty_indices() -> List<Int> {
    []
}

func unpack(text: String) -> String {
    let data = branch Bytes.from_hex(text) {
        Result.Ok(value) -> move value
        Result.Error(_) -> panic("invalid host hex")
    }
    branch String.from_utf8(move data) {
        Result.Ok(value) -> move value
        Result.Error(_) -> panic("invalid host UTF-8")
    }
}

func decimal(text: String) -> Int {
    return -1 if text == "-1"
    let number = 0
    for character in text {
        let digit = character.bytes[0].int - 48
        assert(digit >= 0 && digit <= 9, "invalid host node index")
        number = number * 10 + digit
    }
    number
}

func contract(input: String) -> Contract {
    let nodes = []
    for row in input.copy().split("\n") {
        continue if row.empty?
        let parts = row.copy().split("\t")
        assert(parts.length == 4, "invalid host JSON tree")
        nodes.push(Node {
            parent: decimal(parts[0]), key: unpack(parts[1]), kind: parts[2].copy(), text: unpack(parts[3])
        })
    }
    indexed(move nodes)
}

func indexed(nodes: List<Node>) -> Contract [consume nodes] {
    let links = []
    for node in nodes {
        links.push(empty_indices())
    }
    let index = 0
    for node in nodes {
        if node.parent >= 0 {
            branch links.borrow(node.parent) {
                Option.Some(children) -> children.push(index)
                Option.None -> panic("invalid host JSON parent")
            }
        }
        index = index + 1
    }
    Contract {
        nodes: move nodes,
        links: move links
    }
}

impl Contract {
    pub func json(self, node: Int) -> String {
        assert(node >= 0, "missing JSON value")
        let kind = self.nodes[node].kind.copy()
        return json_quoted(self.nodes[node].text) if kind == "string"
        return self.nodes[node].text.copy() if kind != "object" && kind != "array"
        let values = []
        for child in self.children(node) {
            let prefix = branch {
                kind == "object" -> json_quoted(self.nodes[child].key) + ":" _ -> ""
            }
            values.push(prefix + self.json(child))
        }
        branch {
            kind == "object" -> "{" + values.join(",") + "}" _ -> "[" + values.join(",") + "]"
        }
    }
    pub func member(self, object: Int, key: String) -> Int {
        return -1 if object < 0
        for index in self.links[object] {
            return index if self.nodes[index].key == key
        }
        -1
    }
    pub func children(self, parent: Int) -> List<Int> {
        return [] if parent < 0
        self.links[parent].slice(0, self.links[parent].length)
    }
    pub func array(self, object: Int, key: String, required: Bool) -> List<Int> {
        let node = self.member(object, key)
        assert(node >= 0 || !required, "missing field " + key)
        return [] if node < 0
        assert(self.nodes[node].kind == "array", "expected array for " + key)
        self.children(node)
    }
    pub func string(self, object: Int, key: String, required: Bool) -> String {
        let node = self.member(object, key)
        assert(node >= 0 || !required, "missing field " + key)
        return "" if node < 0
        return "" if !required && self.nodes[node].kind == "null"
        assert(self.nodes[node].kind == "string", "expected string for " + key)
        assert(required || !self.nodes[node].text.empty?, "optional identifier must not be empty")
        self.nodes[node].text.copy()
    }
    pub func boolean(self, object: Int, key: String) -> Bool {
        let node = self.member(object, key)
        return false if node < 0
        assert(self.nodes[node].kind == "bool", "expected boolean for " + key)
        self.nodes[node].text == "true"
    }
    func fields(self, object: Int, allowed: String) {
        assert(object >= 0 && self.nodes[object].kind == "object", "expected manifest object")
        let names = allowed.copy().split(" ")
        for node in self.children(object) {
            assert(names.contains?(self.nodes[node].key), "unknown manifest field " + self.nodes[node].key)
        }
    }
    func ty(self, node: Int) -> String {
        assert(node >= 0, "missing value type")
        branch self.nodes[node].kind {
            "string" -> {
                let value = self.nodes[node].text.copy()
                assert("void bool char long ulong i8 u8 i16 u16 i32 u32 i64 u64 f32 f64 bytes c_string".split(" ").contains?(value), "unknown C value type " + value)
                move value
            }
            "object" -> {
                if self.member(node, "resource") >= 0 {
                    self.fields(node, "resource pointer retained consume")
                    self.boolean(node, "pointer")
                    self.boolean(node, "retained")
                    self.boolean(node, "consume")
                    assert(!(self.boolean(node, "retained") && self.boolean(node, "consume")), "resource cannot be retained and consumed")
                    return "%" + self.string(node, "resource", true)
                }
                if self.member(node, "callback") >= 0 {
                    self.fields(node, "callback retained")
                    self.boolean(node, "retained")
                    return "^" + self.string(node, "callback", true)
                }
                for key in ["out", "inout"] {
                    if self.member(node, key) >= 0 {
                        self.fields(node, key)
                        return branch {
                            key == "out" -> "&" _ -> "!"
                        } + self.ty(self.member(node, key))
                    }
                }
                if self.member(node, "buffer") >= 0 {
                    self.fields(node, "buffer length mutable output")
                    let element = self.ty(self.member(node, "buffer"))
                    assert(!element.starts_with?("["), "buffer elements must be scalars or value records")
                    if !["u8", "char", "void"].contains?(element) self.slots(element, [])
                    assert(["i32", "u32", "size"].contains?(self.string(node, "length", true)), "buffer length must be i32, u32, or size")
                    self.boolean(node, "mutable")
                    assert(!self.boolean(node, "output") || !self.boolean(node, "mutable"), "choose mutable input or output-only buffer")
                    return "~" + node.as_string()
                }
                if self.member(node, "array") >= 0 {
                    self.fields(node, "array length")
                    let length = self.member(node, "length")
                    assert(length >= 0 && self.nodes[length].kind == "number", "missing array length")
                    let digits = self.nodes[length].text.copy()
                    assert(digits.length <= 4, "invalid C array length")
                    let count = decimal(digits)
                    assert(count > 0 && count <= 8191, "invalid C array length")
                    return "[" + count.as_string() + "]" + self.ty(self.member(node, "array"))
                }
                if self.member(node, "enum") >= 0 {
                    self.fields(node, "enum")
                    return "$" + self.string(node, "enum", true)
                }
                self.fields(node, "record")
                "@" + self.string(node, "record", true)
            }
            _ -> panic("invalid C value type")
        }
    }
    func records(self) -> List<Int> {
        self.array(0, "records", false)
    }
    func enums(self) -> List<Int> {
        self.array(0, "enums", false)
    }
    func enum_type(self, ty: String) -> String {
        for node in self.enums() {
            return self.string(node, "c_type", true) if "$" + self.string(node, "name", true) == ty
        }
        panic("unknown C enum " + ty)
    }
    func resources(self) -> List<Int> {
        self.array(0, "resources", false)
    }
    func callbacks(self) -> List<Int> {
        self.array(0, "callbacks", false)
    }
    func callback(self, ty: String) -> Int {
        for node in self.callbacks() {
            return node if "^" + self.string(node, "name", true) == ty
        }
        panic("unknown C callback " + ty)
    }
    func operations(self) -> List<Int> {
        self.array(0, "operations", true)
    }
    func bound(self, node: Int, key: String, maximum: Int) -> Int {
        let value = self.member(node, key)
        assert(value >= 0 && self.nodes[value].kind == "number", "missing numeric " + key)
        let parsed = branch JsonNumber.parse(self.nodes[value].text) {
            Result.Ok(value) -> move value Result.Error(error) -> panic(error.message)
        }
        let number = branch parsed.as_int() {
            Result.Ok(value) -> value Result.Error(error) -> panic(error.message)
        }
        assert(number > 0 && number <= maximum, "invalid " + key)
        number
    }
    func extended(self, node: Int) -> Bool {
        return true if self.ty(self.member(node, "result")) == "c_string" || self.boolean(node, "borrowed_result") || !self.string(node, "length_type", false).empty?
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            return true if ty.starts_with?("&") || ty.starts_with?("!") || ty.starts_with?("~") || ty.starts_with?("^") || ty.starts_with?("%")
        }
        false
    }
    func outputs(self, node: Int) -> List<String> {
        let values = []
        let result_type = self.ty(self.member(node, "result"))
        if result_type != "void" {
            values.push(result_type.copy())
        }
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            branch {
                ty.starts_with?("&") || ty.starts_with?("!") -> values.push(ty.slice(1, ty.length))
                ty.starts_with?("~") && self.writable_buffer(parameter) -> values.push(branch {
                    self.raw_buffer(parameter) -> "bytes" _ -> ty.copy()
                })
            }
        }
        move values
    }
    func output_names(self, node: Int) -> List<String> {
        let names = []
        if self.ty(self.member(node, "result")) != "void" {
            names.push("result")
        }
        let index = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            if ty.starts_with?("&") || ty.starts_with?("!") || ty.starts_with?("~") && self.writable_buffer(parameter) {
                names.push("out" + index.as_string())
            }
            index = index + 1
        }
        move names
    }
    func writable_buffer(self, node: Int) -> Bool {
        self.boolean(node, "mutable") || self.boolean(node, "output")
    }
    func raw_buffer(self, node: Int) -> Bool {
        ["u8", "char", "void"].contains?(self.ty(self.member(node, "buffer")))
    }
    func value_type(self, ty: String) -> String {
        return "List<" + foster_type(self.ty(self.member(decimal(ty.slice(1, ty.length)), "buffer"))) + ">" if ty.starts_with?("~")
        foster_type(ty)
    }
    func record(self, ty: String) -> Int {
        for node in self.records() {
            return node if "@" + self.string(node, "name", true) == ty
        }
        panic("unknown C record " + ty)
    }
    func resource(self, name: String) -> Int {
        for node in self.resources() {
            return node if self.string(node, "name", true) == name
        }
        panic("unknown C resource " + name)
    }
    func kind(self, name: String) -> Int {
        let index = 1
        for node in self.resources() {
            return index if self.string(node, "name", true) == name
            index = index + 1
        }
        panic("unknown C resource " + name)
    }
    func slots(self, ty: String, stack: List<String>) -> Int {
        branch {
            ty.starts_with?("[") -> {
                assert(stack.length < 32, "excessively nested C array")
                let nested = stack.slice(0, stack.length)
                nested.push(ty.copy())
                let count = array_length(ty) * self.slots(array_element(ty), nested)
                assert(count <= 8191, "C record exceeds 65528 wire bytes")
                count
            }
            ty.starts_with?("@") -> {
                assert(stack.length < 32 && !stack.contains?(ty), "cyclic or excessively nested C record " + ty)
                let nested = stack.slice(0, stack.length)
                nested.push(ty.copy())
                let count = 0
                for field in self.array(self.record(ty), "fields", true) {
                    count = count + self.slots(self.ty(self.member(field, "type")), nested)
                    assert(count <= 8191, "C record exceeds 65528 wire bytes")
                }
                count
            }
            _ -> {
                assert(!ty.starts_with?("&") && !ty.starts_with?("!") && !ty.starts_with?("~") && !ty.starts_with?("^") && !ty.starts_with?("%"), "pointer contracts are only valid on operation parameters")
                branch {
                    ty.starts_with?("$") -> {
                        self.enum_type(ty)
                    }
                    _ -> ""
                }
                assert(ty != "void" && ty != "bytes" && ty != "c_string", "C record fields must be scalar values or value records")
                1
            }
        }
    }
    func c_type(self, ty: String) -> String {
        return self.string(self.record(ty), "c_type", true) if ty.starts_with?("@")
        return self.enum_type(ty) if ty.starts_with?("$")
        branch ty {
            "char" -> "char"
            "long" -> "long"
            "ulong" -> "unsigned long"
            "bool" -> "_Bool"
            "i8" -> "int8_t"
            "u8" -> "uint8_t"
            "i16" -> "int16_t"
            "u16" -> "uint16_t"
            "i32" -> "int32_t"
            "u32" -> "uint32_t"
            "i64" -> "int64_t"
            "u64" -> "uint64_t"
            "f32" -> "float"
            "f64" -> "double"
            "bytes" -> "uint8_t *"
            "c_string" -> "const char*"
            _ -> "void"
        }
    }
    func validate(self) {
        self.fields(0, "abi headers sources include_directories libraries resources records enums operations constants callbacks")
        let abi = self.member(0, "abi")
        assert(abi >= 0, "missing ABI")
        assert(self.nodes[abi].kind == "number" && self.nodes[abi].text == "1", "unsupported C bridge ABI")
        for key in ["headers", "sources", "include_directories", "libraries"] {
            for node in self.array(0, key, key == "headers") {
                assert(self.nodes[node].kind == "string", "expected string in " + key)
                let value = self.nodes[node].text.copy()
                for octet in value.bytes {
                    assert(octet.int != 0, "NUL in build path")
                }
                if key == "headers" {
                    assert(!value.empty? && !value.contains?("\"") && !value.contains?("\n") && !value.contains?("\r"), "invalid C header name")
                }
            }
        }
        let names = []
        for node in self.enums() {
            self.fields(node, "name c_type documentation")
            self.docs(node, "")
            let name = self.string(node, "name", true)
            check_name(name, names)
            names.push(name.copy())
            assert(!["Int", "Float", "Bool", "String", "Bytes", "List", "Result", "CError", "CValue", "CArguments", "CBridge", "CResource"].contains?(name), "C enum conflicts with std.ffi")
            let c_name = self.string(node, "c_type", true)
            let bare = c_name.strip_prefix("enum ")
            assert(identifier(bare), "invalid C enum type")
        }
        for node in self.records() {
            self.fields(node, "name c_type fields documentation foster_module")
            let foster_module = self.string(node, "foster_module", false)
            if !foster_module.empty? {
                for part in foster_module.split(".") {
                    assert(identifier(part), "invalid Foster record module")
                }
            }
            self.docs(node, "")
            let name = self.string(node, "name", true)
            check_name(name, names)
            names.push(name.copy())
            assert(!["Int", "Float", "Bool", "String", "Bytes", "List", "Result", "CError", "CValue", "CArguments", "CBridge", "CResource"].contains?(name), "C record conflicts with std.ffi")
            let c_name = self.string(node, "c_type", true)
            let bare = c_name.strip_prefix("struct ")
            assert(identifier(bare), "invalid C record type")
            let fields = self.array(node, "fields", true)
            assert(fields.length > 0, "empty C records are not supported")
            let field_names = []
            for field in fields {
                self.fields(field, "name type documentation")
                self.docs(field, "")
                let field_name = self.string(field, "name", true)
                check_name(field_name, field_names)
                field_names.push(move field_name)
                self.ty(self.member(field, "type"))
            }
        }
        for node in self.records() {
            self.slots("@" + self.string(node, "name", true), [])
        }
        for node in self.callbacks() {
            self.fields(node, "name c_type method parameters result delivery failure")
            let name = self.string(node, "name", true)
            check_name(name, names)
            names.push(name.copy())
            let native = self.string(node, "c_type", false)
            assert(native.empty? || identifier(native), "invalid callback typedef")
            assert(identifier(self.string(node, "method", true)), "invalid callback method")
            let delivery = self.string(node, "delivery", true)
            assert(["direct", "queued"].contains?(delivery), "callback delivery must be direct or queued")
            let width = 0
            for parameter in self.array(node, "parameters", false) {
                let ty = self.ty(parameter)
                assert(!ty.starts_with?("["), "callback array parameters decay to unsupported pointers")
                width = width + self.slots(ty, [])
            }
            assert(width <= 8191, "callback packet exceeds 65528 bytes")
            let callback_result = self.ty(self.member(node, "result"))
            if callback_result != "void" {
                assert(!callback_result.starts_with?("["), "C callbacks cannot return arrays")
                self.slots(callback_result, [])
                assert(delivery == "direct", "queued callbacks must return void")
                assert(self.string(node, "failure", true) == "zero", "callback result requires explicit zero failure policy")
            }
        }
        let resource_names = []
        for node in self.resources() {
            self.fields(node, "name c_type destroy close close_consumes_on_error by_value valid")
            self.boolean(node, "by_value")
            let valid = self.string(node, "valid", false)
            assert(valid.empty? || identifier(valid), "invalid resource validation function")
            assert(!self.boolean(node, "by_value") || self.string(node, "close", false).empty?, "value resources use their unconditional destructor for close")
            let name = self.string(node, "name", true)
            check_name(name, resource_names)
            resource_names.push(move name)
            for key in ["c_type", "destroy", "close"] {
                let value = self.string(node, key, key != "close")
                assert(value.empty? && key == "close" || identifier(value), "invalid C resource identifier")
            }
            self.boolean(node, "close_consumes_on_error")
        }
        let operation_names = []
        let callback_resources = []
        for operation in self.operations() {
            let callback_owner = self.string(operation, "creates", false)
            if !callback_owner.empty? {
                for parameter in self.array(operation, "parameters", false) {
                    if self.ty(parameter).starts_with?("^") callback_resources.push(callback_owner.copy())
                }
            }
        }
        for node in self.operations() {
            self.fields(node, "name symbol parameters result receiver creates release documentation parameter_names length_type borrowed_result max_length receiver_pointer")
            self.docs(node, "")
            let name = self.string(node, "name", true)
            check_name(name, operation_names)
            operation_names.push(move name)
            assert(identifier(self.string(node, "symbol", true)), "invalid C operation identifier")
            let result_type = self.ty(self.member(node, "result"))
            assert(!result_type.starts_with?("&") && !result_type.starts_with?("!") && !result_type.starts_with?("~") && !result_type.starts_with?("^") && !result_type.starts_with?("%"), "pointer direction contracts are parameters only")
            let parameter_names = self.array(node, "parameter_names", false)
            assert(parameter_names.empty? || parameter_names.length == self.array(node, "parameters", false).length, "parameter_names must match parameters")
            for parameter in parameter_names {
                assert(self.nodes[parameter].kind == "string", "parameter name must be a string")
                assert(self.nodes[parameter].text.empty? || identifier(self.nodes[parameter].text), "invalid parameter name")
            }
            let callback_count = 0
            for parameter in self.array(node, "parameters", false) {
                let ty = self.ty(parameter)
                if ty.starts_with?("%") {
                    let resource_name = ty.slice(1, ty.length)
                    self.kind(resource_name)
                    assert(!self.boolean(parameter, "pointer") || self.boolean(self.resource(resource_name), "by_value"), "pointer applies to boxed value resources")
                    assert(!(self.boolean(parameter, "retained") || self.boolean(parameter, "consume")) || !self.string(node, "creates", false).empty?, "resource retention and consumption require a constructor")
                    assert(!(self.boolean(parameter, "retained") || self.boolean(parameter, "consume")) || !callback_resources.contains?(resource_name), "callback owners cannot be retained or transferred")
                }
                if ty.starts_with?("^") {
                    callback_count = callback_count + 1
                    let callback = self.callback(ty)
                    let retained = self.boolean(parameter, "retained")
                    assert(self.string(node, "receiver", false).empty?, "callback registration must not borrow a receiver")
                    assert(retained == !self.string(node, "creates", false).empty?, "retained callback requires an owning resource constructor")
                    assert(retained || self.string(callback, "delivery", true) == "direct", "queued callback must be retained")
                }
                assert(ty != "void", "void is not a C parameter")
                assert(!ty.starts_with?("["), "array parameters require an explicit buffer contract")
                branch {
                    ty.starts_with?("&") || ty.starts_with?("!") -> {
                        let value = ty.slice(1, ty.length)
                        assert(!value.starts_with?("["), "out pointers must point to a scalar or value record")
                        self.slots(value, [])
                    }
                    _ -> 0
                }
                branch {
                    ty.starts_with?("$") -> {
                        self.enum_type(ty)
                    }
                    _ -> ""
                }
                branch {
                    ty.starts_with?("@") -> {
                        self.slots(ty, [])
                    }
                    _ -> 0
                }
            }
            assert(callback_count <= 1, "one callback/context pair is supported per operation")
            branch {
                result_type.starts_with?("@") -> {
                    self.slots(result_type, [])
                }
                _ -> 0
            }
            branch {
                result_type == "c_string" -> {
                    self.bound(node, "max_length", 16777216)
                }
                _ -> 0
            }
            let length_type = self.string(node, "length_type", false)
            assert(length_type.empty? || result_type == "bytes" && ["i32", "u32", "size"].contains?(length_type), "length_type applies to copied byte results")
            let borrowed = self.boolean(node, "borrowed_result")
            assert(!borrowed || result_type == "bytes" || result_type == "c_string", "borrowed_result applies to copied pointer results")
            assert(!result_type.starts_with?("["), "C functions cannot return arrays by value")
            branch {
                result_type.starts_with?("$") -> {
                    self.enum_type(result_type)
                }
                _ -> ""
            }
            let receiver = self.string(node, "receiver", false)
            assert(!self.boolean(node, "receiver_pointer") || !receiver.empty?, "receiver_pointer requires a resource receiver")
            let creates = self.string(node, "creates", false)
            let release = self.string(node, "release", false)
            assert(receiver.empty? || creates.empty?, "resource-returning receiver calls are not supported yet")
            for resource_name in [receiver.copy(), creates.copy()] {
                branch {
                    !resource_name.empty? -> {
                        self.kind(resource_name)
                    }
                    _ -> 0
                }
            }
            assert(creates.empty? || result_type == "void", "constructors use result void plus creates")
            assert(creates.empty? || self.outputs(node).empty?, "constructors cannot also return output parameters")
            assert(self.outputs(node).length <= 1 || !names.contains?("Result_" + self.string(node, "name", true)), "output record name conflicts with a C type")
            assert(branch {
                result_type == "bytes" || result_type == "c_string" -> borrowed != !release.empty? _ -> release.empty?
            }, "a copied pointer result requires exactly one release function or borrowed_result")
            assert(release.empty? || identifier(release), "invalid release identifier")
        }
        let constant_names = []
        for node in self.array(0, "constants", false) {
            self.fields(node, "name type value documentation")
            self.docs(node, "")
            let name = self.string(node, "name", true)
            check_name(name, constant_names)
            constant_names.push(name.copy())
            // Prefixes keep constants distinct from generated functions and C types.
            assert(!names.contains?("_" + name), "constant name conflicts with C record")
            self.constant_value(self.constant_type(node), self.member(node, "value"))
        }
    }
}

func doc_lines(text: String, indent: String) -> String {
    let lines = []
    for line in text.copy().split("\n") {
        lines.push(indent + "/// " + line.copy().split("\r").join(""))
    }
    lines.join("\n") + "\n"
}

impl Contract {
    func docs(self, node: Int, indent: String) -> String {
        let field = self.member(node, "documentation")
        return "" if field < 0
        assert(self.nodes[field].kind == "string", "documentation must be text")
        doc_lines(self.nodes[field].text, indent)
    }
    func constant_type(self, node: Int) -> String {
        let ty = self.member(node, "type")
        return "string" if ty >= 0 && self.nodes[ty].kind == "string" && self.nodes[ty].text == "string"
        self.ty(ty)
    }
    func constant_value(self, ty: String, node: Int) -> String {
        assert(node >= 0, "missing constant value")
        branch {
            ty.starts_with?("[") -> {
                assert(self.nodes[node].kind == "array", "array constant requires element values")
                let values = self.children(node)
                assert(values.length == array_length(ty), "array constant length mismatch")
                let expressions = []
                for value in values {
                    expressions.push(self.constant_value(array_element(ty), value))
                }
                "[" + expressions.join(", ") + "]"
            }
            ty.starts_with?("@") -> {
                assert(self.nodes[node].kind == "object", "record constant requires field values")
                let fields = self.array(self.record(ty), "fields", true)
                assert(self.children(node).length == fields.length, "constant record field count mismatch")
                let values = []
                for field in fields {
                    let name = self.string(field, "name", true)
                    values.push(foster_name(name) + ": " + self.constant_value(self.ty(self.member(field, "type")), self.member(node, name)))
                }
                foster_type(ty) + " { " + values.join(", ") + " }"
            }
            ty == "string" -> {
                assert(self.nodes[node].kind == "string", "expected string constant")
                quoted(self.nodes[node].text)
            }
            ty == "bool" -> {
                assert(self.nodes[node].kind == "bool", "expected boolean constant")
                self.nodes[node].text.copy()
            }
            _ -> {
                assert(!["void", "bytes", "c_string"].contains?(ty), "unsupported constant type")
                assert(self.nodes[node].kind == "number", "expected numeric constant")
                let value = self.nodes[node].text.copy()
                let number = branch JsonNumber.parse(value) {
                    Result.Ok(number) -> move number Result.Error(error) -> panic(error.message)
                }
                branch {
                    ty == "f32" || ty == "f64" -> {
                        branch number.as_float() {
                            Result.Ok(_) -> () Result.Error(error) -> panic(error.message)
                        }
                        branch {
                            value.contains?(".") || value.contains?("e") || value.contains?("E") -> value.copy() _ -> value + ".0"
                        }
                    }
                    _ -> {
                        branch number.as_int() {
                            Result.Ok(_) -> () Result.Error(error) -> panic(error.message)
                        }
                        branch {
                            value == "-9223372036854775808" -> "(-9223372036854775807 - 1)" _ -> value.copy()
                        }
                    }
                }
            }
        }
    }
}

func identifier(value: String) -> Bool {
    return false if value.empty?
    let index = 0
    for byte in value.bytes {
        let c = byte.int
        return false if !(c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || index > 0 && c >= 48 && c <= 57)
        index = index + 1
    }
    true
}

func check_name(name: String, names: List<String>) {
    assert(identifier(name), "invalid C identifier " + name)
    assert(!names.contains?(name), "duplicate C name " + name)
}

func foster_type(ty: String) -> String {
    return "List<" + foster_type(array_element(ty)) + ">" if ty.starts_with?("[")
    return foster_type_name(ty.slice(1, ty.length)) if ty.starts_with?("@") || ty.starts_with?("$")
    branch ty {
        "void" -> "()"
        "bool" -> "Bool"
        "f32" -> "Float"
        "f64" -> "Float"
        "bytes" -> "Bytes"
        "c_string" -> "String"
        _ -> "Int"
    }
}

func array_length(ty: String) -> Int {
    decimal(ty.copy().split("]")[0].slice(1, ty.copy().split("]")[0].length))
}

func array_element(ty: String) -> String {
    let prefix = ty.copy().split("]")[0]
    ty.slice(prefix.length + 1, ty.length)
}

func foster_copy(ty: String, place: String, depth: Int) -> String {
    return place + ".copy()" if ty.starts_with?("@")
    if ty.starts_with?("[") {
        let element = array_element(ty)
        let name = "element" + depth.as_string()
        return place + ".map((" + name + ": " + foster_type(element) + ") -> " + foster_copy(element, name, depth + 1) + ")"
    }
    place.copy()
}

func foster_type_name(name: String) -> String {
    foster_name(name.slice(0, 1).ascii_upper() + name.slice(1, name.length))
}

func foster_function_name(name: String) -> String {
    foster_name(name.slice(0, 1).ascii_lower() + name.slice(1, name.length))
}

func foster_name(name: String) -> String {
    let reserved = "func function impl test const let pub type enum import static as return assert loop while for in break continue if branch else remote await try panic not true false move ref group read mut reshape consume suspend intrinsic self copy".split(" ")
    branch {
        name.ends_with?("_") || reserved.contains?(name) -> name + "_"
        _ -> name.copy()
    }
}

func quoted(text: String) -> String {
    // Foster literals have different escapes from JSON. Iterate scalars so a
    // combining mark cannot hide an adjacent quote or backslash in a grapheme.
    let output = StringBuilder.empty()
    output.append("\"")
    for character in text.code_points() {
        branch character.as_int() {
            34 -> output.append("\\\"")
            92 -> output.append("\\\\")
            10 -> output.append("\\n")
            13 -> output.append("\\r")
            9 -> output.append("\\t")
            _ -> output.push(character)
        }
    }
    output.append("\"")
    (move output).finish()
}

func json_quoted(text: String) -> String {
    branch json::stringify(JsonValue.String(text.copy())) {
        Result.Ok(output) -> move output
        Result.Error(error) -> panic(error.message)
    }
}

test "indexed JSON re-emits escaped object keys and string values" {
    let source = "{\"\\u0000\\b\\f\":\"\\\"́\\\\́\\r\\n\\t\"}"
    let tree = decode_json(source)
    let emitted = tree.json(0)
    let restored = decode_json(emitted)
    assert(restored.nodes.length == tree.nodes.length)
    assert(restored.nodes[1].key == tree.nodes[1].key)
    assert(restored.nodes[1].text == tree.nodes[1].text)
}

func hex32(number: Int) -> String {
    let output = ""
    let value = number
    for index in 0.range(8) {
        let digit = value.modulo(16)
        output = "0123456789abcdef".slice(digit, digit + 1) + output
        value = value / 16
    }
    move output
}
// FNV-1a using bounded 32-bit limbs, independent of signed overflow behavior.

func identity(input: String) -> String {
    let high = 3421674724
    let low = 2216829733
    for byte in input.bytes {
        let bottom = Byte.unchecked(low.modulo(256)) ^ byte
        low = low / 256 * 256 + bottom.int
        let product = low * 435
        high = (high * 435 + low * 256 + product / 4294967296).modulo(4294967296)
        low = product.modulo(4294967296)
    }
    hex32(high) + hex32(low)
}

impl Contract {
    func c_destroy(self, resource: Int, place: String) -> String {
        let ty = self.string(resource, "c_type", true)
        let by_value = self.boolean(resource, "by_value")
        let argument = branch {
            by_value -> "*(" + ty + "*)" + place _ -> "(" + ty + "*)" + place
        }
        "void (*destroy)(" + ty + branch {
            by_value -> "" _ -> "*"
        } + ")=&" + self.string(resource, "destroy", true) + "; destroy(" + argument + ");" + branch {
            by_value -> " free(" + place + ");" _ -> ""
        }
    }
    func c_create(self, name: String, call: String) -> String {
        let resource = self.resource(name)
        let ty = self.string(resource, "c_type", true)
        let by_value = self.boolean(resource, "by_value")
        let code = branch {
            by_value -> ty + " *owned=malloc(sizeof(*owned)); if(!owned) return 5; *owned=" + call + ";\n"
            _ -> ty + " *owned=" + call + "; if(!owned) return 4;\n"
        }
        let valid = self.string(resource, "valid", false)
        if !valid.empty? {
            code = code + "_Bool (*valid)(" + ty + branch {
                by_value -> "" _ -> "*"
            } + ")=&" + valid + "; if(!valid(" + branch {
                by_value -> "*owned" _ -> "owned"
            } + ")) { " + self.c_destroy(resource, "owned") + " return 4; }\n"
        }
        code + "*created=(void*)owned; return 0;\n"
    }
    func c_extended(self, node: Int, operation: Int) -> String {
        let prefix = "case " + operation.as_string() + ": {\n"
        let types = []
        let arguments = []
        let parse = ""
        let allocate = ""
        let cleanup = ""
        let values = []
        let lengths = []
        let transfers = ""
        let receiver = self.string(node, "receiver", false)
        let creates = self.string(node, "creates", false)
        let returns = self.ty(self.member(node, "result"))
        if !receiver.empty? {
            let resource = self.resource(receiver)
            let ty = self.string(resource, "c_type", true)
            let by_value = self.boolean(resource, "by_value") && !self.boolean(node, "receiver_pointer")
            types.push(ty + branch {
                by_value -> "" _ -> "*"
            })
            arguments.push(branch {
                by_value -> "*(" + ty + "*)resource" _ -> "(" + ty + "*)resource"
            })
        }
        let index = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            let place = "a" + index.as_string()
            let size = "n" + index.as_string()
            branch {
                ty.starts_with?("%") -> {
                    let name = ty.slice(1, ty.length)
                    let resource = self.resource(name)
                    let native = self.string(resource, "c_type", true)
                    let by_value = self.boolean(resource, "by_value") && !self.boolean(parameter, "pointer")
                    types.push(native + branch {
                        by_value -> "" _ -> "*"
                    })
                    let action = branch {
                        self.boolean(parameter, "consume") -> 3 self.boolean(parameter, "retained") -> 1 _ -> 0
                    }
                    parse = parse + "uint64_t " + place + "_token; void *" + place + "_resource=NULL; if(!read64(&input,&remaining,&" + place + "_token) || !foster_resolve || foster_resolve(foster_c_schema(),(int64_t)" + place + "_token," + self.kind(name).as_string() + "," + action.as_string() + ",&" + place + "_resource)) return 2;\n"
                    arguments.push(branch {
                        by_value -> "*(" + native + "*)" + place + "_resource" _ -> "(" + native + "*)" + place + "_resource"
                    })
                    if self.boolean(parameter, "consume") {
                        transfers = transfers + "{ void *transferred=NULL; if(foster_resolve(foster_c_schema(),(int64_t)" + place + "_token," + self.kind(name).as_string() + ",2,&transferred)) abort(); }\n"
                    }
                }
                ty.starts_with?("^") -> {
                    let callback = self.callback(ty)
                    let name = self.string(callback, "name", true)
                    types.push("foster_cb_" + name + "_fn")
                    types.push("void*")
                    parse = parse + "uint64_t " + place + "; if(!read64(&input,&remaining,&" + place + ")) return 2;\nif(!foster_dispatch || foster_dispatch((int64_t)" + place + ",UINT64_C(0x" + identity(self.json(callback)) + "),NULL,UINT64_MAX,NULL,0,NULL)) return 2;\n"
                    arguments.push("foster_cb_" + name)
                    arguments.push("(void*)(uintptr_t)" + place)
                }
                ty.starts_with?("&") || ty.starts_with?("!") -> {
                    let base = ty.slice(1, ty.length)
                    types.push(self.c_type(base) + "*")
                    parse = parse + self.c_type(base) + " " + place + "={0};\n"
                    if ty.starts_with?("!") parse = parse + self.c_read(base, place)
                    arguments.push("&" + place)
                    values.push(place.copy())
                    lengths.push("")
                }
                ty.starts_with?("~") || ty == "bytes" || ty == "c_string" -> {
                    let element = branch {
                        ty.starts_with?("~") -> self.ty(self.member(parameter, "buffer")) ty == "c_string" -> "char" _ -> "u8"
                    }
                    let native = self.c_type(element)
                    let raw = !ty.starts_with?("~") || self.raw_buffer(parameter)
                    let stride = branch {
                        raw -> 1 _ -> self.slots(element, []) * 8
                    }
                    let stored = branch {
                        raw -> "uint8_t" _ -> native.copy()
                    }
                    let mutable = ty.starts_with?("~") && self.writable_buffer(parameter)
                    let output_only = ty.starts_with?("~") && self.boolean(parameter, "output")
                    types.push(branch {
                        mutable -> "" _ -> "const "
                    } + native + "*")
                    parse = parse + "uint64_t " + size + "; if(!read64(&input,&remaining,&" + size + ") || " + size + ">16777216/" + stride.as_string() + " || " + size + ">16777216/sizeof(" + stored + ")" + branch {
                        output_only -> "" _ -> " || " + size + ">remaining/" + stride.as_string()
                    } + ") return 2;\n"
                    if ty == "c_string" parse = parse + "if(!c_string_valid(input," + size + ")) return 2;\n"
                    if !output_only {
                        parse = parse + "const uint8_t *" + place + "_input=input; input+=" + size + "*" + stride.as_string() + "; remaining-=" + size + "*" + stride.as_string() + ";\n"
                    }
                    branch {
                        mutable || !raw -> {
                            // Declare every allocation before the first possible cleanup jump.
                            prefix = prefix + stored + " *" + place + "=NULL;\n"
                            allocate = allocate + place + "=calloc((size_t)(" + size + " ? " + size + " : 1),sizeof(" + stored + ")); if(!" + place + ") { status=5; goto cleanup; }\n"
                            if !output_only {
                                branch {
                                    raw -> {
                                        allocate = allocate + "if(" + size + ") memcpy(" + place + "," + place + "_input,(size_t)" + size + ");\n"
                                    }
                                    _ -> {
                                        let decode = self.c_read(element, place + "[buffer_index]").split("return 2;").join("{ status=2; goto cleanup; }").split("return 3;").join("{ status=3; goto cleanup; }")
                                        allocate = allocate + "{ const uint8_t *input=" + place + "_input; uint64_t remaining=" + size + "*" + stride.as_string() + "; for(uint64_t buffer_index=0; buffer_index<" + size + "; buffer_index++) {\n" + decode + "} }\n"
                                    }
                                }
                            }
                            cleanup = cleanup + "free(" + place + ");\n"
                            arguments.push("(" + branch {
                                mutable -> "" _ -> "const "
                            } + native + "*)" + place)
                            if mutable {
                                values.push(place.copy())
                                lengths.push(size.copy())
                            }
                        }
                        _ -> arguments.push("(const " + native + "*)" + place + "_input")
                    }
                    if ty != "c_string" {
                        let length_type = branch {
                            ty.starts_with?("~") -> self.string(parameter, "length", true) _ -> "size"
                        }
                        let c_length = branch {
                            length_type == "size" -> "size_t" _ -> self.c_type(length_type)
                        }
                        types.push(c_length.copy())
                        arguments.push("(" + c_length + ")" + size)
                    }
                }
                _ -> {
                    types.push(self.c_type(ty))
                    parse = parse + self.c_type(ty) + " " + place + "={0};\n" + self.c_read(ty, place)
                    arguments.push(place.copy())
                }
            }
            index = index + 1
        }
        if returns == "bytes" {
            let length_type = self.string(node, "length_type", false)
            let native = branch {
                length_type.empty? || length_type == "size" -> "size_t" _ -> self.c_type(length_type)
            }
            types.push(native + "*")
            parse = parse + native + " result_size=0;\n"
            arguments.push("&result_size")
        }
        if types.empty? {
            types.push("void")
        }
        let return_type = branch {
            !creates.empty? -> self.string(self.resource(creates), "c_type", true) + branch {
                self.boolean(self.resource(creates), "by_value") -> "" _ -> "*"
            }
            returns == "c_string" && !self.string(node, "release", false).empty? -> "char*"
            _ -> self.c_type(returns)
        }
        let declaration = return_type + " (*target)(" + types.join(",") + ")=&" + self.string(node, "symbol", true) + ";\n"
        let call = "target(" + arguments.join(",") + ")"
        if !creates.empty? {
            let creation = self.c_create(creates, call).split(call + ";").join(call + ";\n" + transfers)
            for status in [0, 4, 5] {
                creation = creation.split("return " + status.as_string() + ";").join("{ status=" + status.as_string() + "; goto cleanup; }")
            }
            let code = prefix + "int32_t status=0;\n" + declaration + parse + "if(remaining) return 2;\n" + allocate + creation + "cleanup:\n" + cleanup + "return status;\n}\n"
            return code.copy().split("goto cleanup;").join("goto cleanup_" + operation.as_string() + ";").split("cleanup:\n").join("cleanup_" + operation.as_string() + ":\n")
        }
        // Result storage is declared before jumps caused by allocation failures.
        let result_declaration = branch {
            returns == "void" -> "" _ -> return_type + " result={0};\n"
        }
        let code = prefix + result_declaration + "int32_t status=0; uint64_t used=0;\n" + declaration + parse + "if(remaining) return 2;\n" + allocate
        // C labels have function scope; each operation uses its own label.
        let result_cleanup = ""
        let release = self.string(node, "release", false)
        if !release.empty? result_cleanup = "if(result) " + release + "(result);\n"
        code = code + branch {
            returns == "void" -> call + ";\n" _ -> "result=" + call + ";\n"
        }
        let all_values = []
        let all_lengths = []
        if returns != "void" {
            all_values.push("result")
            let length = ""
            branch {
                returns == "c_string" -> {
                    let maximum = self.bound(node, "max_length", 16777216).as_string()
                    code = code + "if(!result) { status=4; goto cleanup; } uint64_t result_size=0; while(result_size<" + maximum + " && result[result_size]) result_size++; if(result_size==" + maximum + ") { status=5; goto cleanup; }\n"
                    length = "result_size"
                }
                returns == "bytes" -> {
                    code = code + "if(result_size<0 || (uint64_t)result_size>16777216 || (!result && result_size)) { status=4; goto cleanup; }\n"
                    length = "(uint64_t)result_size"
                }
            }
            all_lengths.push(move length)
        }
        for value in values {
            all_values.push(value.copy())
        }
        for length in lengths {
            all_lengths.push(length.copy())
        }
        let outputs = self.outputs(node)
        index = 0
        for ty in outputs {
            let length = branch {
                ty.starts_with?("~") -> "(8+" + all_lengths[index] + "*" + (self.slots(self.ty(self.member(decimal(ty.slice(1, ty.length)), "buffer")), []) * 8).as_string() + ")" all_lengths[index].empty? -> (self.slots(ty, []) * 8).as_string() _ -> all_lengths[index].copy()
            }
            code = code + "if(capacity-used<8 || " + length + ">capacity-used-8) { status=5; goto cleanup; } write64(out+used," + length + "); used+=8;\n"
            code = code + branch {
                ty.starts_with?("~") -> {
                    let element = self.ty(self.member(decimal(ty.slice(1, ty.length)), "buffer"))
                    "write64(out+used," + all_lengths[index] + "); { uint8_t *saved=out; out+=used+8; for(uint64_t buffer_index=0; buffer_index<" + all_lengths[index] + "; buffer_index++) {\n" + self.c_write(element, all_values[index] + "[buffer_index]", 0) + "out+=" + (self.slots(element, []) * 8).as_string() + "; } out=saved; }\n"
                }
                ty == "bytes" || ty == "c_string" -> "if(" + length + ") memcpy(out+used," + all_values[index] + ",(size_t)" + length + ");\n"
                _ -> "{ uint8_t *saved=out; out+=used;\n" + self.c_write(ty, all_values[index], 0) + "out=saved; }\n"
            }
            code = code + "used+=" + length + ";\n"
            index = index + 1
        }
        code = code + "*length=used;\ncleanup:\n" + result_cleanup + cleanup + "return status;\n}\n"
        code.copy().split("goto cleanup;").join("goto cleanup_" + operation.as_string() + ";").split("cleanup:\n").join("cleanup_" + operation.as_string() + ":\n")
    }
    func c_read(self, ty: String, place: String) -> String {
        branch {
            ty.starts_with?("[") -> {
                let output = ""
                for index in 0.range(array_length(ty)) {
                    output = output + self.c_read(array_element(ty), place + "[" + index.as_string() + "]")
                }
                move output
            }
            ty.starts_with?("@") -> {
                let output = ""
                for field in self.array(self.record(ty), "fields", true) {
                    output = output + self.c_read(self.ty(self.member(field, "type")), place + "." + self.string(field, "name", true))
                }
                move output
            }
            _ -> {
                let output = "{ uint64_t w; if(!read64(&input,&remaining,&w)) return 2;\n"
                branch {
                    ty.starts_with?("$") -> {
                        let c_type = self.c_type(ty)
                        output = output + "int64_t s; memcpy(&s,&w,8); " + c_type + " v=(" + c_type + ")w;\n"
                        output = output + "if ((" + c_type + ")-1 < (" + c_type + ")0) { if ((int64_t)v != s) return 3; } else { if ((uint64_t)v != w) return 3; }\n" + place + "=v;\n"
                    }
                    ty == "char" -> {
                        output = output + "if(w > 255) return 3; { unsigned char b=(unsigned char)w; memcpy(&" + place + ",&b,1); }\n"
                    }
                    ty == "long" -> {
                        output = output + "int64_t s; memcpy(&s,&w,8); if(s < LONG_MIN || s > LONG_MAX) return 3; " + place + "=(long)s;\n"
                    }
                    ty == "ulong" -> {
                        output = output + "if(w > ULONG_MAX) return 3; " + place + "=(unsigned long)w;\n"
                    }
                    ty == "f32" || ty == "f64" -> {
                        output = output + "double d; memcpy(&d,&w,8);\n"
                        if ty == "f32" {
                            output = output + "if(isfinite(d) && (d > FLT_MAX || d < -FLT_MAX)) return 3;\n"
                        }
                        output = output + place + "=(" + self.c_type(ty) + ")d;\n"
                    }
                    ty.starts_with?("i") -> {
                        output = output + "int64_t s; memcpy(&s,&w,8);\n"
                        if ty != "i64" {
                            let width = ty.slice(1, ty.length)
                            output = output + "if(s < INT" + width + "_MIN || s > INT" + width + "_MAX) return 3;\n"
                        }
                        output = output + place + "=(" + self.c_type(ty) + ")s;\n"
                    }
                    _ -> {
                        let maximum = branch {
                            ty == "bool" -> "1"
                            _ -> "UINT" + ty.slice(1, ty.length) + "_MAX"
                        }
                        output = output + ["if(w > ", maximum.copy(), ") return 3; ", place.copy(), "=(", self.c_type(ty), ")w;\n"].join("")
                    }
                }
                output + "}\n"
            }
        }
    }
    func c_write(self, ty: String, place: String, index: Int) -> String {
        branch {
            ty.starts_with?("[") -> {
                let output = ""
                let element = array_element(ty)
                let width = self.slots(element, [])
                for item in 0.range(array_length(ty)) {
                    output = output + self.c_write(element, place + "[" + item.as_string() + "]", index + item * width)
                }
                move output
            }
            ty.starts_with?("@") -> {
                let output = ""
                let offset = index
                for field in self.array(self.record(ty), "fields", true) {
                    let field_type = self.ty(self.member(field, "type"))
                    output = output + self.c_write(field_type, place + "." + self.string(field, "name", true), offset)
                    offset = offset + self.slots(field_type, [])
                }
                move output
            }
            _ -> {
                let offset = (index * 8).as_string()
                branch {
                    ty == "char" -> "write64(out+" + offset + ",(unsigned char)" + place + ");\n"
                    ty == "f32" || ty == "f64" -> "{ double d=" + place + "; uint64_t w; memcpy(&w,&d,8); write64(out+" + offset + ",w); }\n"
                    _ -> "write64(out+" + offset + ",(uint64_t)" + place + ");\n"
                }
            }
        }
    }
    func c_operation(self, node: Int, index: Int) -> String {
        return self.c_extended(node, index) if self.extended(node)
        let output = "case " + index.as_string() + ": {\n"
        let types = []
        let arguments = []
        let receiver = self.string(node, "receiver", false)
        let creates = self.string(node, "creates", false)
        let result_type = self.ty(self.member(node, "result"))
        if !receiver.empty? {
            let c_type = self.string(self.resource(receiver), "c_type", true)
            let by_value = self.boolean(self.resource(receiver), "by_value") && !self.boolean(node, "receiver_pointer")
            types.push(c_type + branch {
                by_value -> "" _ -> "*"
            })
            arguments.push(branch {
                by_value -> "*(" + c_type + "*)resource" _ -> "(" + c_type + "*)resource"
            })
        }
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            branch {
                ty == "bytes" -> {
                    types.push("const uint8_t*")
                    types.push("size_t")
                }
                _ -> types.push(self.c_type(ty))
            }
        }
        if result_type == "bytes" {
            types.push("size_t*")
        }
        if types.length == 0 {
            types.push("void")
        }
        let return_type = branch {
            !creates.empty? -> self.string(self.resource(creates), "c_type", true) + branch {
                self.boolean(self.resource(creates), "by_value") -> "" _ -> "*"
            }
            _ -> self.c_type(result_type)
        }
        output = output + [return_type.copy(), " (*target)(", types.join(","), ") = &", self.string(node, "symbol", true), ";\n"].join("")
        let number = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            let suffix = number.as_string()
            let place = "a" + suffix
            let size = "w" + suffix
            branch {
                ty == "bytes" || ty == "c_string" -> {
                    output = output + "uint64_t " + size + "; if(!read64(&input,&remaining,&" + size + ")) return 2;\n"
                    output = output + branch {
                        ty == "c_string" -> ["if(", size.copy(), " > remaining || !c_string_valid(input,", size.copy(), ")) return 2; const char *", place.copy(), "=(const char*)input;\n"].join("")
                        _ -> ["if(", size.copy(), " > remaining || ", size.copy(), " > SIZE_MAX) return 2; const uint8_t *", place.copy(), "=input;\n"].join("")
                    }
                    output = output + "input += " + size + "; remaining -= " + size + ";\n"
                }
                _ -> {
                    output = output + self.c_type(ty) + " " + place + " = {0};\n" + self.c_read(ty, place)
                }
            }
            arguments.push(place.copy())
            if ty == "bytes" {
                arguments.push("(size_t)" + size)
            }
            number = number + 1
        }
        output = output + "if(remaining != 0) return 2;\n"
        if result_type == "bytes" {
            output = output + "size_t size=0;\n"
            arguments.push("&size")
        }
        let call = "target(" + arguments.join(",") + ")"
        output = output + branch {
            !creates.empty? -> self.c_create(creates, call)
            result_type.starts_with?("@") -> {
                let size = (self.slots(result_type, []) * 8).as_string()
                ["if(capacity < ", size.copy(), ") return 5; ", return_type.copy(), " result=", call.copy(), ";\n", self.c_write(result_type, "result", 0), "*length=", size.copy(), "; return 0;\n"].join("")
            }
            result_type == "void" -> call + "; return 0;\n"
            result_type == "bytes" -> {
                let release = self.string(node, "release", false)
                ["uint8_t *result=", call.copy(), "; if(!result && size) return 4; if(size > capacity) { if(result) ", release.copy(), "(result); return 5; } if(size) memcpy(out,result,size); if(result) ", release.copy(), "(result); *length=size; return 0;\n"].join("")
            }
            result_type == "f32" || result_type == "f64" -> "double result=" + call + "; uint64_t bits; memcpy(&bits,&result,8); write64(out,bits); *length=8; return 0;\n"
            result_type == "char" -> "char result=" + call + "; write64(out,(unsigned char)result); *length=8; return 0;\n"
            _ -> return_type + " result=" + call + "; write64(out,(uint64_t)result); *length=8; return 0;\n"
        }
        output + "}\n"
    }
    func c_callback(self, node: Int) -> String {
        let name = self.string(node, "name", true)
        let callback_result = self.ty(self.member(node, "result"))
        let types = []
        let parameters = []
        let encode = ""
        let width = 0
        let index = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            let place = "p" + index.as_string()
            types.push(self.c_type(ty))
            parameters.push(self.c_type(ty) + " " + place)
            encode = encode + self.c_write(ty, place, width)
            width = width + self.slots(ty, [])
            index = index + 1
        }
        types.push("void*")
        parameters.push("void *context")
        let size = branch {
            callback_result == "void" -> 0 _ -> self.slots(callback_result, []) * 8
        }
        let fallback = branch {
            callback_result == "void" -> "return;" _ -> "return zero;"
        }
        let output = "typedef " + self.c_type(callback_result) + " (*foster_cb_" + name + "_fn)(" + types.join(",") + ");\nstatic " + self.c_type(callback_result) + " foster_cb_" + name + "(" + parameters.join(",") + ") {\n"
        if callback_result != "void" {
            output = output + self.c_type(callback_result) + " zero={0};\n"
        }
        output = output + "uint8_t packet[" + (width * 8 + 1).as_string() + "], reply[" + (size + 1).as_string() + "]; uint8_t *out=packet; uint64_t written=0;\n" + encode + "if(!foster_dispatch || foster_dispatch((int64_t)(uintptr_t)context,UINT64_C(0x" + identity(self.json(node)) + "),packet," + (width * 8).as_string() + ",reply," + size.as_string() + ",&written) || written!=" + size.as_string() + ") { " + fallback + " }\n"
        if callback_result != "void" {
            let invalid = "{ foster_dispatch((int64_t)(uintptr_t)context,UINT64_C(0x" + identity(self.json(node)) + "),NULL,UINT64_MAX-1,NULL,0,NULL); " + fallback + " }"
            output = output + "const uint8_t *input=reply; uint64_t remaining=written; " + self.c_type(callback_result) + " result={0};\n" + self.c_read(callback_result, "result").split("return 2;").join(invalid).split("return 3;").join(invalid) + "return result;\n"
        }
        output = output + "}\n"
        let native = self.string(node, "c_type", false)
        if !native.empty? {
            output = output + "_Static_assert(_Generic((" + native + ")0, foster_cb_" + name + "_fn: 1, default: 0), \"C callback typedef mismatch\");\n"
        }
        move output
    }
    func c_source(self, schema: String) -> String {
        let output = PREAMBLE.copy()
        for node in self.array(0, "headers", true) {
            output = output + "#include \"" + self.nodes[node].text + "\"\n"
        }
        output = output + "EXPORT uint64_t foster_c_schema(void) { return UINT64_C(0x" + schema + "); }\n"
        output = output + "#include <stdatomic.h>\ntypedef int32_t (*foster_resource_fn)(uint64_t,int64_t,uint32_t,uint32_t,void**);\nstatic _Atomic(foster_resource_fn) foster_resolve;\nEXPORT int32_t foster_c_resources_init(uint64_t version,foster_resource_fn fn) { if(version!=1) return 1; atomic_store(&foster_resolve,fn); return 0; }\nEXPORT void foster_c_forget(uint32_t kind,void *p) { switch(kind) {\n"
        let forget_kind = 1
        for resource in self.resources() {
            output = output + "case " + forget_kind.as_string() + ": " + branch {
                self.boolean(resource, "by_value") -> "free(p);" _ -> "(void)p;"
            } + " return;\n"
            forget_kind = forget_kind + 1
        }
        output = output + "default: abort(); } }\n"
        if !self.callbacks().empty? {
            output = output + "#include <stdatomic.h>\ntypedef int32_t (*foster_dispatch_fn)(int64_t,uint64_t,const uint8_t*,uint64_t,uint8_t*,uint64_t,uint64_t*);\nstatic _Atomic(foster_dispatch_fn) foster_dispatch;\nEXPORT int32_t foster_c_callbacks_init(uint64_t version,foster_dispatch_fn fn) { if(version!=1) return 1; atomic_store(&foster_dispatch,fn); return 0; }\n"
            for callback in self.callbacks() {
                output = output + self.c_callback(callback)
            }
        }
        for node in self.enums() {
            let ty = self.string(node, "c_type", true)
            output = output + "_Static_assert(_Generic((" + ty + ")0, char: 1, signed char: 1, unsigned char: 1, short: 1, unsigned short: 1, int: 1, unsigned int: 1, long: 1, unsigned long: 1, long long: 1, unsigned long long: 1, default: 0) && sizeof(" + ty + ") <= 8, \"unsupported C enum representation\");\n"
        }
        for node in self.records() {
            let c_type = self.string(node, "c_type", true)
            for field in self.array(node, "fields", true) {
                let name = self.string(field, "name", true)
                let ty = self.ty(self.member(field, "type"))
                let element = ty.copy()
                let dimensions = ""
                while element.starts_with?("[") {
                    dimensions = dimensions + "[" + array_length(element).as_string() + "]"
                    element = array_element(element)
                }
                let pointer = self.c_type(element) + branch {
                    dimensions.empty? -> " *" _ -> " (*)" + dimensions
                }
                output = output + "_Static_assert(_Generic(&((" + c_type + "*)0)->" + name + ", " + pointer + ": 1, default: 0), \"C field type mismatch: " + self.string(node, "name", true) + "." + name + "\");\n"
            }
        }
        output = output + "EXPORT uint64_t foster_c_describe(uint32_t op) { switch(op) {\n"
        let index = 0
        for node in self.operations() {
            let receiver = self.string(node, "receiver", false)
            let creates = self.string(node, "creates", false)
            let result_type = self.ty(self.member(node, "result"))
            let mode = branch {
                !creates.empty? -> 2
                !receiver.empty? -> 3
                _ -> 1
            }
            let kind = branch {
                !creates.empty? -> self.kind(creates)
                !receiver.empty? -> self.kind(receiver)
                _ -> 0
            }
            let size = branch {
                result_type.starts_with?("@") -> self.slots(result_type, []) * 8
                _ -> 0
            }
            let variable_output = result_type == "bytes"
            if self.extended(node) {
                size = 0
                for value_type in self.outputs(node) {
                    branch {
                        value_type == "bytes" || value_type == "c_string" || value_type.starts_with?("~") -> {
                            variable_output = true
                        }
                        _ -> {
                            size = size + 8 + self.slots(value_type, []) * 8
                        }
                    }
                }
                if size > 65535 variable_output = true
            }
            if variable_output {
                mode = mode + 256
                size = 0
            }
            output = output + ["case ", index.as_string(), ": return ((uint64_t)", kind.as_string(), " << 32) | ((uint64_t)", size.as_string(), " << 16) | ", mode.as_string(), ";\n"].join("")
            index = index + 1
        }
        output = output + "default: return 0; } }\nEXPORT void foster_c_destroy(uint32_t kind, void *p) { switch(kind) {\n"
        index = 1
        for node in self.resources() {
            let c_type = self.string(node, "c_type", true)
            output = output + "case " + index.as_string() + ": { " + self.c_destroy(node, "p") + " return; }\n"
            index = index + 1
        }
        output = output + "default: abort(); } }\nEXPORT int64_t foster_c_close(uint32_t kind, void *p, uint8_t *consumed) { switch(kind) {\n"
        index = 1
        for node in self.resources() {
            let c_type = self.string(node, "c_type", true)
            let close = self.string(node, "close", false)
            let consumed = branch {
                self.boolean(node, "close_consumes_on_error") -> "1"
                _ -> "0"
            }
            output = output + "case " + index.as_string() + ": { " + branch {
                !close.empty? -> "int (*close)(" + c_type + "*) = &" + close + "; int64_t status = close((" + c_type + "*)p); *consumed = (status == 0 || " + consumed + "); return status; }\n"
                _ -> self.c_destroy(node, "p") + " *consumed=1; return 0; }\n"
            }
            index = index + 1
        }
        output = output + "default: *consumed=0; return -1; } }\nEXPORT int32_t foster_c_call(uint32_t op, void *resource, const uint8_t *input, uint64_t remaining, uint8_t *out, uint64_t capacity, uint64_t *length, void **created) {\n*length=0; *created=NULL; if(capacity < 8) return 1; switch(op) {\n"
        index = 0
        for node in self.operations() {
            output = output + self.c_operation(node, index)
            index = index + 1
        }
        output + "default: return 6; } }\n"
    }
}

/// Validates JSON and returns schema, C, and Foster text in order.
/// The module path names the bridge for the runtime loader; it is excluded
/// from contract identity, so relocating the DLL never changes the schema.
pub func generate_bridge(input: String, module_path: String) -> List<String> {
    let tree = json_rows(input)
    let manifest = contract(tree)
    manifest.validate()
    let schema = identity(tree)
    [schema.copy(), manifest.c_source(schema), manifest.foster_source(module_path, schema)]
}

test "schema hash uses exact unsigned FNV-1a arithmetic" {
    assert(identity("") == "cbf29ce484222325")
    assert(identity("hello") == "a430d84680aabd0b")
}

test "indexed JSON preserves array order and matches canonical manifest lookup" {
    let input = "{\"z\":[{\"name\":\"λ\\n\"},false,null,42],\"a\":\"first\"}"
    let tree = decode_json(input)
    let canonical = contract(json_rows(input))
    let items = tree.array(0, "z", true)
    let ordered = canonical.array(0, "z", true)
    assert(items.length == 4 && ordered.length == 4)
    assert(tree.string(items[0], "name", true) == canonical.string(ordered[0], "name", true))
    assert(tree.nodes[items[1]].kind == "bool" && tree.nodes[items[1]].text == "false")
    assert(tree.nodes[items[2]].kind == "null" && tree.nodes[items[3]].text == "42")
    assert(tree.string(0, "a", true) == "first")
}

impl Contract {
    func foster_callback(self, node: Int) -> String {
        let name = foster_type_name(self.string(node, "name", true))
        let method = foster_function_name(self.string(node, "method", true))
        let parameters = ["self"]
        let arguments = []
        let statements = []
        let width = 0
        let index = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            parameters.push("p" + index.as_string() + ": " + foster_type(ty))
            arguments.push(self.foster_result(ty, width, statements))
            width = width + self.slots(ty, [])
            index = index + 1
        }
        let callback_result = self.ty(self.member(node, "result"))
        let output = "/// Handler for copied C callback values.\npub type " + name + "Handler = {\n    /// Handles one event on the registering Foster thread.\n    pub func " + method + "(" + parameters.join(", ") + ") -> " + foster_type(callback_result) + " [reshape self]\n}\nfunc callback_" + name + "<H & " + name + "Handler>(handler: H, payload: String) -> Result<String, CError> [reshape handler, read payload] {\n    let value = try CValue.callback_packet(payload)\n    try value.check_slots(" + width.as_string() + ")\n" + statements.join("")
        output = output + "    let returned = handler." + method + "(" + arguments.join(", ") + ")\n    let arguments = CArguments.empty()\n"
        if callback_result != "void" output = output + self.foster_argument(callback_result, "returned")
        output + "    Result.Ok(arguments.reply())\n}\n\n"
    }
    func foster_extended(self, node: Int, id: Int) -> String {
        let name = self.string(node, "name", true)
        let outputs = self.outputs(node)
        let output_names = self.output_names(node)
        let creates = self.string(node, "creates", false)
        let receiver = self.string(node, "receiver", false)
        let result_type = branch {
            !creates.empty? -> "Native" + creates
            outputs.empty? -> "()"
            outputs.length == 1 -> self.value_type(outputs[0])
            _ -> "Result_" + name
        }
        let output = ""
        if outputs.length > 1 {
            output = output + "/// Copied return value and output parameters of `" + name + "`.\npub type " + result_type + " = {\n"
            let index = 0
            for ty in outputs {
                output = output + "    pub " + output_names[index] + ": " + self.value_type(ty) + "\n"
                index = index + 1
            }
            output = output + "}\n\n"
        }
        let parameters = []
        if !receiver.empty? {
            parameters.push("resource: Native" + receiver)
        }
        let arguments = "    let arguments = CArguments.empty()\n"
        let before = ""
        let adapter = ""
        let generic = ""
        let effects = ""
        let resource_effects = []
        let resource_checks = ""
        let callback_call = ""
        let parameter_names = self.array(node, "parameter_names", false)
        let places = []
        let used_places = ["arguments", "value", "bridge", "resource", "packet", "before", "adapter", "payload", "ffi", "bytes", "string", "result", "list"]
        for slot in 0.range(outputs.length) {
            used_places.push("component" + slot.as_string())
        }
        let parameter_index = 0
        for parameter in self.array(node, "parameters", false) {
            let preferred = "p" + parameter_index.as_string()
            if !parameter_names.empty? && !self.nodes[parameter_names[parameter_index]].text.empty? {
                preferred = foster_name(self.nodes[parameter_names[parameter_index]].text)
            }
            while used_places.contains?(preferred) {
                preferred = preferred + "_"
            }
            used_places.push(preferred.copy())
            places.push(move preferred)
            parameter_index = parameter_index + 1
        }
        let index = 0
        for parameter in self.array(node, "parameters", false) {
            let ty = self.ty(parameter)
            let place = places[index].copy()
            branch {
                ty.starts_with?("%") -> {
                    parameters.push(place + ": Native" + ty.slice(1, ty.length))
                    arguments = arguments + "    try " + place + ".value.argument(arguments)\n"
                    resource_checks = resource_checks + "    try " + place + ".value.check_callbacks()\n"
                    resource_effects.push(branch {
                        self.boolean(parameter, "consume") -> "consume " + place
                        _ -> "read " + place + ".value.token, mut " + place + ".value.callback"
                    })
                }
                ty.starts_with?("^") -> {
                    let callback = self.callback(ty)
                    let callback_name = foster_type_name(self.string(callback, "name", true))
                    let retained = self.boolean(parameter, "retained")
                    parameters.push(place + ": H")
                    generic = "<H & " + callback_name + "Handler>"
                    effects = " [" + branch {
                        retained -> "consume " _ -> "reshape "
                    } + place
                    let other = 0
                    for item in self.array(node, "parameters", false) {
                        if other != index && !self.ty(item).starts_with?("&") && !self.ty(item).starts_with?("%") {
                            effects = effects + ", read " + places[other]
                        }
                        other = other + 1
                    }
                    effects = effects + "]"
                    before = arguments.copy().split("let arguments =").join("let before =").split("    arguments.").join("    before.").split(".argument(arguments)").join(".argument(before)")
                    arguments = "    let arguments = CArguments.empty()\n"
                    adapter = "    let adapter = [" + branch {
                        retained -> "move " _ -> "ref "
                    } + place + "] (payload: String) -> {\n        branch callback_" + callback_name + "(" + place + ", payload) {\n            Result.Ok(reply) -> move reply\n            Result.Error(error) -> error.callback_reply()\n        }\n    }\n"
                    callback_call = "bridge()." + branch {
                        retained -> "subscribe" _ -> "call_with"
                    } + "(" + id.as_string() + ", before, arguments, move adapter, " + quoted(identity(self.json(callback))) + branch {
                        retained -> ", " + branch {
                            self.string(callback, "delivery", true) == "queued" -> "true" _ -> "false"
                        }
                        _ -> ""
                    } + ")"
                }
                ty.starts_with?("&") -> ()
                ty.starts_with?("~") -> {
                    let output_only = self.boolean(parameter, "output")
                    let raw = self.raw_buffer(parameter)
                    parameters.push(place + ": " + branch {
                        output_only -> "Int" raw -> "Bytes" _ -> self.value_type(ty)
                    })
                    branch {
                        output_only || raw -> {
                            arguments = arguments + "    arguments." + branch {
                                output_only -> "integer" _ -> "bytes"
                            } + "(" + place + ")\n"
                        }
                        _ -> {
                            arguments = arguments + "    arguments.integer(" + place + ".length)\n    for element in " + place + " {\n" + self.foster_argument(self.ty(self.member(parameter, "buffer")), "element") + "    }\n"
                        }
                    }
                }
                _ -> {
                    let base = ty.strip_prefix("!")
                    parameters.push(place + ": " + foster_type(base))
                    arguments = arguments + self.foster_argument(base, place)
                }
            }
            index = index + 1
        }
        if !resource_effects.empty? {
            effects = branch {
                effects.empty? -> " [" _ -> effects.slice(0, effects.length - 1) + ", "
            } + resource_effects.join(", ") + "]"
        }
        output = output + self.docs(node, "") + "/// Calls `" + self.string(node, "symbol", true) + "`; pointers are call-scoped copies. Output field numbers match manifest parameter indexes.\npub func " + foster_function_name(name) + generic + "(" + parameters.join(", ") + ") -> Result<" + result_type + ", CError>" + effects + " {\n" + before + arguments + adapter
        return output + "    let resource = try " + branch {
            callback_call.empty? -> "bridge().create(" + id.as_string() + ", arguments)" _ -> callback_call.copy()
        } + "\n" + resource_checks + "    Result.Ok(Native" + creates + " { value: move resource })\n}\n\n" if !creates.empty?
        let owner = branch {
            receiver.empty? -> "bridge()" _ -> "resource.value"
        }
        output = output + "    let packet = try " + branch {
            callback_call.empty? -> owner + ".call(" + id.as_string() + ", arguments)" _ -> callback_call.copy()
        } + "\n" + resource_checks
        let values = []
        index = 0
        for ty in outputs {
            let local = "component" + index.as_string()
            output = output + "    let " + local + " = :decode {\n    let value = try packet.part(" + index.as_string() + ")\n"
            branch {
                ty.starts_with?("~") -> {
                    let element = self.ty(self.member(decimal(ty.slice(1, ty.length)), "buffer"))
                    let width = self.slots(element, [])
                    output = output + "    let count = try (try value.slot(0)).integer()\n    return Result.Error(CError { message: \"invalid typed buffer length\", status: 0 }) if count < 0 || count > " + (16777208 / (width * 8)).as_string() + "\n    return Result.Error(CError { message: \"typed buffer size mismatch\", status: 0 }) if value.bytes().length != 8 + count * " + (width * 8).as_string() + "\n    let items = []\n    let item = 0\n    while item < count {\n"
                    let statements = []
                    let expression = self.foster_result(element, 1, statements)
                    let decoded = statements.join("")
                    for slot in 0.range(width) {
                        decoded = decoded.split(".slot(" + (slot + 1).as_string() + ")").join(".slot(1 + item * " + width.as_string() + " + " + slot.as_string() + ")")
                    }
                    output = output + decoded + "    items.push(" + expression + ")\n    item = item + 1\n    }\n    move items\n"
                }
                ty == "bytes" -> {
                    output = output + "    value.bytes()\n"
                }
                ty == "c_string" -> {
                    output = output + "    try value.text()\n"
                }
                _ -> {
                    let statements = []
                    let expression = self.foster_result(ty, 0, statements)
                    output = output + "    try value.check_slots(" + self.slots(ty, []).as_string() + ")\n" + statements.join("") + "    " + expression + "\n"
                }
            }
            output = output + "    }\n"
            let owned = ty == "bytes" || ty == "c_string" || ty.starts_with?("@") || ty.starts_with?("~")
            values.push(branch {
                outputs.length > 1 -> output_names[index] + ": " _ -> ""
            } + branch {
                owned -> "move " _ -> ""
            } + local)
            index = index + 1
        }
        output + "    Result.Ok(" + branch {
            outputs.empty? -> "()" outputs.length == 1 -> values[0].copy() _ -> result_type + " { " + values.join(", ") + " }"
        } + ")\n}\n\n"
    }
    func foster_argument(self, ty: String, place: String) -> String {
        branch {
            ty.starts_with?("[") -> {
                let output = "    return Result.Error(CError { message: " + quoted("C array length mismatch: " + place) + ", status: 0 }) if " + place + ".length != " + array_length(ty).as_string() + "\n"
                for index in 0.range(array_length(ty)) {
                    output = output + self.foster_argument(array_element(ty), place + "[" + index.as_string() + "]")
                }
                move output
            }
            ty.starts_with?("@") -> {
                let output = ""
                for field in self.array(self.record(ty), "fields", true) {
                    output = output + self.foster_argument(self.ty(self.member(field, "type")), place + "." + foster_name(self.string(field, "name", true)))
                }
                move output
            }
            ty == "bool" -> "    arguments.integer(branch { " + place + " -> 1\n        _ -> 0 })\n"
            _ -> {
                let method = branch ty {
                    "f32" -> "floating"
                    "f64" -> "floating"
                    "bytes" -> "bytes"
                    "c_string" -> "c_string"
                    _ -> "integer"
                }
                "    arguments." + method + "(" + place + ")\n"
            }
        }
    }
    func foster_result(self, ty: String, index: Int, statements: List<String>) -> String {
        branch {
            ty.starts_with?("[") -> {
                let values = []
                let element = array_element(ty)
                let width = self.slots(element, [])
                for item in 0.range(array_length(ty)) {
                    values.push(self.foster_result(element, index + item * width, statements))
                }
                "[" + values.join(", ") + "]"
            }
            ty.starts_with?("@") -> {
                let fields = []
                let offset = index
                for field in self.array(self.record(ty), "fields", true) {
                    let field_type = self.ty(self.member(field, "type"))
                    fields.push(foster_name(self.string(field, "name", true)) + ": " + self.foster_result(field_type, offset, statements))
                    offset = offset + self.slots(field_type, [])
                }
                foster_type(ty) + " { " + fields.join(", ") + " }"
            }
            _ -> {
                let method = branch {
                    ty == "f32" || ty == "f64" -> "floating"
                    _ -> "integer"
                }
                let expression = "(try (try value.slot(" + index.as_string() + "))." + method + "())"
                let name = "slot" + index.as_string()
                statements.push("    let " + name + " = " + expression + "\n")
                branch {
                    ty == "bool" -> "(" + name + " != 0)"
                    _ -> name.copy()
                }
            }
        }
    }
    func foster_source(self, path: String, schema: String) -> String {
        let type_names = ["Int", "Float", "Bool", "String", "Bytes", "List", "Result", "CError", "CValue", "CArguments", "CBridge", "CResource"]
        for declarations in [self.enums(), self.records()] {
            for node in declarations {
                let name = foster_type_name(self.string(node, "name", true))
                assert(!type_names.contains?(name), "duplicate generated Foster type " + name)
                type_names.push(move name)
            }
        }
        let function_names = ["bridge"]
        for node in self.operations() {
            let name = foster_function_name(self.string(node, "name", true))
            assert(!function_names.contains?(name), "duplicate generated Foster function " + name)
            function_names.push(move name)
        }
        for node in self.array(0, "constants", false) {
            let ty = self.constant_type(node)
            let factory = ty.starts_with?("@") || self.constant_value(ty, self.member(node, "value")) == "(-9223372036854775807 - 1)"
            let name = branch {
                factory -> foster_function_name(self.string(node, "name", true))
                _ -> foster_name(self.string(node, "name", true))
            }
            assert(!function_names.contains?(name), "duplicate generated Foster value " + name)
            function_names.push(move name)
        }
        let output = "//! Generated C bindings. Rebuild with the native bridge.\nimport std.ffi.*\nimport core.bytes.Bytes\nimport core.string.String\nimport core.result.Result\nimport core.list.List\n\nfunc bridge() -> CBridge { CBridge.at(" + quoted(path) + ", " + quoted(schema) + ") }\n\n"
        let shared_imports = ""
        for node in self.records() {
            let shared_module = self.string(node, "foster_module", false)
            if !shared_module.empty? {
                shared_imports = shared_imports + "\nimport " + shared_module + "." + foster_type_name(self.string(node, "name", true))
            }
        }
        output = output.split("\n\nfunc bridge").join(shared_imports + "\n\nfunc bridge")
        for callback in self.callbacks() {
            output = output + self.foster_callback(callback)
        }
        for node in self.enums() {
            output = output + self.docs(node, "") + "/// Integer value of C `" + self.string(node, "c_type", true) + "`.\npub type " + foster_type_name(self.string(node, "name", true)) + " = Int\n\n"
        }
        for node in self.records() {
            let name = foster_type_name(self.string(node, "name", true))
            let foster_module = self.string(node, "foster_module", false)
            if !foster_module.empty? {
                continue
            }
            output = output + self.docs(node, "")
            for field in self.array(node, "fields", true) {
                let doc = self.member(field, "documentation")
                if doc >= 0 {
                    output = output + doc_lines(self.string(field, "name", true) + ": " + self.nodes[doc].text, "")
                }
            }
            output = output + "/// Copied fields of C `" + self.string(node, "c_type", true) + "`; no native padding or pointers.\npub type " + name + " = {\n"
            for field in self.array(node, "fields", true) {
                output = output + "    pub " + foster_name(self.string(field, "name", true)) + ": " + foster_type(self.ty(self.member(field, "type"))) + "\n"
            }
            output = output + "}\nimpl " + name + " {\n    /// Copies every value field.\n    pub func copy(self) -> self {\n        " + name + " {\n"
            for field in self.array(node, "fields", true) {
                let field_name = foster_name(self.string(field, "name", true))
                output = output + "            " + field_name + ": " + foster_copy(self.ty(self.member(field, "type")), "self." + field_name, 0) + "\n"
            }
            output = output + "        }\n    }\n}\n\n"
        }
        for node in self.array(0, "constants", false) {
            let name = foster_name(self.string(node, "name", true))
            let ty = self.constant_type(node)
            let value = self.constant_value(ty, self.member(node, "value"))
            output = output + self.docs(node, "") + "/// C constant `" + self.string(node, "name", true) + "`.\n"
            output = output + branch {
                ty.starts_with?("@") -> "pub func " + foster_function_name(self.string(node, "name", true)) + "() -> " + foster_type(ty) + " { " + value + " }\n\n"
                value == "(-9223372036854775807 - 1)" -> "pub func " + foster_function_name(self.string(node, "name", true)) + "() -> Int { " + value + " }\n\n"
                _ -> "pub const " + name + " = " + value + "\n\n"
            }
        }
        for node in self.resources() {
            let name = self.string(node, "name", true)
            output = output + ["/// Owns a native ", name.copy(), " allocation.\npub type Native", name.copy(), " = { value: CResource }\nimpl Native", name.copy(), " {\n    /// Attempts close, retaining ownership when the C close contract requires it.\n    pub func close(self) -> Result<(), CError> { self.value.close() }\n    /// Delivers queued callback notifications on this thread.\n    pub func poll_callbacks(self) -> Result<(), CError> { self.value.poll_callbacks() }\n    /// Retrieves a callback failure without delivering queued events.\n    pub func check_callbacks(self) -> Result<(), CError> { self.value.check_callbacks() }\n}\n\n"].join("")
        }
        let id = 0
        for node in self.operations() {
            if self.extended(node) {
                output = output + self.foster_extended(node, id)
                id = id + 1
                continue
            }
            let parameters = []
            let receiver = self.string(node, "receiver", false)
            let creates = self.string(node, "creates", false)
            let result_type = self.ty(self.member(node, "result"))
            if !receiver.empty? {
                parameters.push("resource: Native" + receiver)
            }
            let index = 0
            let argument_source = ""
            let parameter_names = self.array(node, "parameter_names", false)
            let used_names = ["arguments", "value", "bridge", "resource", "ffi", "bytes", "string", "result", "list"]
            if result_type.starts_with?("@") {
                for slot in 0.range(self.slots(result_type, [])) {
                    used_names.push("slot" + slot.as_string())
                }
            }
            for parameter in self.array(node, "parameters", false) {
                let ty = self.ty(parameter)
                let place = "p" + index.as_string()
                if !parameter_names.empty? && !self.nodes[parameter_names[index]].text.empty? {
                    place = foster_name(self.nodes[parameter_names[index]].text)
                }
                while used_names.contains?(place) {
                    place = place + "_"
                }
                used_names.push(place.copy())
                parameters.push(place + ": " + foster_type(ty))
                argument_source = argument_source + self.foster_argument(ty, place)
                index = index + 1
            }
            let result_name = branch {
                !creates.empty? -> "Native" + creates
                _ -> foster_type(result_type)
            }
            output = output + self.docs(node, "") + ["/// Calls the C symbol `", self.string(node, "symbol", true), "`.\npub func ", foster_function_name(self.string(node, "name", true)), "(", parameters.join(", "), ") -> Result<", result_name.copy(), ", CError> {\n    let arguments = CArguments.empty()\n", argument_source.copy()].join("")
            branch {
                !creates.empty? -> {
                    output = output + "    let value = try bridge().create(" + id.as_string() + ", arguments)\n    Result.Ok(Native" + creates + " { value: move value })\n"
                }
                _ -> {
                    let owner = branch {
                        !receiver.empty? -> "resource.value"
                        _ -> "bridge()"
                    }
                    output = output + "    let value = try " + owner + ".call(" + id.as_string() + ", arguments)\n"
                    output = output + branch {
                        result_type.starts_with?("@") -> {
                            let statements = []
                            let expression = self.foster_result(result_type, 0, statements)
                            "    try value.check_slots(" + self.slots(result_type, []).as_string() + ")\n" + statements.join("") + "    Result.Ok(" + expression + ")\n"
                        }
                        result_type == "void" -> "    Result.Ok(())\n"
                        result_type == "bytes" -> "    Result.Ok(value.bytes())\n"
                        result_type == "f32" || result_type == "f64" -> "    value.floating()\n"
                        result_type == "bool" -> "    Result.Ok((try value.integer()) != 0)\n"
                        _ -> "    value.integer()\n"
                    }
                }
            }
            output = output + "}\n\n"
            id = id + 1
        }
        move output
    }
}

const PREAMBLE = "/* Generated Foster C bridge. Do not edit. */\n#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n#include <float.h>\n#include <math.h>\n#define EXPORT __declspec(dllexport)\n_Static_assert(sizeof(void*) == 8, \"Foster requires x86-64\");\n_Static_assert(sizeof(float) == 4 && sizeof(double) == 8, \"unsupported float ABI\");\nstatic int read64(const uint8_t **p, uint64_t *n, uint64_t *v) {\n    if (*n < 8) return 0;\n    *v = 0; for (unsigned i=0;i<8;i++) *v |= (uint64_t)(*p)[i] << (8*i);\n    *p += 8; *n -= 8; return 1;\n}\nstatic void write64(uint8_t *p, uint64_t v) { for(unsigned i=0;i<8;i++) p[i]=(uint8_t)(v >> (8*i)); }\nstatic int c_string_valid(const uint8_t *p, uint64_t n) {\n    if(!n || p[n-1] != 0) return 0;\n    n--;\n    while(n) {\n        uint8_t first=*p++; n--;\n        if(!first) return 0;\n        if(first < 0x80) continue;\n        unsigned count; uint32_t value, minimum;\n        if(first >= 0xc2 && first <= 0xdf) { count=1; value=first&31; minimum=0x80; }\n        else if(first >= 0xe0 && first <= 0xef) { count=2; value=first&15; minimum=0x800; }\n        else if(first >= 0xf0 && first <= 0xf4) { count=3; value=first&7; minimum=0x10000; }\n        else return 0;\n        if(n < count) return 0;\n        n -= count;\n        while(count--) { uint8_t next=*p++; if((next&0xc0)!=0x80) return 0; value=(value<<6)|(next&63); }\n        if(value < minimum || value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff)) return 0;\n    }\n    return 1;\n}\nEXPORT uint64_t foster_c_abi(void) { return 1; }\n"

// Lexicographic UTF-8 ordering keeps schema identity independent of object order.

func key_before(left: String, right: String) -> Bool {
    let a = left.bytes
    let b = right.bytes
    let index = 0
    while index < a.length && index < b.length {
        return a[index].int < b[index].int if a[index] != b[index]
        index = index + 1
    }
    a.length < b.length
}

func json_member(member: JsonMember, parent: Int, rows: List<String>) {
    json_flatten(member.value, parent, member.key, rows)
}

func json_flatten(value: JsonValue, parent: Int, key: String, rows: List<String>) {
    let id = rows.length
    let kind = ""
    let text = ""
    branch value {
        JsonValue.Null -> {
            kind = "null"
        }
        JsonValue.Bool(flag) -> {
            kind = "bool"
            text = branch {
                flag -> "true" _ -> "false"
            }
        }
        JsonValue.Number(number) -> {
            kind = "number"
            text = number.text()
        }
        JsonValue.String(content) -> {
            kind = "string"
            text = content.copy()
        }
        JsonValue.Array(_) -> {
            kind = "array"
        }
        JsonValue.Object(_) -> {
            kind = "object"
        }
    }
    rows.push(parent.as_string() + "\t" + key.bytes.hex() + "\t" + kind + "\t" + text.bytes.hex())
    branch value {
        JsonValue.Array(values) -> {
            let index = 0
            while index < values.length {
                branch values.borrow(index) {
                    Option.Some(child) -> json_flatten(child, id, "", rows)
                    Option.None -> panic("invalid JSON array index")
                }
                index = index + 1
            }
        }
        JsonValue.Object(members) -> {
            // Sort indices, never copy child subtrees to sort or traverse them.
            let order = []
            let names = []
            let index = 0
            while index < members.length {
                branch members.borrow(index) {
                    Option.Some(member) -> names.push(member.key.copy())
                    Option.None -> panic("invalid JSON member index")
                }
                order.push(index)
                let position = index
                while position > 0 && key_before(names[order[position]], names[order[position - 1]]) {
                    let previous = order[position - 1]
                    order[position - 1] = order[position]
                    order[position] = previous
                    position = position - 1
                }
                index = index + 1
            }
            for position in order {
                branch members.borrow(position) {
                    Option.Some(member) -> json_member(member, id, rows)
                    Option.None -> panic("invalid JSON member index")
                }
            }
        }
        _ -> ()
    }
}

func json_rows(input: String) -> String {
    let tree = branch json::parse_with(input, JsonParseOptions {
        max_depth: 256
    }) {
        Result.Ok(value) -> move value
        Result.Error(error) -> panic("JSON at byte " + error.offset.as_string() + ": " + error.message)
    }
    let rows = []
    json_flatten(tree, -1, "", rows)
    rows.join("\n") + "\n"
}

/// Decodes a JSON document into indexed nodes without copying nested subtrees on lookup.
pub func decode_json(input: String) -> Contract {
    let tree = branch json::parse_with(input, JsonParseOptions {
        max_depth: 256
    }) {
        Result.Ok(value) -> move value
        Result.Error(error) -> panic("JSON at byte " + error.offset.as_string() + ": " + error.message)
    }
    let nodes = []
    json_nodes(tree, -1, "", nodes)
    indexed(move nodes)
}

func member_node(member: JsonMember, parent: Int, nodes: List<Node>) {
    json_nodes(member.value, parent, member.key, nodes)
}
// AST discovery needs indexed lookups, not canonical schema bytes. Avoid the
// hex/TSV serialization, reparsing, and key sorting used for manifest identity.

func json_nodes(value: JsonValue, parent: Int, key: String, nodes: List<Node>) {
    let id = nodes.length
    let kind = ""
    let text = ""
    branch value {
        JsonValue.Null -> {
            kind = "null"
        }
        JsonValue.Bool(flag) -> {
            kind = "bool"
            text = branch {
                flag -> "true" _ -> "false"
            }
        }
        JsonValue.Number(number) -> {
            kind = "number"
            text = number.text()
        }
        JsonValue.String(content) -> {
            kind = "string"
            text = content.copy()
        }
        JsonValue.Array(_) -> {
            kind = "array"
        }
        JsonValue.Object(_) -> {
            kind = "object"
        }
    }
    nodes.push(Node {
        parent, key: key.copy(), kind: move kind, text: move text
    })
    branch value {
        JsonValue.Array(values) -> {
            let index = 0
            while index < values.length {
                branch values.borrow(index) {
                    Option.Some(child) -> json_nodes(child, id, "", nodes) Option.None -> panic("invalid JSON array index")
                }
                index = index + 1
            }
        }
        JsonValue.Object(members) -> {
            let index = 0
            while index < members.length {
                branch members.borrow(index) {
                    Option.Some(member) -> member_node(member, id, nodes) Option.None -> panic("invalid JSON member index")
                }
                index = index + 1
            }
        }
        _ -> ()
    }
}

pub func read_file(file: String) -> String {
    branch fs::read_text(file) {
        Result.Ok(text) -> move text Result.Error(error) -> panic(error.message)
    }
}

pub func write_file(file: String, text: String) {
    branch fs::write_text(file, text) {
        Result.Ok(_) -> () Result.Error(error) -> panic(error.message)
    }
}

pub func canonical(file: String) -> String {
    let value = branch paths::canonicalize(file) {
        Result.Ok(text) -> text.copy().split("\\").join("/") Result.Error(error) -> panic(error.message)
    }
    // Rust's Windows canonicalization returns extended paths; C include syntax
    // and Clang source locations use ordinary drive/UNC spellings.
    return "//" + value.slice(8, value.length) if value.starts_with?("//?/UNC/")
    value.strip_prefix("//?/")
}

pub func absolute(file: String) -> String {
    let directory = branch env::current_directory() {
        Result.Ok(text) -> move text Result.Error(error) -> panic(error.message)
    }
    paths::join(directory, file).split("\\").join("/")
}

pub func artifact(output: String, extension: String) -> String {
    assert(output.ends_with?(".dll"), "output must name a .dll file")
    output.slice(0, output.length - 4) + extension
}

pub func make_parent(output: String) {
    let parent = paths::parent(output).unwrap_or(".")
    branch fs::create_directory_all(parent) {
        Result.Ok(_) -> () Result.Error(error) -> panic(error.message)
    }
}

/// Starts a direct process with separate arguments; forwards failures and captures bounded UTF-8 output.
pub func execute(executable: String, arguments: List<String>, directory: String) -> String {
    let child = branch process::spawn_with(executable, arguments, SpawnOptions {
        directory: directory.copy(), output_limit: 67108864
    }) {
        Result.Ok(child) -> move child
        Result.Error(error) -> panic("cannot start " + executable + ": " + error.message)
    }
    let output = branch await child {
        Result.Ok(output) -> move output Result.Error(error) -> panic(error.message)
    }
    let stdout = String.from_utf8(move output.stdout).unwrap_or("<non-UTF-8 stdout>")
    let stderr = String.from_utf8(move output.stderr).unwrap_or("<non-UTF-8 stderr>")
    assert(output.status.success, executable + " failed:\n" + stdout + "\n" + stderr)
    if !stderr.empty? {
        println(stderr)
    }
    move stdout
}

/// Builds a reviewed manifest directly; paths inside it resolve relative to its directory.
pub func build(manifest_path: String, destination: String, compiler: String, module_path: String) -> String {
    let file = canonical(manifest_path)
    let root = paths::parent(file).unwrap_or(".")
    let output = absolute(destination)
    assert(output.ends_with?(".dll"), "C bridge output must have a .dll extension")
    assert(!module_path.empty?, "C bridge module path must not be empty")
    let input = read_file(file)
    let generated = generate_bridge(input, module_path)
    let manifest = decode_json(input)
    make_parent(output)
    let source = artifact(output, ".bridge.c")
    write_file(source, generated[1])
    let arguments = ["--target=x86_64-pc-windows-msvc", "-std=c11", "-shared", "-Werror=implicit-function-declaration", "-Werror=incompatible-pointer-types", "-Werror=incompatible-function-pointer-types", "-o", output.copy(), source.copy(), "-I", root.copy()]
    for node in manifest.array(0, "include_directories", false) {
        arguments.push("-I")
        arguments.push(paths::join(root, manifest.nodes[node].text))
    }
    for field in ["sources", "libraries"] {
        for node in manifest.array(0, field, false) {
            arguments.push(paths::join(root, manifest.nodes[node].text))
        }
    }
    execute(compiler, arguments, root)
    write_file(artifact(output, ".fos"), generated[2])
    write_file(artifact(output, ".schema"), generated[0])
    move output
}

test "generated names change only the initial letter before escaping" {
    assert(foster_type_name("color") == "Color")
    assert(foster_type_name("cMode") == "CMode")
    assert(foster_function_name("InitWindow") == "initWindow")
    assert(foster_function_name("URLLoad") == "uRLLoad")
    assert(foster_function_name("Type") == "type_")
    assert(foster_function_name("Type_") == "type__")
    assert(foster_name("KEY_SPACE") == "KEY_SPACE")
    assert(foster_type("@color") == "Color")
    assert(foster_type("$mode") == "Mode")
}
