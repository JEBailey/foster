//! Project manifests, discovery, and dependency resolution for the Foster driver.
import core.code_point

import core.future

import std.crypto.sha256

import core.int

import core.list.List

import core.option.Option

import core.result.Result

import core.string.String

import std.fs as fs

import static std.fs.*
import std.path as paths

import static std.path.*
import std.process
import std.process.Arguments

import std.toml
import std.toml.TomlEntry
import std.toml.TomlValue

type Dependency = {
    name: String, root: String
}
impl Dependency {
    func copy(self: Self) -> Self {
        Dependency {
            name: self.name.copy(), root: self.root.copy()
        }
    }
}
type ProjectData = {
    name: String, root: String, manifest: String, source: String, entry: String, dependencies: List<Dependency>
}
impl ProjectData {
    func copy(self: Self) -> Self {
        ProjectData {
            name: self.name.copy(), root: self.root.copy(), manifest: self.manifest.copy(), source: self.source.copy(), entry: self.entry.copy(), dependencies: self.dependencies.map((value: Dependency) -> value.copy())
        }
    }
}
type Resolved = {
    name: String, project: Option<ProjectData>, artifact: String
}
type Resolution = {
    visiting: List<Dependency>, aliases: List<Dependency>, output: List<Resolved>
}

func empty_dependencies() -> List<Dependency> {
    []
}

func lookup(entries: List<TomlEntry>, key: String) -> Option<TomlValue> {
    for entry in entries {
        return Option.Some(entry.value.copy()) if entry.key == key
    }
    Option.None
}

func table(value: TomlValue, message: String) -> Result<List<TomlEntry>, String> [consume value] {
    branch value {
        TomlValue.Table(entries) -> Result.Ok(move entries) _ -> Result.Error(message)
    }
}

func string_value(value: TomlValue, message: String) -> Result<String, String> [consume value] {
    branch value {
        TomlValue.String(text) -> Result.Ok(move text) _ -> Result.Error(message)
    }
}

func reject_unknown(entries: List<TomlEntry>, allowed: List<String>, location: String) -> Result<(), String> {
    for entry in entries {
        if !allowed.contains?(entry.key) {
            let expected = allowed.map((key: String) -> "`" + key + "`").join(" or ")
            return Result.Error("unknown key `" + entry.key + "` in " + location + "; expected " + expected)
        }
    }
    Result.Ok(())
}

func relative(path: String, windows: Bool) -> Bool {
    return false if path.starts_with?("/")
    return false if windows && (path.starts_with?("\\") || (path.scalar_length() >= 2 && path.scalar_slice(1, 2) == ":"))
    true
}

func components(path: String, windows: Bool) -> List<String> {
    let text = branch {
        windows -> path.copy().split("\\").join("/") _ -> path.copy()
    }
    (move text).split("/")
}

func validate_name(name: String, manifest: String) -> Result<(), String> {
    let characters = name.code_points()
    let valid = !characters.empty? && name != "core" && name != "std"
    let index = 0
    for character in characters {
        valid = valid && (character.as_int() == 95 || branch {
            index == 0 -> character.alphabetic?() _ -> character.alphanumeric?()
        })
        index = index + 1
    }
    branch {
        valid -> Result.Ok(()) _ -> Result.Error("dependency name `" + name + "` in `" + manifest + "` must be a portable module name other than `core` or `std`")
    }
}

// Keep dependency traversal deterministic regardless of manifest or directory order.
func ordered(left: String, right: String) -> Bool {
    let a = left.code_points()
    let b = right.code_points()
    let index = 0
    while index < a.length && index < b.length {
        return a[index].as_int() < b[index].as_int() if a[index] != b[index]
        index = index + 1
    }
    a.length <= b.length
}

func sort_dependencies(values: List<Dependency>) -> () {
    let index = 1
    while index < values.length {
        let position = index
        while position > 0 {
            break if ordered(values[position - 1].name, values[position].name)
            let previous = values[position - 1].copy()
            values[position - 1] = values[position].copy()
            values[position] = move previous
            position = position - 1
        }
        index = index + 1
    }
    ()
}

func discover_libraries(value: TomlValue, root: String, manifest: String, dependencies: List<Dependency>, windows: Bool) -> Result<List<Dependency>, String> [consume value] {
    let location = "`[discovery]` in `" + manifest + "`"
    let entries = try table(move value, location + " must be a TOML table")
    try reject_unknown(entries, ["libraries"], location)
    let library_value = branch lookup(entries, "libraries") {
        Option.Some(value) -> value Option.None -> {
            return Result.Ok([])
        }
    }
    let message = "`discovery.libraries` in `" + manifest + "` must be an array of strings"
    let folders = branch library_value {
        TomlValue.Array(values) -> move values _ -> {
            return Result.Error(message)
        }
    }
    let explicit = dependencies.map((value: Dependency) -> value.name.copy())
    let visited = []
    let discovered = empty_dependencies()
    for folder_value in folders {
        let folder = try string_value(folder_value.copy(), message)
        return Result.Error("`discovery.libraries` in `" + manifest + "` requires non-empty relative folder paths") if folder.copy().trim().empty? || !relative(folder, windows)
        let directory = paths::join(root, folder)
        let canonical = branch paths::canonicalize(directory) {
            Result.Ok(path) -> path
            Result.Error(error) -> {
                return Result.Error("cannot resolve library discovery folder `" + directory + "` from `" + manifest + "`: " + error.message)
            }
        }
        continue if visited.contains?(canonical)
        visited.push(canonical)
        let files = branch fs::list_directory(directory) {
            Result.Ok(files) -> files
            Result.Error(error) -> {
                return Result.Error("cannot read library discovery folder `" + directory + "` from `" + manifest + "`: " + error.message)
            }
        }
        let ordered = files.map((path: String) -> Dependency {
            name: path.copy(), root: path.copy()
        })
        sort_dependencies(ordered)
        for file in ordered {
            let path = paths::join(directory, file.root)
            let extension = branch paths::extension(path) {
                Option.Some(value) -> value Option.None -> ""
            }
            continue if extension != "flib" || !fs::file?(path)
            let filename = branch paths::file_name(path) {
                Option.Some(value) -> value Option.None -> {
                    return Result.Error("library discovery filename `" + path + "` must be valid UTF-8")
                }
            }
            let name = filename.scalar_slice(0, filename.scalar_length() - 5)
            try validate_name(name, manifest)
            continue if explicit.contains?(name)
            for previous in discovered {
                return Result.Error("ambiguous discovered library `" + name + "` in `" + manifest + "`: `" + previous.root + "` and `" + path + "`; select an explicit `[dependencies]` path or use distinct module names (previous name `" + previous.name + "`)") if previous.name.lower() == name.lower()
            }
            discovered.push(Dependency {
                name, root: path
            })
        }
    }
    Result.Ok(move discovered)
}

func git_command(arguments: List<String>) -> Result<(), String> {
    let child = branch process::spawn("git", arguments) {
        Result.Ok(child) -> move child
        Result.Error(error) -> {
            return Result.Error("cannot start Git: " + error.message)
        }
    }
    let output = branch await child {
        Result.Ok(output) -> move output
        Result.Error(error) -> {
            return Result.Error(error.message)
        }
    }
    branch {
        output.status.success -> Result.Ok(())
        _ -> Result.Error("Git dependency command failed; check the URI, revision or tag, and repository access")
    }
}

// Tags retain their exact spelling; completed checkouts are reused offline.
func git_source(uri: String, rev: String, tag: Bool) -> Result<String, String> {
    return Result.Error("dependency `uri` must use https://, ssh://, or file://") if !(uri.starts_with?("https://") || uri.starts_with?("ssh://") || uri.starts_with?("file://"))
    let selection = branch {
        tag -> {
            return Result.Error("dependency `tag` must be non-empty") if rev.empty?
            try git_command(["check-ref-format", "refs/tags/" + rev])
            "tag:" + rev
        }
        _ -> {
            let valid = rev.scalar_length() == 40
            for character in rev.code_points() {
                valid = valid && "0123456789abcdefABCDEF".contains?(character.as_string())
            }
            return Result.Error("dependency `rev` must be a full 40-character Git commit ID") if !valid
            "rev:" + rev.lower()
        }
    }
    let cache = paths::join(".", ".foster/sources")
    let key = sha256::digest((uri + "\n" + selection).bytes)
    let destination = paths::join(cache, key)
    return Result.Ok(destination) if fs::file?(paths::join(destination, ".foster-ready"))
    branch fs::create_directory_all(cache) {
        Result.Ok(_) -> ()
        Result.Error(error) -> {
            return Result.Error(error.message)
        }
    }
    let staging = destination + ".partial"
    if !fs::directory?(paths::join(staging, ".git")) {
        try git_command(["init", "--", staging.copy()])
    }
    let requested = branch {
        tag -> "+refs/tags/" + rev + ":refs/tags/foster-source"
        _ -> rev.lower()
    }
    try git_command(["-C", staging.copy(), "fetch", "--depth=1", "--", uri.copy(), requested.copy()])
    try git_command(["-C", staging.copy(), "checkout", "--detach", "FETCH_HEAD^{commit}"])
    branch fs::write_text(paths::join(staging, ".foster-ready"), rev) {
        Result.Ok(_) -> ()
        Result.Error(error) -> {
            return Result.Error(error.message)
        }
    }
    branch fs::rename(staging, destination) {
        Result.Ok(_) -> Result.Ok(destination)
        Result.Error(error) -> Result.Error(error.message)
    }
}

func load(manifest: String, windows: Bool) -> Result<ProjectData, String> {
    let source = branch fs::read_text(manifest) {
        Result.Ok(text) -> text
        Result.Error(error) -> {
            return Result.Error("cannot read project manifest `" + manifest + "`: " + error.message)
        }
    }
    let document = branch toml::parse(move source) {
        Result.Ok(document) -> document
        Result.Error(error) -> {
            return Result.Error("invalid project manifest `" + manifest + "` at " + error.line.as_string() + ":" + error.column.as_string() + ": " + error.message)
        }
    }
    try reject_unknown(document.entries, ["package", "dependencies", "discovery"], "project manifest `" + manifest + "`")
    let package_value = branch lookup(document.entries, "package") {
        Option.Some(value) -> value
        Option.None -> {
            return Result.Error("project manifest `" + manifest + "` is missing the required `[package]` table")
        }
    }
    let package = try table(move package_value, "`package` in `" + manifest + "` must be a TOML table")
    try reject_unknown(package, ["name", "source", "entry"], "`[package]` in `" + manifest + "`")
    let name_value = branch lookup(package, "name") {
        Option.Some(value) -> value
        Option.None -> {
            return Result.Error("project manifest `" + manifest + "` is missing required `package.name`")
        }
    }
    let name = try string_value(move name_value, "`package.name` in `" + manifest + "` must be a string")
    return Result.Error("`package.name` in `" + manifest + "` cannot be empty") if name.copy().trim().empty?
    let source_directory = branch lookup(package, "source") {
        Option.Some(value) -> try string_value(move value, "`package.source` in `" + manifest + "` must be a string")
        Option.None -> "src"
    }
    return Result.Error("`package.source` in `" + manifest + "` cannot be empty") if source_directory.copy().trim().empty?
    return Result.Error("`package.source` in `" + manifest + "` must be a relative path contained by the project") if !relative(source_directory, windows) || components(source_directory, windows).contains?("..")
    let root = branch paths::parent(manifest) {
        Option.Some(value) -> value Option.None -> ""
    }
    let source_root = paths::join(root, source_directory)
    return Result.Error("project source root `" + source_root + "` from `" + manifest + "` is not a directory") if !fs::directory?(source_root)
    let entry = branch lookup(package, "entry") {
        Option.Some(value) -> {
            let entry = try string_value(move value, "`package.entry` in `" + manifest + "` must be a string")
            return Result.Error("`package.entry` in `" + manifest + "` must be a .fos filename in the source root") if !relative(entry, windows) || components(entry, windows).length != 1 || !entry.ends_with?(".fos") || entry == ".fos"
            return Result.Error("package entry `" + paths::join(source_root, entry) + "` is not a file") if !fs::file?(paths::join(source_root, entry))
            entry
        }
        Option.None -> "main.fos"
    }
    let dependencies = []
    branch lookup(document.entries, "dependencies") {
        Option.Some(value) -> {
            let entries = try table(move value, "`dependencies` in `" + manifest + "` must be a TOML table")
            for entry in entries {
                try validate_name(entry.key, manifest)
                let location = "dependency `" + entry.key + "` in `" + manifest + "`"
                let fields = try table(entry.value.copy(), location + " must be a table containing `path` or `uri`")
                try reject_unknown(fields, ["path", "uri", "rev", "tag"], location)
                branch lookup(fields, "uri") {
                    Option.Some(value) -> {
                        branch lookup(fields, "path") {
                            Option.Some(_) -> {
                                return Result.Error(location + " must choose either `path` or `uri`")
                            }
                            Option.None -> ()
                        }
                        let uri = try string_value(move value, location + " requires a string `uri`")
                        let tag = false
                        let revision = branch lookup(fields, "tag") {
                            Option.Some(value) -> {
                                branch lookup(fields, "rev") {
                                    Option.Some(_) -> {
                                        return Result.Error(location + " must choose either `rev` or `tag`")
                                    }
                                    Option.None -> ()
                                }
                                tag = true
                                try string_value(move value, location + " requires a string `tag`")
                            }
                            Option.None -> {
                                branch lookup(fields, "rev") {
                                    Option.Some(value) -> try string_value(move value, location + " requires a string `rev`")
                                    Option.None -> {
                                        return Result.Error(location + " requires `rev` or `tag`")
                                    }
                                }
                            }
                        }
                        let fetched = try git_source(uri, revision, tag)
                        dependencies.push(Dependency {
                            name: entry.key.copy(), root: fetched
                        })
                        continue
                    }
                    Option.None -> ()
                }
                branch lookup(fields, "rev") {
                    Option.Some(_) -> {
                        return Result.Error(location + " permits `rev` only with `uri`")
                    }
                    Option.None -> ()
                }
                branch lookup(fields, "tag") {
                    Option.Some(_) -> {
                        return Result.Error(location + " permits `tag` only with `uri`")
                    }
                    Option.None -> ()
                }
                let path = branch lookup(fields, "path") {
                    Option.Some(value) -> try string_value(move value, location + " requires a string `path`")
                    Option.None -> {
                        return Result.Error(location + " requires a string `path`")
                    }
                }
                return Result.Error("dependency `" + entry.key + "` path in `" + manifest + "` must be a non-empty relative path") if path.copy().trim().empty? || !relative(path, windows)
                dependencies.push(Dependency {
                    name: entry.key.copy(), root: paths::join(root, path)
                })
            }
        }
        Option.None -> ()
    }
    branch lookup(document.entries, "discovery") {
        Option.Some(value) -> {
            let discovered = try discover_libraries(move value, root, manifest, dependencies, windows)
            for dependency in discovered {
                dependencies.push(dependency.copy())
            }
        }
        Option.None -> ()
    }
    sort_dependencies(dependencies)
    Result.Ok(ProjectData {
        name, root, manifest: manifest.copy(), source: source_root, entry, dependencies
    })
}

func canonical_manifest(project: ProjectData) -> Result<String, String> {
    branch paths::canonicalize(project.manifest) {
        Result.Ok(path) -> Result.Ok(path)
        Result.Error(error) -> Result.Error("cannot resolve project manifest `" + project.manifest + "`: " + error.message)
    }
}

func visit(project: ProjectData, state: Resolution, windows: Bool) -> Result<(), String> {
    for dependency in project.dependencies {
        let extension = branch paths::extension(dependency.root) {
            Option.Some(value) -> value Option.None -> ""
        }
        if extension == "flib" {
            let artifact = branch paths::canonicalize(dependency.root) {
                Result.Ok(path) -> path
                Result.Error(error) -> {
                    return Result.Error("cannot resolve library `" + dependency.root + "`: " + error.message)
                }
            }
            let seen = false
            for alias in state.aliases {
                if alias.name == dependency.name {
                    return Result.Error("dependency name `" + dependency.name + "` refers to different artifacts") if alias.root != artifact
                    seen = true
                }
            }
            continue if seen
            state.aliases.push(Dependency {
                name: dependency.name.copy(), root: artifact.copy()
            })
            state.output.push(Resolved {
                name: dependency.name.copy(), project: Option.None, artifact
            })
            continue
        }
        let child = branch load(paths::join(dependency.root, "foster.toml"), windows) {
            Result.Ok(value) -> value
            Result.Error(error) -> {
                return Result.Error("cannot load dependency `" + dependency.name + "` of package `" + project.name + "`: " + error)
            }
        }
        let manifest = try canonical_manifest(child)
        let cycle = []
        let in_cycle = false
        for ancestor in state.visiting {
            in_cycle = in_cycle || ancestor.root == manifest
            if in_cycle cycle.push(ancestor.name.copy())
        }
        if in_cycle {
            cycle.push(dependency.name.copy())
            return Result.Error("path dependency cycle: " + cycle.join(" -> "))
        }
        let seen = false
        for alias in state.aliases {
            if alias.name == dependency.name {
                return Result.Error("dependency name `" + dependency.name + "` refers to both `" + alias.root + "` and `" + manifest + "`") if alias.root != manifest
                seen = true
            }
        }
        continue if seen
        state.aliases.push(Dependency {
            name: dependency.name.copy(), root: manifest.copy()
        })
        state.output.push(Resolved {
            name: dependency.name.copy(), project: Option.Some(child.copy()), artifact: ""
        })
        state.visiting.push(Dependency {
            name: dependency.name.copy(), root: manifest.copy()
        })
        try visit(child, state, windows)
        state.visiting.remove(state.visiting.length - 1)
    }
    Result.Ok(())
}

func one(project: ProjectData) -> List<Resolved> [consume project] {
    [Resolved {
        name: project.name.copy(), project: Option.Some(move project), artifact: ""
    }]
}

func main(arguments: Arguments) -> Result<List<Resolved>, String> {
    let values = arguments.values
    let windows = values[1] == "windows"
    branch values[0] {
        "load" -> Result.Ok(one(try load(values[2], windows)))
        "discover" -> {
            let index = 2
            while index < values.length {
                let manifest = paths::join(values[index], "foster.toml")
                return Result.Ok(one(try load(manifest, windows))) if fs::file?(manifest)
                index = index + 1
            }
            Result.Ok([])
        }
        "resolve" -> {
            let dependencies = []
            let index = 7
            while index < values.length {
                dependencies.push(Dependency {
                    name: values[index].copy(), root: values[index + 1].copy()
                })
                index = index + 2
            }
            let project = ProjectData {
                name: values[2].copy(), root: values[3].copy(), manifest: values[4].copy(), source: values[5].copy(), entry: values[6].copy(), dependencies
            }
            let manifest = try canonical_manifest(project)
            let state = Resolution {
                visiting: [Dependency {
                    name: project.name.copy(), root: manifest
                }], aliases: [], output: []
            }
            try visit(project, state, windows)
            Result.Ok(move state.output)
        }
        _ -> Result.Error("unknown project tool operation")
    }
}

test "manifest path policy separates Windows and Unix spellings" {
    assert(!relative("C:\\outside", true))
    assert(relative("C:\\outside", false))
    assert(!relative("/outside", false))
    assert(components("src\\..\\outside", true).contains?(".."))
    assert(!components("src\\..\\outside", false).contains?(".."))
}

test "Git source requires supported URIs and immutable commits" {
    branch git_source("http://example.com/library.git", "0123456789abcdef0123456789abcdef01234567", false) {
        Result.Error(_) -> () Result.Ok(_) -> panic("accepted unsupported URI")
    }
    branch git_source("https://example.com/library.git", "main", false) {
        Result.Error(_) -> () Result.Ok(_) -> panic("accepted mutable revision")
    }
    branch git_source("https://example.com/library.git", "gggggggggggggggggggggggggggggggggggggggg", false) {
        Result.Error(_) -> () Result.Ok(_) -> panic("accepted invalid commit")
    }
}
