//! Formatting policy for already parser-validated Foster source.
import core.code_point
import core.list
import core.result
import core.string
import std.process

type ScanState = {
    depth: Int, mode: Int, escaped: Bool, comment: Int, parents: List<Int>, indents: List<Int>
}

// Negative modes count expression braces; positive modes are quote delimiters.

func literal_state() -> ScanState {
    ScanState {
        depth: 0, mode: 0, escaped: false, comment: 0, parents: [], indents: []
    }
}

func close_literal(state: ScanState) -> () {
    state.mode = state.parents[state.parents.length - 1]
    state.parents.remove(state.parents.length - 1)
    ()
}

// Both formatting passes use the same literal boundaries, including nested expressions.
func literal_step(points: List<CodePoint>, index: Int, state: ScanState) -> Int {
    let c = points[index].as_int()
    let next = branch {
        index + 1 < points.length -> points[index + 1].as_int() _ -> 0
    }
    let triple = c == 34 && next == 34 && index + 2 < points.length && points[index + 2].as_int() == 34
    if state.comment == -1 {
        if c == 10 state.comment = 0
        return 1
    }
    if state.comment > 0 {
        if c == 47 && next == 42 {
            state.comment = state.comment + 1
            return 2
        }
        if c == 42 && next == 47 {
            state.comment = state.comment - 1
            return 2
        }
        return 1
    }
    if state.mode > 0 {
        if state.escaped {
            state.escaped = false
            return 1
        }
        if c == 92 {
            state.escaped = true
            return 1
        }
        if state.mode == 3 {
            if c == 37 && next == 37 return 2
            if c == 37 && next == 123 {
                state.parents.push(state.mode)
                state.mode = -1
                return 2
            }
            if c == 37 {
                let end = index + 1
                while end < points.length && points[end].as_int() != 37 { end = end + 1 }
                return end - index + 1
            }
            if triple {
                close_literal(state)
                return 3
            }
        }
        if state.mode != 3 && c == state.mode close_literal(state)
        return 1
    }
    if state.mode < 0 {
        if state.mode == -1 && c == 125 && next == 37 {
            close_literal(state)
            return 2
        }
        if c == 123 state.mode = state.mode - 1
        if c == 125 state.mode = state.mode + 1
        if c == 47 && (next == 47 || next == 42) {
            state.comment = branch {
                next == 47 -> -1 _ -> 1
            }
            return 2
        }
    }
    if c == 34 || c == 39 {
        state.parents.push(state.mode)
        state.mode = branch {
            triple -> 3 _ -> c
        }
        return branch {
            triple -> 3 _ -> 1
        }
    }
    branch {
        state.mode != 0 -> 1 _ -> 0
    }
}

func declaration(line: String) -> String {
    line.strip_prefix("pub ")
}

func begins_declaration(line: String) -> Bool {
    let text = declaration(line)
    for prefix in ["import ", "const ", "type ", "enum ", "impl ", "func ", "test "] {
        return true if text.starts_with?(prefix)
    }
    false
}

func continues_type(lines: List<String>, start: Int) -> Bool {
    let index = start
    while index < lines.length {
        let text = lines[index].copy().trim()
        return text.starts_with?("|") || text.starts_with?("&") if !text.empty?
        index = index + 1
    }
    false
}

func closers(line: String, state: ScanState) -> Int {
    return 0 if state.depth != 0 || state.mode != 0
    let count = 0
    for point in line.code_points() {
        let value = point.as_int()
        break if value != 125 && value != 41 && value != 93
        count = count + 1
    }
    count
}

func scan(line: String, indent: Int, state: ScanState) -> () {
    let characters = line.code_points()
    let index = 0
    while index < characters.length {
        let character = characters[index].as_int()
        let next = branch {
            index + 1 < characters.length -> characters[index + 1].as_int() _ -> 0
        }
        if state.depth == 0 {
            let width = literal_step(characters, index, state)
            if width > 0 {
                index = index + width
                continue
            }
        }
        branch {
            state.depth > 0 -> {
                branch {
                    character == 47 && next == 42 -> {
                        state.depth = state.depth + 1
                        index = index + 2
                        continue
                    }
                    character == 42 && next == 47 -> {
                        state.depth = state.depth - 1
                        index = index + 2
                        continue
                    }
                    _ -> ()
                }
                index = index + 1
                continue
            }
            _ -> ()
        }
        break if character == 47 && next == 47
        branch {
            character == 47 && next == 42 -> {
                state.depth = 1
                index = index + 2
                continue
            }
            character == 123 || character == 40 || character == 91 -> {
                state.indents.push(indent + 1)
            }
            character == 125 || character == 41 || character == 93 -> {
                state.indents.remove(state.indents.length - 1)
                ()
            }
            _ -> ()
        }
        index = index + 1
    }
    if state.comment == -1 state.comment = 0
    ()
}

// Insert structural line breaks without interpreting braces inside literals or comments.
func expand_braces(source: String) -> String {
    let points = source.code_points()
    let output = StringBuilder.empty()
    let literal = literal_state()
    let depth = 0
    let line_comment = false
    let pending = false
    let line_start = true
    let index = 0
    while index < points.length {
        let value = points[index].as_int()
        let next = branch {
            index + 1 < points.length -> points[index + 1].as_int() _ -> 0
        }
        if depth == 0 && !line_comment {
            let width = literal_step(points, index, literal)
            if width > 0 {
                if pending output.append("\n")
                pending = false
                let end = index + width
                while index < end {
                    output.push(points[index])
                    line_start = points[index].as_int() == 10
                    index = index + 1
                }
                continue
            }
        }
        branch {
            line_comment -> {
                output.push(points[index])
                if value == 10 line_comment = false
            }
            depth > 0 -> {
                output.push(points[index])
                branch {
                    value == 47 && next == 42 -> {
                        depth = depth + 1
                        index = index + 1
                        output.push(points[index])
                    }
                    value == 42 && next == 47 -> {
                        depth = depth - 1
                        index = index + 1
                        output.push(points[index])
                    }
                }
            }
            _ -> {
                if pending && value == 32 || pending && value == 9 {
                    index = index + 1
                    continue
                }
                if pending && value != 10 {
                    output.append("\n")
                    line_start = true
                }
                pending = false
                if value == 125 && !line_start output.append("\n")
                output.push(points[index])
                branch {
                    value == 123 -> {
                        let following = index + 1
                        while following < points.length {
                            let code = points[following].as_int()
                            break if code != 32 && code != 9 && code != 10
                            following = following + 1
                        }
                        branch {
                            following < points.length && points[following].as_int() == 125 -> {
                                output.push(points[following])
                                index = following
                            }
                            _ -> {
                                pending = true
                            }
                        }
                    }
                    value == 125 -> {
                        let following = index + 1
                        while following < points.length {
                            let code = points[following].as_int()
                            break if code != 32 && code != 9
                            following = following + 1
                        }
                        if following < points.length {
                            let code = points[following].as_int()
                            let guarded = following + 1 < points.length && points[following].as_int() == 105 && points[following + 1].as_int() == 102
                            pending = !guarded && code >= 65 && code <= 90 || !guarded && code >= 97 && code <= 122 || code == 95
                        }
                    }
                    value == 47 && next == 47 -> {
                        line_comment = true
                    }
                    value == 47 && next == 42 -> {
                        depth = 1
                        index = index + 1
                        output.push(points[index])
                    }
                }
            }
        }
        branch {
            value == 10 -> {
                line_start = true
            }
            value != 32 && value != 9 -> {
                line_start = false
            }
        }
        index = index + 1
    }
    (move output).finish()
}

func format(source: String) -> String {
    // Splitting and joining also handles a lone CR, without splitting Unicode scalars.
    let normalized = source.copy().split("\r\n").join("\n").split("\r").join("\n")
    let lines = expand_braces(normalized).split("\n")
    let state = ScanState {
        depth: 0, mode: 0, escaped: false, comment: 0, parents: [], indents: []
    }
    let output = []
    let previous_blank = false
    let type_continuation = false
    let line_index = 0
    while line_index < lines.length {
        if state.mode != 0 || state.depth > 0 {
            let literal_line = lines[line_index].copy()
            output.push(literal_line.copy())
            scan(literal_line, branch {
                state.indents.empty? -> 0 _ -> state.indents[state.indents.length - 1]
            }, state)
            line_index = line_index + 1
            previous_blank = false
            continue
        }
        let probe = ScanState {
            depth: 0, mode: 0, escaped: false, comment: 0, parents: [], indents: []
        }
        scan(lines[line_index], 0, probe)
        let content = branch {
            probe.mode != 0 || probe.depth > 0 -> lines[line_index].copy().trim_start()
            _ -> lines[line_index].copy().trim()
        }
        line_index = line_index + 1
        if content.empty? {
            if !output.empty? && !previous_blank output.push("")
            previous_blank = true
            continue
        }
        previous_blank = false
        let next_continues = continues_type(lines, line_index)
        if begins_declaration(content) && !content.starts_with?("|") && !content.starts_with?("&") {
            let text = declaration(content)
            type_continuation = (text.starts_with?("type ") || text.starts_with?("enum ")) && (content.ends_with?("=") || next_continues)
        }
        let leading = closers(content, state)
        let retained = branch {
            state.indents.length >= leading -> state.indents.length - leading _ -> 0
        }
        let indent = 0
        branch {
            leading > 0 -> {
                if retained < state.indents.length indent = state.indents[retained] - 1
            }
            !state.indents.empty? -> {
                indent = state.indents[state.indents.length - 1]
            }
            _ -> ()
        }
        let text = declaration(content)
        let header = text.starts_with?("type ") || text.starts_with?("enum ")
        if type_continuation && !header && indent < 1 indent = 1
        let joins = false
        if type_continuation && !output.empty? {
            let last = declaration(output[output.length - 1].copy().trim())
            joins = last.starts_with?("enum ") && last.ends_with?("=")
        }
        branch {
            joins -> {
                output[output.length - 1] = output[output.length - 1] + " " + content
            }
            _ -> {
                let prefix = ""
                let level = 0
                while level < indent {
                    prefix = prefix + "    "
                    level = level + 1
                }
                output.push(prefix + content)
            }
        }
        scan(content, indent, state)
        if type_continuation && state.indents.empty? && !header && !next_continues type_continuation = false
    }
    while !output.empty? {
        break if !output[output.length - 1].empty?
        output.remove(output.length - 1)
    }
    output.join("\n") + "\n"
}

func main(arguments: Arguments) -> Result<String, String> {
    Result.Ok(format(arguments.values[0]))
}

test "formatter preserves expression substitutions and nested quotes" {
    let source = "func main() {\nlet text = \"\"\"\n%{branch { true -> \"\"\"{nested}\"\"\" _ -> \"}%\" }}%\n%{1 /* \"\"\" }% */ + 2}%\n\"\"\"\n}\n"
    let expected = "func main() {\n    let text = \"\"\"\n%{branch { true -> \"\"\"{nested}\"\"\" _ -> \"}%\" }}%\n%{1 /* \"\"\" }% */ + 2}%\n\"\"\"\n}\n"
    let formatted = format(source)
    assert(formatted == expected, formatted)
    assert(format(formatted) == formatted)
    ()
}

test "formatter preserves triple quoted contents and remains stable" {
    let probe = ScanState {
        depth: 0, mode: 0, escaped: false, comment: 0, parents: [], indents: []
    }
    scan("let text = \"\"\"", 0, probe)
    assert(probe.mode == 3, "scanner lost the opening delimiter")
    let source = "func main() {\nlet name = \"Ada\"\nlet text = \"\"\"\n  hello %name%  \n\"quotes\" { braces } // text\n\n\"\"\"\ntext\n}\n"
    let expected = "func main() {\n    let name = \"Ada\"\n    let text = \"\"\"\n  hello %name%  \n\"quotes\" { braces } // text\n\n\"\"\"\n    text\n}\n"
    let formatted = format(source)
    assert(formatted == expected, formatted)
    assert(format(formatted) == formatted)
    ()
}

test "formatter is stable around nested comments and Unicode strings" {
    let source = "func main() {\n/* { /* [ */ } */\nlet text = \"λ}\"\n}\n"
    let expected = "func main() {\n    /* { /* [ */ } */\n    let text = \"λ}\"\n}\n"
    assert(format(source) == expected)
    assert(format(expected) == expected)
    assert(format("\r\n  \r") == "\n")
}

test "formatter expands inline brace bodies" {
    let source = "func main() { branch { true -> { println(1) } _ -> { println(2) } } }\n"
    let expected = "func main() {\n    branch {\n        true -> {\n            println(1)\n        }\n        _ -> {\n            println(2)\n        }\n    }\n}\n"
    assert(format(source) == expected)
    assert(format(expected) == expected)
}

test "formatter preserves literal and comment braces" {
    let source = "func main() {\nlet text = \"{λ}\\\"\"\n// { unchanged }\n/* { outer /* } */ } */\n}\n"
    let expected = "func main() {\n    let text = \"{λ}\\\"\"\n    // { unchanged }\n    /* { outer /* } */ } */\n}\n"
    assert(format(source) == expected)
    assert(format(expected) == expected)
}

test "formatter preserves multiline literal contents and closing suffixes" {
    let source = "func main() {\nlet text = \"first  \n  { second }  \n\nlast\"\nlet value = Item { value: 1 }.value\n}\n"
    let expected = "func main() {\n    let text = \"first  \n  { second }  \n\nlast\"\n    let value = Item {\n        value: 1\n    }.value\n}\n"
    assert(format(source) == expected)
    assert(format(expected) == expected)
}
