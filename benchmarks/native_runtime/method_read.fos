type Pair = { left: Int, right: Int }
impl Pair {
    func sum(self) -> Int { self.left + self.right }
}
func main() -> Int {
    let pair = Pair { left: 7, right: 3 }
    let index = 0
    let total = 0
    while index < 100000 {
        total = total + pair.sum()
        index = index + 1
    }
    total
}
