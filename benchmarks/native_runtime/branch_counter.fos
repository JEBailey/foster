func main() -> Int {
    let index = 0
    let phase = 0
    let total = 0
    while index < 100000 {
        total = total + branch {
            phase == 0 -> index
            phase == 1 -> 3
            _ -> 7
        }
        phase = branch {
            phase == 2 -> 0
            _ -> phase + 1
        }
        index = index + 1
    }
    total
}
