// A complete concurrent workflow rather than an isolated language feature.
//
// Two remote auditors inspect borrowed inventory and policy values concurrently.
// The owner then restocks the inventory while a persistent remote read loan
// observes the updated state. A report actor serializes the final aggregation.

type Inventory = {
    apples: Int
    bolts: Int
    version: Int
}

type Policy = {
    minimum_apples: Int
    minimum_bolts: Int
}

type Auditor = {
    weight: Int
}

type Assessment = {
    version: Int
    missing: Int
    weighted: Int
}

type Report = {
    alerts: Int
    healthy: Int
    score: Int
}

func shortage(current: Int, minimum: Int) -> Int {
    branch {
        current < minimum -> minimum - current
        _ -> 0
    }
}

func evaluate(self: Auditor, inventory: Inventory, policy: Policy) -> Assessment {
    missing = shortage(inventory.apples, policy.minimum_apples) + shortage(inventory.bolts, policy.minimum_bolts)
    Assessment {
        version: inventory.version
        missing: missing
        weighted: missing * self.weight
    }
}

func restock(self: Inventory, apples: Int, bolts: Int) -> Int {
    self.apples = self.apples + apples
    self.bolts = self.bolts + bolts
    self.version = self.version + 1
    self.version
}

func total(self: Inventory) -> Int {
    self.apples + self.bolts
}

func submit(self: Report, assessment: Assessment) -> Int {
    self.alerts = self.alerts + branch {
        assessment.missing == 0 -> 0
        _ -> 1
    }
    self.healthy = self.healthy + branch {
        assessment.missing == 0 -> 1
        _ -> 0
    }
    self.score = self.score + assessment.weighted
    self.score
}

func result(self: Report) -> Int {
    self.healthy * 1000 + self.alerts * 100 + self.score
}

func main() -> Int {
    inventory = Inventory { apples: 2, bolts: 1, version: 1 }
    policy = Policy { minimum_apples: 5, minimum_bolts: 4 }

    // `dashboard` holds a persistent read loan to the live inventory. The owner
    // may still mutate it; readers and the owner are coordinated by the VM.
    dashboard = remote ref inventory

    auditor_a = remote Auditor { weight: 2 }
    auditor_b = remote Auditor { weight: 3 }
    report = remote Report { alerts: 0, healthy: 0, score: 0 }

    // Ordinary remote parameters borrow by default. Both calls can inspect the
    // same local values without copying or transferring ownership.
    first_future = auditor_a.evaluate(inventory, policy)
    second_future = auditor_b.evaluate(inventory, policy)

    first = await first_future
    second = await second_future
    await report.submit(first)
    await report.submit(second)

    // This owner mutation is atomic relative to remote readers.
    inventory.restock(5, 4)

    final_assessment = await auditor_a.evaluate(inventory, policy)
    await report.submit(final_assessment)

    live_total = await dashboard.total()
    summary = await report.result()

    // 1 healthy audit, 2 alerts, weighted shortage 30, live inventory total 12.
    summary + live_total
}
