func print_each(values: List[Int]) -> Unit {
    branch {
        values.empty? -> println()
        _ -> print_one_and_continue(values)
    }
}

func print_one_and_continue(values: List[Int]) -> Unit {
    println("number", values.head)
    print_each(values.rest)
}

func main() -> Unit {
    print_each([1, 2, 3, 4, 5])
}

