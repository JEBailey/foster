func fibonacci_from(remaining: Int, current: Int, next: Int) -> Int {
    return current if remaining == 0
    fibonacci_from(remaining - 1, next, current + next)
}

func fibonacci(position: Int) -> Int {
    return 0 if position < 1
    fibonacci_from(position, 0, 1)
}

func main() -> Unit {
    println("The Fibonacci value at position 12 is", fibonacci(12))
}

