import core.string

pub enum Json = Null
    | Boolean(Bool)
    | Number(Float)
    | JsonString(String)
    | Array(List<Json>)
    | Object(List<JsonMember>)

pub type JsonMember = {
    pub key: String
    pub value: Json
}

pub type JsonError = {
    pub message: String
}

pub enum ParseResult<T> = ParseOk(T)
    | ParseError(JsonError)

type Parsed<T> = {
    value: T
    rest: String
}

type ScannedNumber = {
    token: String
    rest: String
    digits: Int
}

func fail<T>(message: String) -> ParseResult<T> {
    ParseError(JsonError { message })
}

func skip_whitespace(characters: String) -> String {
    let prefix = characters.take_while((character: CodePoint) -> character.in?(' ', '\n', '\r', '\t'))
    string.slice(characters, prefix.length, characters.length)
}

func digit_value(character: CodePoint) -> Int {
    branch {
        character < '0' -> -1
        character > '9' -> -1
        _ -> character - '0'
    }
}

func hex_value(character: CodePoint) -> Int {
    let decimal = digit_value(character)
    return decimal if decimal >= 0

    branch {
        character < 'A' -> -1
        character <= 'F' -> character - 'A' + 10
        character < 'a' -> -1
        character <= 'f' -> character - 'a' + 10
        _ -> -1
    }
}

func consume_hex(characters: String, value: Int, remaining: Int) -> ParseResult<Parsed<Int>> {
    return ParseOk(Parsed { value, rest: characters }) if remaining == 0
    return fail("incomplete Unicode escape") if characters.empty?

    let digit = hex_value(characters.head)
    return fail("invalid hexadecimal digit in Unicode escape") if digit < 0
    consume_hex(characters.rest, value * 16 + digit, remaining - 1)
}

func scan_digits(characters: String, token: String, count: Int) -> ScannedNumber {
    let prefix = characters.take_while((character: CodePoint) -> digit_value(character) >= 0)
    let matched = prefix.length
    ScannedNumber {
        token: token + prefix
        rest: string.slice(characters, matched, characters.length)
        digits: count + matched
    }
}

func scan_fraction(characters: String, token: String) -> ParseResult<ScannedNumber> {
    return ParseOk(ScannedNumber { token, rest: characters, digits: 0 }) if characters.empty?
    return ParseOk(ScannedNumber { token, rest: characters, digits: 0 }) if characters.head != '.'
    let scanned = scan_digits(characters.rest, token + ".", 0)
    return fail("expected digits after decimal point") if scanned.digits == 0
    ParseOk(scanned)
}

func scan_exponent(characters: String, token: String) -> ParseResult<ScannedNumber> {
    return ParseOk(ScannedNumber { token, rest: characters, digits: 0 }) if characters.empty?
    return ParseOk(ScannedNumber { token, rest: characters, digits: 0 }) if !characters.head.in?('e', 'E')
    let rest = characters.rest
    let exponent = token + characters.head.string
    return fail("expected exponent digits") if rest.empty?

    let scanned = branch {
        rest.head.in?('+', '-') -> scan_digits(rest.rest, exponent + rest.head.string, 0)
        _ -> scan_digits(move rest, move exponent, 0)
    }
    return fail("expected exponent digits") if scanned.digits == 0
    ParseOk(scanned)
}

func parse_number(characters: String) -> ParseResult<Parsed<Json>> {
    branch {
        characters.head == '-' -> parse_unsigned_number(characters.rest, "-")
        _ -> parse_unsigned_number(move characters, "")
    }
}

func parse_unsigned_number(characters: String, prefix: String) -> ParseResult<Parsed<Json>> {
    return fail("expected a JSON number") if characters.empty?
    let leading_zero = characters.head == '0'
    let whole = scan_digits(move characters, move prefix, 0)
    branch {
        whole.digits == 0 -> fail("expected a JSON number")
        whole.digits > 1 -> branch {
            leading_zero -> fail("leading zero in JSON number")
            _ -> parse_number_fraction(move whole)
        }
        _ -> parse_number_fraction(move whole)
    }
}

func parse_number_fraction(whole: ScannedNumber) -> ParseResult<Parsed<Json>> {
    branch scan_fraction(move whole.rest, move whole.token) {
        ParseError(error) -> ParseError(error)
        ParseOk(fraction) -> parse_number_exponent(move fraction)
    }
}

func parse_number_exponent(number: ScannedNumber) -> ParseResult<Parsed<Json>> {
    branch scan_exponent(move number.rest, move number.token) {
        ParseError(error) -> ParseError(error)
        ParseOk(exponent) -> ParseOk(Parsed { value: Json.Number(parse_float(exponent.token)), rest: exponent.rest })
    }
}

func escaped_character(character: CodePoint) -> ParseResult<String> {
    branch character {
        '\"' -> ParseOk("\"")
        '\\' -> ParseOk("\\")
        '/' -> ParseOk("/")
        'b' -> ParseOk(from_code_point(8).string)
        'f' -> ParseOk(from_code_point(12).string)
        'n' -> ParseOk("\n")
        'r' -> ParseOk("\r")
        't' -> ParseOk("\t")
        _ -> fail("invalid JSON string escape")
    }
}

func parse_escape(characters: String) -> ParseResult<Parsed<String>> {
    return fail("unterminated JSON string escape") if characters.empty?
    return parse_unicode_escape(characters.rest) if characters.head == 'u'
    branch escaped_character(characters.head) {
        ParseError(error) -> ParseError(error)
        ParseOk(value) -> ParseOk(Parsed { value, rest: characters.rest })
    }
}

func parse_unicode_escape(characters: String) -> ParseResult<Parsed<String>> {
    branch consume_hex(move characters, 0, 4) {
        ParseError(error) -> ParseError(error)
        ParseOk(parsed) -> unicode_scalar(move parsed)
    }
}

func unicode_scalar(parsed: Parsed<Int>) -> ParseResult<Parsed<String>> {
    branch {
        parsed.value >= 55296 -> branch {
            parsed.value <= 56319 -> parse_low_surrogate(move parsed)
            parsed.value <= 57343 -> fail("isolated low surrogate")
            _ -> ParseOk(Parsed { value: from_code_point(parsed.value).string, rest: parsed.rest })
        }
        _ -> ParseOk(Parsed { value: from_code_point(parsed.value).string, rest: parsed.rest })
    }
}

const HIGH_SURROGATE_LOW_MESSAGE = "high surrogate must be followed by a low surrogate"
const HIGH_SURROGATE_UNICODE_MESSAGE = "high surrogate must be followed by a Unicode escape"

func parse_low_surrogate(high: Parsed<Int>) -> ParseResult<Parsed<String>> {
    return branch {
        high.rest.empty? -> fail(HIGH_SURROGATE_LOW_MESSAGE)
        high.rest.head != '\\' -> fail(HIGH_SURROGATE_LOW_MESSAGE)
        high.rest.rest.empty? -> fail(HIGH_SURROGATE_LOW_MESSAGE)
        high.rest.rest.head != 'u' -> fail(HIGH_SURROGATE_LOW_MESSAGE)
        _ -> combine_surrogates(high.value, consume_hex(high.rest.rest.rest, 0, 4))
    }
}

func combine_surrogates(high: Int, low_result: ParseResult<Parsed<Int>>) -> ParseResult<Parsed<String>> {
    branch low_result {
        ParseError(error) -> ParseError(error)
        ParseOk(low) -> branch {
            low.value < 56320 -> fail("invalid low surrogate")
            low.value > 57343 -> fail("invalid low surrogate")
            _ -> ParseOk(Parsed { value: from_code_point(65536 + (high - 55296) * 1024 + low.value - 56320).string, rest: low.rest })
        }
    }
}

func parse_string_characters(characters: String, result: String) -> ParseResult<Parsed<String>> {
    branch {
        characters.empty? -> fail("unterminated JSON string")
        characters.head == '\"' -> ParseOk(Parsed { value: result, rest: characters.rest })
        characters.head == '\\' -> append_escape(characters.rest, move result)
        characters.head < 32 -> fail("unescaped control character in JSON string")
        _ -> parse_string_characters(characters.rest, result + characters.head.string)
    }
}

func append_escape(characters: String, result: String) -> ParseResult<Parsed<String>> {
    branch parse_escape(move characters) {
        ParseError(error) -> ParseError(error)
        ParseOk(parsed) -> parse_string_characters(move parsed.rest, result + parsed.value)
    }
}

func parse_string(characters: String) -> ParseResult<Parsed<String>> {
    return fail("expected a JSON string") if characters.empty?
    return fail("expected a JSON string") if characters.head != '\"'
    parse_string_characters(characters.rest, "")
}

func consume_literal(characters: String, expected: String) -> ParseResult<String> {
    branch {
        expected.empty? -> ParseOk(characters)
        characters.empty? -> fail("incomplete JSON literal")
        characters.head == expected.head -> consume_literal(characters.rest, expected.rest)
        _ -> fail("invalid JSON literal")
    }
}

func literal_value(characters: String, expected: String, value: Json) -> ParseResult<Parsed<Json>> {
    branch consume_literal(move characters, move expected) {
        ParseError(error) -> ParseError(error)
        ParseOk(rest) -> ParseOk(Parsed { value, rest })
    }
}

func parse_array_items(characters: String, items: List<Json>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON array") if rest.empty?
    return ParseOk(Parsed { value: Json.Array(items), rest: rest.rest }) if rest.head == ']'
    append_array_value(parse_value(move rest), move items)
}

func append_array_value(parsed: ParseResult<Parsed<Json>>, items: List<Json>) -> ParseResult<Parsed<Json>> {
    branch parsed {
        ParseError(error) -> ParseError(error)
        ParseOk(value) -> array_separator(move value.rest, items.append(value.value))
    }
}

func array_separator(characters: String, items: List<Json>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON array") if rest.empty?
    return parse_required_array_item(rest.rest, move items) if rest.head == ','
    return ParseOk(Parsed { value: Json.Array(items), rest: rest.rest }) if rest.head == ']'
    fail("expected `,` or `]` in JSON array")
}

func parse_required_array_item(characters: String, items: List<Json>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON array") if rest.empty?
    return fail("trailing comma in JSON array") if rest.head == ']'
    append_array_value(parse_value(move rest), move items)
}

func parse_object_members(characters: String, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON object") if rest.empty?
    return ParseOk(Parsed { value: Json.Object(members), rest: rest.rest }) if rest.head == '}'
    return fail("expected a string key in JSON object") if rest.head != '\"'
    parse_object_key(parse_string(move rest), move members)
}

func parse_object_key(parsed: ParseResult<Parsed<String>>, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    branch parsed {
        ParseError(error) -> ParseError(error)
        ParseOk(key) -> require_object_colon(move key, move members)
    }
}

func require_object_colon(key: Parsed<String>, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move key.rest)
    return fail("expected `:` after JSON object key") if rest.empty?
    return fail("expected `:` after JSON object key") if rest.head != ':'
    parse_object_value(parse_value(rest.rest), move key.value, move members)
}

func parse_object_value(parsed: ParseResult<Parsed<Json>>, key: String, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    branch parsed {
        ParseError(error) -> ParseError(error)
        ParseOk(value) -> object_separator(move value.rest, members.append(JsonMember { key, value: value.value }))
    }
}

func object_separator(characters: String, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON object") if rest.empty?
    return parse_required_object_member(rest.rest, move members) if rest.head == ','
    return ParseOk(Parsed { value: Json.Object(members), rest: rest.rest }) if rest.head == '}'
    fail("expected `,` or `}` in JSON object")
}

func parse_required_object_member(characters: String, members: List<JsonMember>) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("unterminated JSON object") if rest.empty?
    return fail("trailing comma in JSON object") if rest.head == '}'
    parse_object_members(move rest, move members)
}

func parse_value(characters: String) -> ParseResult<Parsed<Json>> {
    let rest = skip_whitespace(move characters)
    return fail("expected a JSON value") if rest.empty?
    branch rest.head {
        '\"' -> string_json(parse_string(move rest))
        '[' -> parse_array_items(rest.rest, [])
        '{' -> parse_object_members(rest.rest, [])
        't' -> literal_value(move rest, "true", Json.Boolean(true))
        'f' -> literal_value(move rest, "false", Json.Boolean(false))
        'n' -> literal_value(move rest, "null", Json.Null)
        _ -> parse_number(move rest)
    }
}

func string_json(parsed: ParseResult<Parsed<String>>) -> ParseResult<Parsed<Json>> {
    branch parsed {
        ParseError(error) -> ParseError(error)
        ParseOk(value) -> ParseOk(Parsed { value: Json.JsonString(value.value), rest: value.rest })
    }
}

pub func parse_json(source: String) -> ParseResult<Json> {
    branch parse_value(move source) {
        ParseError(error) -> ParseError(error)
        ParseOk(parsed) -> finish_json(move parsed)
    }
}

func finish_json(parsed: Parsed<Json>) -> ParseResult<Json> {
    return fail("unexpected content after JSON value") if !skip_whitespace(move parsed.rest).empty?
    ParseOk(parsed.value)
}
