pub type Parsed<T> {
    pub value: T
    pub remaining: String
}

pub type JsonError {
    pub message: String
    pub offset: Int
}

func parsed_int(value: Int, remaining: String) -> Parsed<Int> {
    Parsed { value remaining }
}

func main() -> Int {
    result = parsed_int(42, " trailing")
    error = JsonError {
        message: "trailing content"
        offset: result.remaining.length
    }
    println(error.message, error.offset)
    result.value
}
