type Json =
    | Null
    | Boolean(Bool)
    | Number(Float)
    | String(String)
    | Array(List[Json])
    | Object(List[JsonMember])

type JsonMember {
    key: String
    value: Json
}

type JsonError {
    message: String
}

type ParseResult[T] =
    | Ok(T)
    | Error(JsonError)

type ParsedJson {
    value: Json
    rest: String
}

type ParsedString {
    value: String
    rest: String
}

type ScannedNumber {
    token: String
    rest: String
    digits: Int
}

type ParsedHex {
    value: Int
    rest: String
}

func skip_whitespace(characters: String) -> String {
    branch {
        characters.empty? -> characters
        characters.head.in?(' ', '\n', '\r', '\t') -> skip_whitespace(characters.rest)
        _ -> characters
    }
}

func digit_value(character: CodePoint) -> Int {
    branch {
        character < '0' -> -1
        character > '9' -> -1
        _ -> character - '0'
    }
}

func hex_value(character: CodePoint) -> Int {
    branch {
        character >= '0' -> branch { character <= '9' -> character - '0' _ -> hex_letter_value(character) }
        _ -> -1
    }
}

func hex_letter_value(character: CodePoint) -> Int {
    branch {
        character >= 'A' -> branch { character <= 'F' -> character - 'A' + 10 _ -> lower_hex_value(character) }
        _ -> -1
    }
}

func lower_hex_value(character: CodePoint) -> Int {
    branch {
        character >= 'a' -> branch { character <= 'f' -> character - 'a' + 10 _ -> -1 }
        _ -> -1
    }
}

func consume_hex(characters: String, value: Int, remaining: Int) -> ParseResult[ParsedHex] {
    branch {
        remaining == 0 -> Ok(ParsedHex { value, rest: characters })
        characters.empty? -> Error(JsonError { message: "incomplete Unicode escape" })
        _ -> consume_hex_digit(move characters, value, remaining)
    }
}

func consume_hex_digit(characters: String, value: Int, remaining: Int) -> ParseResult[ParsedHex] {
    digit = hex_value(characters.head)
    branch {
        digit < 0 -> Error(JsonError { message: "invalid hexadecimal digit in Unicode escape" })
        _ -> consume_hex(characters.rest, value * 16 + digit, remaining - 1)
    }
}

func scan_digits(characters: String, token: String, count: Int) -> ScannedNumber {
    branch {
        characters.empty? -> ScannedNumber { token, rest: characters, digits: count }
        digit_value(characters.head) < 0 -> ScannedNumber { token, rest: characters, digits: count }
        _ -> scan_digits(characters.rest, token + characters.head.string, count + 1)
    }
}

func scan_fraction(characters: String, token: String) -> ParseResult[ScannedNumber] {
    branch {
        characters.empty? -> Ok(ScannedNumber { token, rest: characters, digits: 0 })
        characters.head != '.' -> Ok(ScannedNumber { token, rest: characters, digits: 0 })
        _ -> require_fraction_digits(scan_digits(characters.rest, token + ".", 0))
    }
}

func require_fraction_digits(scanned: ScannedNumber) -> ParseResult[ScannedNumber] {
    branch {
        scanned.digits == 0 -> Error(JsonError { message: "expected digits after decimal point" })
        _ -> Ok(scanned)
    }
}

func scan_exponent(characters: String, token: String) -> ParseResult[ScannedNumber] {
    branch {
        characters.empty? -> Ok(ScannedNumber { token, rest: characters, digits: 0 })
        characters.head.in?('e', 'E') -> scan_exponent_sign(characters.rest, token + characters.head.string)
        _ -> Ok(ScannedNumber { token, rest: characters, digits: 0 })
    }
}

func scan_exponent_sign(characters: String, token: String) -> ParseResult[ScannedNumber] {
    branch {
        characters.empty? -> Error(JsonError { message: "expected exponent digits" })
        characters.head.in?('+', '-') -> require_exponent_digits(scan_digits(characters.rest, token + characters.head.string, 0))
        _ -> require_exponent_digits(scan_digits(move characters, move token, 0))
    }
}

func require_exponent_digits(scanned: ScannedNumber) -> ParseResult[ScannedNumber] {
    branch {
        scanned.digits == 0 -> Error(JsonError { message: "expected exponent digits" })
        _ -> Ok(scanned)
    }
}

func parse_number(characters: String) -> ParseResult[ParsedJson] {
    branch {
        characters.head == '-' -> parse_unsigned_number(characters.rest, "-")
        _ -> parse_unsigned_number(move characters, "")
    }
}

func parse_unsigned_number(characters: String, prefix: String) -> ParseResult[ParsedJson] {
    leading_zero = characters.head == '0'
    whole = scan_digits(move characters, move prefix, 0)
    branch {
        whole.digits == 0 -> Error(JsonError { message: "expected a JSON number" })
        whole.digits > 1 -> branch {
            leading_zero -> Error(JsonError { message: "leading zero in JSON number" })
            _ -> parse_number_fraction(move whole)
        }
        _ -> parse_number_fraction(move whole)
    }
}

func parse_number_fraction(whole: ScannedNumber) -> ParseResult[ParsedJson] {
    branch scan_fraction(move whole.rest, move whole.token) {
        Error(error) -> Error(error)
        Ok(fraction) -> parse_number_exponent(move fraction)
    }
}

func parse_number_exponent(number: ScannedNumber) -> ParseResult[ParsedJson] {
    branch scan_exponent(move number.rest, move number.token) {
        Error(error) -> Error(error)
        Ok(exponent) -> Ok(ParsedJson { value: Json.Number(parse_float(exponent.token)), rest: exponent.rest })
    }
}

func escaped_character(character: CodePoint) -> ParseResult[String] {
    branch character {
        '\"' -> Ok("\"")
        '\\' -> Ok("\\")
        '/' -> Ok("/")
        'b' -> Ok(from_code_point(8).string)
        'f' -> Ok(from_code_point(12).string)
        'n' -> Ok("\n")
        'r' -> Ok("\r")
        't' -> Ok("\t")
        _ -> Error(JsonError { message: "invalid JSON string escape" })
    }
}

func parse_escape(characters: String) -> ParseResult[ParsedString] {
    branch {
        characters.empty? -> Error(JsonError { message: "unterminated JSON string escape" })
        characters.head == 'u' -> parse_unicode_escape(characters.rest)
        _ -> branch escaped_character(characters.head) {
            Error(error) -> Error(error)
            Ok(value) -> Ok(ParsedString { value, rest: characters.rest })
        }
    }
}

func parse_unicode_escape(characters: String) -> ParseResult[ParsedString] {
    branch consume_hex(move characters, 0, 4) {
        Error(error) -> Error(error)
        Ok(parsed) -> unicode_scalar(move parsed)
    }
}

func unicode_scalar(parsed: ParsedHex) -> ParseResult[ParsedString] {
    branch {
        parsed.value >= 55296 -> branch {
            parsed.value <= 56319 -> parse_low_surrogate(move parsed)
            parsed.value <= 57343 -> Error(JsonError { message: "isolated low surrogate" })
            _ -> Ok(ParsedString { value: from_code_point(parsed.value).string, rest: parsed.rest })
        }
        _ -> Ok(ParsedString { value: from_code_point(parsed.value).string, rest: parsed.rest })
    }
}

func parse_low_surrogate(high: ParsedHex) -> ParseResult[ParsedString] {
    branch {
        high.rest.empty? -> Error(JsonError { message: "high surrogate must be followed by a low surrogate" })
        high.rest.head != '\\' -> Error(JsonError { message: "high surrogate must be followed by a low surrogate" })
        high.rest.rest.empty? -> Error(JsonError { message: "high surrogate must be followed by a Unicode escape" })
        high.rest.rest.head != 'u' -> Error(JsonError { message: "high surrogate must be followed by a Unicode escape" })
        _ -> combine_surrogates(high.value, consume_hex(high.rest.rest.rest, 0, 4))
    }
}

func combine_surrogates(high: Int, low_result: ParseResult[ParsedHex]) -> ParseResult[ParsedString] {
    branch low_result {
        Error(error) -> Error(error)
        Ok(low) -> branch {
            low.value < 56320 -> Error(JsonError { message: "invalid low surrogate" })
            low.value > 57343 -> Error(JsonError { message: "invalid low surrogate" })
            _ -> Ok(ParsedString { value: from_code_point(65536 + (high - 55296) * 1024 + low.value - 56320).string, rest: low.rest })
        }
    }
}

func parse_string_characters(characters: String, result: String) -> ParseResult[ParsedString] {
    branch {
        characters.empty? -> Error(JsonError { message: "unterminated JSON string" })
        characters.head == '\"' -> Ok(ParsedString { value: result, rest: characters.rest })
        characters.head == '\\' -> append_escape(characters.rest, move result)
        characters.head < 32 -> Error(JsonError { message: "unescaped control character in JSON string" })
        _ -> parse_string_characters(characters.rest, result + characters.head.string)
    }
}

func append_escape(characters: String, result: String) -> ParseResult[ParsedString] {
    branch parse_escape(move characters) {
        Error(error) -> Error(error)
        Ok(parsed) -> parse_string_characters(move parsed.rest, result + parsed.value)
    }
}

func parse_string(characters: String) -> ParseResult[ParsedString] {
    branch {
        characters.empty? -> Error(JsonError { message: "expected a JSON string" })
        characters.head == '\"' -> parse_string_characters(characters.rest, "")
        _ -> Error(JsonError { message: "expected a JSON string" })
    }
}

func consume_literal(characters: String, expected: String) -> ParseResult[String] {
    branch {
        expected.empty? -> Ok(characters)
        characters.empty? -> Error(JsonError { message: "incomplete JSON literal" })
        characters.head == expected.head -> consume_literal(characters.rest, expected.rest)
        _ -> Error(JsonError { message: "invalid JSON literal" })
    }
}

func literal_value(characters: String, expected: String, value: Json) -> ParseResult[ParsedJson] {
    branch consume_literal(move characters, move expected) {
        Error(error) -> Error(error)
        Ok(rest) -> Ok(ParsedJson { value, rest })
    }
}

func parse_array(characters: String) -> ParseResult[ParsedJson] {
    parse_array_items(characters.rest, [])
}

func parse_array_items(characters: String, items: List[Json]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON array" })
        rest.head == ']' -> Ok(ParsedJson { value: Json.Array(items), rest: rest.rest })
        _ -> append_array_value(parse_value(move rest), move items)
    }
}

func append_array_value(parsed: ParseResult[ParsedJson], items: List[Json]) -> ParseResult[ParsedJson] {
    branch parsed {
        Error(error) -> Error(error)
        Ok(value) -> array_separator(move value.rest, items.append(value.value))
    }
}

func array_separator(characters: String, items: List[Json]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON array" })
        rest.head == ',' -> parse_required_array_item(rest.rest, move items)
        rest.head == ']' -> Ok(ParsedJson { value: Json.Array(items), rest: rest.rest })
        _ -> Error(JsonError { message: "expected `,` or `]` in JSON array" })
    }
}

func parse_required_array_item(characters: String, items: List[Json]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON array" })
        rest.head == ']' -> Error(JsonError { message: "trailing comma in JSON array" })
        _ -> append_array_value(parse_value(move rest), move items)
    }
}

func parse_object(characters: String) -> ParseResult[ParsedJson] {
    parse_object_members(characters.rest, [])
}

func parse_object_members(characters: String, members: List[JsonMember]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON object" })
        rest.head == '}' -> Ok(ParsedJson { value: Json.Object(members), rest: rest.rest })
        rest.head != '\"' -> Error(JsonError { message: "expected a string key in JSON object" })
        _ -> parse_object_key(parse_string(move rest), move members)
    }
}

func parse_object_key(parsed: ParseResult[ParsedString], members: List[JsonMember]) -> ParseResult[ParsedJson] {
    branch parsed {
        Error(error) -> Error(error)
        Ok(key) -> require_object_colon(move key, move members)
    }
}

func require_object_colon(key: ParsedString, members: List[JsonMember]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move key.rest)
    branch {
        rest.empty? -> Error(JsonError { message: "expected `:` after JSON object key" })
        rest.head != ':' -> Error(JsonError { message: "expected `:` after JSON object key" })
        _ -> parse_object_value(parse_value(rest.rest), move key.value, move members)
    }
}

func parse_object_value(parsed: ParseResult[ParsedJson], key: String, members: List[JsonMember]) -> ParseResult[ParsedJson] {
    branch parsed {
        Error(error) -> Error(error)
        Ok(value) -> object_separator(move value.rest, members.append(JsonMember { key, value: value.value }))
    }
}

func object_separator(characters: String, members: List[JsonMember]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON object" })
        rest.head == ',' -> parse_required_object_member(rest.rest, move members)
        rest.head == '}' -> Ok(ParsedJson { value: Json.Object(members), rest: rest.rest })
        _ -> Error(JsonError { message: "expected `,` or `}` in JSON object" })
    }
}

func parse_required_object_member(characters: String, members: List[JsonMember]) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "unterminated JSON object" })
        rest.head == '}' -> Error(JsonError { message: "trailing comma in JSON object" })
        _ -> parse_object_members(move rest, move members)
    }
}

func parse_value(characters: String) -> ParseResult[ParsedJson] {
    rest = skip_whitespace(move characters)
    branch {
        rest.empty? -> Error(JsonError { message: "expected a JSON value" })
        _ -> parse_value_head(move rest)
    }
}

func parse_value_head(rest: String) -> ParseResult[ParsedJson] {
    branch rest.head {
        '\"' -> string_json(parse_string(move rest))
        '[' -> parse_array(move rest)
        '{' -> parse_object(move rest)
        't' -> literal_value(move rest, "true", Json.Boolean(true))
        'f' -> literal_value(move rest, "false", Json.Boolean(false))
        'n' -> literal_value(move rest, "null", Json.Null)
        _ -> parse_number(move rest)
    }
}

func string_json(parsed: ParseResult[ParsedString]) -> ParseResult[ParsedJson] {
    branch parsed {
        Error(error) -> Error(error)
        Ok(value) -> Ok(ParsedJson { value: Json.String(value.value), rest: value.rest })
    }
}

func parse_json(source: String) -> ParseResult[Json] {
    branch parse_value(move source) {
        Error(error) -> Error(error)
        Ok(parsed) -> finish_json(move parsed)
    }
}

func finish_json(parsed: ParsedJson) -> ParseResult[Json] {
    branch {
        skip_whitespace(move parsed.rest).empty? -> Ok(parsed.value)
        _ -> Error(JsonError { message: "unexpected content after JSON value" })
    }
}

type ParserWorker {}

type Statistics {
    processed: Int
    failed: Int
}

type PipelineReport {
    processed: Int
    failed: Int
}

func parse_document(self: ParserWorker, source: String) -> ParseResult[Json] {
    parse_json(move source)
}

func record_success(self: Statistics) -> Int {
    self.processed = self.processed + 1
    self.processed
}

func record_failure(self: Statistics) -> Int {
    self.failed = self.failed + 1
    self.processed
}

func record_result(self: Statistics, result: ParseResult[Json]) -> Int {
    branch result {
        Ok(_) -> self.record_success()
        Error(_) -> self.record_failure()
    }
}

func snapshot(self: Statistics) -> PipelineReport {
    PipelineReport {
        processed: self.processed
        failed: self.failed
    }
}

func main() -> PipelineReport {
    parser_a = remote ParserWorker {}
    parser_b = remote ParserWorker {}
    statistics = remote Statistics { processed: 0, failed: 0 }

    first = parser_a.parse_document("{\"name\":\"Ada\",\"active\":true}")
    second = parser_b.parse_document("[1,2,3,4]")
    third = parser_a.parse_document("{broken json}")

    first_recorded = statistics.record_result(await first)
    second_recorded = statistics.record_result(await second)
    third_recorded = statistics.record_result(await third)

    await first_recorded
    await second_recorded
    await third_recorded
    await statistics.snapshot()
}

