type Square = {
    length: Int
    width: Int
    total_area: Int
}

func area(self: Square) -> Int {
    self.length * self.width
}

func set_width(self: Square, width: Int) -> Unit {
    self.width = width
    self.total_area = self.length * width
    println()
}

func main() -> Int {
    square1 = Square { length: 5, width: 80, total_area: 400 }
    square2 = Square { length: 5, width: 80, total_area: 400 }
    println("square1 area:", square1.area())
    println("square2 area:", square2.area())
    square1.set_width(40)
    println("changed square1:", square1.area())
    println("unchanged square2:", square2.area())
    square1.area() + square2.area()
}
