func count_to(current: Int, limit: Int) -> Int {
    return current if current >= limit
    count_to(current + 1, limit)
}

func main() -> Int {
    // The Pima source uses a mutable while loop to reach 12,000. This smaller
    // recursive run remains safe until Foster has loops or tail-call lowering.
    count_to(0, 10)
}
