//! Remote parsing workers and result aggregation built around the JSON parser module.

import parser

import core.result as outcomes
import core.remote_error

type ParserWorker = {}

type Statistics = {
    processed: Int
    failed: Int
}

type PipelineReport = {
    processed: Int
    failed: Int
}

impl ParserWorker {
    func parse_document(self: ParserWorker, source: String) -> ParseResult<Json> {
        parse_json(move source)
    }
}

impl Statistics {
    func record_success(self: Statistics) -> Int {
        self.processed = self.processed + 1
        self.processed
    }

    func record_failure(self: Statistics) -> Int {
        self.failed = self.failed + 1
        self.failed
    }

    func record_result(self: Statistics, result: ParseResult<Json>) -> Int {
        branch result {
            ParseOk(_) -> self.record_success()
            ParseError(_) -> self.record_failure()
        }
    }

    func snapshot(self: Statistics) -> PipelineReport {
        PipelineReport {
            processed: self.processed
            failed: self.failed
        }
    }
}

func main() -> Result<PipelineReport, RemoteError> {
    let parser_a = remote ParserWorker {}
    let parser_b = remote ParserWorker {}
    let statistics = remote Statistics { processed: 0, failed: 0 }

    let first = parser_a.parse_document("{\"name\":\"Ada\",\"active\":true}")
    let second = parser_b.parse_document("[1,2,3,4]")
    let third = parser_a.parse_document("{broken json}")

    let first_recorded = statistics.record_result(try await first)
    let second_recorded = statistics.record_result(try await second)
    let third_recorded = statistics.record_result(try await third)

    try await first_recorded
    try await second_recorded
    try await third_recorded
    await statistics.snapshot()
}
