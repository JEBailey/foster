//! Remote parsing workers and result aggregation built around the JSON parser module.

import parser

type ParserWorker = {}

type Statistics = {
    processed: Int
    failed: Int
}

type PipelineReport = {
    processed: Int
    failed: Int
}

func ParserWorker.parse_document(self: ParserWorker, source: String) -> ParseResult<Json> {
    parse_json(move source)
}

func Statistics.record_success(self: Statistics) -> Int {
    self.processed = self.processed + 1
    self.processed
}

func Statistics.record_failure(self: Statistics) -> Int {
    self.failed = self.failed + 1
    self.failed
}

func Statistics.record_result(self: Statistics, result: ParseResult<Json>) -> Int {
    branch result {
        ParseOk(_) -> self.record_success()
        ParseError(_) -> self.record_failure()
    }
}

func Statistics.snapshot(self: Statistics) -> PipelineReport {
    PipelineReport {
        processed: self.processed
        failed: self.failed
    }
}

func main() -> PipelineReport {
    let parser_a = remote ParserWorker {}
    let parser_b = remote ParserWorker {}
    let statistics = remote Statistics { processed: 0, failed: 0 }

    let first = parser_a.parse_document("{\"name\":\"Ada\",\"active\":true}")
    let second = parser_b.parse_document("[1,2,3,4]")
    let third = parser_a.parse_document("{broken json}")

    let first_recorded = statistics.record_result(await first)
    let second_recorded = statistics.record_result(await second)
    let third_recorded = statistics.record_result(await third)

    await first_recorded
    await second_recorded
    await third_recorded
    await statistics.snapshot()
}
