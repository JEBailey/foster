import std.collections.Collection

import core.option.Option

import core.range.Range

import std.collections.set.Set

func size<T>(values: Collection<T>) -> Int {
    values.length()
}

func value_or(candidate: Option<Int>, fallback: Int) -> Int {
    branch candidate {
        Option.Some(value) -> value
        Option.None -> fallback
    }
}

func main() -> Int {
    let distinct = Set.from([2, 2, 4, 6])
    let values = Range.from([10, 20, 30])
    let cursor = values.iterator()

    size(distinct) + size(values) + value_or(cursor.next(), 0)
}
