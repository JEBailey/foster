//! Lexically nested functions and iterative floating-point convergence.

func square_root(number: Float) -> Float {
    func absolute(value: Float) -> Float {
        return -value if value < 0.0
        value
    }

    func average(left: Float, right: Float) -> Float {
        (left + right) / 2.0
    }

    func good_enough(guess: Float) -> Bool {
        absolute(guess * guess - number) < 0.001
    }

    func find_square_root(guess: Float) -> Float {
        return guess if good_enough(guess)
        find_square_root(average(guess, number / guess))
    }

    find_square_root(1.0)
}

func main() -> Float {
    square_root(16.0)
}
