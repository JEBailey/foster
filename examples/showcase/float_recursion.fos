//! Recursive floating-point computation using the birthday-paradox threshold.

func birthday_paradox(probability: Float, number_of_people: Float) -> Float {
    let new_probability = ((365.0 - number_of_people) / 365.0) * probability
    return number_of_people + 1.0 if new_probability < 0.5
    birthday_paradox(new_probability, number_of_people + 1.0)
}

func main() -> Float {
    birthday_paradox(1.0, 1.0)
}
