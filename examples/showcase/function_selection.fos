//! Selects between ordinary functions through their shared callable type.

func compact_report(name: String, score: Int) -> () {
    println(name, ":", score)
}

func detailed_report(name: String, score: Int) -> () {
    println("Student:", name)
    println("Score:", score)
    println("Passing:", score >= 70)
}

func choose_report(detailed: Bool) -> func(String, Int) -> () {
    branch {
        detailed -> detailed_report
        _ -> compact_report
    }
}

func render_report(report: func(String, Int) -> (), name: String, score: Int) -> () {
    report(name, score)
}

func for_each_report(reports: List<func(String, Int) -> ()>, name: String, score: Int) -> () {
    branch {
        reports.empty? -> println()
        _ -> render_then_continue(reports, name, score)
    }
}

func render_then_continue(reports: List<func(String, Int) -> ()>, name: String, score: Int) -> () {
    reports.head(name, score)
    for_each_report(reports.rest, name, score)
}

func main() -> Int {
    let selected = choose_report(true)
    render_report(selected, "Ada", 96)
    render_report(selected, "Grace", 68)
    let reports = [compact_report, detailed_report]
    for_each_report(reports, "Linus", 88)
    2
}
