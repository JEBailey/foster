import core.ordering.Ordering
import core.ordering.Ordered
import core.ordering.Hashing

type Version = & Ordered<Version> & Hashing & {
    number: Int
}

impl Version {
    func equal?(self: Self, other: Version) -> Bool {
        self.number == other.number
    }

    func compare(self: Self, other: Version) -> Ordering {
        branch {
            self.number < other.number -> Ordering.Less
            self.number > other.number -> Ordering.Greater
            _ -> Ordering.Equal
        }
    }

    func hash(self: Self) -> Int {
        self.number * 31
    }
}

func compare_score(left: Ordered<Version>, right: Version) -> Int {
    branch left.compare(right) {
        Ordering.Less -> -1
        Ordering.Equal -> 0
        Ordering.Greater -> 1
    }
}

func main() -> Int {
    let version = Version {
        number: 7
    }
    version.hash() + compare_score(version, Version {
        number: 8
    })
}
