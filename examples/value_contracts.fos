import core.ordering

type Version = & Ordered<Version> & Hashing & {
    number: Int
}

func Version.equal?(self: Version, other: Version) -> Bool {
    self.number == other.number
}

func Version.compare(self: Version, other: Version) -> Ordering {
    branch {
        self.number < other.number -> Ordering.Less
        self.number > other.number -> Ordering.Greater
        _ -> Ordering.Equal
    }
}

func Version.hash(self: Version) -> Int {
    self.number * 31
}

func compare_score(left: Ordered<Version>, right: Version) -> Int {
    branch left.compare(right) {
        Ordering.Less -> -1
        Ordering.Equal -> 0
        Ordering.Greater -> 1
    }
}

func main() -> Int {
    let version = Version { number: 7 }
    version.hash + compare_score(version, Version { number: 8 })
}
