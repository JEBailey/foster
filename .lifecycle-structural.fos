import core.drop
import core.copy
type Item = & Copy & Drop & { id: Int }
impl Item {
    func copy(self) -> self { Item { id: self.id + 10 } }
    func deinit(self) -> () { println(self.id) }
}
func copied(value: Copy) -> Copy { value.copy() }
func main() -> Int {
    let original = Item { id: 1 }
    let duplicate = copied(original)
    println(20)
    42
}
